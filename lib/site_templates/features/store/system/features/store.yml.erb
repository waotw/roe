enabled: true
currency: "<%= currency %>"
default_domain: "<%= default_domain %>"
product_categories:<%= categories_yaml %>
product_groups: []
product_button_template: |
  ![Add Image Description](@image)

  # @title

  **Price:** @price

  @description

  ```button
  sku: @sku
  text: Add to Cart
  style: primary
  ```

grouped_products:
  button_text: "View"
  price_display: "range"
  price_separator: "-"
snipcart:
  load_strategy: "on-user-interaction"
  modal_style: "side"
  show_taxes: true
  show_quantity: true
