<!DOCTYPE html>
<!-- Site Mode: <%= @static_generation ? 'Static (Generated)' : 'Dynamic (Rails)' %> -->
<html>
  <head>
    <title>Roe CMS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Feed autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="<%= feed_url(format: :xml) %>">
    <link rel="alternate" type="application/atom+xml" title="Atom Feed" href="<%= feed_atom_url(format: :xml) %>">
    <!-- Font preloading -->
    <% fonts_config = SiteConfig.get('fonts') %>
    <% if fonts_config %>
      <% %w[heading body].each do |role| %>
        <% if fonts_config[role] && fonts_config[role]['regular'] %>
          <link rel="preload"
                as="font"
                type="font/<%= font_format_for_preload(fonts_config[role]['regular']) %>"
                href="<%= system_font_path(fonts_config[role]['regular']) %>"
                crossorigin>
        <% end %>
      <% end %>
    <% end %>
    <!-- Custom Fonts & Site Assets -->
    <style>
      <%= font_face_css.html_safe %>
    </style>
    <!-- Public site theme -->
    <% if params[:preview_theme].present? %>
      <%= stylesheet_link_tag "/theme/#{params[:preview_theme]}.css?v=#{Time.now.to_i}" %>
    <% else %>
      <% theme_name = SiteConfig.get('theme.active') || 'default' %>
      <% theme_file = Rails.root.join('site', 'theme', "#{theme_name}.css") %>
      <% cache_buster = File.exist?(theme_file) ? "?v=#{File.mtime(theme_file).to_i}" : "" %>
      <%= stylesheet_link_tag "/theme/#{theme_name}.css#{cache_buster}" %>
    <% end %>
    <!-- Favicon -->
    <% if SiteConfig.get('favicon') %>
      <link rel="icon" type="image/x-icon" href="<%= system_image_path(SiteConfig.get('favicon')) %>">
    <% end %>
    <!-- Apple touch icon -->
    <% if SiteConfig.get('logo').present? %>
      <%= image_tag safe_system_image_path(SiteConfig.get('logo')), alt: site_title %>
    <% end %>
    <!-- Turbo / Import maps -->
    <%= javascript_importmap_tags %>
    <meta name="turbo-visit-control" content="restore">
  </head>
  <body>
    <header class="site-nav <%= logo_classes %>">
      <%= render_layout_file('navigation', current_page: @post || @page || @doc) %>
    </header>
    <main data-controller="footnote-tooltip">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>">
          <mark> • <%= message %> • </mark>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <footer class="site-footer">
      <%= render_layout_file('footer') %>
    </footer>
    <% if defined?(@preview_mode) && @preview_mode %>
      <script>
        (function() {
          const previewId = <%= @preview_id.to_json.html_safe %>;

          // Listen on broadcast channel
          window.previewChannel = new BroadcastChannel(`preview-${previewId}`);

          window.previewChannel.onmessage = (event) => {
            if (event.data.action === 'refresh') {
              // Save current scroll position before reload
              sessionStorage.setItem('previewScrollPosition', window.scrollY);
              window.location.reload();
            }
          };

          // Restore scroll position after reload
          const savedScroll = sessionStorage.getItem('previewScrollPosition');
          if (savedScroll !== null) {
            window.scrollTo(0, parseInt(savedScroll));
            sessionStorage.removeItem('previewScrollPosition');
          }

          window.name = previewId;
        })();
      </script>
    <% end %>
    <script src="/theme/checkout.js"></script>
    <% if current_member %>
      <%= link_to account_path, class: "member-account-icon", title: "My Account" do %>
        <svg viewBox="0 0 16.1328 15.7715" xmlns="http://www.w3.org/2000/svg">
          <path d="M15.7715 7.89062C15.7715 12.2363 12.2363 15.7715 7.88086 15.7715C3.53516 15.7715 0 12.2363 0 7.89062C0 3.54492 3.53516 0.00976562 7.88086 0.00976562C12.2363 0.00976562 15.7715 3.54492 15.7715 7.89062ZM8.84766 2.71484L4.57031 8.07617C4.48242 8.17383 4.43359 8.30078 4.43359 8.4082C4.43359 8.62305 4.60938 8.78906 4.82422 8.78906L7.4707 8.78906L6.06445 12.5586C5.85938 13.1055 6.44531 13.3984 6.80664 12.959L11.084 7.58789C11.1719 7.49023 11.2207 7.36328 11.2207 7.26562C11.2207 7.04102 11.0449 6.88477 10.8301 6.88477L8.18359 6.88477L9.58984 3.11523C9.79492 2.56836 9.20898 2.27539 8.84766 2.71484Z" fill="currentColor"/>
        </svg>
      <% end %>
    <% end %>
  </body>
</html>
