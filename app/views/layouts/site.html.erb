<!DOCTYPE html>
<!-- Site Mode: <%= @static_generation ? 'Static (Generated)' : 'Dynamic (Rails)' %> -->
<html>
  <head>
    <%# SEO metadata: title, description, OG, Twitter Cards, canonical,
        JSON-LD, RSS/Atom auto-discovery (main + per-podcast). The
        partial pulls everything from SeoHelper, which auto-detects
        the page subject from @post / @page (Page record) / @product
        / @doc and falls back to site config defaults. %>
    <%= render "shared/head_meta" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Font preloading -->
    <% fonts_config = SiteConfig.get('fonts') %>
    <% if fonts_config %>
      <% %w[heading body].each do |role| %>
        <% if fonts_config[role] && fonts_config[role]['regular'] %>
          <link rel="preload"
                as="font"
                type="font/<%= font_format_for_preload(fonts_config[role]['regular']) %>"
                href="<%= system_font_path(fonts_config[role]['regular']) %>"
                crossorigin>
        <% end %>
      <% end %>
    <% end %>
    <!-- Public site theme -->
    <% if params[:preview_theme].present? %>
      <%= stylesheet_link_tag "/theme/#{params[:preview_theme]}.css?v=#{Time.now.to_i}" %>
    <% else %>
      <% theme_name = SiteConfig.get('theme.active') || 'default' %>
      <% theme_file = File.join(RoeSitePaths::SITE_PATH, 'theme', "#{theme_name}.css") %>
      <% cache_buster = File.exist?(theme_file) ? "?v=#{File.mtime(theme_file).to_i}" : "" %>
      <%= stylesheet_link_tag "/theme/#{theme_name}.css#{cache_buster}" %>
    <% end %>
    <!-- Custom Fonts & Site Assets -->
    <style>
      <%= font_face_css.html_safe %>
    </style>
    <!-- Favicon -->
    <% if SiteConfig.get('favicon').present? %>
      <link rel="icon" type="image/x-icon" href="<%= system_image_path(SiteConfig.get('favicon')) %>">
    <% end %>
    <!-- Apple touch icon — uses social_image when set (Apple prefers
         square art with margin); falls back to logo. -->
    <% touch_icon = SiteConfig.get('social_image').presence || SiteConfig.get('logo').presence %>
    <% if touch_icon %>
      <link rel="apple-touch-icon" href="<%= system_image_path(touch_icon) %>">
    <% end %>
    <!-- Turbo / Import maps -->
    <%= javascript_importmap_tags %>
    <meta name="turbo-visit-control" content="restore">
  </head>
  <% body_classes = [ ("has-sidebar" if show_sidebar?), "sidebar-#{sidebar_position}" ].compact.join(" ") %>
  <body class="<%= body_classes %>">
    <header class="site-nav <%= logo_classes %>">
      <%= render_layout_file('navigation', current_page: @post || @page || @doc) %>
    </header>
    <main data-controller="footnote-tooltip">
      <% flash.each do |type, message| %>
        <% flash_classes = "flash flash-#{type}" %>
        <div class="<%= flash_classes %>">
          <mark>&nbsp; • <%= message %> • &nbsp;</mark>
        </div>
      <% end %>
      <%= yield %>
    </main>
    <% if show_sidebar? %>
      <% sidebar_classes = "site-sidebar sidebar-#{sidebar_position}" %>
      <aside class="<%= sidebar_classes %>">
        <%= render_sidebar %>
      </aside>
    <% end %>
    <footer class="site-footer">
      <%= render_layout_file('footer') %>
    </footer>
    <% if defined?(@preview_mode) && @preview_mode %>
      <script nonce="<%= request.content_security_policy_nonce %>">
        (function() {
          const previewId = <%= @preview_id.to_json.html_safe %>;

          // Listen on broadcast channel
          window.previewChannel = new BroadcastChannel(`preview-${previewId}`);

          window.previewChannel.onmessage = (event) => {
            if (event.data.action === 'refresh') {
              // Save current scroll position before reload
              sessionStorage.setItem('previewScrollPosition', window.scrollY);
              window.location.reload();
            }
          };

          // Restore scroll position after reload
          const savedScroll = sessionStorage.getItem('previewScrollPosition');
          if (savedScroll !== null) {
            window.scrollTo(0, parseInt(savedScroll));
            sessionStorage.removeItem('previewScrollPosition');
          }

          window.name = previewId;
        })();
      </script>
    <% end %>
    <script src="/theme/checkout.js" nonce="<%= request.content_security_policy_nonce %>"></script>
    <% if current_member && !@static_generation %>
      <%= link_to account_path, class: "member-account-icon", title: "My Account" do %>
        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 16.1328 15.7715">
         <g>
          <rect height="15.7715" opacity="0" width="16.1328" x="0" y="0"/>
          <path d="M15.7715 7.89062C15.7715 12.2363 12.2363 15.7715 7.88086 15.7715C3.53516 15.7715 0 12.2363 0 7.89062C0 3.54492 3.53516 0.00976562 7.88086 0.00976562C12.2363 0.00976562 15.7715 3.54492 15.7715 7.89062ZM3.7793 11.3574C3.7793 11.6699 3.94531 11.9141 4.29688 11.9141L11.4746 11.9141C11.8262 11.9141 11.9922 11.6699 11.9922 11.3574C11.9922 10.498 10.6836 8.28125 7.88086 8.28125C5.08789 8.28125 3.7793 10.498 3.7793 11.3574ZM5.83984 5.39062C5.83984 6.66016 6.75781 7.61719 7.88086 7.62695C9.01367 7.63672 9.93164 6.66016 9.93164 5.39062C9.93164 4.19922 9.01367 3.20312 7.88086 3.20312C6.75781 3.20312 5.83984 4.19922 5.83984 5.39062Z" fill="currentColor" fill-opacity="0.85"/>
         </g>
        </svg>
      <% end %>
    <% end %>
    <% if snipcart_connected? %>
      <% snipcart = SnipcartConfig.current %>

      <% if snipcart.snippet.present? %>
        <%= snipcart.snippet_html %>

        <script nonce="<%= request.content_security_policy_nonce %>">
          // Override currency after snippet loads but before Snipcart initializes
          if (window.SnipcartSettings) {
            window.SnipcartSettings.currency = '<%= snipcart.currency.downcase %>';
          }
        </script>
      <% end %>
    <% end %>
  </body>
</html>
