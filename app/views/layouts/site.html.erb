<!DOCTYPE html>
<html>
  <head>
    <title>Roe CMS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Public site theme -->
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload" %>
  </head>
  <body>
    <header class="site-nav">
      <%= render_layout_file('navigation') %>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="site-footer">
      <%= render_layout_file('footer') %>
    </footer>
    <script>
      // Auto-refresh when content is saved in admin
      window.addEventListener('storage', (e) => {
        if (e.key === 'content-updated') {
          location.reload();
        }
      });
    </script>
  </body>
</html>
