<!DOCTYPE html>
<!-- Site Mode: <%= @static_generation ? 'Static (Generated)' : 'Dynamic (Rails)' %> -->
<html>
  <head>
    <%# SEO metadata: title, description, OG, Twitter Cards, canonical,
        JSON-LD, RSS/Atom auto-discovery (main + per-podcast). The
        partial pulls everything from SeoHelper, which auto-detects
        the page subject from @post / @page (Page record) / @product
        / @doc and falls back to site config defaults. %>
    <%= render "shared/head_meta" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- Font preloading -->
    <% fonts_config = SiteConfig.get('fonts') %>
    <% if fonts_config %>
      <% %w[heading body].each do |role| %>
        <% if fonts_config[role] && fonts_config[role]['regular'] %>
          <link rel="preload"
                as="font"
                type="font/<%= font_format_for_preload(fonts_config[role]['regular']) %>"
                href="<%= system_font_path(fonts_config[role]['regular']) %>"
                crossorigin>
        <% end %>
      <% end %>
    <% end %>
    <!-- Public site theme -->
    <% if params[:preview_theme].present? %>
      <%= stylesheet_link_tag "/theme/#{params[:preview_theme]}.css?v=#{Time.now.to_i}" %>
    <% else %>
      <% theme_name = SiteConfig.get('theme.active') || 'default' %>
      <% theme_file = File.join(RoeSitePaths::SITE_PATH, 'theme', "#{theme_name}.css") %>
      <% cache_buster = File.exist?(theme_file) ? "?v=#{File.mtime(theme_file).to_i}" : "" %>
      <%= stylesheet_link_tag "/theme/#{theme_name}.css#{cache_buster}" %>
    <% end %>
    <!-- Custom Fonts & Site Assets -->
    <style>
      <%= font_face_css.html_safe %>
    </style>
    <% heading_links_on = SiteConfig.content("heading_links") != false %>
    <% if heading_links_on %>
    <style>
      .content :is(h1,h2,h3,h4,h5,h6).has-heading-anchor { position: relative; }
      a.heading-anchor {
        position: absolute;
        right: 100%;
        top: var(--heading-anchor-top, calc(0.5lh - 0.5 * var(--heading-anchor-size, 1em)));
        transform: translate(var(--heading-anchor-offset-x, 0), var(--heading-anchor-offset-y, 0));
        display: inline-flex;
        align-items: center;
        opacity: 0;
        color: inherit;
        border-bottom: none;
        transition: opacity 0.12s ease;
      }
      a.heading-anchor svg {
        width: var(--heading-anchor-size, 1em);
        height: var(--heading-anchor-size, 1em);
        display: block;
      }
      a.heading-anchor svg path { fill: var(--heading-anchor-color, currentColor); }
      a.heading-anchor .ha-icon-copied { display: none; }
      a.heading-anchor.copied .ha-icon-default { display: none; }
      a.heading-anchor.copied .ha-icon-copied { display: block; }
      .content :is(h1,h2,h3,h4,h5,h6).has-heading-anchor:hover a.heading-anchor,
      a.heading-anchor:focus-visible { opacity: var(--heading-anchor-opacity, 1); outline: none; text-decoration: none; }
      @media (hover: none), (max-width: 640px) {
        a.heading-anchor { display: none; }
      }
    </style>
    <% end %>
    <!-- Favicon -->
    <% if SiteConfig.get('favicon').present? %>
      <link rel="icon" type="image/x-icon" href="<%= config_image_path(SiteConfig.get('favicon')) %>">
    <% end %>
    <!-- Apple touch icon — uses social_image when set (Apple prefers
         square art with margin); falls back to logo. -->
    <% touch_icon = SiteConfig.get('social_image').presence || SiteConfig.get('logo').presence %>
    <% if touch_icon %>
      <link rel="apple-touch-icon" href="<%= config_image_path(touch_icon) %>">
    <% end %>
    <!-- Turbo / Import maps -->
    <%= javascript_importmap_tags %>
    <meta name="turbo-visit-control" content="restore">

    <%# Custom code — user-pasted HTML for analytics, fonts, widgets,
        etc. Injected verbatim except for nonce attributes added to
        inline <script>/<style> tags via CustomCodeRenderer. Edited
        in Admin → Settings → Custom Code. %>
    <%= CustomCodeRenderer.render_field("head_html", nonce: safe_csp_nonce) %>
  </head>
  <% body_classes = [ ("has-sidebar" if show_sidebar?), "sidebar-#{sidebar_position}" ].compact.join(" ") %>
  <body class="<%= body_classes %>">
    <header class="site-nav <%= logo_classes %>">
      <%= render_layout_file('header', current_page: @post || @page || @doc) %>
    </header>
    <%# Live preview receiver: content editors set @preview_mode/@preview_id;
        the theme editor opens the site with ?preview_theme=<name> and drives
        it over the "preview-theme-<name>" channel. Both attach the same
        preview-receiver controller. %>
    <% theme_preview   = params[:preview_theme].presence %>
    <% preview_live    = (defined?(@preview_mode) && @preview_mode) || theme_preview.present? %>
    <% preview_recv_id = theme_preview.present? ? "theme-#{theme_preview}" : (defined?(@preview_id) ? @preview_id : nil) %>
    <main data-controller="footnote-tooltip<%= " heading-anchor" if heading_links_on %><%= " preview-receiver" if preview_live %>"
          <% if preview_live %>data-preview-receiver-id-value="<%= preview_recv_id %>"<% end %>>
      <% flash.each do |type, message| %>
        <% flash_classes = "flash flash-#{type}" %>
        <div class="<%= flash_classes %>">
          <mark>&nbsp; • <%= message %> • &nbsp;</mark>
        </div>
      <% end %>
      <% if heading_links_on %>
        <%# Cloned into each heading by the heading-anchor controller. Both icons
            are inserted; CSS swaps to the clipboard one briefly after a copy. %>
        <template data-heading-anchor-target="icon"><%= icon_svg("link") %></template>
        <template data-heading-anchor-target="copiedIcon"><%= icon_svg("clipboard") %></template>
      <% end %>
      <%= yield %>
    </main>
    <% if show_sidebar? %>
      <% sidebar_classes = "site-sidebar sidebar-#{sidebar_position}" %>
      <aside class="<%= sidebar_classes %>">
        <%= render_sidebar %>
      </aside>
    <% end %>
    <footer class="site-footer">
      <%= render_layout_file('footer') %>
    </footer>
    <%# Site-facing vanilla JS, served from /javascript — the site copies in
        site/javascript/ win, falling back to the shipped app/site_js/. All
        load in both dynamic and static (the importmap/Stimulus stack doesn't
        export to a static host), and each is overridable per-site. %>
    <%# Checkout glue so Snipcart picks up cart events on static product pages. %>
    <script src="/javascript/checkout.js" nonce="<%= safe_csp_nonce %>"></script>
    <%# Gallery enhancements (carousel nav + zoom keyboard). Galleries work
        without it — zoom is CSS :target, the carousel is CSS scroll-snap. %>
    <script src="/javascript/gallery.js" nonce="<%= safe_csp_nonce %>" defer></script>
    <%# Public site search. %>
    <script src="/javascript/search.js" nonce="<%= safe_csp_nonce %>" defer></script>
    <%# Cart icon shows in both dynamic and static — Snipcart is entirely
        client-side so it works on static product pages. Member icon only
        appears in dynamic mode (current_member is forced to nil during
        static rendering, so this short-circuits naturally). %>
    <%# site-wide search is always available, so .site-actions always renders;
        cart/member remain conditional within it. %>
    <div class="site-actions">
      <%= render "shared/site_search", search_scope: site_search_scope %>
      <% if snipcart_connected? || current_member %>
        <% if snipcart_connected? %>
          <%# `snipcart-checkout` is the class Snipcart v3 binds the
              open-cart click handler to — without it the icon is inert.
              `snipcart-link` is kept only as a CSS styling hook
              (themes target it); it carries no behaviour on its own. %>
          <a href="#" class="site-action snipcart-link snipcart-checkout" title="Cart" aria-label="Cart">
            <%= inline_system_svg("cart-icon.svg") || "Cart" %>
            <sup class="snipcart-items-count"></sup>
          </a>
        <% end %>
        <% if current_member %>
          <%= link_to inline_system_svg("member-icon.svg") || "Account", account_path, class: "site-action member-link", title: "My Account", aria_label: "My Account" %>
        <% end %>
      <% end %>
    </div>
    <%# Snipcart snippet — loads in both dynamic and static. Snipcart's
        cart UI, checkout flow, and payment processing all run client-
        side via Snipcart's CDN; no Rails backend involvement at
        runtime. So static product pages are fully functional. %>
    <% if snipcart_connected? %>
      <% snipcart = SnipcartConfig.current %>

      <% if snipcart.current_snippet.present? %>
        <%= snipcart.current_snippet_html %>

        <script nonce="<%= safe_csp_nonce %>">
          // Override currency after snippet loads but before Snipcart initializes
          if (window.SnipcartSettings) {
            window.SnipcartSettings.currency = '<%= snipcart.currency.downcase %>';
          }
        </script>
      <% end %>
    <% end %>

    <%# Custom code — user-pasted footer injection (chat widgets,
        late-binding tracking SDKs, etc.). Same nonce + allowlist
        handling as the head_html injection above. %>
    <%= CustomCodeRenderer.render_field("footer_html", nonce: safe_csp_nonce) %>
  </body>
</html>
