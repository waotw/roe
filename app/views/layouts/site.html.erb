<!DOCTYPE html>
<html>
  <head>
    <title>Roe CMS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Feed autodiscovery -->
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="<%= feed_url(format: :xml) %>">
    <link rel="alternate" type="application/atom+xml" title="Atom Feed" href="<%= feed_atom_url(format: :xml) %>">

    <!-- Custom Fonts & Site Assets -->
    <style>
      <%= font_face_css.html_safe %>
    </style>
    <!-- Public site theme -->
    <%= stylesheet_link_tag "theme", "data-turbo-track": "reload" %>
    <% if SiteConfig.get('favicon') %>
      <link rel="icon" type="image/x-icon" href="<%= system_image_path(SiteConfig.get('favicon')) %>">
    <% end %>

    <% if SiteConfig.get('logo') %>
      <link rel="apple-touch-icon" href="<%= system_image_path(SiteConfig.get('logo')) %>">
    <% end %>
  </head>
  <body>
    <% logo_url = SiteConfig.get('logo') %>
    <% logo_style = SiteConfig.get('logo_style') %>
    <% has_logo = logo_url.present? && logo_url != 'none' %>
    <header class="site-nav <%= 'logo' if has_logo %> <%= "logo-#{logo_style}" if has_logo && logo_style.present? %>">
      <%= render_layout_file('navigation', current_page: @page) %>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="site-footer">
      <%= render_layout_file('footer') %>
    </footer>
    <script>
      // Auto-refresh when content is saved in admin
      window.addEventListener('storage', (e) => {
        if (e.key === 'content-updated') {
          location.reload();
        }
      });
    </script>
  </body>
</html>
