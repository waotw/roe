<!DOCTYPE html>
<html>
  <head>
    <title>Roe CMS - Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!--<%= stylesheet_link_tag "theme", "data-turbo-track": "reload" %>-->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <script>
      // Editor State Manager - preserves cursor and scroll across navigation
      const EditorState = {
        save(textareaId) {
          const textarea = document.getElementById(textareaId);
          if (!textarea) return;

          const state = {
            cursorPosition: textarea.selectionStart,
            scrollPosition: textarea.scrollTop,
            url: window.location.pathname
          };

          sessionStorage.setItem(`editorState:${window.location.pathname}`, JSON.stringify(state));
        },

        restore(textareaId) {
          const stateKey = `editorState:${window.location.pathname}`;
          const savedState = sessionStorage.getItem(stateKey);

          if (!savedState) return;

          const state = JSON.parse(savedState);
          const textarea = document.getElementById(textareaId);

          if (!textarea) return;

          setTimeout(() => {
            // Set cursor position FIRST (before focus)
            textarea.setSelectionRange(state.cursorPosition, state.cursorPosition);

            // Then restore scroll position
            textarea.scrollTop = state.scrollPosition;

            // Focus last, with preventScroll option
            textarea.focus({ preventScroll: true });

            sessionStorage.removeItem(stateKey);
          }, 200);
        },

        init(textareaId) {
          const textarea = document.getElementById(textareaId);
          if (!textarea) return;

          this.restore(textareaId);

          window.addEventListener('beforeunload', () => {
            this.save(textareaId);
          });

          const form = textarea.closest('form');
          if (form) {
            form.addEventListener('submit', () => {
              this.save(textareaId);
            });
          }
        }
      };
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <!-- Admin Navigation -->
    <nav class="bg-white border-b border-gray-200">
      <div class="px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex">
            <div class="shrink-0 flex items-center">
              <%= link_to "Roe CMS", admin_root_path, class: "text-xl font-bold text-gray-900" %>
            </div>
            <div class="ml-6 flex space-x-8">
              <%= link_to "Dashboard", admin_root_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500" %>
              <%= link_to "Pages", admin_pages_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-gray-900" %>
              <%= link_to "Posts", admin_posts_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-gray-900" %>
              <%= link_to "Drafts", drafts_admin_posts_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-gray-900" %>
              <%= link_to "Layouts", admin_layouts_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-gray-900" %>
              <%= link_to "Settings", admin_configs_path, class: "inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-gray-900" %>
            </div>
          </div>
          <div class="flex items-center">
            <span class="text-sm text-gray-500 mr-4"><%= Current.user.email_address %></span>
            <%= button_to "Logout", session_path, method: :delete, class: "text-sm text-gray-700 hover:text-gray-900", form: { style: "display: inline;" } %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Page Content -->
    <main class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
      <%= yield %>
    </main>
  </body>
</html>
