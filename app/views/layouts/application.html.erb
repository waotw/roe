<!DOCTYPE html>
<html>
  <head>
    <title>Roe CMS - Admin</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!--<%= stylesheet_link_tag "theme", "data-turbo-track": "reload" %>-->
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <script>
      // Editor State Manager - preserves cursor and scroll across navigation
      const EditorState = {
        save(textareaId) {
          const textarea = document.getElementById(textareaId);
          if (!textarea) return;

          const state = {
            cursorPosition: textarea.selectionStart,
            scrollPosition: textarea.scrollTop,
            url: window.location.pathname
          };

          sessionStorage.setItem(`editorState:${window.location.pathname}`, JSON.stringify(state));
        },

        restore(textareaId) {
          const stateKey = `editorState:${window.location.pathname}`;
          const savedState = sessionStorage.getItem(stateKey);

          if (!savedState) return;

          const state = JSON.parse(savedState);
          const textarea = document.getElementById(textareaId);

          if (!textarea) return;

          setTimeout(() => {
            // Set cursor position FIRST (before focus)
            textarea.setSelectionRange(state.cursorPosition, state.cursorPosition);

            // Then restore scroll position
            textarea.scrollTop = state.scrollPosition;

            // Focus last, with preventScroll option
            textarea.focus({ preventScroll: true });

            sessionStorage.removeItem(stateKey);
          }, 200);
        },

        init(textareaId) {
          const textarea = document.getElementById(textareaId);
          if (!textarea) return;

          this.restore(textareaId);

          window.addEventListener('beforeunload', () => {
            this.save(textareaId);
          });

          const form = textarea.closest('form');
          if (form) {
            form.addEventListener('submit', () => {
              this.save(textareaId);
            });
          }
        }
      };
    </script>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-[#fffdf9] min-w-185.5">
    <% if warning = duplicate_sku_warning %>
      <div class="admin-warning-bar bg-red-100 border-l-4 border-red-500 text-red-700 p-4 font-mono text-xs">
        <p class="">⚠️ Store Issue: <%= warning[:message] %> <%= link_to "View and fix →", warning[:path], class: "underline" %>
        </p>
      </div>
    <% end %>
    <%# Site-sync drift banner. Lives in the layout so it surfaces on every
        admin page once the ledger sees changes since the last recorded
        sync. Cached for ~30s — see SiteSync::Checker. %>
    <% if authenticated? %>
      <%= render "shared/site_sync_banner" %>
    <% end %>
    <% if flash.any? %>
      <% flash.each do |type, message| %>
        <%# Skip internal flags, only show user-facing messages %>
        <% next unless ['notice', 'alert', 'error', 'success', 'warning'].include?(type.to_s) %>
        <div data-flash-message class="flash-floating <%= type %>" title="Click to dismiss">
          <span class="flash-message"><%= message %></span>
          <span class="flash-close" aria-hidden="true">×</span>
        </div>
      <% end %>
    <% end %>
    <!-- Admin Navigation -->
    <nav class="bg-white border-b border-gray-200 min-w-185.5">
      <div class="px-8">
        <div class="flex justify-between items-center h-16">
          <!-- Left: Roe CMS Title + env badge so dev and prod are visually distinct -->
          <div class="shrink-0 flex items-center gap-2">
            <%= link_to "Roe CMS", admin_root_path, class: "text-xl font-bold text-gray-900" %>
            <% env_classes = case Rails.env
               when "production"  then "bg-green-100 text-green-800 border-green-300"
               when "development" then "bg-amber-100 text-amber-800 border-amber-300"
               when "test"        then "bg-red-100 text-red-800 border-red-300"
               else                    "bg-gray-100 text-gray-700 border-gray-300"
               end %>
            <% env_label = case Rails.env
               when "production"  then "live"
               when "development" then "local"
               else                    Rails.env
               end %>
            <span class="text-xs px-2 py-0.5 rounded uppercase font-mono border <%= env_classes %>" title="Rails.env: <%= Rails.env %>">
              <%= env_label %>
            </span>
          </div>
          <!-- Right: Settings, Updates & Logout -->
          <div class="flex items-center gap-6">
            <%= link_to "Site Sync", admin_site_sync_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= link_to "Updates", admin_updates_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= link_to "Settings", admin_configs_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= button_to "Logout", session_path, method: :delete, class: "text-sm font-medium text-gray-500 hover:text-gray-900", form: { style: "display: inline;" } %>
          </div>
        </div>
        <div class="flex flex-wrap justify-between gap-x-6 gap-y-2 pb-3 border-t border-gray-100 pt-3">
          <!-- Left side: Main navigation -->
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            <%= link_to "Dashboard", admin_root_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= link_to "Pages", admin_pages_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= link_to "Posts", admin_posts_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <% if store_enabled? %>
              <%= link_to "Products", admin_products_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <% end %>
            <%= link_to "Media", browse_admin_medium_index_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= link_to "Layouts", admin_layouts_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
            <%= link_to "Themes", admin_themes_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
          </div>
          <% if members_enabled? %>
             <div class="flex gap-x-6">
               <%= link_to "Members", admin_members_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
               <%= link_to "Emails", admin_emails_path, class: "text-sm font-medium text-gray-500 hover:text-gray-900" %>
             </div>
           <% end %>

           <%# Build list of unconfigured and configured integrations %>
           <% unconfigured_integrations = [] %>
           <% configured_integrations = [] %>

           <% if members_enabled? %>
             <% if newsletters_enabled? %>
              <% if PostmarkConfig.current.connected? %>
                <% configured_integrations << { name: "Postmark", path: edit_admin_postmark_config_path } %>
              <% else %>
                <% unconfigured_integrations << { name: "Postmark", path: edit_admin_postmark_config_path } %>
              <% end %>
             <% end %>

             <% if payments_enabled? %>
             <% if StripeConfig.current.connected? %>
               <% configured_integrations << { name: "Stripe", path: edit_admin_stripe_config_path } %>
             <% else %>
               <% unconfigured_integrations << { name: "Stripe", path: edit_admin_stripe_config_path } %>
             <% end %>
             <% end %>
           <% end %>

           <% if store_enabled? %>
             <% if SnipcartConfig.current.connected? %>
               <% configured_integrations << { name: "Snipcart", path: edit_admin_snipcart_config_path } %>
             <% else %>
               <% unconfigured_integrations << { name: "Snipcart", path: edit_admin_snipcart_config_path } %>
             <% end %>
           <% end %>

           <%# Show unconfigured integrations with red border %>
          <div class="flex gap-x-6">
            <% unconfigured_integrations.each do |integration| %>
              <%= link_to integration[:name], integration[:path], class: "text-sm font-medium text-gray-500 border-b-2 border-red-600 hover:text-gray-900" %>
            <% end %>
          </div>

          <%# Tools and Integrations grouped together %>
          <div class="flex gap-x-4 items-center">
          <% if show_development_features? %>
            <%# Tools dropdown %>
            <div class="relative p-0 m-0 leading-0" data-controller="dropdown">
              <button type="button" data-action="click->dropdown#toggle" class="text-base font-medium text-gray-500 hover:text-gray-900 flex items-center gap-1 cursor-pointer" title="Tools">
                <%# icon_svg('tools', class: 'w-4.5 h-4.5 text-gray-500 hover:text-gray-900') %>🛠️
              </button>
              <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-white border border-gray-200 shadow-lg z-50">
                <%= link_to "Substack Imports", admin_imports_path, class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
              </div>
            </div>
          <% end %>

            <%# Integrations dropdown (only show if configured) %>
            <% if configured_integrations.any? && show_production_features? %>
              <div class="relative p-0 m-0 leading-0" data-controller="dropdown">
                <button type="button" data-action="click->dropdown#toggle" class="text-sm font-medium text-gray-500 hover:text-gray-900 flex items-center gap-1 cursor-pointer" title="Integrations">
                  <%= icon_svg('integration', class: 'w-4.5 h-4.5 text-gray-500 hover:text-gray-900') %>
                </button>
                <div data-dropdown-target="menu" class="hidden absolute right-0 mt-2 w-48 bg-white border border-gray-200 shadow-lg z-50">
                  <% configured_integrations.each do |integration| %>
                    <%= link_to integration[:name], integration[:path], class: "block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100" %>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
      </div>
    </nav>
    <!-- Page Content -->
    <main class="max-w-7xl mx-auto py-6 px-8">
      <%= yield %>
    </main>
  </body>
</html>
