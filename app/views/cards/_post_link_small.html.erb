<div class="card post-link-small<%= ' product-link-small' if kind == 'product-link' %>">
  <% if image.present? %>
    <img src="<%= image %>"
         alt="<%= title %>"
         class="card-image"
         data-sizes="(min-width: 768px) 300px, 100vw">
  <% end %>
  <div class="card-content">
    <% if variant.present? %>
      <div class="card-header">
        <h4 class="card-title"><%= title %></h4>
        <span class="product-variant"><%= variant %></span>
      </div>
    <% else %>
      <h4 class="card-title"><%= title %></h4>
    <% end %>
    <% if subtitle.present? %>
      <p class="card-subtitle"><%= subtitle %></p>
    <% end %>
    <% if author.present? || date.present? %>
      <p class="card-metadata">
        <% if author.present? %><span class="card-author"><%= author %></span><% end %>
        <% if date.present? && author.present? %> • <% end %>
        <% if date.present? %><span class="card-date"><%= date %></span><% end %>
      </p>
    <% end %>
    <% if show_excerpt && excerpt.present? %>
      <p class="card-excerpt"><%= excerpt %></p>
    <% end %>
    <% if price.present? %>
      <span class="card-price"><%= price %></span>
    <% end %>
    <a href="<%= url %>" class="card-link"><%= link_text %></a>
  </div>
</div>
