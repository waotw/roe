<%
  # Parse existing metadata YAML into hash
  begin
    parsed_metadata = YAML.safe_load(metadata, permitted_classes: [Date, Time, Symbol])

    # Ensure it's a hash, not a string or other type
    metadata_hash = if parsed_metadata.is_a?(Hash)
      parsed_metadata
    else
      Rails.logger.warn "Metadata is not a hash: #{parsed_metadata.inspect}"
      {}
    end
  rescue => e
    Rails.logger.error "Failed to parse metadata: #{e.message}"
    metadata_hash = {}
  end

  # Known fields live in ContentMetadataSchema so the rest of the app can read
  # them. Order is load-bearing: the controller reads Object.keys() on this
  # payload to order both the editor rows and the YAML it writes back.
  known_fields_config = ContentMetadataSchema.fields_for(resource_type, metadata: metadata_hash)

  # Add default author value from site config
  default_author = SiteConfig.get('author') || ''

  # Determine if this is a new record or newly created
  is_new = (!defined?(item) || !item.persisted?) || flash[:new_post]
  metadata_hidden = is_new ? '' : 'hidden'

  # Auto-surface site-gated fields so the writer always sees them
  # (whether or not the file has set them yet). If left blank, they save
  # as `""` like any other empty field — the publish modal prompts
  # before the post goes live.
  #   - audience: posts and pages, when paid memberships are configured
  #   - published_to: posts only (pages don't go out as newsletters),
  #     when newsletters are enabled
  if resource_type == 'post' || resource_type == 'page'
    metadata_hash['audience'] = '' if memberships_enabled? && !metadata_hash.key?('audience')
  end
  if resource_type == 'post'
    metadata_hash['published_to'] = '' if newsletters_enabled? && !metadata_hash.key?('published_to')
    metadata_hash['image_in_header'] = 'false' if metadata_hash['image'].present? && !metadata_hash.key?('image_in_header')
  end
  # variant + primary only matter for grouped products — surface them once a
  # group is set (the JS keeps this live as the group field changes).
  if resource_type == 'product' && metadata_hash['group'].present?
    metadata_hash['variant'] = '' unless metadata_hash.key?('variant')
    metadata_hash['primary'] = 'false' unless metadata_hash.key?('primary')
  end
  # Every product gets the digital toggle, so selling a file is a checkbox
  # rather than something you have to know to add. file_guid rides with it —
  # the digital-product controller adds and removes that row as the box is
  # ticked, so the two can't end up in the file without each other.
  if resource_type == 'product'
    metadata_hash['digital'] = 'false' unless metadata_hash.key?('digital')
    digital_on = metadata_hash['digital'] == true || metadata_hash['digital'] == 'true'
    if digital_on
      metadata_hash['file_guid'] = '' unless metadata_hash.key?('file_guid')
    else
      metadata_hash.delete('file_guid')
    end
  end

  # Width of the label column, in characters: the longest label this resource
  # type has, plus one for the colon. Every known field is measured, not just
  # the rendered ones, so adding a field from the Add Field menu can't outgrow
  # the column it lands in.
  longest_label = known_fields_config.values.map { |c| c[:label].to_s.length }.max.to_i
  label_column_ch = longest_label + 1

  # Separate what's in the file vs what's available
  existing_fields = metadata_hash.keys
  available_known_fields = known_fields_config.keys - existing_fields
  custom_fields = metadata_hash.reject { |k, v| known_fields_config.key?(k) }

  # Fields that reference media files on disk. Used to attach the
  # media-field Stimulus controller so the editor can warn when a path
  # doesn't resolve to a real file under site/media/.
  media_field_kinds = { 'audio' => 'audio', 'video' => 'video', 'image' => 'image', 'captions' => 'file' }

  # Filename autocomplete options per media kind (composed alongside the
  # media-field controller on the same input). Keys match media_field_kinds
  # values; 'image' kind maps to media_type 'images' (plural in DB).
  autocomplete_paths_by_kind = {
    'audio' => Medium.originals_only.where(media_type: 'audio').pluck(:file_path).sort,
    'video' => Medium.originals_only.where(media_type: 'video').pluck(:file_path).sort,
    'image' => Medium.originals_only.where(media_type: 'images').pluck(:file_path).sort
  }

  # For the initial render, pre-compute which media paths are already broken
  # so the warning shows on page load (matches the fonts pattern in
  # _config_font_roles.html.erb / system_assets_controller). Blur re-checks
  # via AJAX pick up any fixes the user makes without a reload.
  initial_missing_media = {}
  if resource_type == 'post' && defined?(item) && item.respond_to?(:missing_media_refs)
    item.missing_media_refs.each { |ref| initial_missing_media[ref[:field]] = true }
  end

  # Same idea for values expected to be unique (url_name, episode/track/chapter
  # numbers): resolve conflicts server-side so an existing clash is visible the
  # moment the editor opens, not only after the field is touched. The
  # unique-field controller keeps it current while typing. Advisory only —
  # nothing here prevents a save.
  unique_conflicts = {}
  unique_exclude = nil
  if resource_type == 'post'
    unique_exclude = item.url_name if defined?(item) && item.respond_to?(:url_name)
    Post::UNIQUE_FIELDS.each do |unique_name, scope_fields|
      next if metadata_hash[unique_name].to_s.strip.blank?

      found = Post.conflicting_post(
        field: unique_name,
        value: metadata_hash[unique_name],
        scopes: scope_fields.index_with { |sf| metadata_hash[sf] },
        exclude_url_name: unique_exclude
      )
      unique_conflicts[unique_name] = found.title if found
    end
  end
%>
<div id="metadata-container"
     data-controller="metadata-editor<%= ' release-link' if resource_type == 'post' && SiteFeature.music_enabled? %><%= ' digital-product' if resource_type == 'product' %>"
     data-release-link-settings-path-value="<%= admin_edit_music_config_path %>"
     data-metadata-editor-known-fields-value="<%= known_fields_config.to_json %>"
     data-metadata-editor-default-author-value="<%= ERB::Util.html_escape(default_author) %>"
     data-metadata-editor-raw-frontmatter-value="<%= ERB::Util.html_escape(item&.raw_frontmatter || '') %>"
     data-metadata-editor-original-metadata-value="<%= metadata_hash.to_json %>"
     data-metadata-editor-post-types-value="<%= Post::POST_TYPES.to_json %>"
     data-metadata-editor-resource-type-value="<%= resource_type %>"
     data-metadata-editor-podcast-configs-value="<%= PodcastConfig.all_podcasts.to_json %>"
     data-metadata-editor-media-paths-value="<%= ERB::Util.html_escape(autocomplete_paths_by_kind.to_json) %>"
     <% if resource_type == 'product' %>
     data-metadata-editor-product-categories-value="<%= (ProductCategory.all rescue []).to_json %>"
     data-metadata-editor-product-groups-value="<%= (ProductGroup.all rescue []).to_json %>"
     <% end %>
     style="--metadata-label-width: <%= label_column_ch %>ch"
     class="mb-5">
  <div class="flex items-center justify-between mb-2">
    <button type="button"
            data-action="click->metadata-editor#toggleMetadataSection"
      class="text-sm font-semibold text-gray-700 hover:text-gray-900">
      Metadata <span data-metadata-editor-target="arrow" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none text-blue-800 cursor-pointer"><%= metadata_hidden.present? ? '▶' : '▼' %></span>
    </button>
    <button type="button"
            data-action="click->metadata-editor#toggleMetadataView"
      data-metadata-editor-target="toggleBtn"
      class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none pt-[0.1rem] cursor-pointer">
      RAW
    </button>
  </div>

  <!-- Form View -->
  <div data-metadata-editor-target="content" class="<%= metadata_hidden %>">
    <div data-metadata-editor-target="formView" class="space-y-2">
      <div data-metadata-editor-target="fieldsContainer" class="space-y-2">
      <% if item&.persisted? && item.respond_to?(:url_name) && item.url_name.present? %>
        <div class="mb-3 p-2 bg-blue-50 border border-blue-200 text-sm font-mono mb-4">
          <div>
            <span class="text-blue-800 font-semibold">url_name:</span>
            <code class="text-xs ml-2"><%= item.url_name %></code>
          </div>
          <% if resource_type == 'product' && item.url_name.present? %>
            <div class="">
              <span class="text-blue-800 font-semibold">public url:</span>
              <code class="text-xs ml-2"><%= @product.public_url %></code>
            </div>
          <% end %>
          <% if resource_type == 'post' && defined?(@post) && @post %>
            <div id="newsletter-status-<%= @post.id %>">
              <%= render 'newsletter_status' %>
            </div>
          <% end %>
        </div>
      <% end %>
        <%# Render known fields in config order first %>
        <% known_fields_config.each do |field_name, config| %>
          <% next unless metadata_hash.key?(field_name) %>
          <% value = metadata_hash[field_name] %>
          <%# items-start suits a text input, whose first line of text sits at
              the top of a possibly-tall field. A checkbox is a single small
              box, so it wants centring against its label instead — and the
              label drops the top padding that exists to line up with text. %>
          <% checkbox_row = config[:type] == :checkbox %>
          <div class="metadata-field-row flex <%= checkbox_row ? 'items-center' : 'items-start' %> gap-2" data-field-name="<%= field_name %>">
            <label class="font-mono text-xs px-2 py-1 text-gray-700 metadata-label shrink-0 <%= 'pt-1.5' unless checkbox_row %>">
              <%= config[:label] %>:<% if config[:required] %><span class="text-red-600 relative -top-0.5"><sup>*</sup></span><% end %>
            </label>
            <% case config[:type] %>
              <% when :text %>
                <%
                  # List fields (tags, related, collection) show as comma-separated, not array notation
                  display_value = if %w[tags related collection].include?(field_name)
                    if value.is_a?(Array)
                      value.join(', ')
                    else
                      value.to_s == '[]' ? '' : value.to_s
                    end
                  else
                    value.to_s
                  end
                %>
                <%# Fields that suggest known values but still accept anything typed.
                    All reuse the shared `autocomplete` controller, differing only in
                    the option list. `release` is not here — it's a select now, built
                    from music.yml by ContentMetadataSchema.release_options. %>
                <% autocomplete_options =
                     if resource_type == 'product' && field_name == 'group'
                       (ProductGroup.all rescue [])
                     elsif resource_type == 'product' && field_name == 'category'
                       (ProductCategory.all rescue [])
                     end %>
                <% if autocomplete_options %>
                  <div class="flex-1 relative"
                        data-controller="autocomplete"
                        data-autocomplete-options-value="<%= autocomplete_options.to_json %>">
                    <input type="text"
                            id="metadata-field-<%= field_name %>"
                            name="metadata_fields[<%= field_name %>]"
                            value="<%= ERB::Util.html_escape(display_value) %>"
                            autocomplete="off"
                            class="w-full font-mono text-xs px-2 py-1 border border-gray-300"
                            data-metadata-field="<%= field_name %>"
                            data-autocomplete-target="input"
                            data-action="input->autocomplete#filter focus->autocomplete#showDropdown keydown->autocomplete#navigate"
                            <% if config[:hint] %>placeholder="<%= config[:hint].respond_to?(:call) ? config[:hint].call : config[:hint] %>"<% end %>>
                    <div data-autocomplete-target="dropdown"
                          class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-gray-800 shadow-lg z-50 max-h-48 overflow-y-auto">
                    </div>
                  </div>
                  <% elsif field_name == 'sku' && resource_type == 'product' %>
                    <!-- SKU field with generator link -->
                    <div class="flex-1">
                      <input type="text"
                              id="metadata-field-<%= field_name %>"
                              name="metadata_fields[<%= field_name %>]"
                              value="<%= ERB::Util.html_escape(display_value) %>"
                              class="w-full font-mono text-xs px-2 py-1 border border-gray-300"
                              data-metadata-field="<%= field_name %>"
                              <% if config[:hint] %>placeholder="<%= config[:hint] %>"<% end %>>
                      <% if defined?(item) && item.persisted? %>
                        <%= link_to "Generate SKU →",
                            sku_generator_admin_product_path(item),
                            data: { turbo_frame: "sku-generator-modal" },
                            class: "text-xs text-blue-600 hover:text-blue-800 underline mt-0.5 inline-block" %>
                      <% end %>
                    </div>
                  <%# Snipcart has no API for digital goods, so the GUID is a
                      paste from their dashboard — link straight to it. %>
                  <% elsif field_name == 'file_guid' && resource_type == 'product' %>
                    <div class="flex-1">
                      <input type="text"
                              id="metadata-field-<%= field_name %>"
                              name="metadata_fields[<%= field_name %>]"
                              value="<%= ERB::Util.html_escape(display_value) %>"
                              class="w-full font-mono text-xs px-2 py-1 border border-gray-300"
                              data-metadata-field="<%= field_name %>"
                              placeholder="7235bd18-1745-488e-bdbb-dc4f424c1ca1">
                      <%# Link and warning share a row under the field. The
                          warning used to be appended to the field row itself,
                          which is a flex container — it sat beside the input
                          and squashed it. %>
                      <div class="flex items-center gap-3 mt-0.5" data-digital-product-footer>
                        <a href="https://app.snipcart.com/dashboard/digital"
                           target="_blank" rel="noopener"
                           class="text-xs text-blue-600 hover:text-blue-800 underline whitespace-nowrap">Snipcart Digital Goods →</a>
                      </div>
                    </div>

                  <% elsif media_field_kinds.key?(field_name) %>
                    <%
                      # Autocomplete is offered for kinds we have a clean
                      # media_type mapping for (audio/video/image). The
                      # 'captions' field uses kind='file' and is excluded.
                      ac_paths = autocomplete_paths_by_kind[media_field_kinds[field_name]]
                      ac_enabled = ac_paths.present?
                    %>
                    <!-- Media text input with file-existence warning + filename autocomplete -->
                    <div class="flex-1 flex flex-col gap-1 <%= 'relative' if ac_enabled %>"
                         data-controller="media-field<%= ' autocomplete' if ac_enabled %>"
                         data-media-field-kind-value="<%= media_field_kinds[field_name] %>"
                         <% if ac_enabled %>data-autocomplete-options-value="<%= ERB::Util.html_escape(ac_paths.to_json) %>"<% end %>>
                      <input type="text"
                              id="metadata-field-<%= field_name %>"
                              name="metadata_fields[<%= field_name %>]"
                              value="<%= ERB::Util.html_escape(display_value) %>"
                              <% if ac_enabled %>autocomplete="off"<% end %>
                              class="w-full font-mono text-xs px-2 py-1 border border-gray-300 <%= 'border-red-400' if initial_missing_media[field_name] %>"
                              data-metadata-field="<%= field_name %>"
                              data-media-field-target="input"
                              <% if ac_enabled %>data-autocomplete-target="input"<% end %>
                              data-action="input->media-field#checkDebounced<% if ac_enabled %> input->autocomplete#filter keydown->autocomplete#navigate<% end %> blur->media-field#check change->media-field#check"
                              <% if config[:hint] %>placeholder="<%= config[:hint] %>"<% end %>>
                      <% if ac_enabled %>
                        <div data-autocomplete-target="dropdown"
                             class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-gray-800 shadow-lg z-50 max-h-48 overflow-y-auto">
                        </div>
                      <% end %>
                      <p class="text-xs text-red-600 <%= 'hidden' unless initial_missing_media[field_name] %>"
                         data-media-field-target="warning">
                        ⚠ File not found under <code>site/media/</code>.
                      </p>
                    </div>
                  <% elsif resource_type == 'post' && Post::UNIQUE_FIELDS.key?(field_name) %>
                    <!-- Text input with an advisory "already in use" warning -->
                    <div class="flex-1 flex flex-col gap-1"
                         data-controller="unique-field"
                         data-unique-field-field-value="<%= field_name %>"
                         data-unique-field-scope-fields-value="<%= ERB::Util.html_escape(Post::UNIQUE_FIELDS[field_name].to_json) %>"
                         data-unique-field-exclude-value="<%= ERB::Util.html_escape(unique_exclude) %>">
                      <input type="text"
                              id="metadata-field-<%= field_name %>"
                              name="metadata_fields[<%= field_name %>]"
                              value="<%= ERB::Util.html_escape(display_value) %>"
                              class="w-full font-mono text-xs px-2 py-1 border border-gray-300 <%= 'border-amber-400' if unique_conflicts[field_name] %>"
                              data-metadata-field="<%= field_name %>"
                              data-unique-field-target="input"
                              data-action="input->unique-field#checkDebounced blur->unique-field#check change->unique-field#check"
                              <% if config[:hint] %>placeholder="<%= config[:hint] %>"<% end %>>
                      <%# Left empty when there's no conflict — the controller
                          fills it in. Otherwise the message sits in the DOM
                          claiming a clash that isn't there. %>
                      <p class="text-xs text-amber-700 <%= 'hidden' unless unique_conflicts[field_name] %>"
                         data-unique-field-target="warning"><% if unique_conflicts[field_name] %>⚠ Already used by “<%= unique_conflicts[field_name] %>”.<% end %></p>
                    </div>
                  <% else %>
                  <!-- Regular text input -->
                    <input type="text"
                            id="metadata-field-<%= field_name %>"
                            name="metadata_fields[<%= field_name %>]"
                            value="<%= ERB::Util.html_escape(display_value) %>"
                            class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300 <%= 'bg-gray-200 text-gray-600' if config[:readonly] %>"
                            data-metadata-field="<%= field_name %>"
                            <% if config[:readonly] %>readonly<% end %>
                            <% if config[:hint] %>placeholder="<%= config[:hint] %>"<% end %>>
                  <% end %>
            <% when :date %>
              <input type="date"
                      id="metadata-field-<%= field_name %>"
                      name="metadata_fields[<%= field_name %>]"
                      value="<%= value&.to_s %>"
                      class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                      data-metadata-field="<%= field_name %>">
            <% when :datetime %>
              <%
                  datetime_value = value.to_s
                  if datetime_value.include?('T')
                    datetime_value = datetime_value[0..15]
                  end
                %>
              <input type="datetime-local"
                      id="metadata-field-<%= field_name %>"
                      name="metadata_fields[<%= field_name %>]"
                      value="<%= datetime_value %>"
                      class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                      data-metadata-field="<%= field_name %>">
            <% when :select %>
              <select id="metadata-field-<%= field_name %>"
                        name="metadata_fields[<%= field_name %>]"
                        class="w-full font-mono text-xs p-1.5 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                        data-metadata-field="<%= field_name %>">
                <option value="">-- select --</option>
                <% config[:options].each do |option| %>
                  <%# Coerce both sides to string so boolean YAML values like
                      `explicit: true` correctly pre-select their option (the
                      <option value> attribute is always a string). Without
                      this, `true == "true"` is false and the select renders
                      with no selection, which used to let handlePodcastChange
                      overwrite the user's per-episode choice on every load. %>
                  <option value="<%= option %>"<% if value.to_s == option.to_s %> selected<% end %>><%= option %></option>
                  <% end %>
                </select>
              <%# A real checkbox. formToYaml reads .checked for these — an
                  unchecked box still has a .value, so reading that would make
                  every product digital. %>
              <% when :checkbox %>
                <label class="flex-1 flex items-center gap-2 cursor-pointer">
                  <input type="checkbox"
                         id="metadata-field-<%= field_name %>"
                         data-metadata-field="<%= field_name %>"
                         <%= 'checked' if value.to_s == 'true' %>>
                  <% if config[:hint] %>
                    <span class="text-xs text-gray-500"><%= config[:hint] %></span>
                  <% end %>
                </label>
              <% when :textarea %>
                <textarea id="metadata-field-<%= field_name %>"
                          name="metadata_fields[<%= field_name %>]"
                          rows="2"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="<%= field_name %>"><%= ERB::Util.html_escape(value.to_s) %></textarea>
              <% end %>
              <% if !config[:required] %>
                <button type="button"
                      data-action="click->metadata-editor#removeMetadataField"
                  class="mt-px px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-700 shrink-0 cursor-pointer">
                  ×
                </button>
              <% else %>
                <div class="w-6 shrink-0"></div>
              <% end %>
            </div>
          <% end %>
          <%# Then render custom fields (not in known_fields_config) %>
          <% custom_fields.each do |field_name, value| %>
            <div class="metadata-field-row flex items-start gap-2" data-field-name="<%= field_name %>">
              <input type="text"
                  value="<%= field_name %>"
                  placeholder="field_name"
                  class="font-mono text-xs px-2 py-1 border border-gray-300 metadata-label"
                  data-custom-key>
              <input type="text"
                  id="metadata-field-<%= field_name.parameterize %>"
                  name="metadata_fields[<%= field_name %>]"
                  value="<%= ERB::Util.html_escape(value.to_s) %>"
                  class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                  data-metadata-field="<%= field_name %>">
              <button type="button"
                    data-action="click->metadata-editor#removeMetadataField"
                class="mt-px px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-700 shrink-0 cursor-pointer">
                ×
              </button>
            </div>
          <% end %>
        </div>
        <!-- Add Field Button with Dropdown -->
        <div class="relative inline-block">
          <button type="button"
                data-action="click->metadata-editor#toggleAddFieldMenu"
            class="text-xs font-mono uppercase px-3 py-1 border border-gray-400 hover:bg-gray-200 rounded-xs cursor-pointer">
            + Add Field
          </button>
          <div data-metadata-editor-target="addFieldMenu"
            class="hidden absolute top-full left-0 mt-1 bg-white border border-gray-800 shadow-lg z-50 min-w-50">
            <% available_known_fields.each do |field_name| %>
              <button type="button"
                    data-action="click->metadata-editor#addKnownField"
                data-field-name="<%= field_name %>"
                class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono"
                data-available-field="<%= field_name %>">
                <%= field_name %>
              </button>
            <% end %>
            <div class="border-t border-gray-200"></div>
            <button type="button"
                  data-action="click->metadata-editor#addCustomField"
              class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono italic text-gray-600">
              Custom field...
            </button>
          </div>
        </div>
      </div>
    </div>
    <!-- Raw YAML View -->
    <div data-metadata-editor-target="yamlView" class="hidden">
      <textarea name="metadata"
              data-metadata-editor-target="yamlTextarea"
              class="w-full font-mono text-sm p-2 border border-gray-300 bg-gray-50 "
              rows="12"><%= metadata %></textarea>
    </div>
    <!-- Hidden field to store final metadata YAML -->
    <input type="hidden"
         name="metadata"
         data-metadata-editor-target="finalInput"
         value="<%= ERB::Util.html_escape(metadata) %>"
         data-editor-target="metadata">
  </div>
