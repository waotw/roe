<%
  # Parse existing metadata YAML into hash
  begin
    metadata_hash = YAML.safe_load(metadata, permitted_classes: [Date, Time, Symbol]) || {}
  rescue
    metadata_hash = {}
  end

  # Define known fields for posts
  known_fields_config = if resource_type == 'post'
    {
      'title' => { type: :text, label: 'title', required: true },
      'date' => { type: :date, label: 'date', required: true },
      'status' => { type: :select, label: 'status', options: ['draft', 'published', 'unlisted'], required: true },
      'subtitle' => { type: :text, label: 'subtitle' },
      'post_type' => { type: :select, label: 'post_type', options: ['article', 'music', 'podcast', 'image'] },
      'author' => { type: :text, label: 'author', default_from_config: true },
      'tags' => { type: :text, label: 'tags', hint: 'comma-separated' },
      'url_name' => { type: :text, label: 'url_name', hint: 'auto-generated from title if blank' },
      'image' => { type: :text, label: 'image' },
      'excerpt' => { type: :textarea, label: 'excerpt' }
    }
  else # pages
    {
      'title' => { type: :text, label: 'title', required: true },
      'status' => { type: :select, label: 'status', options: ['draft', 'published', 'unlisted'], required: true },
      'subtitle' => { type: :text, label: 'subtitle' },
      'url_name' => { type: :text, label: 'url_name', hint: 'auto-generated from title if blank' },
      'image' => { type: :text, label: 'image' },
      'excerpt' => { type: :textarea, label: 'excerpt' }
    }
  end

  # Add default author value from site config
  default_author = SiteConfig.get('author') || ''

  # Determine if this is a new record or newly created
  is_new = (!defined?(item) || !item.persisted?) || flash[:new_post]
  metadata_hidden = is_new ? '' : 'hidden'

  # Separate what's in the file vs what's available
  existing_fields = metadata_hash.keys
  available_known_fields = known_fields_config.keys - existing_fields
  custom_fields = metadata_hash.reject { |k, v| known_fields_config.key?(k) }
%>

<div id="metadata-container" class="mb-5">
  <div class="flex items-center justify-between mb-2">
    <button type="button"
              onclick="toggleMetadataSection()"
              class="text-sm font-semibold text-gray-700 hover:text-gray-900">
              Metadata <span id="metadata-arrow" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none  text-blue-800"><%= metadata_hidden.present? ? '▶' : '▼' %></span>
    </button>
    <button type="button"
            onclick="toggleMetadataView()"
            class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none pt-[0.1rem]"
            id="metadata-toggle">
            RAW
    </button>
  </div>

  <% if defined?(item) && item.persisted? && item.url_name.present? %>
    <div class="mb-3 p-2 bg-blue-50 border border-blue-200 text-sm font-mono">
      <span class="text-blue-800 font-semibold">URL:</span>
      <code class="text-xs ml-2"><%= item.url_name %></code>
    </div>
  <% end %>

  <!-- Form View -->
  <div id="metadata-content" class="<%= metadata_hidden %>">
    <div id="metadata-form-view" class="space-y-2">
      <div id="metadata-fields-container" class="space-y-2">
        <% existing_fields.each do |field_name| %>
          <%
            config = known_fields_config[field_name]
            value = metadata_hash[field_name]
            is_custom = config.nil?
          %>

          <div class="metadata-field-row flex items-start gap-2" data-field-name="<%= field_name %>">
            <% if is_custom %>
              <!-- Custom field with editable key -->
              <input type="text"
                    value="<%= field_name %>"
                    placeholder="field_name"
                    class="font-mono text-xs px-2 py-1 border border-gray-300 w-32"
                    data-custom-key>
            <% else %>
              <!-- Known field with fixed label -->
              <label class="font-mono text-xs px-2 py-1 text-gray-700 w-32 shrink-0 pt-1.5">
                <%= config[:label] %>:
              </label>
            <% end %>

            <% if is_custom %>
              <!-- Custom field value (always text) -->
              <input type="text"
                    id="metadata-field-<%= field_name.parameterize %>"
                    name="metadata_fields[<%= field_name %>]"
                    value="<%= value %>"
                    class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                    data-metadata-field="<%= field_name %>">
            <% else %>
              <% case config[:type] %>
              <% when :text %>
                <input type="text"
                      id="metadata-field-<%= field_name %>"
                      name="metadata_fields[<%= field_name %>]"
                      value="<%= value %>"
                      class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                      data-metadata-field="<%= field_name %>"
                      <% if config[:hint] %>placeholder="<%= config[:hint] %>"<% end %>>

              <% when :date %>
                <input type="date"
                      id="metadata-field-<%= field_name %>"
                      name="metadata_fields[<%= field_name %>]"
                      value="<%= value&.to_s %>"
                      class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                      data-metadata-field="<%= field_name %>">

              <% when :select %>
                <select id="metadata-field-<%= field_name %>"
                        name="metadata_fields[<%= field_name %>]"
                        class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                        data-metadata-field="<%= field_name %>">
                  <option value="">-- select --</option>
                  <% config[:options].each do |option| %>
                    <option value="<%= option %>" <% if value == option %>selected<% end %>><%= option %></option>
                  <% end %>
                </select>

              <% when :textarea %>
                <textarea id="metadata-field-<%= field_name %>"
                          name="metadata_fields[<%= field_name %>]"
                          rows="2"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="<%= field_name %>"><%= value %></textarea>
              <% end %>
            <% end %>

            <!-- Only show delete button if NOT required -->
            <% if is_custom || !config[:required] %>
              <button type="button"
                      onclick="removeMetadataField(this)"
                      class="mt-px px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-700 shrink-0">
                ×
              </button>
            <% else %>
              <!-- Spacer to maintain alignment -->
              <div class="w-6 shrink-0"></div>
            <% end %>
          </div>
        <% end %>
      </div>

      <!-- Add Field Button with Dropdown -->
      <div class="relative inline-block">
        <button type="button"
                onclick="toggleAddFieldMenu()"
                class="text-xs px-3 py-1 border border-gray-300 hover:bg-gray-100 ">
          + Add Field
        </button>

        <div id="add-field-menu"
            class="hidden absolute top-full left-0 mt-1 bg-white border border-gray-800 shadow-lg z-10 min-w-50">
          <% available_known_fields.each do |field_name| %>
            <button type="button"
                    onclick="addKnownField('<%= field_name %>')"
                    class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono"
                    data-available-field="<%= field_name %>">
              <%= field_name %>
            </button>
          <% end %>
          <div class="border-t border-gray-200"></div>
          <button type="button"
                  onclick="addCustomField()"
                  class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono italic text-gray-600">
            Custom field...
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Raw YAML View -->
  <div id="metadata-yaml-view" class="hidden">
    <textarea name="metadata"
              id="metadata-yaml"
              class="w-full font-mono text-sm p-2 border border-gray-300 bg-gray-50 "
              rows="12"><%= metadata %></textarea>
  </div>

  <!-- Hidden field to store final metadata YAML -->
  <input type="hidden"
         name="metadata"
         id="metadata-final"
         value=""
         data-editor-target="metadata">
</div>

<script>
(function() {
  // Store field configs for dynamic add
  const knownFieldsConfig = <%= raw known_fields_config.to_json %>;
  const defaultAuthor = <%= default_author.to_json.html_safe %>;
  let isYamlView = false;

  // Restore metadata section state from sessionStorage
  const savedState = sessionStorage.getItem('metadataEditorOpen');
  const content = document.getElementById('metadata-content');
  const arrow = document.getElementById('metadata-arrow');

  if (savedState !== null) {
    const shouldBeOpen = savedState === 'true';
    if (shouldBeOpen) {
      content.classList.remove('hidden');
      arrow.textContent = '▼';
    } else {
      content.classList.add('hidden');
      arrow.textContent = '▶';
    }
  }

  function toggleAddFieldMenu() {
    const menu = document.getElementById('add-field-menu');
    menu.classList.toggle('hidden');
  }

// Close menu when clicking outside
document.addEventListener('click', function(e) {
  const menu = document.getElementById('add-field-menu');
  if (menu && !e.target.closest('[onclick*="toggleAddFieldMenu"]') && !e.target.closest('#add-field-menu')) {
    menu.classList.add('hidden');
  }
});

function addKnownField(fieldName) {
  const config = knownFieldsConfig[fieldName];
  const container = document.getElementById('metadata-fields-container');

  const row = document.createElement('div');
  row.className = 'metadata-field-row flex items-start gap-2';
  row.dataset.fieldName = fieldName;

  // Use default author if adding author field
  const defaultValue = (fieldName === 'author' && config.default_from_config) ? defaultAuthor : '';

  let inputHtml = '';

  switch(config.type) {
    case 'text':
      inputHtml = `<input type="text"
                          id="metadata-field-${fieldName}"
                          name="metadata_fields[${fieldName}]"
                          value="${defaultValue}"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="${fieldName}"
                          ${config.hint ? `placeholder="${config.hint}"` : ''}>`;
      break;
    case 'date':
      inputHtml = `<input type="date"
                          id="metadata-field-${fieldName}"
                          name="metadata_fields[${fieldName}]"
                          value="${defaultValue}"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="${fieldName}">`;
      break;
    case 'select':
      const options = config.options.map(opt =>
        `<option value="${opt}">${opt}</option>`
      ).join('');
      inputHtml = `<select id="metadata-field-${fieldName}"
                          name="metadata_fields[${fieldName}]"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="${fieldName}">
                     <option value="">-- select --</option>
                     ${options}
                   </select>`;
      break;
    case 'textarea':
      inputHtml = `<textarea id="metadata-field-${fieldName}"
                            name="metadata_fields[${fieldName}]"
                            rows="2"
                            class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                            data-metadata-field="${fieldName}">${defaultValue}</textarea>`;
      break;
  }

  // Conditionally add delete button (not for required fields)
  const deleteButton = config.required
    ? '<div class="w-6 flex-shrink-0"></div>'
    : `<button type="button"
              onclick="removeMetadataField(this)"
              class="mt-[1px] px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-700 flex-shrink-0">
        ×
      </button>`;

  row.innerHTML = `
    <label class="font-mono text-xs px-2 py-1 text-gray-700 w-32 flex-shrink-0 pt-1.5">
      ${config.label}:
    </label>
    ${inputHtml}
    ${deleteButton}
  `;

  container.appendChild(row);

  // Hide this field from the menu
  document.querySelector(`[data-available-field="${fieldName}"]`)?.remove();

  // Check if menu is now empty (except custom field option)
  const menu = document.getElementById('add-field-menu');
  const remainingFields = menu.querySelectorAll('[data-available-field]');
  if (remainingFields.length === 0) {
    menu.querySelector('.border-t')?.remove();
  }

  toggleAddFieldMenu();
}

function addCustomField() {
  const container = document.getElementById('metadata-fields-container');

  const row = document.createElement('div');
  row.className = 'metadata-field-row flex items-start gap-2';

  row.innerHTML = `
    <input type="text"
           value=""
           placeholder="field_name"
           class="font-mono text-xs px-2 py-1 border border-gray-300 w-32"
           data-custom-key>
    <input type="text"
           value=""
           placeholder="value"
           class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
           data-custom-value>
    <button type="button"
            onclick="removeMetadataField(this)"
            class="mt-[1px] px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-700 flex-shrink-0">
      ×
    </button>
  `;

  container.appendChild(row);
  toggleAddFieldMenu();
}

function removeMetadataField(button) {
  const row = button.closest('.metadata-field-row');
  const fieldName = row.dataset.fieldName;

  // Double-check we're not removing a required field
  if (fieldName && knownFieldsConfig[fieldName]?.required) {
    return; // Shouldn't happen, but safety check
  }

  // If it's a known field, add it back to the menu
  if (fieldName && knownFieldsConfig[fieldName]) {
    const menu = document.getElementById('add-field-menu');
    const customButton = menu.querySelector('button[onclick*="addCustomField"]');

    const fieldButton = document.createElement('button');
    fieldButton.type = 'button';
    fieldButton.onclick = function() { addKnownField(fieldName); };
    fieldButton.className = 'block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono';
    fieldButton.dataset.availableField = fieldName;
    fieldButton.textContent = fieldName;

    // Insert before the custom field option
    const divider = menu.querySelector('.border-t');
    if (divider) {
      divider.before(fieldButton);
    } else {
      // Re-add divider if needed
      const div = document.createElement('div');
      div.className = 'border-t border-gray-200';
      customButton.before(div);
      div.before(fieldButton);
    }
  }

  row.remove();
}

function toggleMetadataView() {
  const formView = document.getElementById('metadata-form-view');
  const yamlView = document.getElementById('metadata-yaml-view');
  const toggleBtn = document.getElementById('metadata-toggle');
  const yamlTextarea = document.getElementById('metadata-yaml');
  const metadataContent = document.getElementById('metadata-content');
  const arrow = document.getElementById('metadata-arrow');

  isYamlView = !isYamlView;

  if (isYamlView) {
    const yamlContent = formToYaml();
    yamlTextarea.value = yamlContent;

    formView.classList.add('hidden');
    yamlView.classList.remove('hidden');
    toggleBtn.textContent = 'Edit as Form';

    // Open metadata section if closed
    if (metadataContent.classList.contains('hidden')) {
      metadataContent.classList.remove('hidden');
      arrow.textContent = '▼';
    }
  } else {
    try {
      yamlToForm(yamlTextarea.value);
      formView.classList.remove('hidden');
      yamlView.classList.add('hidden');
      toggleBtn.textContent = 'RAW';

      // Open metadata section if closed
      if (metadataContent.classList.contains('hidden')) {
        metadataContent.classList.remove('hidden');
        arrow.textContent = '▼';
      }
    } catch(e) {
      alert('Invalid YAML syntax. Please fix errors before switching to form view.');
      return;
    }
  }
}

function toggleMetadataSection() {
  const content = document.getElementById('metadata-content');
  const arrow = document.getElementById('metadata-arrow');

  content.classList.toggle('hidden');
  const isHidden = content.classList.contains('hidden');
  arrow.textContent = isHidden ? '▶' : '▼';

  // Save state to sessionStorage
  sessionStorage.setItem('metadataEditorOpen', !isHidden);
}

function formToYaml() {
  const fields = {};

  // Collect all known fields
  document.querySelectorAll('[data-metadata-field]').forEach(input => {
    const fieldName = input.dataset.metadataField;
    let value = input.value.trim();

    if (value !== '') {
      fields[fieldName] = value;
    }
  });

  // Collect custom fields
  document.querySelectorAll('[data-custom-key]').forEach(keyInput => {
    const valueInput = keyInput.nextElementSibling;
    const key = keyInput.value.trim();
    const value = valueInput.value.trim();

    if (key !== '' && value !== '') {
      fields[key] = value;
    }
  });

  // Convert to YAML string
  let yaml = '';
  for (const [key, value] of Object.entries(fields)) {
    yaml += `${key}: ${value}\n`;
  }

  return yaml;
}

function yamlToForm(yamlText) {
  // Simple YAML parser
  const lines = yamlText.split('\n');
  const fields = {};

  lines.forEach(line => {
    const match = line.match(/^([^:]+):\s*(.*)$/);
    if (match) {
      fields[match[1].trim()] = match[2].trim();
    }
  });

  // Clear and rebuild form
  const container = document.getElementById('metadata-fields-container');
  container.innerHTML = '';

  // Reset available fields menu
  const menu = document.getElementById('add-field-menu');
  // Rebuild menu with all known fields not in the YAML

  for (const [key, value] of Object.entries(fields)) {
    if (knownFieldsConfig[key]) {
      addKnownFieldToForm(key, value);
    } else {
      addCustomFieldToForm(key, value);
    }
  }
}

function addKnownFieldToForm(fieldName, value) {
  // Similar to addKnownField but with a value
  const config = knownFieldsConfig[fieldName];
  const container = document.getElementById('metadata-fields-container');

  const row = document.createElement('div');
  row.className = 'metadata-field-row flex items-start gap-2';
  row.dataset.fieldName = fieldName;

  let inputHtml = '';

  switch(config.type) {
    case 'text':
      inputHtml = `<input type="text"
                          id="metadata-field-${fieldName}"
                          name="metadata_fields[${fieldName}]"
                          value="${value}"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="${fieldName}">`;
      break;
    case 'date':
      inputHtml = `<input type="date"
                          id="metadata-field-${fieldName}"
                          name="metadata_fields[${fieldName}]"
                          value="${value}"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="${fieldName}">`;
      break;
    case 'select':
      const options = config.options.map(opt =>
        `<option value="${opt}" ${opt === value ? 'selected' : ''}>${opt}</option>`
      ).join('');
      inputHtml = `<select id="metadata-field-${fieldName}"
                          name="metadata_fields[${fieldName}]"
                          class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                          data-metadata-field="${fieldName}">
                     <option value="">-- select --</option>
                     ${options}
                   </select>`;
      break;
    case 'textarea':
      inputHtml = `<textarea id="metadata-field-${fieldName}"
                            name="metadata_fields[${fieldName}]"
                            rows="2"
                            class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
                            data-metadata-field="${fieldName}">${value}</textarea>`;
      break;
  }

  // Conditionally add delete button (not for required fields)
  const deleteButton = config.required
    ? '<div class="w-6 flex-shrink-0"></div>'
    : `<button type="button"
              onclick="removeMetadataField(this)"
              class="mt-[1px] px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-700 flex-shrink-0">
        ×
      </button>`;

  row.innerHTML = `
    <label class="font-mono text-xs px-2 py-1 text-gray-700 w-32 flex-shrink-0 pt-1.5">
      ${config.label}:
    </label>
    ${inputHtml}
    ${deleteButton}
  `;

  container.appendChild(row);
}

function addCustomFieldToForm(key, value) {
  const container = document.getElementById('metadata-fields-container');
  const sanitizedKey = key.replace(/[^a-z0-9_-]/gi, '-'); // Make safe ID

  const row = document.createElement('div');
  row.className = 'metadata-field-row flex items-start gap-2';

  row.innerHTML = `
    <input type="text"
           value="${key}"
           placeholder="field_name"
           class="font-mono text-xs px-2 py-1 border border-gray-300 w-32"
           data-custom-key>
    <input type="text"
           id="metadata-field-${sanitizedKey}"
           value="${value}"
           placeholder="value"
           class="flex-1 font-mono text-xs px-2 py-1 border border-gray-300"
           data-custom-value>
    <button type="button"
            onclick="removeMetadataField(this)"
            class="mt-[1px] px-2 py-1 text-xs bg-red-100 hover:bg-red-200 text-red-700 flex-shrink-0">
      ×
    </button>
  `;

  container.appendChild(row);
}

// Before form submission, convert form data to YAML
const form = document.getElementById('<%= j(resource_type) %>-form');
if (form) {
  form.addEventListener('submit', function(e) {
    const finalYaml = isYamlView
      ? document.getElementById('metadata-yaml').value
      : formToYaml();

    document.getElementById('metadata-final').value = finalYaml;
  });
}

// Notify Stimulus controller of metadata changes
function notifyMetadataChange() {
  const finalYaml = isYamlView
    ? document.getElementById('metadata-yaml').value
    : formToYaml();

  document.getElementById('metadata-final').value = finalYaml;

  // Dispatch a custom event that the Stimulus controller can listen to
  const event = new CustomEvent('metadata:changed', {
    detail: { yaml: finalYaml }
  });
  document.dispatchEvent(event);
}

// Add change listeners to all metadata inputs
function attachChangeListeners() {
  // Listen to form field changes
  document.querySelectorAll('[data-metadata-field], [data-custom-key], [data-custom-value]').forEach(input => {
    input.removeEventListener('input', notifyMetadataChange); // Remove old listener
    input.removeEventListener('change', notifyMetadataChange);
    input.addEventListener('input', notifyMetadataChange);
    input.addEventListener('change', notifyMetadataChange);
  });

  // Listen to YAML textarea changes
  const yamlTextarea = document.getElementById('metadata-yaml');
  if (yamlTextarea) {
    yamlTextarea.removeEventListener('input', notifyMetadataChange);
    yamlTextarea.addEventListener('input', notifyMetadataChange);
  }
}

// Call on load
attachChangeListeners();

// Wrap existing functions to notify on changes
const _addKnownField = addKnownField;
addKnownField = function(fieldName) {
  _addKnownField(fieldName);
  attachChangeListeners();
  notifyMetadataChange();
};

const _addCustomField = addCustomField;
addCustomField = function() {
  _addCustomField();
  attachChangeListeners();
  notifyMetadataChange();
};

const _removeMetadataField = removeMetadataField;
removeMetadataField = function(button) {
  _removeMetadataField(button);
  notifyMetadataChange();
};

const _toggleMetadataView = toggleMetadataView;
toggleMetadataView = function() {
  _toggleMetadataView();
  attachChangeListeners();
  notifyMetadataChange();
};

// Make functions globally available
window.toggleAddFieldMenu = toggleAddFieldMenu;
window.addKnownField = addKnownField;
window.addCustomField = addCustomField;
window.removeMetadataField = removeMetadataField;
window.toggleMetadataView = toggleMetadataView;
window.toggleMetadataSection = toggleMetadataSection;
})();
</script>
