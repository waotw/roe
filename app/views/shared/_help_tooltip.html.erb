<%#
  Reusable help-tooltip icon — a question-mark that reveals a tooltip on
  hover or keyboard focus. Intended to mark places where a user might have
  a question about a field, setting, or concept.

  Usage (in ERB):
    render 'shared/help_tooltip', text: "Short explanation."
    render 'shared/help_tooltip', text: "...".html_safe, title: "Type"
    render 'shared/help_tooltip', text: "...", position: "top"

  Params:
    text     — String or html_safe String (required)
    title    — Optional bold header above the text
    position — 'right' (default) | 'top' | 'bottom' | 'left'
%>
<%
  tooltip_id = "help-tooltip-#{SecureRandom.hex(4)}"
  position ||= 'right'
  position_classes = case position.to_s
                     when 'top'    then 'bottom-full left-1/2 -translate-x-1/2 mb-2'
                     when 'bottom' then 'top-full left-1/2 -translate-x-1/2 mt-2'
                     when 'left'   then 'right-full top-1/2 -translate-y-1/2 mr-2'
                     else               'left-full top-1/2 -translate-y-1/2 ml-2'
                     end
%>
<span class="relative inline-flex items-center group align-middle ml-1.5"
      tabindex="0"
      role="img"
      aria-label="Help"
      aria-describedby="<%= tooltip_id %>">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16.1328 15.7715"
       class="w-3.5 h-3.5 text-gray-400 hover:text-gray-700 cursor-help"
       aria-hidden="true" focusable="false">
    <path d="M7.88086 15.7617C12.2363 15.7617 15.7715 12.2363 15.7715 7.88086C15.7715 3.52539 12.2363 0 7.88086 0C3.53516 0 0 3.52539 0 7.88086C0 12.2363 3.53516 15.7617 7.88086 15.7617ZM7.88086 14.2773C4.3457 14.2773 1.49414 11.416 1.49414 7.88086C1.49414 4.3457 4.3457 1.48438 7.88086 1.48438C11.416 1.48438 14.2773 4.3457 14.2773 7.88086C14.2773 11.416 11.416 14.2773 7.88086 14.2773Z" fill="currentColor"/>
    <path d="M7.72461 9.48242C8.16406 9.48242 8.42773 9.20898 8.42773 8.86719C8.42773 8.84766 8.42773 8.82812 8.42773 8.80859C8.42773 8.39844 8.68164 8.13477 9.19922 7.79297C9.92188 7.32422 10.5078 6.875 10.5078 5.9082C10.5078 4.56055 9.30664 3.87695 7.97852 3.87695C6.63086 3.87695 5.74219 4.48242 5.50781 5.15625C5.45898 5.29297 5.42969 5.42969 5.42969 5.56641C5.42969 5.94727 5.74219 6.15234 6.02539 6.15234C6.31836 6.15234 6.49414 6.02539 6.66016 5.82031L6.82617 5.625C7.1582 5.21484 7.5 5.04883 7.91992 5.04883C8.56445 5.04883 8.98438 5.41992 8.98438 5.97656C8.98438 6.49414 8.65234 6.72852 7.99805 7.17773C7.4707 7.54883 7.02148 7.95898 7.02148 8.74023C7.02148 8.75 7.02148 8.7793 7.02148 8.78906C7.02148 9.24805 7.26562 9.48242 7.72461 9.48242ZM7.70508 11.8262C8.17383 11.8262 8.59375 11.4453 8.59375 10.9668C8.59375 10.4785 8.18359 10.1074 7.70508 10.1074C7.2168 10.1074 6.80664 10.4883 6.80664 10.9668C6.80664 11.4355 7.22656 11.8262 7.70508 11.8262Z" fill="currentColor"/>
  </svg>
  <span id="<%= tooltip_id %>"
        role="tooltip"
        class="hidden group-hover:block group-focus:block absolute <%= position_classes %> z-50 w-64 p-3 bg-gray-900 text-white text-xs font-normal normal-case leading-relaxed rounded-xs shadow-lg">
    <% if local_assigns[:title] %>
      <strong class="block font-semibold mb-1 text-base"><%= title %></strong>
    <% end %>
    <%= text %>
  </span>
</span>
