<%# Collection builder modal. Lives inside the editor root so its
    `collection-builder:insert` event bubbles to the editor controller (same
    seam the media picker uses). All options come from CollectionBuilderSchema
    — the single source of truth — and pre-fill from the site's button_template
    so commonly-used options are the defaults. Fields dim until they hold a
    value; only non-empty fields get written into the block. %>
<%# The `collection-builder` controller lives on the editor root (alongside
    `editor`), so this modal, the toolbar trigger, and the textarea all sit in
    its scope. %>
<% defaults = CollectionBuilderSchema.default_values %>
<%# Down-chevron styling used by selects across Roe's forms. %>
<% select_chevron = "appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat" %>
<div data-collection-builder-target="modal"
     data-action="keydown->collection-builder#onKeydown"
     class="fixed inset-0 z-50 items-center justify-center"
     style="display: none;">
  <div class="absolute inset-0 bg-black/50"
       data-action="click->collection-builder#close"></div>

  <div class="relative bg-white border border-gray-300 shadow-xl flex flex-col"
       style="width: 90vw; max-width: 560px; max-height: 85vh;">
    <div class="flex items-center justify-between px-4 py-3 border-b border-gray-300">
      <div>
      <h2 class="font-mono text-sm font-semibold text-gray-900">Insert collection</h2>
      <p class="text-xs text-gray-500">There are a lot of options here but none are required for a working Collection</a><br>
        Check out some <a href="/documentation/roe/collections#collection-examples" target="_blank" class="underline">Collection examples</a><br>You can edit the <a href="/admin/configs/collections/edit" class="underline" target="_blank">button template</a> which controls the defaults for this form.</p>
      </div>
      <button type="button" data-action="click->collection-builder#close"
              class="w-7 h-7 flex items-center justify-center border border-gray-400 bg-white hover:bg-gray-100 text-gray-600 text-sm font-mono rounded-xs">×</button>
    </div>

    <div class="overflow-y-auto p-4 space-y-3">
      <% CollectionBuilderSchema.fields.each do |field| %>
        <% key = field[:key] %>
        <% value = defaults[key].to_s %>
        <% deps = Array.wrap(field[:depends_on]) %>
        <div class="cb-row"
             data-collection-builder-target="row"
             <% if deps.any? %>data-cb-depends="<%= deps.to_json %>"<% end %>>
          <label class="block text-xs font-medium text-gray-700 mb-1"><%= field[:label] %></label>

          <% case field[:type] %>
          <% when :select %>
            <select data-cb-field="<%= key %>"
                    data-action="change->collection-builder#fieldChanged"
                    class="cb-input w-full font-mono text-sm p-2 border border-gray-300 <%= select_chevron %> <%= 'cb-empty' if value.blank? %>">
              <option value="">—</option>
              <% field[:options].each do |opt| %>
                <option value="<%= opt %>"<%= ' selected' if value == opt %>><%= opt %></option>
              <% end %>
            </select>

          <% when :boolean %>
            <%# Tri-state: blank = use engine default; true/false force it. %>
            <select data-cb-field="<%= key %>"
                    data-cb-boolean="true"
                    data-action="change->collection-builder#fieldChanged"
                    class="cb-input w-full font-mono text-sm p-2 border border-gray-300 <%= select_chevron %> <%= 'cb-empty' if value.blank? %>">
              <option value="">— (default)</option>
              <option value="true"<%= ' selected' if value == 'true' %>>true</option>
              <option value="false"<%= ' selected' if value == 'false' %>>false</option>
            </select>

          <% else %>
            <input type="text" data-cb-field="<%= key %>"
                   value="<%= value %>"
                   data-action="input->collection-builder#fieldChanged"
                   class="cb-input w-full font-mono text-sm p-2 border border-gray-300 <%= 'cb-empty' if value.blank? %>">
          <% end %>

          <% if field[:hint] || field[:docs] %>
            <p class="text-xs text-gray-500 mt-1"><%= field[:hint] %><% if field[:docs] %> <a href="<%= field[:docs] %>" target="_blank" rel="noopener" class="text-blue-600 underline">Learn more →</a><% end %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center justify-end gap-2 px-4 py-3 border-t border-gray-300">
      <button type="button" data-action="click->collection-builder#close"
              class="uppercase text-xs px-3 py-1 border border-gray-400 bg-white hover:bg-gray-100 font-mono rounded-xs">Cancel</button>
      <button type="button" data-action="click->collection-builder#insert"
              class="uppercase text-xs px-3 py-1 border border-gray-800 bg-gray-800 text-white hover:bg-gray-700 font-mono rounded-xs">Insert</button>
    </div>
  </div>
</div>
