  function formatYamlValue(value) {
    if (value === null || value === undefined) {
      return '""';
    }

    const strValue = String(value);

    if (strValue === "") {
      return '""';
    }

    // Numbers (not quoted)
    if (!isNaN(strValue) && strValue.trim() !== "") {
