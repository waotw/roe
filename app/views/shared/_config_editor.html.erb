<%
  # Prefer the config_hash the controller passed in (it may have been
  # mutated server-side — e.g. edit_podcast auto-seeds audience: '' when
  # payments are enabled). Fall back to parsing config_content only when
  # no hash was provided.
  config_hash = local_assigns[:config_hash]
  if config_hash.nil?
    begin
      config_hash = YAML.safe_load(config_content, permitted_classes: [Date, Time, Symbol]) || {}
    rescue
      config_hash = {}
    end
  end

  # Flatten nested structures for easier form handling
  flattened_config = {}

  config_hash.each do |key, value|
    if key == 'fonts' && value.is_a?(Hash)
      # Fonts are 2 levels: fonts.heading.family
      value.each do |role, role_data|
        next unless role_data.is_a?(Hash)
        role_data.each do |variant, variant_value|
          flattened_config["fonts.#{role}.#{variant}"] = variant_value
        end
      end
    elsif key == 'theme' && value.is_a?(Hash)
      # Theme is 1 level: theme.active
      value.each do |field, field_value|
        flattened_config["theme.#{field}"] = field_value
      end
    elsif key == 'grouped_products' && value.is_a?(Hash)
      # Grouped products is 1 level: grouped_products.button_text
      value.each do |field, field_value|
        flattened_config["grouped_products.#{field}"] = field_value
      end
    elsif key == 'snipcart' && value.is_a?(Hash)
      # Snipcart settings are 1 level: snipcart.load_strategy
      value.each do |field, field_value|
        flattened_config["snipcart.#{field}"] = field_value
      end
    else
      flattened_config[key] = value
    end
  end
%>

<div id="config-container" class="mb-5 bg-white p-8 border border-gray-200">
  <div class="flex items-center justify-between mb-6">
    <!--<h2 class="text-lg font-semibold text-gray-900">Configuration</h2>-->
    <h2 class="text-xl font-semibold text-gray-900">
      <% if @config_type == 'members' %>
        Membership & Paid Content Settings
      <% elsif @config_type == 'podcast' %>
        Podcasts
      <% else %>
        <%= @config_type.capitalize %>
      <% end %>
    </h2>
    <button type="button"
            onclick="toggleConfigView()"
            class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none pt-[0.1rem]"
            id="config-toggle">
      EDIT YAML
    </button>
  </div>

  <%= form_with url: form_url, method: :patch, id: "config-form", class: "space-y-6" do |form| %>

    <!-- Form View -->
    <div id="config-form-view">

      <div class="config-section mb-8">
              <% if @config_type == 'site' %>
                <!-- Site Information Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Global</h3>

                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:site_info][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

                <!-- Branding Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Branding</h3>

                  <div class="mb-3 flex gap-2 items-center">
                    <p class="text-base font-medium text-gray-700">Manage:</p>
                    <%= link_to "Global Images", browse_images_admin_system_assets_path,
                      target: "_blank",
                      class: "uppercase text-sm px-1.5 py-1.5 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none" %>
                  </div>

                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:branding][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

                <!-- Theme Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Theme</h3>
                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% theme_active = flattened_config['theme.active'] %>
                    <div class="config-field-row">
                      <label class="block text-sm font-medium text-gray-700 mb-1">
                        Active Theme
                      </label>
                      <select name="config_fields[theme][active]"
                              class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                              data-config-field="theme.active">
                        <option value="">Select...</option>
                        <% theme_options = config_schema.dig(:theme, :fields, 'active', :options) || [] %>
                        <% theme_options.each do |option| %>
                          <option value="<%= option %>" <%= 'selected' if theme_active == option %>><%= option %></option>
                        <% end %>
                      </select>
                      <p class="text-xs text-gray-500 mt-1">Select the theme for your site</p>
                    </div>
                  </div>
                </div>

                <!-- Static Site Generation Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1"><%= link_to "Static Site Settings", admin_static_site_path,
                        class: "" %></h3>

                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:static_generation][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

              <% elsif @config_type == 'fonts' %>
                <!-- Themes Section -->
                <div class="config-section mb-8">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Themes</h3>
                  <p class="text-sm text-gray-600 mb-3">Themes that should load these fonts. Leave all unchecked to load for every theme.</p>
                  <% selected_themes = Array(config_hash['themes']) %>
                  <div class="space-y-1 pl-4 border-l-2 border-gray-200">
                    <% (local_assigns[:available_themes] || []).each do |theme_name| %>
                      <label class="flex items-center gap-2 text-sm font-mono">
                        <input type="checkbox"
                               value="<%= theme_name %>"
                               data-config-multi-field="themes"
                               <%= 'checked' if selected_themes.include?(theme_name) %>>
                        <span><%= theme_name %></span>
                      </label>
                    <% end %>
                    <% if (local_assigns[:available_themes] || []).empty? %>
                      <p class="text-xs text-gray-500 italic">No themes found in app/themes/ or site/theme/.</p>
                    <% end %>
                  </div>
                </div>

                <!-- Custom Fonts Section -->
                <h3 class="text-base font-semibold text-gray-900 mb-1">Custom Fonts</h3>
                <p class="text-sm text-gray-600 mb-3">Upload font files with the FONTS button. Copy the url…</p>

                <div class="mb-3 flex gap-2 items-center">
                  <p class="text-base font-medium text-gray-700">Manage:</p>
                  <%= link_to "Fonts", browse_fonts_admin_system_assets_path,
                      target: "_blank",
                      class: "uppercase text-sm px-1.5 py-0.5 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none pt-[0.2rem]" %>
                </div>

                <%# Check if any fonts are installed %>
                <% fonts_installed = Dir.glob(File.join(RoeSitePaths::SITE_PATH, 'system/assets/fonts/*')).any? %>
                <% if !fonts_installed %>
                  <div class="mb-4 p-4 bg-amber-50 border border-amber-200 rounded-xs">
                    <p class="text-sm text-amber-800">
                      <strong>No fonts installed yet.</strong>
                      <%= link_to "Upload font files", browse_fonts_admin_system_assets_path, target: "_blank", class: "underline" %>
                      to use custom fonts.
                    </p>
                  </div>
                <% end %>

                <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                  <%= render 'shared/config_font_roles',
                                               roles: config_schema[:fonts][:roles],
                                               config_hash: config_hash,
                                               flattened_config: flattened_config,
                                               custom_family_variants: config_schema[:fonts][:custom_family_variants] %>
                </div>

                <% elsif @config_type == 'store' %>
                  <!-- Store Configuration -->

                  <!-- Enabled Field -->
                  <div class="config-section mb-8">
                    <h3 class="text-base font-semibold text-gray-900 mb-3">Store</h3>
                    <div class="space-y-4 pl-4 border-l-2 border-gray-200">

                      <!-- Enabled -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Enabled
                        </label>
                        <div class="flex items-center gap-2">
                          <select name="config_fields[enabled]"
                                  class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                  data-config-field="enabled"
                                  onchange="updateBooleanFieldIndicators()">
                            <option value="true" <%= 'selected' if flattened_config['enabled'] == true || flattened_config['enabled'] == 'true' %>>true</option>
                            <option value="false" <%= 'selected' if flattened_config['enabled'] == false || flattened_config['enabled'] == 'false' %>>false</option>
                          </select>
                          <span class="boolean-indicator inline-flex items-center justify-center w-3 h-3 rounded-full"
                                data-field="enabled"
                                data-value="<%= flattened_config['enabled'] %>"></span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Enable or disable the store feature</p>
                      </div>

                      <!-- Currency -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Currency
                        </label>
                        <select name="config_fields[currency]"
                                class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="currency">
                          <% current_currency = flattened_config['currency'] || 'usd' %>
                          <option value="usd" <%= 'selected' if current_currency == 'usd' %>>USD - US Dollar</option>
                          <option value="eur" <%= 'selected' if current_currency == 'eur' %>>EUR - Euro</option>
                          <option value="gbp" <%= 'selected' if current_currency == 'gbp' %>>GBP - British Pound</option>
                          <option value="cad" <%= 'selected' if current_currency == 'cad' %>>CAD - Canadian Dollar</option>
                          <option value="aud" <%= 'selected' if current_currency == 'aud' %>>AUD - Australian Dollar</option>
                          <option value="jpy" <%= 'selected' if current_currency == 'jpy' %>>JPY - Japanese Yen</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">Default currency for your store</p>
                      </div>

                      <!-- Default Domain -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Default Domain
                        </label>
                        <input type="text"
                               name="config_fields[default_domain]"
                               value="<%= flattened_config['default_domain'] %>"
                               placeholder="yourdomain.com"
                               class="w-full font-mono text-sm px-2 py-1.5 border border-gray-300"
                               data-config-field="default_domain">
                        <p class="text-xs text-gray-500 mt-1">Domain used for Snipcart order validation</p>
                      </div>

                      <!-- Product Categories -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Product Categories
                        </label>
                        <input type="text"
                               name="config_fields[product_categories]"
                               value="<%= (flattened_config['product_categories'].is_a?(Array) ? flattened_config['product_categories'].join(', ') : flattened_config['product_categories'].to_s) %>"
                               placeholder="book, ebook, poster, tshirt"
                               class="w-full font-mono text-sm px-2 py-1.5 border border-gray-300"
                               data-config-field="product_categories">
                        <p class="text-xs text-gray-500 mt-1">Comma-separated list of product categories for organization and SKU generation</p>
                      </div>

                      <!-- Product Button Template -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Product Page & Button Template
                        </label>
                        <textarea name="config_fields[product_button_template]"
                                  rows="12"
                                  placeholder="![Add Image Description](@image)&#10;&#10;# @title&#10;&#10;**Price:** @price&#10;&#10;@description&#10;&#10;```button&#10;sku: @sku&#10;text: Add to Cart&#10;style: primary&#10;```"
                                  class="w-full font-mono text-xs px-2 py-1.5 border border-gray-300"
                                  data-config-field="product_button_template"><%= flattened_config['product_button_template'] %></textarea>
                        <p class="text-xs text-gray-500 mt-1">
                          Template used when inserting products via PRODUCT button in editor.
                          Use placeholders: @image, @title, @price, @description, @sku
                        </p>
                      </div>

                    </div>
                  </div>

                  <!-- Grouped Products Section -->
                  <div class="config-section mb-8">
                    <h3 class="text-base font-semibold text-gray-900 mb-3">Grouped Products</h3>
                    <div class="space-y-4 pl-4 border-l-2 border-gray-200">

                      <!-- Button Text -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Button Text
                        </label>
                        <input type="text"
                               name="config_fields[grouped_products][button_text]"
                               value="<%= flattened_config['grouped_products.button_text'] %>"
                               placeholder="View"
                               class="w-48 font-mono text-sm px-2 py-1.5 border border-gray-300"
                               data-config-field="grouped_products.button_text">
                        <p class="text-xs text-gray-500 mt-1">Text for grouped product buttons.</p>
                        <p class="text-xs text-gray-500 mt-1"> <mark class="bg-blue-200 rounded-xs px-0.5">Leave blank to disable button for grouped products.</mark></p>
                      </div>

                      <!-- Price Display -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Price Display
                        </label>
                        <select name="config_fields[grouped_products][price_display]"
                                class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="grouped_products.price_display">
                          <% current_price_display = flattened_config['grouped_products.price_display'] || 'range' %>
                          <option value="range" <%= 'selected' if current_price_display == 'range' %>>range</option>
                          <option value="lowest" <%= 'selected' if current_price_display == 'lowest' %>>lowest</option>
                          <option value="highest" <%= 'selected' if current_price_display == 'highest' %>>highest</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">How to display prices for grouped products</p>
                      </div>

                      <!-- Price Separator -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Price Separator
                        </label>
                        <input type="text"
                               value="<%= flattened_config['grouped_products.price_separator'] || '-' %>"
                               class="w-24 font-mono text-sm px-2 py-1.5 border border-gray-300"
                               placeholder="-"
                               data-config-field="grouped_products.price_separator">
                        <p class="text-xs text-gray-500 mt-1">Separator between min and max price (e.g. <code class="font-mono">-</code> <code class="font-mono">&ndash;</code> <code class="font-mono">/</code> <code class="font-mono">|</code>). Only used when Price Display is set to range.</p>
                      </div>

                    </div>
                  </div>

                  <!-- Snipcart Settings Section -->
                  <div class="config-section mb-8">
                    <h3 class="text-base font-semibold text-gray-900 mb-3">Snipcart</h3>
                    <div class="space-y-4 pl-4 border-l-2 border-gray-200">

                      <!-- Load Strategy -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Load Strategy
                        </label>
                        <select name="config_fields[snipcart][load_strategy]"
                                class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="snipcart.load_strategy">
                          <% current_load_strategy = flattened_config['snipcart.load_strategy'] || 'on-user-interaction' %>
                          <option value="on-user-interaction" <%= 'selected' if current_load_strategy == 'on-user-interaction' %>>on-user-interaction</option>
                          <option value="manual" <%= 'selected' if current_load_strategy == 'manual' %>>manual</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">How Snipcart JavaScript loads on your site</p>
                      </div>

                      <!-- Modal Style -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Modal Style
                        </label>
                        <select name="config_fields[snipcart][modal_style]"
                                class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="snipcart.modal_style">
                          <% current_modal_style = flattened_config['snipcart.modal_style'] || 'side' %>
                          <option value="side" <%= 'selected' if current_modal_style == 'side' %>>side</option>
                          <option value="full" <%= 'selected' if current_modal_style == 'full' %>>full</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">How the shopping cart displays</p>
                      </div>

                      <!-- Show Taxes -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Show Taxes
                        </label>
                        <div class="flex items-center gap-2">
                          <select name="config_fields[snipcart][show_taxes]"
                                  class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                  data-config-field="snipcart.show_taxes"
                                  onchange="updateBooleanFieldIndicators()">
                            <% current_show_taxes = flattened_config['snipcart.show_taxes'] %>
                            <option value="true" <%= 'selected' if current_show_taxes == true || current_show_taxes == 'true' %>>true</option>
                            <option value="false" <%= 'selected' if current_show_taxes == false || current_show_taxes == 'false' %>>false</option>
                          </select>
                          <span class="boolean-indicator inline-flex items-center justify-center w-3 h-3 rounded-full"
                                data-field="snipcart.show_taxes"
                                data-value="<%= current_show_taxes %>"></span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Display taxes in cart</p>
                      </div>

                      <!-- Show Quantity -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Show Quantity
                        </label>
                        <div class="flex items-center gap-2">
                          <select name="config_fields[snipcart][show_quantity]"
                                  class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                  data-config-field="snipcart.show_quantity"
                                  onchange="updateBooleanFieldIndicators()">
                            <% current_show_quantity = flattened_config['snipcart.show_quantity'] %>
                            <option value="true" <%= 'selected' if current_show_quantity == true || current_show_quantity == 'true' %>>true</option>
                            <option value="false" <%= 'selected' if current_show_quantity == false || current_show_quantity == 'false' %>>false</option>
                          </select>
                          <span class="boolean-indicator inline-flex items-center justify-center w-3 h-3 rounded-full"
                                data-field="snipcart.show_quantity"
                                data-value="<%= current_show_quantity %>"></span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Allow quantity changes in cart</p>
                      </div>

                    </div>
                  </div>

                <% else %>
            <!-- SIMPLE KEY-VALUE EDITOR FOR CARDS/COLLECTIONS -->
            <div class="config-section mb-10">

              <%
                # Separate defaults from templates
                # Templates end with _button_template or are exactly "button_template"
                templates = config_hash.select { |k, v| k.to_s.end_with?('_button_template') || k.to_s == 'button_template' }
                defaults = config_hash.reject { |k, v| templates.key?(k) }
              %>

              <!-- Defaults Section -->
              <% if defaults.any? %>
                <div class="mb-8">
                  <% if @config_type != 'members' && @config_type != 'podcast' %>
                    <h3 class="text-base font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Defaults</h3>
                  <% end %>

                  <div class="space-y-6">
                    <% podcast_index = 0 %>
                    <% defaults.each do |key, value| %>
                      <% if value.is_a?(Hash) %>
                        <% if @config_type == 'podcast' %>
                          <% podcast_index += 1 %>
                          <% podcast_title = value['title'].to_s.strip.presence || ("Podcast %02d" % podcast_index) %>
                          <h3 class="text-base font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200"><%= podcast_title %></h3>
                        <% end %>
                        <!-- Nested section (like post-link, aside, pullquote) -->
                        <div class="config-subsection pl-4 border-l-2 border-gray-300">
                          <% if @config_type == 'podcast' %>
                            <!-- Podcast key — editable. The data-podcast-key
                                 attribute holds the original; formToYaml
                                 renames the top-level YAML key on save when
                                 the input value differs. -->
                            <div class="config-field-row mb-4">
                              <label class="block text-sm font-medium text-gray-700 mb-1">
                                Podcast key<span class="text-red-600 ml-0.5">*</span>
                                <%= render 'shared/help_tooltip',
                                           title: 'Podcast key',
                                           text: ('DO NOT RENAME IF PODCAST IS PUBLISHED. Used in the feed URL (<code>/podcast/&lt;key&gt;.xml</code>) and in episode post metadata as <code>podcast:</code> which connects a podcast post to this podcast. ' \
                                                  'Renaming will <strong>break</strong> the connection in any existing podcast posts that reference this podcast — and break the exisitng feed. Any subscribers using the old feed will lose access.').html_safe %>
                              </label>
                              <input type="text"
                                     data-podcast-key="<%= key %>"
                                     value="<%= key %>"
                                     class="w-full font-mono text-sm p-2 border border-gray-300"
                                     placeholder="e.g., the-briefcase">
                              <p class="text-xs text-gray-500 mt-0.5">Feed: <code>/podcast/<span data-podcast-feed-key="<%= key %>"><%= key %></span>.xml</code></p>
                            </div>
                          <% else %>
                            <h4 class="text-sm font-semibold text-gray-800 mb-3"><%= key.humanize %></h4>
                          <% end %>

                          <div class="space-y-3">
                            <% value.each do |subkey, subvalue| %>
                              <%
                                # Skip subcategory fields - they're dynamically managed
                                next if subkey == 'subcategory' || subkey == 'subcategory_2'
                              %>

                              <% nested_field_key = "#{key}.#{subkey}" %>
                              <% help_key = @field_help&.key?(nested_field_key) ? nested_field_key : (@field_help&.key?(subkey) ? subkey : nil) %>
                              <% field_required = @field_required&.include?(subkey) || @field_required&.include?(nested_field_key) %>

                              <div class="config-field-row">
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                  <%= subkey.humanize %><% if field_required %><span class="text-red-600 ml-0.5">*</span><% end %>
                                  <% if help_key %>
                                    <%= render 'shared/help_tooltip',
                                               text: @field_help[help_key][:text],
                                               title: @field_help[help_key][:title] %>
                                  <% end %>
                                </label>

                                <%
                                  # Skip subcategory fields - they're dynamically managed
                                  next if subkey == 'subcategory' || subkey == 'subcategory_2'
                                %>

                                <% field_options_key = @field_options&.key?(nested_field_key) ? nested_field_key : subkey %>
                                <% if @field_options&.key?(field_options_key) %>
                                  <!-- Select dropdown (no extra wrapper/label) -->
                                  <select name="config_fields[<%= key %>][<%= subkey %>]"
                                          class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                          data-config-field="<%= nested_field_key %>">
                                    <% @field_options[field_options_key].each do |option| %>
                                      <% display_text = option.blank? ? '-- select --' : option %>
                                      <option value="<%= option %>" <%= 'selected' if subvalue.to_s == option.to_s %>><%= display_text %></option>
                                    <% end %>
                                  </select>

                                  <%# Add subcategory container after primary category %>
                                  <% if subkey == 'category' %>
                                    <div class="category-subcategories mt-2"
                                         data-podcast-key="<%= key %>"
                                         data-category-type="primary">
                                      <!-- Subcategories added here by JS -->
                                    </div>
                                  <% end %>

                                  <%# Add subcategory container after secondary category %>
                                  <% if subkey == 'category_2' %>
                                    <div class="category-subcategories mt-2"
                                         data-podcast-key="<%= key %>"
                                         data-category-type="secondary">
                                      <!-- Subcategories added here by JS -->
                                    </div>
                                  <% end %>
                                <% else %>
                                  <!-- Regular text input for nested field -->
                                  <input type="text"
                                         name="config_fields[<%= key %>][<%= subkey %>]"
                                         value="<%= subvalue %>"
                                         class="w-full font-mono text-sm p-2 border border-gray-300"
                                         data-config-field="<%= nested_field_key %>">
                                <% end %>
                                <!-- Add hint text here ↓ -->
                                <% if @field_hints&.key?(nested_field_key) %>
                                  <p class="text-xs text-gray-500 mt-1"><%= @field_hints[nested_field_key] %></p>
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                        </div>

                      <% else %>
                        <!-- Top-level field -->
                        <div class="config-field-row">
                          <label class="block text-sm font-medium text-gray-700 mb-1">
                            <%= key.humanize %>
                            <% if @field_help&.key?(key) %>
                              <%= render 'shared/help_tooltip',
                                         text: @field_help[key][:text],
                                         title: @field_help[key][:title] %>
                            <% end %>
                          </label>

                          <% if @field_options&.key?(key) %>
                            <!-- Select dropdown for field with options -->
                            <select name="config_fields[<%= key %>]"
                                    class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                    data-config-field="<%= key %>">
                              <% @field_options[key].each do |option| %>
                                <option value="<%= option %>" <%= 'selected' if value.to_s == option.to_s %>><%= option %></option>
                              <% end %>
                            </select>
                          <% else %>
                            <!-- Regular text input -->
                            <input type="text"
                                   name="config_fields[<%= key %>]"
                                   value="<%= value %>"
                                   class="w-full font-mono text-sm p-2 border border-gray-300"
                                   data-config-field="<%= key %>">
                          <% end %>

                          <% if key == 'default_limit' %>
                            <p class="text-xs text-gray-500 mt-1">Use a number (e.g., 10) or "all" to show everything</p>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- Templates Section -->
              <% if templates.any? %>
                <div>
                  <h3 class="text-base font-semibold text-gray-800 mb-2 pb-2 border-b border-gray-200">Button Templates</h3>
                  <p class="text-xs text-amber-600 mt-0 mb-2"><code class="font-mono bg-blue-200 text-gray-800 rounded-xs py-1 px-2">__PLACEHOLDER__</code> will be selected when you use the button in a Post/Page.</p>

                  <div class="space-y-4">
                    <% templates.each do |key, value| %>
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          <%= key.humanize %>
                        </label>
                        <textarea name="config_fields[<%= key %>]"
                                  rows="<%= value.lines.count + 2 %>"
                                  class="w-full font-mono text-sm p-2 border border-gray-300 bg-gray-50"
                                  data-config-field="<%= key %>"><%= value %></textarea>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>

            </div>
          <% end %>
      </div>

    </div>

    <!-- Raw YAML View -->
    <div id="config-yaml-view" class="hidden">
      <%= form.text_area :content,
                         value: config_content,
                         id: "config-yaml",
                         class: "w-full font-mono text-sm p-2 border border-gray-300 bg-gray-50",
                         rows: 25 %>
    </div>

    <!-- Hidden field to store final config YAML -->
    <%= form.hidden_field :content, id: "config-final", value: "" %>

    <div class="flex items-center gap-3 p-4 border border-gray-400 fixed bottom-8 right-12 bg-white">
      <%= form.submit "Save Configuration",
                      class: "uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none" %>
      <%= link_to "Cancel", admin_configs_path,
                  class: "uppercase text-sm px-2 py-1.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs leading-none" %>
    </div>
  <% end %>
</div>

<script>
  // Global flags (outside IIFE so it persists)
  window.configEditorSetupComplete = window.configEditorSetupComplete || false;
  window.yamlWasEdited = window.yamlWasEdited || false;
  window.isYamlView = window.isYamlView || false;
  window.hasUnsavedChanges = window.hasUnsavedChanges || false;

  (function() {
  const configSchema = <%= raw (defined?(config_schema) ? config_schema.to_json : '{}') %>;
  let imageFieldsWithErrors = {};
  let fontFieldsWithErrors = {};
  let availableFonts = [];

  // Fetch available fonts on page load
  async function fetchAvailableFonts() {
  try {
  const response = await fetch('<%= available_fonts_admin_system_assets_path %>');
  const data = await response.json();
  availableFonts = data.fonts || [];
  } catch (error) {
  console.error('Failed to fetch available fonts:', error);
  }
  }

  // Load saved view preference
  function loadViewPreference() {
  const savedView = sessionStorage.getItem('configViewMode');
  console.log('Loading view preference:', savedView); // Debug

  // Only toggle if we're NOT already in the saved view
  if (savedView === 'yaml' && !window.isYamlView) {
  toggleConfigView();
  } else if (savedView === 'form' && window.isYamlView) {
  toggleConfigView();
  }
  }

  // Save view preference
  function saveViewPreference(mode) {
  sessionStorage.setItem('configViewMode', mode);
  }

  function toggleConfigView() {
  const formView = document.getElementById('config-form-view');
  const yamlView = document.getElementById('config-yaml-view');
  const toggleBtn = document.getElementById('config-toggle');
  const yamlTextarea = document.getElementById('config-yaml');

  console.log('Toggle attempt - isYamlView:', window.isYamlView, 'yamlWasEdited:', window.yamlWasEdited); // Add this

  // Prevent switching back to form if YAML was edited
  if (window.isYamlView && window.yamlWasEdited) {
  alert('YAML has been edited. Please save your changes first. The page will refresh and you can use the form view again.');
  return;
  }

  window.isYamlView = !window.isYamlView;

  if (window.isYamlView) {
  const yamlContent = formToYaml();
  yamlTextarea.value = yamlContent;
  window.yamlWasEdited = false; // Reset since we just generated it from form

  formView.classList.add('hidden');
  yamlView.classList.remove('hidden');
  toggleBtn.textContent = 'EDIT IN FORM';
  saveViewPreference('yaml');
  } else {
  formView.classList.remove('hidden');
  yamlView.classList.add('hidden');
  toggleBtn.textContent = 'EDIT YAML';
  saveViewPreference('form');
  }
  }

  // Track changes in form
  function trackChanges() {
  window.hasUnsavedChanges = true;
  }

  // Check field dependencies in real-time
  function checkDependencies() {
    console.log('checkDependencies called');
    document.querySelectorAll('[data-depends-on]').forEach(field => {
      const dependsOn = field.dataset.dependsOn;
      console.log('Field depends on:', dependsOn);
      const dependencyField = document.querySelector('[data-config-field="' + dependsOn + '"]');
      console.log('Dependency field found:', dependencyField);

      if (dependencyField) {
        const hasValue = dependencyField.value.trim() !== '';
        console.log('Has value:', hasValue);
        field.disabled = !hasValue;

        // Visual indication
        const wrapper = field.closest('.config-field-row');
        if (wrapper) {
          if (hasValue) {
            wrapper.classList.remove('opacity-50');
          } else {
            wrapper.classList.add('opacity-50');
          }
        }
      }
    });
  }

  // Validate image exists
  function validateImage(input) {
  const fieldName = input.dataset.configField;
  const value = input.value.trim();
  const errorMsg = document.querySelector(`[data-${fieldName}-error]`);

  if (!value) {
  // Empty field - hide error
  if (errorMsg) {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-300');
  }
  imageFieldsWithErrors[fieldName] = false;
  return;
  }

  if (!errorMsg) return;

  // User only types filename (e.g., "logo.svg"), prepend the system images path
  let imageUrl = '/system/images/' + value;

  // Create a temporary image to test if it loads
  const img = new Image();

  img.onload = function() {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-300');
  imageFieldsWithErrors[fieldName] = false;
  };

  img.onerror = function() {
  errorMsg.classList.remove('hidden');
  input.classList.add('border-red-300');
  imageFieldsWithErrors[fieldName] = true;
  };

  img.src = imageUrl;
  }

  // Validate font exists
  function validateFont(input) {
  const fieldName = input.dataset.configField;
  const value = input.value.trim();
  const errorMsg = document.querySelector(`[data-font-error="${fieldName}"]`);

  if (!value) {
  // Empty field - hide error
  if (errorMsg) {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-400');
  }
  fontFieldsWithErrors[fieldName] = false;
  return;
  }

  if (!errorMsg) return;

  // Don't show individual warnings if no fonts are installed at all
  // (A global warning is shown at the top of the form instead)
  if (availableFonts.length === 0) {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-400');
  fontFieldsWithErrors[fieldName] = false;
  return;
  }

  // Check if font filename exists in available fonts list
  const fontExists = availableFonts.includes(value);

  if (fontExists) {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-400');
  fontFieldsWithErrors[fieldName] = false;
  } else {
  errorMsg.classList.remove('hidden');
  input.classList.add('border-red-400');
  fontFieldsWithErrors[fieldName] = true;
  }
  }

  // Setup font validation listeners
  function setupFontValidation() {
  // Validate all font fields on page load
  document.querySelectorAll('[data-validate-font="true"]').forEach(input => {
  if (input.value.trim()) {
  validateFont(input);
  }
  });
  }

  // Keyboard shortcut handler (only set up once)
  function handleKeyboardShortcut(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 's') {
  e.preventDefault();
  const formElement = document.getElementById('config-form');
  if (formElement) {
  formElement.requestSubmit();
  }
  }
  }

  // Set up global event listeners (only once)
  console.log('setupComplete at start:', window.configEditorSetupComplete);

  if (!window.configEditorSetupComplete) {
  console.log('Setting up global listeners');

  // Unsaved changes warning (for closing tab/window/external navigation)
  window.addEventListener('beforeunload', function(e) {
  console.log('beforeunload event fired, hasUnsavedChanges:', window.hasUnsavedChanges);
  if (window.hasUnsavedChanges) {
  e.preventDefault();
  e.returnValue = '';
  return '';
  }
  });

  // Clear unsaved changes flag when navigating via Turbo
  document.addEventListener('turbo:before-visit', function(e) {
  console.log('turbo:before-visit fired, hasUnsavedChanges:', window.hasUnsavedChanges);
  if (window.hasUnsavedChanges) {
  const confirmed = confirm('You have unsaved changes. Are you sure you want to leave?');
  if (!confirmed) {
  e.preventDefault();
  }
  }
  });

  // Listen for changes on all config fields
  document.addEventListener('input', function(e) {
  if (e.target.matches('[data-config-field]')) {
  checkDependencies();
  trackChanges();
  }

  if (e.target.id === 'config-yaml') {
  console.log('YAML edited, setting yamlWasEdited to true');
  window.yamlWasEdited = true;
  trackChanges();
  }

  // If any image field has an error showing, validate in real-time as they type
  if (e.target.matches('[data-validate-image="true"]')) {
  const fieldName = e.target.dataset.configField;
  if (imageFieldsWithErrors[fieldName]) {
  validateImage(e.target);
  }
  }

  // If any font field has an error showing, validate in real-time as they type
  if (e.target.matches('[data-validate-font="true"]')) {
  const fieldName = e.target.dataset.configField;
  if (fontFieldsWithErrors[fieldName]) {
  validateFont(e.target);
  }
  }
  });

  // Validate image/font on blur
  document.addEventListener('blur', function(e) {
  if (e.target.matches('[data-validate-image="true"]')) {
  validateImage(e.target);
  }

  if (e.target.matches('[data-validate-font="true"]')) {
  validateFont(e.target);
  }
  }, true);

  // Validate on Enter key
  document.addEventListener('keydown', function(e) {
  // Keyboard shortcut
  handleKeyboardShortcut(e);

  // Validate on Enter
  if (e.key === 'Enter') {
  if (e.target.matches('[data-validate-image="true"]')) {
  validateImage(e.target);
  }
  if (e.target.matches('[data-validate-font="true"]')) {
  validateFont(e.target);
  }
  }
  });

  // Refetch fonts when window regains focus
  window.addEventListener('focus', async function() {
  await fetchAvailableFonts();
  setupFontValidation();
  });

  // Clear flag on form submission (BEFORE Turbo processes it)
  document.addEventListener('turbo:submit-start', function(e) {
  if (e.target.id === 'config-form') {
  window.hasUnsavedChanges = false;
  }
  });

  // Live-update the "Feed: /podcast/<key>.xml" hint as the user edits
  // a podcast key input. Sanitizes the value the same way formToYaml
  // will on save, so what they see is what they'll get.
  document.querySelectorAll('[data-podcast-key]').forEach(input => {
    const oldKey = input.dataset.podcastKey;
    const feedSpan = document.querySelector(`[data-podcast-feed-key="${oldKey}"]`);
    if (!feedSpan) return;
    input.addEventListener('input', () => {
      const sanitized = sanitizePodcastKey(input.value);
      feedSpan.textContent = sanitized || oldKey;
      window.hasUnsavedChanges = true;
    });
  });

  window.configEditorSetupComplete = true;
  console.log('setupComplete set to true');
  }

  console.log('setupComplete at end:', window.configEditorSetupComplete);

  // Run on page load
  document.addEventListener('turbo:load', async function() {
  // Reset unsaved changes flag on new page load
  window.hasUnsavedChanges = false;
  window.isYamlView = false;
  window.yamlWasEdited = false;

  checkDependencies();

  // Restore scroll position after save
  const savedPosition = sessionStorage.getItem('configScrollPosition');
  if (savedPosition) {
  setTimeout(function() {
  window.scrollTo(0, parseInt(savedPosition));
  sessionStorage.removeItem('configScrollPosition');
  }, 0);
  }

  // Fetch available fonts first
  await fetchAvailableFonts();

  // Validate logo/favicon on page load if they have values
  const logoInput = document.querySelector('[data-config-field="logo"]');
  if (logoInput && logoInput.value.trim()) {
  validateImage(logoInput);
  }

  const faviconInput = document.querySelector('[data-config-field="favicon"]');
  if (faviconInput && faviconInput.value.trim()) {
  validateImage(faviconInput);
  }

  // Setup font validation
  setupFontValidation();

  // Set up form submission handler (only if form exists)
  const configForm = document.getElementById('config-form');
  if (configForm) {
  configForm.removeEventListener('submit', handleFormSubmit);
  configForm.addEventListener('submit', handleFormSubmit);
  }

  // Load view preference LAST (after form is ready)
  setTimeout(function() {
  loadViewPreference();
  }, 0);
  });

  // Form submit handler (defined outside to allow removal)
  function handleFormSubmit(e) {
    const finalYaml = window.isYamlView
      ? document.getElementById('config-yaml').value
      : formToYaml();

    console.log('📤 Submitting YAML:', finalYaml);
    document.getElementById('config-final').value = finalYaml;

    // Save scroll position
    sessionStorage.setItem('configScrollPosition', window.scrollY);

    // Clear unsaved changes flag before submit
    window.hasUnsavedChanges = false;
  }

  function formatYamlValue(value) {
    if (value === null || value === undefined) {
      return '""';
    }

    const strValue = String(value);

    if (strValue === "") {
      return '""';
    }

    // Numbers (not quoted)
    if (!isNaN(strValue) && strValue.trim() !== "") {
      return strValue;
    }

    // Booleans (not quoted)
    if (strValue === "true" || strValue === "false") {
      return strValue;
    }

    // Flow-style numeric arrays like "[5, 10, 20, 50]" — emit unquoted
    // so YAML parses them as a real Array. Without this they'd be saved
    // as a literal string and any consumer would have to re-parse.
    if (/^\[\s*\d+(\.\d+)?(\s*,\s*\d+(\.\d+)?)*\s*\]$/.test(strValue.trim())) {
      return strValue.trim();
    }

    // Multi-line strings (block scalar)
    if (strValue.includes('\n')) {
      return null; // Signal to use block scalar format
    }

    // All other strings (quoted and escaped)
    return `"${strValue.replace(/"/g, '\\"')}"`;
  }

  function formToYaml() {
    const fields = {};

    document.querySelectorAll('[data-config-field]').forEach(input => {
      const fieldName = input.dataset.configField;
      let value;

      // Handle checkboxes specially
      if (input.type === 'checkbox') {
        value = input.checked ? 'true' : 'false';
      } else {
        value = input.value;
      }

      // Handle nested fields (fonts.heading.family OR post-link.default_link_text)
      const parts = fieldName.split('.');
      if (parts.length > 1) {
        let current = fields;
        for (let i = 0; i < parts.length - 1; i++) {
          if (!current[parts[i]]) {
            current[parts[i]] = {};
          }
          current = current[parts[i]];
        }
        current[parts[parts.length - 1]] = value.trim ? value.trim() : value;
      } else {
        fields[fieldName] = value.trim ? value.trim() : value;
      }
    });

    // Collect multi-value checkbox groups (e.g. themes) as arrays.
    // Each checkbox shares the same data-config-multi-field name; checked
    // values are aggregated into an array at that key. Always writes the
    // key (empty array when nothing is checked) so unchecking persists.
    const multiFieldNames = new Set();
    document.querySelectorAll('[data-config-multi-field]').forEach(input => {
      multiFieldNames.add(input.dataset.configMultiField);
    });
    multiFieldNames.forEach(name => {
      const values = [];
      document.querySelectorAll(`[data-config-multi-field="${name}"]`).forEach(input => {
        if (input.checked) values.push(input.value);
      });
      fields[name] = values;
    });

    // Collect subcategories as arrays
    console.log('🔍 Looking for subcategory selects...');
    const subcatSelects = document.querySelectorAll('[data-subcategory-for]');
    console.log(`Found ${subcatSelects.length} subcategory selects`);

    subcatSelects.forEach(select => {
      const podcastKey = select.dataset.subcategoryFor;
      const subcategoryField = select.dataset.subcategoryField;
      const value = select.value.trim();

      console.log('Subcategory select:', { podcastKey, subcategoryField, value, element: select });

      if (value) {
        if (!fields[podcastKey]) fields[podcastKey] = {};
        if (!fields[podcastKey][subcategoryField]) {
          fields[podcastKey][subcategoryField] = [];
        }
        fields[podcastKey][subcategoryField].push(value);
      }
    });

    // Podcast-key renames: if the user edited the key input for any
    // podcast block, rebuild `fields` with the new key in place of the
    // original. Done after the field/subcategory loops so any data
    // attached under the old key gets carried over.
    document.querySelectorAll('[data-podcast-key]').forEach(input => {
      const oldKey = input.dataset.podcastKey;
      const newKey = sanitizePodcastKey(input.value);
      if (newKey && newKey !== oldKey && fields[oldKey] !== undefined) {
        // Rebuild to preserve order (Object.fromEntries with map keeps
        // insertion order — important so the file diff stays stable).
        const renamed = {};
        Object.entries(fields).forEach(([k, v]) => {
          renamed[k === oldKey ? newKey : k] = v;
        });
        // Replace fields contents in place.
        Object.keys(fields).forEach(k => delete fields[k]);
        Object.assign(fields, renamed);
      }
    });

    return simpleYamlStringify(fields, 0);
  }

  function sanitizePodcastKey(value) {
    return (value || '').toString().trim().toLowerCase()
      .replace(/[^a-z0-9-]+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-|-$/g, '');
  }

  function simpleYamlStringify(obj, indent) {
    let yaml = '';
    const spaces = '  '.repeat(indent);
    const configType = '<%= @config_type %>';
    const yamlOperator = (configType === 'store') ? '|' : '|-';

    for (const [key, value] of Object.entries(obj)) {
      // CHECK ARRAYS FIRST (before objects)
      if (Array.isArray(value)) {
        if (value.length === 0) {
          yaml += `${spaces}${key}: []\n`;
        } else {
          const quotedValues = value.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
          yaml += `${spaces}${key}: [${quotedValues.join(', ')}]\n`;
        }
      } else if (typeof value === 'object' && value !== null) {
        // Nested object (like podcast configs)
        yaml += `${spaces}${key}:\n`;

        const nestedEntries = Object.entries(value);

        nestedEntries.forEach(([nestedKey, nestedValue]) => {
          // Skip subcategory fields - they'll be output after their parent category
          if (nestedKey === 'subcategory' || nestedKey === 'subcategory_2') {
            return;
          }

          // Output the field
          if (Array.isArray(nestedValue)) {
            if (nestedValue.length === 0) {
              yaml += `${spaces}  ${nestedKey}: []\n`;
            } else {
              const quotedValues = nestedValue.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
              yaml += `${spaces}  ${nestedKey}: [${quotedValues.join(', ')}]\n`;
            }
          } else if (typeof nestedValue === 'object' && nestedValue !== null) {
            yaml += simpleYamlStringify({ [nestedKey]: nestedValue }, indent + 1);
          } else {
            const formattedValue = formatYamlValue(nestedValue);
            if (formattedValue === null) {
              yaml += `${spaces}  ${nestedKey}: ${yamlOperator}\n`;
              const lines = String(nestedValue).split('\n');
              lines.forEach(line => {
                yaml += `${spaces}    ${line}\n`;
              });
            } else {
              yaml += `${spaces}  ${nestedKey}: ${formattedValue}\n`;
            }
          }

          // After category, immediately output subcategory if it exists
          if (nestedKey === 'category' && value['subcategory']) {
            const subcats = value['subcategory'];
            if (Array.isArray(subcats) && subcats.length > 0) {
              const quotedValues = subcats.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
              yaml += `${spaces}  subcategory: [${quotedValues.join(', ')}]\n`;
            }
          }

          // After category_2, immediately output subcategory_2 if it exists
          if (nestedKey === 'category_2' && value['subcategory_2']) {
            const subcats = value['subcategory_2'];
            if (Array.isArray(subcats) && subcats.length > 0) {
              const quotedValues = subcats.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
              yaml += `${spaces}  subcategory_2: [${quotedValues.join(', ')}]\n`;
            }
          }
        });
      } else {
        // Format the value
        const formattedValue = formatYamlValue(value);

        if (formattedValue === null) {
          yaml += `${spaces}${key}: ${yamlOperator}\n`;
          const lines = String(value).split('\n');
          lines.forEach(line => {
            yaml += `${spaces}  ${line}\n`;
          });
        } else {
          yaml += `${spaces}${key}: ${formattedValue}\n`;
        }
      }
    }

    return yaml;
  }

  function yamlToForm(yamlText) {

  // Just validate it's parseable
  const lines = yamlText.split('\n');
