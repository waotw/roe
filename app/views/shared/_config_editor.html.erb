<%
  # Prefer the config_hash the controller passed in (it may have been
  # mutated server-side — e.g. edit_podcast auto-seeds audience: '' when
  # payments are enabled). Fall back to parsing config_content only when
  # no hash was provided.
  config_hash = local_assigns[:config_hash]
  if config_hash.nil?
    begin
      config_hash = YAML.safe_load(config_content, permitted_classes: [Date, Time, Symbol]) || {}
    rescue
      config_hash = {}
    end
  end

  # Flatten nested structures so a field named "docs.roe" can look up its
  # current value, matching the dotted names the schema uses.
  #
  # This used to name each nestable key explicitly — fonts, theme,
  # grouped_products, snipcart, search — and anything absent from that list
  # fell through to the else branch and stayed a Hash. So a new nested setting
  # rendered with no value: the select fell back to its "Select..." placeholder
  # every time, including straight after a successful save, which reads exactly
  # like the save being ignored. `docs.roe` was the one that hit it.
  #
  # formToYaml() below already splits dotted names generically when writing, so
  # the allowlist meant reading and writing disagreed about which settings could
  # nest. Doing the same thing generically here keeps them in step and means the
  # next nested setting needs no change at all.
  #
  # Two levels covers everything in use (fonts.heading.family is the deepest).
  # The unflattened key is kept alongside so anything reading a whole hash is
  # unaffected.
  flattened_config = {}

  config_hash.each do |key, value|
    flattened_config[key] = value
    next unless value.is_a?(Hash)

    value.each do |sub_key, sub_value|
      if sub_value.is_a?(Hash)
        sub_value.each { |leaf, leaf_value| flattened_config["#{key}.#{sub_key}.#{leaf}"] = leaf_value }
      else
        flattened_config["#{key}.#{sub_key}"] = sub_value
      end
    end
  end
%>

<div id="config-container" class="mb-5 bg-white p-8 border border-gray-200"
     data-controller="config-focus<%= ' podcast-entries' if @config_type == 'podcast' %>"
     <% if @config_type == 'podcast' %>data-podcast-entries-add-path-value="<%= add_podcast_admin_configs_path %>"<% end %>>
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center gap-3">
      <!--<h2 class="text-lg font-semibold text-gray-900">Configuration</h2>-->
      <h2 class="text-xl font-semibold text-gray-900">
        <% if @config_type == 'members' %>
          Payments, newsletter & paid content
        <% elsif @config_type == 'podcast' %>
          Podcasts
        <% else %>
          <%= @config_type.capitalize %>
        <% end %>
      </h2>
      <%# Add a fresh blank podcast entry to podcast.yml (podcast config only). %>
      <%# Client-side — appends a blank show to the form. Nothing is written
          until Save, so adding one no longer discards unsaved edits. %>
      <% if @config_type == 'podcast' %>
        <button type="button"
                data-action="podcast-entries#add"
                class="uppercase text-xs px-1.5 py-0 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono h-4.5 rounded-xs leading-none pt-[0.1rem] cursor-pointer">
          ADD NEW
        </button>
        <span class="text-xs text-gray-500">Saved when you click Save.</span>
      <% end %>
    </div>
    <button type="button"
            onclick="toggleConfigView()"
            class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none pt-[0.1rem]"
            id="config-toggle">
      EDIT YAML
    </button>
  </div>

  <%= form_with url: form_url, method: :patch, id: "config-form", class: "space-y-6" do |form| %>

    <!-- Form View -->
    <div id="config-form-view">

      <div class="config-section mb-8">
              <% if @config_type == 'site' %>
                <!-- Site Information Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Global</h3>

                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:site_info][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

                <!-- Branding Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Branding</h3>

                  <div class="mb-3 flex gap-2 items-center">
                    <p class="text-base font-medium text-gray-700">Manage:</p>
                    <%= link_to "GLOBAL IMAGES", browse_images_admin_system_assets_path,
                      target: "_blank",
                      class: "uppercase text-sm px-1.5 py-1.5 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none" %>
                  </div>

                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:branding][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                    <%# Advisory ratio warning computed in edit_site —
                        the saved social image isn't ~1.91:1. Never
                        blocks a save; just nudges toward 1200×630. %>
                    <% if @social_image_warning.present? %>
                      <div class="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-xs p-2">
                        <%= @social_image_warning %>
                      </div>
                    <% end %>
                  </div>
                </div>

                <!-- Theme Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Theme</h3>
                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% theme_active = flattened_config['theme.active'] %>
                    <div class="config-field-row">
                      <label class="block text-sm font-medium text-gray-700 mb-1">
                        Active Theme
                      </label>
                      <select name="config_fields[theme][active]"
                              class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                              data-config-field="theme.active">
                        <option value="">Select...</option>
                        <%# Prefer the dynamically-populated `available_themes`
                            local (passed in by edit_site / edit_fonts) so
                            user-installed themes like roe-site show up.
                            Falls back to the schema's hardcoded options when
                            the partial is rendered from a context that
                            doesn't supply available_themes. %>
                        <% theme_options = (local_assigns[:available_themes].presence) ||
                                           config_schema.dig(:theme, :fields, 'active', :options) ||
                                           [] %>
                        <% theme_options.each do |option| %>
                          <option value="<%= option %>"<% if theme_active == option %> selected<% end %>><%= option %></option>
                        <% end %>
                      </select>
                      <p class="text-xs text-gray-500 mt-1">Select the theme for your site</p>
                    </div>
                  </div>
                </div>

                <!-- Site Sync Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Site Sync</h3>
                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:site_sync][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

                <!-- Updates Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Updates</h3>
                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:updates][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

                <!-- Static Site Generation Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Static Site Settings</h3>

                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:static_generation][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                    <%= link_to "Static Site Actions", admin_static_site_path,
                          class: "uppercase text-sm font-normal px-1.5 py-1 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none" %>
                  </div>
                </div>

              <% elsif @config_type == 'security' %>
                <% [ :rate_limiting, :ai_crawlers, :limits ].each do |section| %>
                  <div class="config-section mb-10">
                    <h3 class="text-base font-semibold text-gray-900 mb-1"><%= config_schema[section][:label] %></h3>
                    <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                      <%# A site with no security.yml yet is still rate limited —
                          RateLimits falls back to its defaults. Show those, so
                          the form reports what's running rather than blanks. %>
                      <% config_schema[section][:fields].each do |field_name, field_config| %>
                        <%= render 'shared/config_field',
                                 field_name: field_name,
                                 field_config: field_config,
                                 value: security_field_value(flattened_config, field_name),
                                 all_values: flattened_config %>
                      <% end %>
                      <% if section == :ai_crawlers %>
                        <p class="text-xs text-gray-500">
                          Preview it at <%= link_to "/robots.txt", "/robots.txt", target: "_blank", rel: "noopener", class: "underline" %>.
                        </p>
                      <% end %>
                    </div>
                  </div>
                <% end %>

              <% elsif @config_type == 'content' %>
                <!-- Content Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1"><%= config_schema[:content][:label] %></h3>
                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:content][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

                <!-- Search Section -->
                <div class="config-section mb-10">
                  <h3 class="text-base font-semibold text-gray-900 mb-1"><%= config_schema[:search][:label] %></h3>
                  <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                    <% config_schema[:search][:fields].each do |field_name, field_config| %>
                      <%= render 'shared/config_field',
                               field_name: field_name,
                               field_config: field_config,
                               value: flattened_config[field_name],
                               all_values: flattened_config %>
                    <% end %>
                  </div>
                </div>

              <% elsif @config_type == 'fonts' %>
                <!-- Themes Section -->
                <div class="config-section mb-8">
                  <h3 class="text-base font-semibold text-gray-900 mb-1">Themes</h3>
                  <p class="text-sm text-gray-600 mb-3">Themes that should load these fonts.<br> Leave all unchecked to disable custom fonts.</p>
                  <% selected_themes = Array(config_hash['themes']) %>
                  <div class="space-y-1 pl-4 border-l-2 border-gray-200">
                    <% (local_assigns[:available_themes] || []).each do |theme_name| %>
                      <label class="flex items-center gap-2 text-sm font-mono">
                        <input type="checkbox"
                               value="<%= theme_name %>"
                               data-config-multi-field="themes"
                               <%= 'checked' if selected_themes.include?(theme_name) %>>
                        <span><%= theme_name %></span>
                      </label>
                    <% end %>
                    <% if (local_assigns[:available_themes] || []).empty? %>
                      <p class="text-xs text-gray-500 italic">No themes found in app/themes/ or site/theme/.</p>
                    <% end %>
                  </div>
                </div>

                <!-- Custom Fonts Section -->
                <h3 class="text-base font-semibold text-gray-900 mb-1">Custom Fonts</h3>
                <p class="text-sm text-gray-600 mb-3">Upload font files with the FONTS button. Copy the url…</p>

                <div class="mb-3 flex gap-2 items-center">
                  <p class="text-base font-medium text-gray-700">Manage:</p>
                  <%= link_to "Fonts", browse_fonts_admin_system_assets_path,
                      target: "_blank",
                      class: "uppercase text-sm px-1.5 py-0.5 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none pt-[0.2rem]" %>
                </div>

                <%# Check if any fonts are installed %>
                <% fonts_installed = Dir.glob(File.join(RoeSitePaths::SITE_PATH, 'system/assets/fonts/*')).any? %>
                <% if !fonts_installed %>
                  <div class="mb-4 p-4 bg-amber-50 border border-amber-200 rounded-xs">
                    <p class="text-sm text-amber-800">
                      <strong>No fonts installed yet.</strong>
                      <%= link_to "Upload font files", browse_fonts_admin_system_assets_path, target: "_blank", class: "underline" %>
                      to use custom fonts.
                    </p>
                  </div>
                <% end %>

                <div class="space-y-3 pl-4 border-l-2 border-gray-200">
                  <%= render 'shared/config_font_roles',
                                               roles: config_schema[:fonts][:roles],
                                               config_hash: config_hash,
                                               flattened_config: flattened_config,
                                               custom_family_variants: config_schema[:fonts][:custom_family_variants] %>
                </div>

                <% elsif @config_type == 'store' %>
                  <!-- Store Configuration -->

                  <!-- Enabled Field -->
                  <div class="config-section mb-8">
                    <h3 class="text-base font-semibold text-gray-900 mb-3">Store</h3>
                    <div class="space-y-4 pl-4 border-l-2 border-gray-200">

                      <!-- Enabled -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Enabled
                        </label>
                        <div class="flex items-center gap-2">
                          <select name="config_fields[enabled]"
                                  class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                  data-config-field="enabled"
                                  onchange="updateBooleanFieldIndicators()">
                            <option value="true"<% if flattened_config['enabled'] == true || flattened_config['enabled'] == 'true' %> selected<% end %>>true</option>
                            <option value="false"<% if flattened_config['enabled'] == false || flattened_config['enabled'] == 'false' %> selected<% end %>>false</option>
                          </select>
                          <span class="boolean-indicator inline-flex items-center justify-center w-3 h-3 rounded-full"
                                data-field="enabled"
                                data-value="<%= flattened_config['enabled'] %>"></span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Enable or disable the store feature</p>
                      </div>

                      <!-- Currency -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Currency
                        </label>
                        <select name="config_fields[currency]"
                                class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="currency">
                          <% current_currency = flattened_config['currency'] || 'usd' %>
                          <option value="usd"<% if current_currency == 'usd' %> selected<% end %>>USD - US Dollar</option>
                          <option value="eur"<% if current_currency == 'eur' %> selected<% end %>>EUR - Euro</option>
                          <option value="gbp"<% if current_currency == 'gbp' %> selected<% end %>>GBP - British Pound</option>
                          <option value="cad"<% if current_currency == 'cad' %> selected<% end %>>CAD - Canadian Dollar</option>
                          <option value="aud"<% if current_currency == 'aud' %> selected<% end %>>AUD - Australian Dollar</option>
                          <option value="jpy"<% if current_currency == 'jpy' %> selected<% end %>>JPY - Japanese Yen</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">Default currency for your store</p>
                      </div>

                      <!-- Default Domain -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Default Domain
                        </label>
                        <input type="text"
                               name="config_fields[default_domain]"
                               value="<%= flattened_config['default_domain'] %>"
                               placeholder="yourdomain.com"
                               class="w-full font-mono text-sm px-2 py-1.5 border border-gray-300"
                               data-config-field="default_domain">
                        <p class="text-xs text-gray-500 mt-1">Domain used for Snipcart order validation</p>
                      </div>

                      <!-- Product Categories -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Product Categories
                        </label>
                        <input type="text"
                               name="config_fields[product_categories]"
                               value="<%= (flattened_config['product_categories'].is_a?(Array) ? flattened_config['product_categories'].join(', ') : flattened_config['product_categories'].to_s) %>"
                               placeholder="book, ebook, poster, tshirt"
                               class="w-full font-mono text-sm px-2 py-1.5 border border-gray-300"
                               data-config-field="product_categories"
                               data-config-csv-array="true">
                        <p class="text-xs text-gray-500 mt-1">Comma-separated list of product categories for organization and SKU generation</p>
                      </div>

                      <!-- Product Groups (read-only) — unlike categories, groups
                           are authored in product front-matter; this list is
                           populated automatically as products are grouped and is
                           shown for reference only. -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Product Groups
                        </label>
                        <% groups = (ProductGroup.all rescue []) %>
                        <% if groups.any? %>
                          <div class="flex flex-wrap gap-1.5">
                            <% groups.each do |g| %>
                              <span class="inline-flex items-center bg-gray-100 px-2 py-0.5 text-xs font-mono text-gray-700"><%= g %></span>
                            <% end %>
                          </div>
                        <% else %>
                          <p class="text-sm text-gray-400 font-mono">No groups yet.</p>
                        <% end %>
                        <p class="text-xs text-gray-500 mt-1">Group names in product metadata</p>
                      </div>

                      <!-- Product Button Template -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Product Page & Button Template
                        </label>
                        <textarea name="config_fields[product_button_template]"
                                  rows="12"
                                  placeholder="![Add Image Description](@image)&#10;&#10;# @title&#10;&#10;**Price:** @price&#10;&#10;@description&#10;&#10;```button&#10;sku: @sku&#10;text: Add to Cart&#10;style: primary&#10;```"
                                  class="w-full font-mono text-xs px-2 py-1.5 border border-gray-300"
                                  data-config-field="product_button_template"><%= flattened_config['product_button_template'] %></textarea>
                        <p class="text-xs text-gray-500 mt-1">
                          Template used when inserting products via PRODUCT button in editor.
                          Use placeholders: @image, @title, @price, @description, @sku
                        </p>
                      </div>

                    </div>
                  </div>

                  <!-- Grouped Products Section -->
                  <div class="config-section mb-8">
                    <h3 class="text-base font-semibold text-gray-900 mb-3">Grouped Products</h3>
                    <div class="space-y-4 pl-4 border-l-2 border-gray-200">

                      <!-- Button Text -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Button Text
                        </label>
                        <input type="text"
                               name="config_fields[grouped_products][button_text]"
                               value="<%= flattened_config['grouped_products.button_text'] %>"
                               placeholder="View"
                               class="w-48 font-mono text-sm px-2 py-1.5 border border-gray-300"
                               data-config-field="grouped_products.button_text">
                        <p class="text-xs text-gray-500 mt-1">Text for grouped product buttons.</p>
                        <p class="text-xs text-gray-500 mt-1"> <mark class="bg-blue-200 rounded-xs px-0.5">Leave blank to disable button for grouped products in Collections.</mark></p>
                      </div>

                      <!-- Price Display -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Price Display
                        </label>
                        <select name="config_fields[grouped_products][price_display]"
                                class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="grouped_products.price_display">
                          <% current_price_display = flattened_config['grouped_products.price_display'] || 'range' %>
                          <option value="range"<% if current_price_display == 'range' %> selected<% end %>>range</option>
                          <option value="lowest"<% if current_price_display == 'lowest' %> selected<% end %>>lowest</option>
                          <option value="highest"<% if current_price_display == 'highest' %> selected<% end %>>highest</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">How to display prices for grouped products</p>
                      </div>

                      <!-- Price Separator -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Price Separator
                        </label>
                        <input type="text"
                               value="<%= flattened_config['grouped_products.price_separator'] || '-' %>"
                               class="w-24 font-mono text-sm px-2 py-1.5 border border-gray-300"
                               placeholder="-"
                               data-config-field="grouped_products.price_separator">
                        <p class="text-xs text-gray-500 mt-1">Separator between min and max price (e.g. <code class="font-mono">-</code> <code class="font-mono">&ndash;</code> <code class="font-mono">/</code> <code class="font-mono">|</code>). Only used when Price Display is set to range.</p>
                      </div>

                    </div>
                  </div>

                  <!-- Snipcart Settings Section -->
                  <div class="config-section mb-8">
                    <h3 class="text-base font-semibold text-gray-900 mb-3">Snipcart</h3>
                    <div class="space-y-4 pl-4 border-l-2 border-gray-200">

                      <!-- Load Strategy -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Load Strategy
                        </label>
                        <select name="config_fields[snipcart][load_strategy]"
                                class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="snipcart.load_strategy">
                          <% current_load_strategy = flattened_config['snipcart.load_strategy'] || 'on-user-interaction' %>
                          <option value="on-user-interaction"<% if current_load_strategy == 'on-user-interaction' %> selected<% end %>>on-user-interaction</option>
                          <option value="manual"<% if current_load_strategy == 'manual' %> selected<% end %>>manual</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">How Snipcart JavaScript loads on your site</p>
                      </div>

                      <!-- Modal Style -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Modal Style
                        </label>
                        <select name="config_fields[snipcart][modal_style]"
                                class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                data-config-field="snipcart.modal_style">
                          <% current_modal_style = flattened_config['snipcart.modal_style'] || 'side' %>
                          <option value="side"<% if current_modal_style == 'side' %> selected<% end %>>side</option>
                          <option value="full"<% if current_modal_style == 'full' %> selected<% end %>>full</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">How the shopping cart displays</p>
                      </div>

                      <!-- Show Taxes -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Show Taxes
                        </label>
                        <div class="flex items-center gap-2">
                          <select name="config_fields[snipcart][show_taxes]"
                                  class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                  data-config-field="snipcart.show_taxes"
                                  onchange="updateBooleanFieldIndicators()">
                            <% current_show_taxes = flattened_config['snipcart.show_taxes'] %>
                            <option value="true"<% if current_show_taxes == true || current_show_taxes == 'true' %> selected<% end %>>true</option>
                            <option value="false"<% if current_show_taxes == false || current_show_taxes == 'false' %> selected<% end %>>false</option>
                          </select>
                          <span class="boolean-indicator inline-flex items-center justify-center w-3 h-3 rounded-full"
                                data-field="snipcart.show_taxes"
                                data-value="<%= current_show_taxes %>"></span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Display taxes in cart</p>
                      </div>

                      <!-- Show Quantity -->
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          Show Quantity
                        </label>
                        <div class="flex items-center gap-2">
                          <select name="config_fields[snipcart][show_quantity]"
                                  class="w-48 font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                  data-config-field="snipcart.show_quantity"
                                  onchange="updateBooleanFieldIndicators()">
                            <% current_show_quantity = flattened_config['snipcart.show_quantity'] %>
                            <option value="true"<% if current_show_quantity == true || current_show_quantity == 'true' %> selected<% end %>>true</option>
                            <option value="false"<% if current_show_quantity == false || current_show_quantity == 'false' %> selected<% end %>>false</option>
                          </select>
                          <span class="boolean-indicator inline-flex items-center justify-center w-3 h-3 rounded-full"
                                data-field="snipcart.show_quantity"
                                data-value="<%= current_show_quantity %>"></span>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">Allow quantity changes in cart</p>
                      </div>

                    </div>
                  </div>

                <% else %>
            <!-- SIMPLE KEY-VALUE EDITOR FOR CARDS/COLLECTIONS -->
            <div class="config-section mb-10">

              <%
                # Separate defaults from templates
                # Templates end with _button_template or are exactly "button_template"
                templates = config_hash.select { |k, v| k.to_s.end_with?('_button_template') || k.to_s == 'button_template' }
                defaults = config_hash.reject { |k, v| templates.key?(k) }

                # Optional `extra_field_defaults` (e.g. pagination_template
                # added in a later Roe release) — render the form field
                # with its default value when the YAML doesn't include the
                # key yet. Existing keys are never overwritten. The value
                # lands in the YAML only when the user clicks save.
                extras = local_assigns[:extra_field_defaults] || {}
                extras.each do |k, v|
                  defaults[k] = v unless defaults.key?(k)
                end
              %>

              <!-- Defaults Section -->
              <% if defaults.any? %>
                <div class="mb-8">
                  <% if @config_type != 'members' && @config_type != 'podcast' %>
                    <h3 class="text-base font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Defaults</h3>
                  <% end %>

                  <div class="space-y-6">
                    <%# Podcast configs get a tabbed layout (one tab per show).
                        The tabs controller remembers the last-opened tab in
                        localStorage, and ?tab=<key> — set by "Add new" — opens
                        that tab straight away. Podcast-only; every other config
                        type renders the flat list exactly as before. %>
                    <% if @config_type == 'podcast' %>
                      <div data-controller="tabs" data-tabs-remember-value="true" data-tabs-storage-key-value="podcast-config">
                        <nav class="flex flex-wrap gap-1 border-b border-gray-200 mb-6">
                          <% nav_idx = 0 %>
                          <% defaults.each do |nav_key, nav_value| %>
                            <% next unless nav_value.is_a?(Hash) %>
                            <% nav_idx += 1 %>
                            <% nav_title = nav_value['title'].to_s.strip.presence || ("Podcast %02d" % nav_idx) %>
                            <button type="button" data-tabs-target="tab" data-action="click->tabs#show" data-tabs-panel="<%= nav_key %>"
                                    class="py-2 px-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 whitespace-nowrap cursor-pointer"><%= nav_title %></button>
                          <% end %>
                        </nav>
                    <% end %>
                    <% podcast_index = 0 %>
                    <% defaults.each do |key, value| %>
                      <% if value.is_a?(Hash) %>
                        <% if @config_type == 'podcast' %>
                          <% podcast_index += 1 %>
                          <div data-tabs-target="panel" data-tabs-panel="<%= key %>" class="hidden">
                        <% end %>
                        <!-- Nested section (like post-link, aside, pullquote) -->
                        <div class="config-subsection pl-4 border-l-2 border-gray-300">
                          <% if @config_type == 'podcast' %>
                            <!-- Podcast key — editable. The data-podcast-key
                                 attribute holds the original; formToYaml
                                 renames the top-level YAML key on save when
                                 the input value differs. -->
                            <div class="config-field-row mb-4">
                              <label class="block text-sm font-medium text-gray-700 mb-1">
                                Podcast key<span class="text-red-600 ml-0.5">*</span>
                                <%= render 'shared/help_tooltip',
                                           title: 'Podcast key',
                                           text: ('DO NOT RENAME IF PODCAST IS PUBLISHED. Used in the feed URL (<code>/podcast/&lt;key&gt;.xml</code>) and in episode post metadata as <code>podcast:</code> which connects a podcast post to this podcast. ' \
                                                  'Renaming will <strong>break</strong> the connection in any existing podcast posts that reference this podcast — and break the exisitng feed. Any subscribers using the old feed will lose access.').html_safe %>
                              </label>
                              <input type="text"
                                     data-podcast-key="<%= key %>"
                                     value="<%= key %>"
                                     class="w-full font-mono text-sm p-2 border border-gray-300"
                                     placeholder="e.g., the-briefcase">
                              <p class="text-xs text-gray-500 mt-0.5">Feed: <code>/podcast/<span data-podcast-feed-key="<%= key %>"><%= key %></span>.xml</code></p>
                            </div>
                          <% else %>
                            <h4 class="text-sm font-semibold text-gray-800 mb-3"><%= (local_assigns[:section_labels]&.dig(key) || key.humanize) %></h4>
                          <% end %>

                          <div class="space-y-3">
                            <% subscribe_heading_shown = false %>
                            <% value.each do |subkey, subvalue| %>
                              <%
                                # Skip subcategory fields - they're dynamically managed
                                next if subkey == 'subcategory' || subkey == 'subcategory_secondary'
                              %>

                              <%# The subscribe fields are ordered last (display toggle
                                  first) by edit_podcast; draw one heading over them. %>
                              <% if @config_type == 'podcast' && !subscribe_heading_shown && defined?(PodcastConfig) && PodcastConfig::SUBSCRIBE_FIELDS.include?(subkey) %>
                                <% subscribe_heading_shown = true %>
                                <h4 class="text-sm font-semibold text-gray-800 mt-6 mb-3 pt-4 border-t border-gray-200">Subscribe Links</h4>
                              <% end %>

                              <% nested_field_key = "#{key}.#{subkey}" %>
                              <% help_key = @field_help&.key?(nested_field_key) ? nested_field_key : (@field_help&.key?(subkey) ? subkey : nil) %>
                              <% field_required = @field_required&.include?(subkey) || @field_required&.include?(nested_field_key) %>

                              <div class="config-field-row">
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                  <%= subkey.humanize %><% if field_required %><span class="text-red-600 ml-0.5">*</span><% end %>
                                  <% if help_key %>
                                    <%= render 'shared/help_tooltip',
                                               text: @field_help[help_key][:text],
                                               title: @field_help[help_key][:title] %>
                                  <% end %>
                                </label>

                                <%
                                  # Skip subcategory fields - they're dynamically managed
                                  next if subkey == 'subcategory' || subkey == 'subcategory_secondary'
                                %>

                                <% field_options_key = @field_options&.key?(nested_field_key) ? nested_field_key : subkey %>
                                <%# An on/off setting that reads as on/off. Everything else here is a
                                    two-option select, which is fine for a genuine choice (memberships
                                    vs donations) but makes a plain yes/no look like a decision. A
                                    checkbox writes true/false through formToYaml's existing checkbox
                                    branch, so the YAML is identical either way. %>
                                <% if @field_checkboxes&.include?(nested_field_key) %>
                                  <%# No caption beside it — the field's own label is already
                                      rendered above, the same as every other control here. %>
                                  <input type="checkbox"
                                         name="config_fields[<%= key %>][<%= subkey %>]"
                                         value="true"
                                         class="w-4 h-4"
                                         data-config-field="<%= nested_field_key %>"
                                         <%= 'checked' if subvalue.to_s == 'true' %>>
                                <% elsif @field_options&.key?(field_options_key) %>
                                  <!-- Select dropdown (no extra wrapper/label) -->
                                  <select name="config_fields[<%= key %>][<%= subkey %>]"
                                          class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                          data-config-field="<%= nested_field_key %>">
                                    <% @field_options[field_options_key].each do |option| %>
                                      <% display_text = option.blank? ? '-- select --' : option %>
                                      <option value="<%= option %>"<% if subvalue.to_s == option.to_s %> selected<% end %>><%= display_text %></option>
                                    <% end %>
                                  </select>

                                  <%# Add subcategory container after primary category %>
                                  <% if subkey == 'category' %>
                                    <div class="category-subcategories mt-2"
                                         data-podcast-key="<%= key %>"
                                         data-category-type="primary">
                                      <!-- Subcategories added here by JS -->
                                    </div>
                                  <% end %>

                                  <%# Add subcategory container after secondary category %>
                                  <% if subkey == 'category_secondary' %>
                                    <div class="category-subcategories mt-2"
                                         data-podcast-key="<%= key %>"
                                         data-category-type="secondary">
                                      <!-- Subcategories added here by JS -->
                                    </div>
                                  <% end %>
                                <% elsif @config_type == 'podcast' && subkey == 'artwork' %>
                                  <%# Image-upload Stimulus widget in verify-only
                                      mode. show_upload: false hides the inline
                                      Upload button because podcast artwork is
                                      uploaded via the "GLOBAL IMAGES" link
                                      rendered beside this field (browse_url:),
                                      which opens browse_images in a new tab —
                                      the user can upload there without losing
                                      their form state and copy the filename
                                      back into this input. The verify-on-blur
                                      behaviour stays on, so a typo'd filename
                                      shows the inline warning.

                                      flex-1 min-w-0 (not w-full) on the input
                                      so the inline GLOBAL IMAGES button can
                                      sit beside it without getting pushed
                                      off-row. %>
                                  <%= render "shared/image_upload_field",
                                             name: "config_fields[#{key}][#{subkey}]",
                                             value: subvalue,
                                             placeholder: "podcast-artwork.jpg",
                                             show_upload: false,
                                             browse_url: browse_images_admin_system_assets_path,
                                             input_class: "flex-1 min-w-0 font-mono text-sm p-2 border border-gray-300",
                                             extra_input_data: { "config-field" => nested_field_key } %>
                                <% else %>
                                  <!-- Regular text input for nested field -->
                                  <input type="text"
                                         name="config_fields[<%= key %>][<%= subkey %>]"
                                         value="<%= subvalue %>"
                                         class="w-full font-mono text-sm p-2 border border-gray-300"
                                         data-config-field="<%= nested_field_key %>">
                                <% end %>
                                <!-- Add hint text here ↓ -->
                                <% if @field_hints&.key?(nested_field_key) %>
                                  <p class="text-xs text-gray-500 mt-1"><%= config_hint(@field_hints[nested_field_key]) %></p>
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                        <% if @config_type == 'podcast' %></div><% end %>

                      <% else %>
                        <!-- Top-level field -->
                        <div class="config-field-row">
                          <label class="block text-sm font-medium text-gray-700 mb-1">
                            <%= key.humanize %>
                            <% if @field_help&.key?(key) %>
                              <%= render 'shared/help_tooltip',
                                         text: @field_help[key][:text],
                                         title: @field_help[key][:title] %>
                            <% end %>
                          </label>

                          <% if @field_options&.key?(key) %>
                            <!-- Select dropdown for field with options -->
                            <select name="config_fields[<%= key %>]"
                                    class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
                                    data-config-field="<%= key %>">
                              <% @field_options[key].each do |option| %>
                                <option value="<%= option %>"<% if value.to_s == option.to_s %> selected<% end %>><%= option %></option>
                              <% end %>
                            </select>
                          <% else %>
                            <!-- Regular text input -->
                            <input type="text"
                                   name="config_fields[<%= key %>]"
                                   value="<%= value %>"
                                   class="w-full font-mono text-sm p-2 border border-gray-300"
                                   data-config-field="<%= key %>">
                          <% end %>

                          <% if key == 'default_limit' %>
                            <p class="text-xs text-gray-500 mt-1">Use a number (e.g., 10) or "all" to show everything</p>
                          <% end %>
                          <% if key == 'items_per_page' %>
                            <p class="text-xs text-gray-500 mt-1">If <code class="font-mono text-xs">show_more = true</code> this sets the number of items for pagination.</p>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                    <% if @config_type == 'podcast' %></div><% end %>
                  </div>
                </div>
              <% end %>

              <%# Retired settings (the old button templates) are excluded from
                  `defaults` above so they don't render as editable fields. The
                  notice explaining them is rendered by edit.html.erb, outside
                  this form — its Cleanup button is a button_to, and a form
                  nested inside another form is invalid HTML that the browser
                  silently drops. %>

            </div>
          <% end %>
      </div>

    </div>

    <!-- Raw YAML View -->
    <div id="config-yaml-view" class="hidden">
      <%= form.text_area :content,
                         value: config_content,
                         id: "config-yaml",
                         class: "w-full font-mono text-sm p-2 border border-gray-300 bg-gray-50",
                         rows: 25 %>
    </div>

    <div class="h-6"></div>

    <!-- Hidden field to store final config YAML -->
    <%= form.hidden_field :content, id: "config-final", value: "" %>

    <div class="flex items-center gap-3 p-4 border border-gray-400 fixed bottom-8 right-12 bg-white">
      <%= form.submit "Save",
                      class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer" %>
      <%= link_to "Cancel", admin_configs_path,
                  class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
    </div>
  <% end %>
</div>

<script>
  // Global flags (outside IIFE so it persists)
  window.configEditorSetupComplete = window.configEditorSetupComplete || false;
  window.yamlWasEdited = window.yamlWasEdited || false;
  window.isYamlView = window.isYamlView || false;
  window.hasUnsavedChanges = window.hasUnsavedChanges || false;

  (function() {
  const configSchema = <%= raw (defined?(config_schema) ? config_schema.to_json : '{}') %>;
  let imageFieldsWithErrors = {};
  let fontFieldsWithErrors = {};
  let availableFonts = [];

  // Fetch available fonts on page load
  async function fetchAvailableFonts() {
  try {
  const response = await fetch('<%= available_fonts_admin_system_assets_path %>');
  const data = await response.json();
  availableFonts = data.fonts || [];
  } catch (error) {
  console.error('Failed to fetch available fonts:', error);
  }
  }

  // Load saved view preference
  function loadViewPreference() {
  const savedView = sessionStorage.getItem('configViewMode');
  console.log('Loading view preference:', savedView); // Debug

  // Only toggle if we're NOT already in the saved view
  if (savedView === 'yaml' && !window.isYamlView) {
  toggleConfigView();
  } else if (savedView === 'form' && window.isYamlView) {
  toggleConfigView();
  }
  }

  // Save view preference
  function saveViewPreference(mode) {
  sessionStorage.setItem('configViewMode', mode);
  }

  function toggleConfigView() {
  const formView = document.getElementById('config-form-view');
  const yamlView = document.getElementById('config-yaml-view');
  const toggleBtn = document.getElementById('config-toggle');
  const yamlTextarea = document.getElementById('config-yaml');

  console.log('Toggle attempt - isYamlView:', window.isYamlView, 'yamlWasEdited:', window.yamlWasEdited); // Add this

  // Prevent switching back to form if YAML was edited
  if (window.isYamlView && window.yamlWasEdited) {
  alert('YAML has been edited. Please save your changes first. The page will refresh and you can use the form view again.');
  return;
  }

  window.isYamlView = !window.isYamlView;

  if (window.isYamlView) {
  const yamlContent = formToYaml();
  yamlTextarea.value = yamlContent;
  window.yamlWasEdited = false; // Reset since we just generated it from form

  formView.classList.add('hidden');
  yamlView.classList.remove('hidden');
  toggleBtn.textContent = 'EDIT IN FORM';
  saveViewPreference('yaml');
  } else {
  formView.classList.remove('hidden');
  yamlView.classList.add('hidden');
  toggleBtn.textContent = 'EDIT YAML';
  saveViewPreference('form');
  }
  }

  // Track changes in form
  function trackChanges() {
  window.hasUnsavedChanges = true;
  }

  // Check field dependencies in real-time
  function checkDependencies() {
    console.log('checkDependencies called');
    document.querySelectorAll('[data-depends-on]').forEach(field => {
      const dependsOn = field.dataset.dependsOn;
      console.log('Field depends on:', dependsOn);
      const dependencyField = document.querySelector('[data-config-field="' + dependsOn + '"]');
      console.log('Dependency field found:', dependencyField);

      if (dependencyField) {
        const hasValue = dependencyField.value.trim() !== '';
        field.disabled = !hasValue;

        // Uncheck checkboxes when their dependencyVisual indication
        const wrapper = field.closest('.config-field-row');
        if (wrapper) {
          if (hasValue) {
            wrapper.classList.remove('opacity-50');
          } else {
