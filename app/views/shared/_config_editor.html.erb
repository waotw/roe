<%
  # Parse existing YAML into hash
  begin
    config_hash = YAML.safe_load(config_content, permitted_classes: [Date, Time, Symbol]) || {}
  rescue
    config_hash = {}
  end

  # Flatten nested structures for easier form handling
  flattened_config = {}

  config_hash.each do |key, value|
    if key == 'fonts' && value.is_a?(Hash)
      # Fonts are 2 levels: fonts.heading.family
      value.each do |role, role_data|
        next unless role_data.is_a?(Hash)
        role_data.each do |variant, variant_value|
          flattened_config["fonts.#{role}.#{variant}"] = variant_value
        end
      end
    elsif key == 'theme' && value.is_a?(Hash)
      # Theme is 1 level: theme.active
      value.each do |field, field_value|
        flattened_config["theme.#{field}"] = field_value
      end
    else
      flattened_config[key] = value
    end
  end
%>

<div id="config-container" class="mb-5 bg-white p-8">
  <div class="flex items-center justify-between mb-2">
    <!--<h2 class="text-lg font-semibold text-gray-900">Configuration</h2>-->
    <h2 class="text-xl font-semibold text-gray-900"><%= @config_type.capitalize %></h2>
    <button type="button"
            onclick="toggleConfigView()"
            class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none pt-[0.1rem]"
            id="config-toggle">
      EDIT YAML
    </button>
  </div>

  <%= form_with url: form_url, method: :patch, id: "config-form", class: "space-y-6" do |form| %>

    <!-- Form View -->
    <div id="config-form-view">

      <div class="config-section mb-8">
        <% if @config_type == 'site' %>
          <!-- Site Information Section -->
          <div class="config-section mb-10">
            <h3 class="text-base font-semibold text-gray-900 mb-1">Global</h3>

            <div class="space-y-3 pl-4 border-l-2 border-gray-200">
              <% config_schema[:site_info][:fields].each do |field_name, field_config| %>
                <%= render 'shared/config_field',
                         field_name: field_name,
                         field_config: field_config,
                         value: flattened_config[field_name],
                         all_values: flattened_config %>
              <% end %>
            </div>
          </div>

          <!-- Branding Section -->
          <div class="config-section mb-10">
            <h3 class="text-base font-semibold text-gray-900 mb-1">Branding</h3>

            <div class="mb-3 flex gap-2 items-center">
              <p class="text-sm font-medium text-gray-700">Manage:</p>
              <%= link_to "Global Images", browse_images_admin_system_assets_path,
                target: "_blank",
                class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.2rem]" %>
            </div>

            <div class="space-y-3 pl-4 border-l-2 border-gray-200">
              <% config_schema[:branding][:fields].each do |field_name, field_config| %>
                <%= render 'shared/config_field',
                         field_name: field_name,
                         field_config: field_config,
                         value: flattened_config[field_name],
                         all_values: flattened_config %>
              <% end %>
            </div>
          </div>

          <!-- Theme Section -->
          <div class="config-section mb-10">
            <h3 class="text-base font-semibold text-gray-900 mb-1">Theme</h3>
            <div class="space-y-3 pl-4 border-l-2 border-gray-200">
              <% theme_active = flattened_config['theme.active'] %>
              <div class="config-field-row">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  Active Theme
                </label>
                <select name="config_fields[theme][active]"
                        class="w-full font-mono text-sm p-2 border border-gray-300"
                        data-config-field="theme.active">
                  <option value="">Select...</option>
                  <% theme_options = config_schema.dig(:theme, :fields, 'active', :options) || [] %>
                  <% theme_options.each do |option| %>
                    <option value="<%= option %>" <%= 'selected' if theme_active == option %>><%= option %></option>
                  <% end %>
                </select>
                <p class="text-xs text-gray-500 mt-1">Select the theme for your site</p>
              </div>
            </div>
          </div>

          <!-- Static Site Generation Section -->
          <div class="config-section mb-10">
            <h3 class="text-base font-semibold text-gray-900 mb-1"><%= link_to "Static Site Settings", admin_static_site_path,
                  class: "" %></h3>

            <div class="space-y-3 pl-4 border-l-2 border-gray-200">
              <% config_schema[:static_generation][:fields].each do |field_name, field_config| %>
                <%= render 'shared/config_field',
                         field_name: field_name,
                         field_config: field_config,
                         value: flattened_config[field_name],
                         all_values: flattened_config %>
              <% end %>
            </div>
          </div>

          <!-- Custom Fonts Section -->

          <h3 class="text-base font-semibold text-gray-900 mb-1">Custom Fonts</h3>
          <p class="text-sm text-gray-600 mb-3">Upload font files with the FONTS button. Copy the url…</p>

          <div class="mb-3 flex gap-2 items-center">
            <p class="text-sm font-medium text-gray-700">Manage:</p>
            <%= link_to "Fonts", browse_fonts_admin_system_assets_path,
                target: "_blank",
                class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.2rem]" %>
          </div>

          <div class="space-y-3 pl-4 border-l-2 border-gray-200">
            <%= render 'shared/config_font_roles',
                       roles: config_schema[:fonts][:roles],
                       config_hash: config_hash,
                       flattened_config: flattened_config %>
          </div>


          <% else %>
            <!-- SIMPLE KEY-VALUE EDITOR FOR CARDS/COLLECTIONS -->
            <div class="config-section mb-10">

              <%
                # Separate defaults from templates
                # Templates end with _button_template or are exactly "button_template"
                templates = config_hash.select { |k, v| k.to_s.end_with?('_button_template') || k.to_s == 'button_template' }
                defaults = config_hash.reject { |k, v| templates.key?(k) }
              %>

              <!-- Defaults Section -->
              <% if defaults.any? %>
                <div class="mb-8">
                  <h3 class="text-base font-semibold text-gray-800 mb-4 pb-2 border-b border-gray-200">Defaults</h3>

                  <div class="space-y-6">
                    <% defaults.each do |key, value| %>
                      <% if value.is_a?(Hash) %>
                        <!-- Nested section (like post-link, aside, pullquote) -->
                        <div class="config-subsection pl-4 border-l-2 border-gray-300">
                          <h5 class="text-sm font-semibold text-gray-800 mb-3"><%= key.humanize %></h5>

                          <div class="space-y-3">
                            <% value.each do |subkey, subvalue| %>
                              <%
                                # Skip subcategory fields - they're dynamically managed
                                next if subkey == 'subcategory' || subkey == 'subcategory_2'
                              %>

                              <div class="config-field-row">
                                <label class="block text-sm font-medium text-gray-700 mb-1">
                                  <%= subkey.humanize %>
                                </label>

                                <% nested_field_key = "#{key}.#{subkey}" %>
                                <%
                                  # Skip subcategory fields - they're dynamically managed
                                  next if subkey == 'subcategory' || subkey == 'subcategory_2'
                                %>

                                <% field_options_key = @field_options&.key?(nested_field_key) ? nested_field_key : subkey %>
                                <% if @field_options&.key?(field_options_key) %>
                                  <!-- Select dropdown (no extra wrapper/label) -->
                                  <select name="config_fields[<%= key %>][<%= subkey %>]"
                                          class="w-full font-mono text-sm p-2 border border-gray-300"
                                          data-config-field="<%= nested_field_key %>">
                                    <% @field_options[field_options_key].each do |option| %>
                                      <% display_text = option.blank? ? '-- select --' : option %>
                                      <option value="<%= option %>" <%= 'selected' if subvalue.to_s == option.to_s %>><%= display_text %></option>
                                    <% end %>
                                  </select>

                                  <%# Add subcategory container after primary category %>
                                  <% if subkey == 'category' %>
                                    <div class="category-subcategories mt-2"
                                         data-podcast-key="<%= key %>"
                                         data-category-type="primary">
                                      <!-- Subcategories added here by JS -->
                                    </div>
                                  <% end %>

                                  <%# Add subcategory container after secondary category %>
                                  <% if subkey == 'category_2' %>
                                    <div class="category-subcategories mt-2"
                                         data-podcast-key="<%= key %>"
                                         data-category-type="secondary">
                                      <!-- Subcategories added here by JS -->
                                    </div>
                                  <% end %>
                                <% else %>
                                  <!-- Regular text input for nested field -->
                                  <input type="text"
                                         name="config_fields[<%= key %>][<%= subkey %>]"
                                         value="<%= subvalue %>"
                                         class="w-full font-mono text-sm p-2 border border-gray-300"
                                         data-config-field="<%= nested_field_key %>">
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                        </div>

                      <% else %>
                        <!-- Top-level field -->
                        <div class="config-field-row">
                          <label class="block text-sm font-medium text-gray-700 mb-1">
                            <%= key.humanize %>
                          </label>

                          <% if @field_options&.key?(key) %>
                            <!-- Select dropdown for field with options -->
                            <select name="config_fields[<%= key %>]"
                                    class="w-full font-mono text-sm p-2 border border-gray-300"
                                    data-config-field="<%= key %>">
                              <% @field_options[key].each do |option| %>
                                <option value="<%= option %>" <%= 'selected' if value.to_s == option.to_s %>><%= option %></option>
                              <% end %>
                            </select>
                          <% else %>
                            <!-- Regular text input -->
                            <input type="text"
                                   name="config_fields[<%= key %>]"
                                   value="<%= value %>"
                                   class="w-full font-mono text-sm p-2 border border-gray-300"
                                   data-config-field="<%= key %>">
                          <% end %>

                          <% if key == 'default_limit' %>
                            <p class="text-xs text-gray-500 mt-1">Use a number (e.g., 10) or "all" to show everything</p>
                          <% end %>
                        </div>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              <% end %>

              <!-- Templates Section -->
              <% if templates.any? %>
                <div>
                  <h3 class="text-base font-semibold text-gray-800 mb-2 pb-2 border-b border-gray-200">Button Templates</h3>
                  <p class="text-xs text-amber-600 mt-0 mb-2"><code class="font-mono bg-blue-200 text-gray-800 rounded-xs py-1 px-2">__PLACEHOLDER__</code> will be selected when you use the button in a Post/Page.</p>

                  <div class="space-y-4">
                    <% templates.each do |key, value| %>
                      <div class="config-field-row">
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                          <%= key.humanize %>
                        </label>
                        <textarea name="config_fields[<%= key %>]"
                                  rows="<%= value.lines.count + 2 %>"
                                  class="w-full font-mono text-sm p-2 border border-gray-300 bg-gray-50"
                                  data-config-field="<%= key %>"><%= value %></textarea>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>

            </div>
          <% end %>
      </div>

    </div>

    <!-- Raw YAML View -->
    <div id="config-yaml-view" class="hidden">
      <%= form.text_area :content,
                         value: config_content,
                         id: "config-yaml",
                         class: "w-full font-mono text-sm p-2 border border-gray-300 bg-gray-50",
                         rows: 25 %>
    </div>

    <!-- Hidden field to store final config YAML -->
    <%= form.hidden_field :content, id: "config-final", value: "" %>

    <div class="flex items-center gap-3 p-4 border border-gray-400 fixed bottom-8 right-10 bg-white">
      <%= form.submit "Save Configuration",
                      class: "uppercase text-sm px-2 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none" %>
      <%= link_to "Cancel", admin_configs_path,
                  class: "uppercase text-sm px-2 py-2 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none" %>
    </div>
  <% end %>
</div>

<script>
  // Global flags (outside IIFE so it persists)
  window.configEditorSetupComplete = window.configEditorSetupComplete || false;
  window.yamlWasEdited = window.yamlWasEdited || false;
  window.isYamlView = window.isYamlView || false;
  window.hasUnsavedChanges = window.hasUnsavedChanges || false;

  (function() {
  const configSchema = <%= raw (defined?(config_schema) ? config_schema.to_json : '{}') %>;
  let imageFieldsWithErrors = {};
  let fontFieldsWithErrors = {};
  let availableFonts = [];

  // Fetch available fonts on page load
  async function fetchAvailableFonts() {
  try {
  const response = await fetch('<%= available_fonts_admin_system_assets_path %>');
  const data = await response.json();
  availableFonts = data.fonts || [];
  } catch (error) {
  console.error('Failed to fetch available fonts:', error);
  }
  }

  // Load saved view preference
  function loadViewPreference() {
  const savedView = sessionStorage.getItem('configViewMode');
  console.log('Loading view preference:', savedView); // Debug

  // Only toggle if we're NOT already in the saved view
  if (savedView === 'yaml' && !window.isYamlView) {
  toggleConfigView();
  } else if (savedView === 'form' && window.isYamlView) {
  toggleConfigView();
  }
  }

  // Save view preference
  function saveViewPreference(mode) {
  sessionStorage.setItem('configViewMode', mode);
  }

  function toggleConfigView() {
  const formView = document.getElementById('config-form-view');
  const yamlView = document.getElementById('config-yaml-view');
  const toggleBtn = document.getElementById('config-toggle');
  const yamlTextarea = document.getElementById('config-yaml');

  console.log('Toggle attempt - isYamlView:', window.isYamlView, 'yamlWasEdited:', window.yamlWasEdited); // Add this

  // Prevent switching back to form if YAML was edited
  if (window.isYamlView && window.yamlWasEdited) {
  alert('YAML has been edited. Please save your changes first. The page will refresh and you can use the form view again.');
  return;
  }

  window.isYamlView = !window.isYamlView;

  if (window.isYamlView) {
  const yamlContent = formToYaml();
  yamlTextarea.value = yamlContent;
  window.yamlWasEdited = false; // Reset since we just generated it from form

  formView.classList.add('hidden');
  yamlView.classList.remove('hidden');
  toggleBtn.textContent = 'EDIT IN FORM';
  saveViewPreference('yaml');
  } else {
  formView.classList.remove('hidden');
  yamlView.classList.add('hidden');
  toggleBtn.textContent = 'EDIT YAML';
  saveViewPreference('form');
  }
  }

  // Track changes in form
  function trackChanges() {
  window.hasUnsavedChanges = true;
  }

  // Check field dependencies in real-time
  function checkDependencies() {
    console.log('checkDependencies called');
    document.querySelectorAll('[data-depends-on]').forEach(field => {
      const dependsOn = field.dataset.dependsOn;
      console.log('Field depends on:', dependsOn);
      const dependencyField = document.querySelector('[data-config-field="' + dependsOn + '"]');
      console.log('Dependency field found:', dependencyField);

      if (dependencyField) {
        const hasValue = dependencyField.value.trim() !== '';
        console.log('Has value:', hasValue);
        field.disabled = !hasValue;

        // Visual indication
        const wrapper = field.closest('.config-field-row');
        if (wrapper) {
          if (hasValue) {
            wrapper.classList.remove('opacity-50');
          } else {
            wrapper.classList.add('opacity-50');
          }
        }
      }
    });
  }

  // Validate image exists
  function validateImage(input) {
  const fieldName = input.dataset.configField;
  const value = input.value.trim();
  const errorMsg = document.querySelector(`[data-${fieldName}-error]`);

  if (!value) {
  // Empty field - hide error
  if (errorMsg) {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-300');
  }
  imageFieldsWithErrors[fieldName] = false;
  return;
  }

  if (!errorMsg) return;

  // User only types filename (e.g., "logo.svg"), prepend the system images path
  let imageUrl = '/system/images/' + value;

  // Create a temporary image to test if it loads
  const img = new Image();

  img.onload = function() {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-300');
  imageFieldsWithErrors[fieldName] = false;
  };

  img.onerror = function() {
  errorMsg.classList.remove('hidden');
  input.classList.add('border-red-300');
  imageFieldsWithErrors[fieldName] = true;
  };

  img.src = imageUrl;
  }

  // Validate font exists
  function validateFont(input) {
  const fieldName = input.dataset.configField;
  const value = input.value.trim();
  const errorMsg = document.querySelector(`[data-font-error="${fieldName}"]`);

  if (!value) {
  // Empty field - hide error
  if (errorMsg) {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-400');
  }
  fontFieldsWithErrors[fieldName] = false;
  return;
  }

  if (!errorMsg) return;

  // Wait for fonts to be fetched if list is empty
  if (availableFonts.length === 0) {
  return; // Don't validate if list isn't loaded yet
  }

  // Check if font filename exists in available fonts list
  const fontExists = availableFonts.includes(value);

  if (fontExists) {
  errorMsg.classList.add('hidden');
  input.classList.remove('border-red-400');
  fontFieldsWithErrors[fieldName] = false;
  } else {
  errorMsg.classList.remove('hidden');
  input.classList.add('border-red-400');
  fontFieldsWithErrors[fieldName] = true;
  }
  }

  // Setup font validation listeners
  function setupFontValidation() {
  // Validate all font fields on page load
  document.querySelectorAll('[data-validate-font="true"]').forEach(input => {
  if (input.value.trim()) {
  validateFont(input);
  }
  });
  }

  // Keyboard shortcut handler (only set up once)
  function handleKeyboardShortcut(e) {
  if ((e.metaKey || e.ctrlKey) && e.key === 's') {
  e.preventDefault();
  const formElement = document.getElementById('config-form');
  if (formElement) {
  formElement.requestSubmit();
  }
  }
  }

  // Set up global event listeners (only once)
  console.log('setupComplete at start:', window.configEditorSetupComplete);

  if (!window.configEditorSetupComplete) {
  console.log('Setting up global listeners');

  // Unsaved changes warning (for closing tab/window/external navigation)
  window.addEventListener('beforeunload', function(e) {
  console.log('beforeunload event fired, hasUnsavedChanges:', window.hasUnsavedChanges);
  if (window.hasUnsavedChanges) {
  e.preventDefault();
  e.returnValue = '';
  return '';
  }
  });

  // Clear unsaved changes flag when navigating via Turbo
  document.addEventListener('turbo:before-visit', function(e) {
  console.log('turbo:before-visit fired, hasUnsavedChanges:', window.hasUnsavedChanges);
  if (window.hasUnsavedChanges) {
  const confirmed = confirm('You have unsaved changes. Are you sure you want to leave?');
  if (!confirmed) {
  e.preventDefault();
  }
  }
  });

  // Listen for changes on all config fields
  document.addEventListener('input', function(e) {
  if (e.target.matches('[data-config-field]')) {
  checkDependencies();
  trackChanges();
  }

  if (e.target.id === 'config-yaml') {
  console.log('YAML edited, setting yamlWasEdited to true');
  window.yamlWasEdited = true;
  trackChanges();
  }

  // If any image field has an error showing, validate in real-time as they type
  if (e.target.matches('[data-validate-image="true"]')) {
  const fieldName = e.target.dataset.configField;
  if (imageFieldsWithErrors[fieldName]) {
  validateImage(e.target);
  }
  }

  // If any font field has an error showing, validate in real-time as they type
  if (e.target.matches('[data-validate-font="true"]')) {
  const fieldName = e.target.dataset.configField;
  if (fontFieldsWithErrors[fieldName]) {
  validateFont(e.target);
  }
  }
  });

  // Validate image/font on blur
  document.addEventListener('blur', function(e) {
  if (e.target.matches('[data-validate-image="true"]')) {
  validateImage(e.target);
  }

  if (e.target.matches('[data-validate-font="true"]')) {
  validateFont(e.target);
  }
  }, true);

  // Validate on Enter key
  document.addEventListener('keydown', function(e) {
  // Keyboard shortcut
  handleKeyboardShortcut(e);

  // Validate on Enter
  if (e.key === 'Enter') {
  if (e.target.matches('[data-validate-image="true"]')) {
  validateImage(e.target);
  }
  if (e.target.matches('[data-validate-font="true"]')) {
  validateFont(e.target);
  }
  }
  });

  // Refetch fonts when window regains focus
  window.addEventListener('focus', async function() {
  await fetchAvailableFonts();
  setupFontValidation();
  });

  // Clear flag on form submission (BEFORE Turbo processes it)
  document.addEventListener('turbo:submit-start', function(e) {
  if (e.target.id === 'config-form') {
  window.hasUnsavedChanges = false;
  }
  });

  window.configEditorSetupComplete = true;
  console.log('setupComplete set to true');
  }

  console.log('setupComplete at end:', window.configEditorSetupComplete);

  // Run on page load
  document.addEventListener('turbo:load', async function() {
  // Reset unsaved changes flag on new page load
  window.hasUnsavedChanges = false;
  window.isYamlView = false;
  window.yamlWasEdited = false;

  checkDependencies();

  // Restore scroll position after save
  const savedPosition = sessionStorage.getItem('configScrollPosition');
  if (savedPosition) {
  setTimeout(function() {
  window.scrollTo(0, parseInt(savedPosition));
  sessionStorage.removeItem('configScrollPosition');
  }, 0);
  }

  // Fetch available fonts first
  await fetchAvailableFonts();

  // Validate logo/favicon on page load if they have values
  const logoInput = document.querySelector('[data-config-field="logo"]');
  if (logoInput && logoInput.value.trim()) {
  validateImage(logoInput);
  }

  const faviconInput = document.querySelector('[data-config-field="favicon"]');
  if (faviconInput && faviconInput.value.trim()) {
  validateImage(faviconInput);
  }

  // Setup font validation
  setupFontValidation();

  // Set up form submission handler (only if form exists)
  const configForm = document.getElementById('config-form');
  if (configForm) {
  configForm.removeEventListener('submit', handleFormSubmit);
  configForm.addEventListener('submit', handleFormSubmit);
  }

  // Load view preference LAST (after form is ready)
  setTimeout(function() {
  loadViewPreference();
  }, 0);
  });

  // Form submit handler (defined outside to allow removal)
  function handleFormSubmit(e) {
    const finalYaml = window.isYamlView
      ? document.getElementById('config-yaml').value
      : formToYaml();

    console.log('📤 Submitting YAML:', finalYaml);
    document.getElementById('config-final').value = finalYaml;

    // Save scroll position
    sessionStorage.setItem('configScrollPosition', window.scrollY);

    // Clear unsaved changes flag before submit
    window.hasUnsavedChanges = false;
  }

  function formatYamlValue(value) {
    if (value === null || value === undefined) {
      return '""';
    }

    const strValue = String(value);

    if (strValue === "") {
      return '""';
    }

    // Numbers (not quoted)
    if (!isNaN(strValue) && strValue.trim() !== "") {
      return strValue;
    }

    // Booleans (not quoted)
    if (strValue === "true" || strValue === "false") {
      return strValue;
    }

    // Multi-line strings (block scalar)
    if (strValue.includes('\n')) {
      return null; // Signal to use block scalar format
    }

    // All other strings (quoted and escaped)
    return `"${strValue.replace(/"/g, '\\"')}"`;
  }

  function formToYaml() {
    const fields = {};

    document.querySelectorAll('[data-config-field]').forEach(input => {
      const fieldName = input.dataset.configField;
      let value;

      // Handle checkboxes specially
      if (input.type === 'checkbox') {
        value = input.checked ? 'true' : 'false';
      } else {
        value = input.value;
      }

      // Handle nested fields (fonts.heading.family OR post-link.default_link_text)
      const parts = fieldName.split('.');
      if (parts.length > 1) {
        let current = fields;
        for (let i = 0; i < parts.length - 1; i++) {
          if (!current[parts[i]]) {
            current[parts[i]] = {};
          }
          current = current[parts[i]];
        }
        current[parts[parts.length - 1]] = value.trim ? value.trim() : value;
      } else {
        fields[fieldName] = value.trim ? value.trim() : value;
      }
    });

    // Collect subcategories as arrays
    console.log('🔍 Looking for subcategory selects...');
    const subcatSelects = document.querySelectorAll('[data-subcategory-for]');
    console.log(`Found ${subcatSelects.length} subcategory selects`);

    subcatSelects.forEach(select => {
      const podcastKey = select.dataset.subcategoryFor;
      const subcategoryField = select.dataset.subcategoryField;
      const value = select.value.trim();

      console.log('Subcategory select:', { podcastKey, subcategoryField, value, element: select });

      if (value) {
        if (!fields[podcastKey]) fields[podcastKey] = {};
        if (!fields[podcastKey][subcategoryField]) {
          fields[podcastKey][subcategoryField] = [];
        }
        fields[podcastKey][subcategoryField].push(value);
      }
    });

    return simpleYamlStringify(fields, 0);
  }

  function simpleYamlStringify(obj, indent) {
    let yaml = '';
    const spaces = '  '.repeat(indent);

    for (const [key, value] of Object.entries(obj)) {
      // CHECK ARRAYS FIRST (before objects)
      if (Array.isArray(value)) {
        if (value.length === 0) {
          yaml += `${spaces}${key}: []\n`;
        } else {
          const quotedValues = value.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
          yaml += `${spaces}${key}: [${quotedValues.join(', ')}]\n`;
        }
      } else if (typeof value === 'object' && value !== null) {
        // Nested object (like podcast configs)
        yaml += `${spaces}${key}:\n`;

        const nestedEntries = Object.entries(value);

        nestedEntries.forEach(([nestedKey, nestedValue]) => {
          // Skip subcategory fields - they'll be output after their parent category
          if (nestedKey === 'subcategory' || nestedKey === 'subcategory_2') {
            return;
          }

          // Output the field
          if (Array.isArray(nestedValue)) {
            if (nestedValue.length === 0) {
              yaml += `${spaces}  ${nestedKey}: []\n`;
            } else {
              const quotedValues = nestedValue.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
              yaml += `${spaces}  ${nestedKey}: [${quotedValues.join(', ')}]\n`;
            }
          } else if (typeof nestedValue === 'object' && nestedValue !== null) {
            yaml += simpleYamlStringify({ [nestedKey]: nestedValue }, indent + 1);
          } else {
            const formattedValue = formatYamlValue(nestedValue);
            if (formattedValue === null) {
              yaml += `${spaces}  ${nestedKey}: |-\n`;
              const lines = String(nestedValue).split('\n');
              lines.forEach(line => {
                yaml += `${spaces}    ${line}\n`;
              });
            } else {
              yaml += `${spaces}  ${nestedKey}: ${formattedValue}\n`;
            }
          }

          // After category, immediately output subcategory if it exists
          if (nestedKey === 'category' && value['subcategory']) {
            const subcats = value['subcategory'];
            if (Array.isArray(subcats) && subcats.length > 0) {
              const quotedValues = subcats.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
              yaml += `${spaces}  subcategory: [${quotedValues.join(', ')}]\n`;
            }
          }

          // After category_2, immediately output subcategory_2 if it exists
          if (nestedKey === 'category_2' && value['subcategory_2']) {
            const subcats = value['subcategory_2'];
            if (Array.isArray(subcats) && subcats.length > 0) {
              const quotedValues = subcats.map(v => `"${String(v).replace(/"/g, '\\"')}"`);
              yaml += `${spaces}  subcategory_2: [${quotedValues.join(', ')}]\n`;
            }
          }
        });
      } else {
        // Format the value
        const formattedValue = formatYamlValue(value);

        if (formattedValue === null) {
          yaml += `${spaces}${key}: |-\n`;
          const lines = String(value).split('\n');
          lines.forEach(line => {
            yaml += `${spaces}  ${line}\n`;
          });
        } else {
          yaml += `${spaces}${key}: ${formattedValue}\n`;
        }
      }
    }

    return yaml;
  }

  function yamlToForm(yamlText) {

  // Just validate it's parseable
  const lines = yamlText.split('\n');
  // Basic validation - actual parsing will happen on submit
  }

  window.toggleConfigView = toggleConfigView;
  window.setupFontValidation = setupFontValidation;
  window.checkDependencies = checkDependencies;
  })();

  // ========== PODCAST CATEGORY/SUBCATEGORY MANAGEMENT ==========

  if (typeof subcategoryMap === 'undefined') {
    var subcategoryMap = <%= raw @itunes_subcategories.to_json %>;
  }

  function setupPodcastCategories() {
    // Clear any existing dynamic subcategory fields first (Turbo cache issue)
    document.querySelectorAll('.subcategory-field').forEach(el => el.remove());
    document.querySelectorAll('.add-subcategory-btn').forEach(el => el.remove());

    // Now set up fresh from the file content
    document.querySelectorAll('[data-podcast-key]').forEach(container => {
      const podcastKey = container.dataset.podcastKey;
      const categoryType = container.dataset.categoryType; // 'primary' or 'secondary'
      const categoryField = categoryType === 'primary' ? 'category' : 'category_2';
      const subcategoryField = categoryType === 'primary' ? 'subcategory' : 'subcategory_2';

      const categorySelect = document.querySelector(`select[data-config-field="${podcastKey}.${categoryField}"]`);
      if (!categorySelect) return;

      // Initialize from existing YAML data
      initializeSubcategories(container, podcastKey, categoryField, subcategoryField, categorySelect.value);

      // Listen for category changes
      categorySelect.addEventListener('change', function() {
        updateSubcategoryUI(container, podcastKey, categoryField, subcategoryField, this.value);
      });
    });
  }

  function initializeSubcategories(container, podcastKey, categoryField, subcategoryField, categoryValue) {
    console.log(`🎬 initializeSubcategories called for ${podcastKey}.${subcategoryField}`);

    // Guard: Check if subcategoryMap exists
      if (!subcategoryMap || typeof subcategoryMap !== 'object') {
        console.warn('⚠️  subcategoryMap not loaded');
        return;
      }

    // Read existing subcategory values from YAML data
    const yamlTextarea = document.getElementById('config-yaml');
    if (yamlTextarea && yamlTextarea.value) {
      try {
        // Parse the YAML to extract subcategory values
        const yamlContent = yamlTextarea.value;
        const lines = yamlContent.split('\n');

        let inPodcast = false;
        let existingSubcats = [];

        lines.forEach(line => {
          if (line.trim() === `${podcastKey}:`) {
            inPodcast = true;
          } else if (inPodcast && line.match(/^\S/)) {
            inPodcast = false; // Left the podcast block
          }

          if (inPodcast && line.includes(`${subcategoryField}:`)) {
            // Extract array values from flow style: ["Value1", "Value2"]
            const match = line.match(/\[(.*?)\]/);
            if (match) {
              const arrayContent = match[1];
              existingSubcats = arrayContent.split(',').map(v =>
                v.trim().replace(/^"/, '').replace(/"$/, '')
              ).filter(v => v);
            }
          }
        });

        // Populate the UI with existing values
        if (existingSubcats.length > 0) {
          console.log(`Found existing subcats:`, existingSubcats);
          existingSubcats.forEach(value => {
            addSubcategoryField(container, podcastKey, subcategoryField, categoryValue, value);
          });
          updateAddSubcategoryButton(container, podcastKey, subcategoryField, categoryValue);
          return; // Already initialized
        }
      } catch (e) {
        console.error('Failed to parse existing subcategories:', e);
      }
    }

    // If no existing data, just set up the UI
    updateSubcategoryUI(container, podcastKey, categoryField, subcategoryField, categoryValue);
  }

  function updateSubcategoryUI(container, podcastKey, categoryField, subcategoryField, categoryValue) {
    // Clear existing subcategory UI
    const existingSubcats = container.querySelectorAll('.subcategory-field');
    const existingButton = container.querySelector('.add-subcategory-btn');

    // Collect current values before clearing
    const currentValues = Array.from(existingSubcats).map(field =>
      field.querySelector('select')?.value || ''
    ).filter(v => v);

    existingSubcats.forEach(el => el.remove());
    if (existingButton) existingButton.remove();

    // If no category selected, hide everything
      if (!categoryValue || categoryValue === '') {
        return;
      }

      // Guard: Check if subcategoryMap exists and is valid
      if (!subcategoryMap || typeof subcategoryMap !== 'object') {
        console.warn('⚠️  subcategoryMap not loaded');
        return;
      }

      // Check if this category has subcategories
      const availableSubcats = subcategoryMap[categoryValue];
      if (!availableSubcats || availableSubcats.length === 0) {
        console.log(`ℹ️  "${categoryValue}" has no subcategories (this is normal)`);
        return; // Category has no subcategories - perfectly valid!
      }

    // Re-add existing subcategory fields with values
    currentValues.forEach(value => {
      addSubcategoryField(container, podcastKey, subcategoryField, categoryValue, value);
    });

    // Show "add subcategory" button if < 2 subcategories
    if (currentValues.length < 2) {
      showAddSubcategoryButton(container, podcastKey, subcategoryField, categoryValue);
    }
  }

  function addSubcategoryField(container, podcastKey, subcategoryField, categoryValue, selectedValue = '') {
    const subcatCount = container.querySelectorAll('.subcategory-field').length;
    if (subcatCount >= 2) return; // Max 2

    const availableSubcats = subcategoryMap[categoryValue];

    const fieldDiv = document.createElement('div');
    fieldDiv.className = 'subcategory-field flex items-center gap-2 mt-2';

    const select = document.createElement('select');
    select.className = 'flex-1 font-mono text-sm p-2 border border-gray-300';
    select.dataset.subcategoryFor = podcastKey;
    select.dataset.subcategoryField = subcategoryField;

    // Add options
    const emptyOption = document.createElement('option');
    emptyOption.value = '';
    emptyOption.textContent = '-- select subcategory --';
    select.appendChild(emptyOption);

    availableSubcats.forEach(subcat => {
      const option = document.createElement('option');
      option.value = subcat;
      option.textContent = subcat;
      if (subcat === selectedValue) {
        option.selected = true;
      }
      select.appendChild(option);
    });

    // Remove button
    const removeBtn = document.createElement('button');
    removeBtn.type = 'button';
    removeBtn.className = 'px-2 py-1 text-sm bg-red-100 hover:bg-red-200 text-red-700';
    removeBtn.textContent = '×';
    removeBtn.onclick = function() {
      fieldDiv.remove();
      updateAddSubcategoryButton(container, podcastKey, subcategoryField, categoryValue);
    };

    fieldDiv.appendChild(select);
    fieldDiv.appendChild(removeBtn);

    // Insert before the add button (if it exists) or append
    const addBtn = container.querySelector('.add-subcategory-btn');
    if (addBtn) {
      container.insertBefore(fieldDiv, addBtn);
    } else {
      container.appendChild(fieldDiv);
    }

    // Update button visibility
    updateAddSubcategoryButton(container, podcastKey, subcategoryField, categoryValue);
  }

  function showAddSubcategoryButton(container, podcastKey, subcategoryField, categoryValue) {
    // Don't add if already exists
    if (container.querySelector('.add-subcategory-btn')) return;

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'add-subcategory-btn mt-2 text-sm px-3 py-1 border border-gray-300 hover:bg-gray-100 rounded';
    button.textContent = '+ add subcategory';
    button.onclick = function() {
      addSubcategoryField(container, podcastKey, subcategoryField, categoryValue);
    };

    container.appendChild(button);
  }

  function updateAddSubcategoryButton(container, podcastKey, subcategoryField, categoryValue) {
    const subcatCount = container.querySelectorAll('.subcategory-field').length;
    const addBtn = container.querySelector('.add-subcategory-btn');

    if (subcatCount >= 2) {
      // Hide button if 2 subcategories exist
      if (addBtn) addBtn.remove();
    } else {
      // Show button if < 2
      if (!addBtn) {
        showAddSubcategoryButton(container, podcastKey, subcategoryField, categoryValue);
      }
    }
  }

  // Run on page load
  document.addEventListener('turbo:load', function() {
    setupPodcastCategories();
  });
</script>
