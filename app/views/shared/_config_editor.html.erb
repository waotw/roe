        <div class="mb-4 text-center">
          <div class="text-2xl mb-2">╔═══════════════════════════════════════╗</div>
          <div class="text-2xl mb-2">║   REGENERATING COLLECTIONS           ║</div>
          <div class="text-2xl mb-4">╚═══════════════════════════════════════╝</div>
        </div>

        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Updating member access settings...</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Regenerating home page...</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Regenerating collection archives...</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Updating posts and pages...</span>
          </div>
        </div>

        <div class="mt-6 text-center text-xs text-blue-300">
          <span class="animate-pulse">⏳ Please wait...</span>
        </div>
      </div>
    `;

    document.body.appendChild(overlay);
  }

  // Run on page load
  document.addEventListener('turbo:load', function() {
    setupMembersConfigProgress();

    // Remove overlay when page reloads
    const existingOverlay = document.getElementById('members-progress-overlay');
    if (existingOverlay) {
      existingOverlay.remove();
    }
  });

  function setupStaticGenerationProgress() {
    const configForm = document.getElementById('config-form');
    if (!configForm) return;

    // Only run on site.yml edit page
    const isSiteConfig = '<%= @config_type %>' === 'site';
    console.log('🔍 Static generation setup - isSiteConfig:', isSiteConfig);

    if (!isSiteConfig) return;

    // Store original value on page load
    const staticEnabledCheckbox = document.querySelector('input[data-config-field="static_generation_enabled"]');
    console.log('🔍 Found checkbox:', staticEnabledCheckbox);

    if (staticEnabledCheckbox) {
      const originalValue = staticEnabledCheckbox.checked;
      console.log('🔍 Original value:', originalValue);

      staticEnabledCheckbox.dataset.originalValue = originalValue ? 'true' : 'false';

      // Listen for form submission
      configForm.addEventListener('submit', function(e) {
        const wasEnabled = staticEnabledCheckbox.dataset.originalValue === 'true';
        const isNowEnabled = staticEnabledCheckbox.checked;

        console.log('📤 Form submit - wasEnabled:', wasEnabled, 'isNowEnabled:', isNowEnabled);

        if (!wasEnabled && isNowEnabled) {
          console.log('✨ Showing generation progress');
          showGenerationProgress();
        }
      });
    }
  }

  function showGenerationProgress() {
    const overlay = document.createElement('div');
    overlay.id = 'generation-progress-overlay';
    overlay.className = 'fixed inset-0 flex items-center justify-center z-50';
    overlay.innerHTML = `
      <div class="bg-gray-900 border-2 border-blue-600 p-8 font-mono text-blue-500 max-w-2xl">
        <div class="mb-4 text-center">
          <div class="text-2xl mb-2">╔═══════════════════════════════════════╗</div>
          <div class="text-2xl mb-2">║   STATIC SITE GENERATION ACTIVE      ║</div>
          <div class="text-2xl mb-4">╚═══════════════════════════════════════╝</div>
        </div>

        <div class="space-y-2 text-sm">
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Syncing content from markdown files...</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Rendering pages and posts...</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Generating collections and feeds...</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="animate-pulse">▶</span>
            <span>Copying assets and media...</span>
          </div>
        </div>

        <div class="mt-6 text-center text-xs text-blue-300">
          <span class="animate-pulse">⏳ Please wait...</span>
        </div>
      </div>
    `;

    document.body.appendChild(overlay);
    console.log('✅ Progress overlay added to DOM');
  }

  // ========== BOOLEAN FIELD INDICATORS ==========

  function updateBooleanFieldIndicators() {
    // Find all select fields with true/false options
    document.querySelectorAll('select[data-config-field]').forEach(field => {
      const options = Array.from(field.options).map(opt => opt.value);

      // Check if this is a boolean field (has 'true' and 'false' options)
      if (options.includes('true') && options.includes('false')) {
        const value = field.value;

        // Remove existing classes
        field.classList.remove(
          'bg-green-100', 'border-green-500',
          'bg-red-100', 'border-red-300'
        );

        // Add classes based on value
        if (value === 'true') {
          field.classList.add('bg-green-100', 'border-green-500');
        } else if (value === 'false') {
          field.classList.add('bg-red-100', 'border-red-300');
        }
      }
    });
  }

  // Run on page load
  document.addEventListener('turbo:load', function() {
    updateBooleanFieldIndicators();

    // Listen for changes on all config fields
    document.querySelectorAll('select[data-config-field]').forEach(field => {
      field.addEventListener('change', updateBooleanFieldIndicators);
    });
  });
</script>
