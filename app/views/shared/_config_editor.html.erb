          if (nestedKey === 'category_secondary' && value['subcategory_secondary']) {
            yaml += emitArrayBlock(nestedSpaces, 'subcategory_secondary', value['subcategory_secondary']);
          }
        });
      } else {
        // Format the value
        const formattedValue = formatYamlValue(value);

        if (formattedValue === null) {
          yaml += `${spaces}${key}: ${yamlOperator}\n`;
          const lines = String(value).split('\n');
          lines.forEach(line => {
            yaml += `${spaces}  ${line}\n`;
          });
        } else {
          yaml += `${spaces}${key}: ${formattedValue}\n`;
        }
      }
    }

    return yaml;
  }

