      // Comma-separated string → array. The text input for fields
      // tagged with data-config-csv-array (e.g. product_categories)
      // stores its UI value as "album, book, ebook". Without this
      // conversion the YAML would persist as a quoted string and
      // any consumer expecting an array (ProductCategory, the new
      // category dropdown in product editor, etc.) would have to
      // re-parse. Splitting here standardizes on the array shape.
      if (input.dataset.configCsvArray === 'true' && typeof value === 'string') {
        value = value.split(',')
                     .map(s => s.trim())
                     .filter(s => s.length > 0);
      }

      // Handle nested fields (fonts.heading.family OR post-link.default_link_text)
      const parts = fieldName.split('.');
      if (parts.length > 1) {
        let current = fields;
        for (let i = 0; i < parts.length - 1; i++) {
          if (!current[parts[i]]) {
