  // Emit a YAML array as a block-style list under the given key.
  // System-emitted arrays standardize on block style:
  //
  //   key:
  //     - "value-1"
  //     - "value-2"
  //
  // Empty arrays still emit inline `key: []` since "no items" reads
  // most clearly that way. Block-form is what Psych emits when given
  // a hash containing an Array, what ProductCategory's surgical
  // writer produces, and what the user is most likely to
  // hand-author. The reader path (YAML.load + every consumer that
  // calls Array() on the value) handles flow-style `[a, b]` too, so
  // users who hand-edit to inline arrays don't break anything — but
  // the next system write normalizes back to block style.
  function emitArrayBlock(spaces, key, arr) {
    if (!Array.isArray(arr) || arr.length === 0) {
      return `${spaces}${key}: []\n`;
    }
    const childSpaces = spaces + '  ';
    let block = `${spaces}${key}:\n`;
    arr.forEach(v => {
      block += `${childSpaces}- "${String(v).replace(/"/g, '\\"')}"\n`;
    });
