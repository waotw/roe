  // For every podcast: tie the secondary <category_secondary> select
  // to the primary <category> select.
  //
  //   - When primary is empty → secondary disabled + value cleared
  //   - When primary has a value → secondary enabled, options
  //     rebuilt to exclude the primary's value
  //   - Changing primary that previously matched secondary's value →
  //     secondary's value clears
  //
  // After any state change we dispatch `change` on the secondary
  // select so the existing subcategory listener (from
  // setupPodcastCategories above) refreshes the dependent
  // subcategory UI for free.
  function setupSecondaryCategoryConstraints() {
    document.querySelectorAll('select[data-config-field$=".category"]').forEach(primarySelect => {
      const fullField = primarySelect.dataset.configField;
      const podcastKey = fullField.replace(/\.category$/, '');
      const secondarySelect = document.querySelector(
        `select[data-config-field="${podcastKey}.category_secondary"]`
      );
      if (!secondarySelect) return;

      // Snapshot the FULL set of options once. We rebuild from this
      // every time primary changes — simpler than diff-and-patch.
      const allOptions = Array.from(secondarySelect.options).map(opt => ({
        value: opt.value,
        text: opt.textContent
      }));

      function refreshSecondary() {
        const primaryValue = primarySelect.value;
        const previousValue = secondarySelect.value;

        if (!primaryValue) {
          secondarySelect.disabled = true;
          if (secondarySelect.value !== '') {
            secondarySelect.value = '';
            secondarySelect.dispatchEvent(new Event('change'));
          }
          return;
        }

        secondarySelect.disabled = false;

        // Rebuild options excluding the primary's chosen value.
        // Try to preserve the user's previous secondary selection if
        // it's still a valid option after the exclusion.
        secondarySelect.innerHTML = '';
        let preserved = false;
        allOptions.forEach(opt => {
          if (opt.value && opt.value === primaryValue) return;
          const newOpt = document.createElement('option');
          newOpt.value = opt.value;
          newOpt.textContent = opt.text;
          if (opt.value === previousValue) {
            newOpt.selected = true;
            preserved = true;
          }
          secondarySelect.appendChild(newOpt);
        });

        if (!preserved) {
          // The previous secondary value is no longer valid (it
          // matched the new primary, or was outside this option set).
          secondarySelect.value = '';
        }

        // Fire change so the secondary's subcategory UI refreshes
        // based on its (possibly cleared) value.
        secondarySelect.dispatchEvent(new Event('change'));
      }

      primarySelect.addEventListener('change', refreshSecondary);
      refreshSecondary(); // apply initial state on page load
    });
