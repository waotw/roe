    // Podcast-key renames: if the user edited the key input for any
    // podcast block, rebuild `fields` with the new key in place of the
    // original. Done after the field/subcategory loops so any data
    // attached under the old key gets carried over.
    document.querySelectorAll('[data-podcast-key]').forEach(input => {
      const oldKey = input.dataset.podcastKey;
      const newKey = sanitizePodcastKey(input.value);
