<%# Cross-env drift banner. Shows when the OTHER environment has
    unsynced changes — dev sees prod's state, prod sees dev's. The
    state is fetched via SiteSync::Exchange (hourly background job
    + opportunistic refresh on stale cache). Silent when we have
    no peer info, when peer is clean, or when peer's last checkin
    is older than the cache TTL. %>
<%
  peer_state = (SiteSync::Exchange.refresh_if_stale rescue nil)
%>
<% if peer_state && SiteSync::Exchange.peer_has_drift? %>
  <div class="admin-warning-bar bg-amber-100 border-l-4 border-amber-500 text-amber-900 p-4 font-mono text-xs">
    <p>
      🔄 <%= SiteSync::Exchange.peer_label %> has unsynced changes — sync them before editing.
      <%= link_to "View →", admin_site_sync_path, class: "underline" %>
    </p>
  </div>
<% end %>
