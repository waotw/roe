<%# Per-page metadata for the public site layout. Composes title,
    description, OpenGraph, Twitter Cards, canonical, JSON-LD, and
    feed discovery via SeoHelper. The helper auto-detects the
    "subject" from view ivars (@post / @page Page record /
    @product / @doc), so controllers don't need to set anything
    special — just render this partial from the layout. %>

<meta charset="UTF-8">
<title><%= seo_title %></title>

<% if seo_description.present? %>
  <meta name="description" content="<%= seo_description %>">
<% end %>

<% if seo_author.present? %>
  <meta name="author" content="<%= seo_author %>">
<% end %>

<% if seo_noindex? %>
  <meta name="robots" content="noindex, nofollow">
<% end %>

<link rel="canonical" href="<%= seo_canonical_url %>">

<%# ── OpenGraph ─────────────────────────────────────────── %>
<meta property="og:title" content="<%= seo_title %>">
<% if seo_description.present? %>
  <meta property="og:description" content="<%= seo_description %>">
<% end %>
<meta property="og:url" content="<%= seo_canonical_url %>">
<meta property="og:type" content="<%= seo_og_type %>">
<% if SiteConfig.get("title").to_s.strip.present? %>
  <meta property="og:site_name" content="<%= SiteConfig.get("title") %>">
<% end %>
<% if (og_image = seo_image_url) %>
  <meta property="og:image" content="<%= og_image %>">
<% end %>

<% if seo_og_type == "article" %>
  <% if (pub_time = seo_published_time) %>
    <meta property="article:published_time" content="<%= pub_time %>">
  <% end %>
  <% if seo_author.present? %>
    <meta property="article:author" content="<%= seo_author %>">
  <% end %>
  <% seo_tags.each do |tag| %>
    <meta property="article:tag" content="<%= tag %>">
  <% end %>
<% end %>

<%# ── Twitter Cards ──────────────────────────────────────
     summary_large_image when we have an image, summary otherwise.
     No twitter:site/creator — deferred until there's a site-level
     twitter handle field in site.yml. %>
<meta name="twitter:card" content="<%= seo_image_url ? 'summary_large_image' : 'summary' %>">
<meta name="twitter:title" content="<%= seo_title %>">
<% if seo_description.present? %>
  <meta name="twitter:description" content="<%= seo_description %>">
<% end %>
<% if (tw_image = seo_image_url) %>
  <meta name="twitter:image" content="<%= tw_image %>">
<% end %>

<%# ── JSON-LD Article schema ────────────────────────────
     Only emitted for posts. Google's rich-result eligibility for
     Article requires publisher.logo, headline, image, datePublished
     — the helper composes those from site config + post metadata
     with safe nil drops. %>
<% if (article = article_jsonld) %>
  <script type="application/ld+json" nonce="<%= request.content_security_policy_nonce %>">
    <%= article.to_json.html_safe %>
  </script>
<% end %>

<%# ── Site-wide feed auto-discovery ─────────────────────
     RSS + Atom for the main posts feed, on every page. %>
<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="<%= feed_url(format: :xml) %>">
<link rel="alternate" type="application/atom+xml" title="Atom Feed" href="<%= feed_atom_url(format: :xml) %>">

<%# ── Per-podcast feed auto-discovery ────────────────────
     When the current page is a podcast episode wired to a
     podcast.yml entry, advertise that podcast's RSS feed too so
     podcast clients pick it up from the episode page. %>
<% if (pf = podcast_feed_link) %>
  <link rel="alternate" type="application/rss+xml" title="<%= pf[:title] %>" href="<%= pf[:href] %>">
<% end %>
