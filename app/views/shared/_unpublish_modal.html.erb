<%# Unpublish confirmation modal — styled like the publish modal but simple:
    just confirms what will happen, appropriate to the content type. Shown by
    the editor controller when Unpublish is clicked (a form submit intercepted
    in confirmUnpublish); "Unpublish" submits the stashed form. Must sit inside
    a data-controller="editor". Locals: resource, resource_type. %>
<div data-editor-target="unpublishModal"
     data-action="click->editor#unpublishModalBackdrop"
     class="hidden fixed inset-0 bg-amber-700/35 flex items-center justify-center z-50">
  <div class="bg-white border-2 border-gray-900 p-8 max-w-lg mx-auto">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Unpublish <%= resource_type.capitalize %></h2>
    <p class="text-gray-700 mb-6">
      This saves your current edits and removes
      <strong><%= resource.title.presence || "this #{resource_type}" %></strong>
      from your live site. You can republish it any time.
    </p>
    <div class="flex items-center gap-3 pt-2">
      <button type="button"
              data-action="click->editor#submitUnpublish"
              class="uppercase text-sm px-4 py-2 border border-gray-800 bg-slate-400 hover:bg-slate-300 text-white font-mono rounded-xs cursor-pointer">
        Unpublish
      </button>
      <button type="button"
              data-action="click->editor#cancelUnpublish"
              class="uppercase text-sm px-4 py-2 border border-gray-800 bg-gray-200 hover:bg-gray-100 font-mono rounded-xs">
        Cancel
      </button>
    </div>
  </div>
</div>
