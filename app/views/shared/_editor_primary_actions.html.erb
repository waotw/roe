<%# Primary editor actions — Save / Preview / (Un)publish + the save-state
    indicator. Rendered twice per editor: in-flow at the top (inside
    #primary-actions) AND inside the sticky bottom drawer, so the markup lives
    here once. Sits inside the editor Stimulus controller, so the button actions
    and the saveDot/saveMessage targets resolve there (targets are read as
    *plural* in editor#updateSaveState, keeping both copies in sync).

    Publish/Unpublish applies to post/page/product (all share HasMetadata's
    published?); emails have nothing to publish.

    Locals: resource, resource_type. %>
<% publishable = %w[post page product].include?(resource_type) %>
<div class="flex gap-1 items-baseline overflow-hidden">
  <button type="submit" form="<%= resource_type %>-form" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer">Save</button>

  <button type="button"
          data-action="click->editor#preview"
          class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer">
    Preview
  </button>

  <%# No Check Markdown button: the check runs on load and on every pause in
      typing, so the dot in the tab strip already says what the button would
      have. See markdown_doctor_controller. %>

  <% if publishable %>
    <div class="publish-button-container">
      <% unless resource.published? %>
        <button type="button"
                data-action="click->editor#confirmPublish"
                data-editor-post-id="<%= resource.id %>"
                class="uppercase text-xs px-1.5 py-0 border border-slate-800 bg-slate-200 hover:bg-slate-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer">
          Publish
        </button>
      <% else %>
        <form action="<%= send("unpublish_admin_#{resource_type}_path", resource) %>"
              method="post"
              data-turbo="false"
              data-action="submit->editor#confirmUnpublish">
          <input type="hidden" name="_method" value="patch">
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
          <button type="submit"
                  class="uppercase text-xs text-white px-1.5 py-0 border border-slate-800 bg-slate-400 hover:bg-slate-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer">
            Unpublish
          </button>
        </form>
      <% end %>
    </div>
  <% end %>

  <%# Save-state indicator — amber "unsaved changes" / green "changes saved" /
      pristine (blank). Driven by editor#updateSaveState (isDirty). %>
  <div class="flex items-center gap-1.5 font-mono text-[0.65rem] uppercase text-gray-500 select-none pl-1.5">
    <span class="inline-block w-2 h-2 rounded-full bg-green-500" data-editor-target="saveDot"></span>
    <span data-editor-target="saveMessage"></span>
  </div>
</div>
