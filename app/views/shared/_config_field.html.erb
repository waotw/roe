<%
  field_type = field_config[:type] || :text
  field_label = field_config[:label] || field_name.humanize
  field_hint = field_config[:hint]
  field_required = field_config[:required]
  field_placeholder = field_config[:placeholder]
  field_depends_on = field_config[:depends_on]
  field_options = field_config[:options]
  # Shown when nothing is stored yet. Only selects use this: they have a blank
  # "Select..." option that otherwise makes an unset setting look switched off
  # rather than sitting at its default.
  field_default = field_config[:default]
  # A checkbox can map to arbitrary string values (e.g. stable/nightly)
  # instead of true/false via on_value / off_value.
  field_on_value = field_config[:on_value]
  field_off_value = field_config[:off_value]
  checkbox_on = field_on_value || "true"
  checkbox_off = field_off_value || "false"
  field_id = "config-field-#{field_name}"
%>

<div class="config-field-row <%= 'depends-on-field' if field_depends_on %>">
  <% if field_type == :checkbox %>
    <%# Toggle: checkbox sits inline with its label, hint below both. %>
    <div class="flex items-center gap-2">
      <!-- Hidden field ensures the "off" value is sent when unchecked -->
      <input type="hidden" name="config_fields[<%= field_name %>]" value="<%= checkbox_off %>">
      <input type="checkbox"
             id="<%= field_id %>"
             name="config_fields[<%= field_name %>]"
             value="<%= checkbox_on %>"
             <%= 'checked' if value.to_s == checkbox_on %>
             class="h-4 w-4 border-gray-300 rounded"
             data-config-field="<%= field_name %>"
             <% if field_on_value %>data-on-value="<%= field_on_value %>"<% end %>
             <% if field_off_value %>data-off-value="<%= field_off_value %>"<% end %>
             <% if field_depends_on %>data-depends-on="<%= field_depends_on %>"<% end %>
             <%= 'disabled' if field_depends_on && all_values[field_depends_on].to_s.strip.empty? %>>
      <label for="<%= field_id %>" class="text-sm font-medium text-gray-700">
        <%= field_label %>
        <% if field_required %><span class="text-red-500">*</span><% end %>
      </label>
    </div>
    <% if field_hint %>
      <p class="text-xs text-gray-600 mt-1 max-w-96"><%= config_hint(field_hint) %></p>
    <% end %>

  <% else %>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      <%= field_label %>
      <% if field_required %>
        <span class="text-red-500">*</span>
      <% end %>
    </label>

    <% if field_type == :select %>
      <% selected_value = value.presence || field_default %>
      <select name="config_fields[<%= field_name %>]"
              class="w-full font-mono text-sm p-2 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat"
              data-config-field="<%= field_name %>"
              <%= 'disabled' if field_depends_on %>
              <% if field_depends_on %>data-depends-on="<%= field_depends_on %>"<% end %>>
        <option value="">Select...</option>
        <%# Options are bare strings, or [label, value] pairs where the stored
            value needs explaining — "block_all" says nothing on its own. %>
        <% field_options.each do |option| %>
          <% label, option_value = option.is_a?(Array) ? option : [ option, option ] %>
          <option value="<%= option_value %>"<% if selected_value.to_s == option_value.to_s %> selected<% end %>><%= label %></option>
        <% end %>
      </select>
      <% if field_hint %>
        <p class="text-xs text-gray-500 mt-1"><%= config_hint(field_hint) %></p>
      <% end %>

    <% elsif field_type == :textarea %>
      <textarea name="config_fields[<%= field_name %>]"
                rows="<%= field_config[:rows] || 3 %>"
                class="w-full font-mono text-sm p-2 border border-gray-300"
                placeholder="<%= field_placeholder %>"
                data-config-field="<%= field_name %>"
                <%= 'required' if field_required %>><%= value %></textarea>
      <% if field_hint %>
        <p class="text-xs text-gray-500 mt-1"><%= config_hint(field_hint) %></p>
      <% end %>

    <% else # text input %>
      <input type="text"
             name="config_fields[<%= field_name %>]"
             value="<%= value %>"
             placeholder="<%= field_placeholder %>"
             class="w-full font-mono text-sm p-2 border border-gray-300"
             data-config-field="<%= field_name %>"
             <%= 'required' if field_required %>
             <%= 'disabled' if field_depends_on %>
             <% if field_depends_on %>data-depends-on="<%= field_depends_on %>"<% end %>>
      <% if field_hint %>
        <p class="text-xs text-gray-500 mt-1"><%= config_hint(field_hint) %></p>
      <% end %>
    <% end %>
  <% end %>
</div>
