<%= form_with url: form_url,
              method: :patch,
              id: "#{resource_type}-form",
              data: {
                editor_target: "form",
                action: "submit->editor#save"
              } do |form| %>
  <% if show_metadata %>
    <%= render 'shared/metadata_editor',
        metadata: metadata,
        resource_type: resource_type,
        item: defined?(item) ? item : nil %>
  <% end %>

  <div>
    <!-- Sticky container for buttons + TOC -->
    <%# reveal: a markdown check can be started from the sticky drawer at the
        bottom of the window, with this toolbar scrolled away or its lower half
        auto-hidden. Opening the results panel expands the region and brings the
        toolbar back into view, so the results land somewhere visible. %>
    <div data-controller="sticky-toolbar"
         data-action="markdown-doctor:opened->sticky-toolbar#reveal"
         class="sticky top-0 z-10 bg-white border-b border-gray-300">
          <!-- Button bar -->
          <div class="flex justify-start gap-6 items-center py-2 px-2 border-x border-5 border-gray-300">
            <div class="flex gap-4">
            <div class="flex gap-1">
          <button type="button" data-action="click->editor#insertBold" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]"><strong>B</strong></button>
          <button type="button" data-action="click->editor#insertItalic" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]"><em>I</em></button>
          <button type="button" data-action="click->editor#insertStrike" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]"><s>S</s></button>
          <button type="button" data-action="click->editor#insertMark" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]" title="Highlight"><mark class="bg-amber-400 px-0.5">H</mark></button>
        </div>
        <div class="flex gap-1">
          <button type="button" data-action="click->editor#insertUnorderedList" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] text-nowrap">• List</button>
          <button type="button" data-action="click->editor#insertOrderedList" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] text-nowrap">1. List</button>
          <button type="button" data-action="click->editor#insertLink" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">🔗</button>
          <button type="button" data-action="click->editor#insertFootnote" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">f<sup>1</sup></button>
        </div>
        <div class="flex gap-1">
          <div class="relative inline-flex" data-gallery-builder-target="wrap">
            <button type="button" data-action="click->gallery-builder#toggle" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">Gallery</button>
            <div data-gallery-builder-target="menu" class="hidden absolute top-full left-0 mt-1 bg-white border border-gray-800 shadow-lg z-20 p-3" style="min-width: 260px;">
              <label class="flex items-center gap-2 text-xs mb-2 text-gray-700">
                <input type="checkbox" data-gallery-builder-target="carousel" data-action="change->gallery-builder#updateRatioNote" class="h-4 w-4 border-gray-300 rounded">
                Display as carousel?
              </label>
              <select data-gallery-builder-target="aspect" data-action="change->gallery-builder#updateRatioNote" class="w-full mb-2 border border-gray-300 rounded-xs px-2 py-1 text-xs">
                <%# From GalleryBuilderSchema, so the menu and the renderer's
                    directive checking can't drift apart. One entry per shape:
                    `landscape`, `film` and `auto` are synonyms of TV, Cinema
                    and Original, and stay valid to type by hand. %>
                <option value="">Aspect ratio (default)</option>
                <% GalleryBuilderSchema::MENU_RATIOS.each do |ratio| %>
                  <option value="<%= ratio[:value] %>"><%= ratio[:label] %></option>
                <% end %>
              </select>
              <p data-gallery-builder-target="ratioNote" class="hidden text-xs text-red-600 mb-2">Slideshow will ignore aspect ratio</p>
              <input type="text" data-gallery-builder-target="caption" data-action="keydown.enter->gallery-builder#insert" placeholder="Caption this gallery (empty = no caption)" class="w-full mb-2 border border-gray-300 rounded-xs px-2 py-1 text-xs">

              <%# The gallery's images, however they got here: picked from the
                  media modal, or read out of a selection the author made in the
                  editor before opening this. Filenames only — the thumbnails
                  are the picker's job. %>
              <div data-gallery-builder-target="imageList"
                   class="hidden mb-2 max-h-32 overflow-y-auto border border-gray-200 bg-gray-50 rounded-xs text-xs font-mono"></div>

              <div class="flex gap-1 mb-2">
                <%# ADD IMAGES opens the media picker, which hands its selection
                    back here rather than writing markdown of its own. %>
                <button type="button"
                        data-gallery-builder-target="addImages"
                        data-action="click->gallery-builder#pickImages"
                        class="uppercase text-xs px-3 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs flex-1">
                  Add Images
                </button>
                <button type="button"
                        data-gallery-builder-target="clear"
                        data-action="click->gallery-builder#clearImages"
                        class="hidden uppercase text-xs px-3 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs flex-1">
                  Clear
                </button>
              </div>

              <button type="button" data-action="click->gallery-builder#insert" class="uppercase text-xs px-3 py-1 border border-gray-800 bg-gray-800 text-white hover:bg-gray-700 font-mono rounded-xs w-full">Insert</button>
            </div>
          </div>
          <div class="relative inline-flex">
            <button type="button"
                    data-action="click->editor#toggleCardMenu"
                    class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] text-nowrap items-center">
              Card <span class="text-base leading-0">▼</span>
            </button>
            <div data-editor-target="cardMenu" class="hidden absolute top-full left-0 mt-1 bg-white border border-gray-800 shadow-lg z-20" style="min-width: 150px;">
              <button type="button"
                      data-action="click->card-builder#open"
                      data-card-type="pullquote"
                      class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs">Pull Quote</button>
              <button type="button"
                      data-action="click->card-builder#open"
                      data-card-type="post-link"
                      class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs">Post Link</button>
              <button type="button"
                      data-action="click->card-builder#open"
                      data-card-type="aside"
                      class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs">Aside</button>
              <% if store_enabled? %>
                <button type="button"
                        data-action="click->card-builder#open"
                        data-card-type="product-link"
                        class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs">Product Link</button>
              <% end %>
            </div>
          </div>
          <button type="button" data-action="click->collection-builder#open" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">Collection</button>
          <% if store_enabled? || members_enabled? %>
            <div class="relative inline-flex" data-action-builder-menu>
              <button type="button"
                      data-action="click->action-builder#toggleMenu"
                      class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] text-nowrap items-center">
                Action <span class="text-base leading-0">▼</span>
              </button>
              <div data-action-builder-target="menu" class="hidden absolute top-full left-0 mt-1 bg-white border border-gray-800 shadow-lg z-20" style="min-width: 150px;">
                <button type="button"
                        data-action="click->action-builder#open"
                        data-action-block="button"
                        class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs">Button</button>
                <% if members_enabled? %>
                  <button type="button"
                          data-action="click->action-builder#open"
                          data-action-block="form"
                          class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs">Form</button>
                <% end %>
                <% if payments_enabled? %>
                  <%# Shortcut: opens the Form modal already set to paid_content. %>
                  <button type="button"
                          data-action="click->action-builder#open"
                          data-action-block="form"
                          data-action-kind="paid_content"
                          class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs">Paywall</button>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if store_enabled? && resource_type == "product" %>
            <%# On a product page, scaffold this product's body from its own
                metadata. (Product-link cards live in the Card ▼ menu.) %>
            <button type="button"
                    data-action="click->editor#showProductPrompt"
                    class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
              Product
            </button>
          <% end %>
          <div class="relative inline-flex">
            <button type="button"
                    data-action="click->editor#toggleMediaMenu"
                    class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] text-nowrap items-center">
              Media <span class="text-base leading-0">▼</span>
            </button>
            <div data-editor-target="mediaMenuDropdown" class="hidden absolute top-full right-0 mt-1 bg-white border border-gray-800 shadow-lg z-20" style="min-width: 120px;">
              <button type="button"
                      data-action="click->editor#openMediaPicker"
                      data-media-type="images"
                      class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono">Images</button>
              <button type="button"
                      data-action="click->editor#openMediaPicker"
                      data-media-type="audio"
                      class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono">Audio</button>
              <button type="button"
                      data-action="click->editor#openMediaPicker"
                      data-media-type="video"
                      class="block w-full text-left px-3 py-1.5 hover:bg-gray-100 text-xs font-mono">Video</button>
            </div>
          </div>
        </div>
      </div>
    </div><!-- /flex justify-start gap-6 -->

      <!-- Auto-hide region: TOC toggle + panel collapse on scroll-
           down and reappear on scroll-up. The primary button bar
           above stays visible at all times. The sticky-toolbar
           Stimulus controller animates max-height inline on this
           element and uses clamp detection to avoid the scroll-
           feedback oscillation that height changes can cause. -->
      <div data-sticky-toolbar-target="collapsible"
           class="overflow-hidden transition-[max-height] duration-200 ease-out">
        <%# Tab strip. Table of contents on the left, markdown check on the
            right, sharing one row and the panel space beneath it. Only one is
            open at a time — stacked, two panels would push the writing area
            off the screen — so each toggle closes the other.

            No bottom padding on the row: the tabs have their own, so they reach
            the panel's top edge and can join it. The whole active-tab look
            (background, border) lives in application.css — see .editor-tab. %>
        <div class="editor-tabs flex items-center gap-1 px-1.5 py-1 border-t border-x border-gray-300">
          <button type="button"
                  data-action="click->editor#toggleTOC click->markdown-doctor#closePanel"
                  class="editor-tab editor-tab-toc text-xs text-gray-600 hover:text-gray-900 text-nowrap">
            Table of Contents
            <span data-editor-target="tocArrow" class="text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none text-blue-800 cursor-pointer">▶</span>
          </button>

          <%# Present only while there's something to read. Arriving and leaving
              costs no vertical space — the table-of-contents tab sets the row's
              height — so it can follow the writing without shoving the page
              around. Nothing here opens on its own; that's always a click. %>
          <button type="button"
                  data-markdown-doctor-target="toggleRow"
                  data-action="click->markdown-doctor#togglePanel click->editor#closeTOC"
                  class="editor-tab editor-tab-markdown hidden text-xs text-gray-600 hover:text-gray-900 text-nowrap">
            Markdown Check
            <%# Collapsed to start: the tab now arrives on its own when a check
                finds something, with the panel still closed. %>
            <span data-markdown-doctor-target="arrow"
                  class="text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none text-blue-800 cursor-pointer">▶</span>
          </button>

          <%# Status. Green says the markdown is fine, amber that something's
              worth a look — the same two colours the save dot uses, since it's
              the same question asked about a different thing. Grey until the
              first check answers, so a document with problems never flashes
              green on the way in. The dot is decorative; the text beside it
              carries the meaning, which is what a screen reader will read.

              Both sit outside the panel so they stay legible with it closed —
              which, for a clean document, is the only state there is.

              Undo is here rather than in the Fixable section because a
              successful Fix All empties that section, which is exactly when undo
              is wanted. The fix only touches the textarea, so Ctrl+Z and "don't
              save" already undo it; this just makes one click reversible in one. %>
          <span data-markdown-doctor-target="dot" aria-hidden="true"
                class="inline-block w-2 h-2 rounded-full bg-gray-300 ml-1 shrink-0"></span>
          <span data-markdown-doctor-target="summary" class="text-xs text-gray-500 ml-1.5"></span>
          <button type="button"
                  data-markdown-doctor-target="revertButton"
                  data-action="click->markdown-doctor#revert"
                  class="hidden uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer">
            Undo Fix
          </button>
        </div>

        <%# Two sections, because the distinction is what the writer acts on:
            things Roe can safely rewrite (with the Fix All button beside that
            heading) and things only they can decide about.

            keep-open pins the auto-hide region open while this panel is showing
            — see sticky_toolbar_controller. Scrolling shouldn't swallow results
            the writer just asked for. The TOC is deliberately not pinned. %>
        <div data-markdown-doctor-target="panel"
             data-sticky-toolbar-keep-open
             class="editor-panel-markdown hidden border-t border-gray-300 bg-gray-50 p-3 max-h-60 overflow-y-auto">

          <div data-markdown-doctor-target="fixableSection" class="hidden mb-3">
            <div class="flex items-center gap-2 mb-1">
              <h4 class="text-xs font-semibold text-gray-700">
                Fixable <span data-markdown-doctor-target="fixableCount" class="text-gray-500"></span>
              </h4>
              <button type="button"
                      data-markdown-doctor-target="fixButton"
                      data-action="click->markdown-doctor#fixAll"
                      class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-amber-200 hover:bg-amber-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer">
                Fix All
              </button>
            </div>
            <div data-markdown-doctor-target="fixableList" class="text-xs font-mono space-y-1"></div>
          </div>

          <div data-markdown-doctor-target="manualSection" class="hidden">
            <h4 class="text-xs font-semibold text-gray-700 mb-1">
              Needs your attention <span data-markdown-doctor-target="manualCount" class="text-gray-500"></span>
            </h4>
            <div data-markdown-doctor-target="manualList" class="text-xs font-mono space-y-1"></div>
          </div>

          <p data-markdown-doctor-target="clean" class="hidden text-xs text-gray-600">
            No formatting issues found.
          </p>
        </div>

        <!-- TOC Panel — shares the tab strip above with the markdown check -->
        <div data-editor-target="tocPanel"
          class="editor-panel-toc hidden border-t border-gray-300 bg-gray-50 p-3 max-h-60 overflow-y-auto transition-all"
          data-action="mouseenter->editor#restoreTocOpacity">
          <div data-editor-target="tocContent" class="text-sm font-mono">
            <!-- TOC will be rendered here -->
          </div>
        </div>
      </div>
    </div><!-- /sticky-toolbar -->

    <!-- Textarea — inside the wrapper so the sticky bar's containing
         block extends down through the textarea. Without this, the
         sticky bar's range is only ~80px (just the toolbar+TOC), and
         it scrolls out of view as soon as you start editing. -->
    <%# No top border: the sticky toolbar above already ends in one
        (border-b border-gray-300), and two adjacent 1px lines read as a
        thick grey bar. border-x/border-b are WIDTH utilities — border-l-gray-300
        and friends only set a colour, and Tailwind's preflight zeroes every
        border width, so naming colours alone leaves no border at all. %>
    <%= form.text_area :content, value: content,
            placeholder: "Start writing…",
            class: "w-full font-mono text-sm p-1 border-x border-b border-gray-300 bg-white resize-none overflow-hidden pb-96 focus:placeholder-transparent",
            data: {
              editor_target: "textarea",
              action: "input->editor#hideFlashOnInput input->editor#updateTOC " \
                      "markdown-doctor:contentChanged->editor#refreshPreview"
            },
            id: "content-textarea" %>
  </div>

  <!-- Media Picker Modal -->
  <div data-editor-target="mediaPickerModal"
       class="fixed inset-0 z-50 items-center justify-center"
       style="display: none;">
    <!-- Backdrop: clicking this closes the modal -->
    <div class="absolute inset-0 bg-black/50"
         data-action="click->editor#closeMediaPicker"></div>
    <!-- Modal content: clicks here do NOT close the modal -->
    <div class="relative bg-white border border-gray-300 shadow-xl flex flex-col"
         style="width: 80vw; height: 80vh; max-width: 1200px;">
      <div data-editor-target="mediaPickerContent" class="flex flex-col h-full">
        <div class="flex items-center justify-center h-full text-gray-400 font-mono text-sm">Loading...</div>
      </div>
      <button type="button"
              data-action="click->editor#closeMediaPicker"
              class="absolute top-3 right-3 w-7 h-7 flex items-center justify-center border border-gray-400 bg-white hover:bg-gray-100 text-gray-600 text-sm font-mono z-10">
        ×
      </button>
    </div>
  </div>

  <%= render "shared/collection_builder" %>
  <%= render "shared/card_builder" %>
  <% if store_enabled? || members_enabled? %>
    <%= render "shared/action_builder" %>
  <% end %>
<% end %>
