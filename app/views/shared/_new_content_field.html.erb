<%# One field row on a NEW <thing> form.
    Locals: field (name/type/label/hint/required/options), id (the input's id).

    Labelled with its frontmatter key rather than a prose label, matching the
    metadata editor and the file the writer ends up with. Three shapes:
    a select when the field has options, a media input with the editor's
    picker, and plain text — which also carries the advisory uniqueness check
    when the field is one writers expect to be unique. %>
<% name = field[:name].to_s %>
<% options = field[:options].respond_to?(:call) ? field[:options].call : field[:options] %>
<% media_type = { "audio" => "audio", "video" => "video", "image" => "images" }[name] %>
<div>
  <label class="block font-mono text-xs text-gray-700 mb-1" for="<%= id %>">
    <%= name %><% if field[:required] %><span class="text-red-600 relative -top-0.5"><sup>*</sup></span><% end %>
  </label>

  <% if options.present? %>
    <select name="fields[<%= name %>]" id="<%= id %>"
            class="w-full bg-white font-mono text-sm p-1.5 border border-gray-300 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat">
      <option value="">—</option>
      <% options.each do |opt| %>
        <option value="<%= opt %>"><%= opt %></option>
      <% end %>
    </select>

  <% elsif media_type %>
    <%# The same picker the editor uses — upload or choose an existing file
        rather than typing a path by hand. %>
    <div class="flex items-center gap-2">
      <input type="text" name="fields[<%= name %>]" id="<%= id %>"
             class="flex-1 bg-white font-mono text-sm p-1.5 border border-gray-300"
             placeholder="<%= field[:hint] %>">
      <button type="button"
              class="shrink-0 uppercase text-xs px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-200 font-mono rounded-xs"
              data-action="click->new-content#openPicker"
              data-media-type="<%= media_type %>"
              data-field-id="<%= id %>">Choose</button>
    </div>

  <% elsif name == "sku" %>
    <%# Snipcart keys the cart on the SKU, so a product needs one. Generate
        suggests the same identifier the editor's generator would, from the
        title and category already on this form; it's checked for collisions
        like any other unique value. %>
    <div class="flex items-center gap-2">
      <input type="text" name="fields[sku]" id="<%= id %>"
             class="flex-1 bg-white font-mono text-sm p-1.5 border border-gray-300"
             placeholder="<%= field[:hint] %>"
             data-new-content-target="sku"
             data-action="input->new-content#checkSku">
      <button type="button"
              class="shrink-0 uppercase text-xs px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-200 font-mono rounded-xs"
              data-action="click->new-content#generateSku">Generate</button>
    </div>
    <p class="mt-1 text-xs text-gray-500">Pattern: CATEGORY-NUMBER-TITLE-DETAILS</p>

  <% else %>
    <input type="text" name="fields[<%= name %>]" id="<%= id %>"
           class="w-full bg-white font-mono text-sm p-1.5 border border-gray-300"
           placeholder="<%= field[:hint] %>"
           <% if Post::UNIQUE_FIELDS.key?(name) %>
             data-action="input->new-content#checkUnique"
             data-unique-field="<%= name %>"
             data-unique-scope-fields="<%= Post::UNIQUE_FIELDS[name].join(',') %>"
           <% end %>>
  <% end %>

  <% if Post::UNIQUE_FIELDS.key?(name) || name == "sku" %>
    <p class="mt-1 text-xs text-amber-700" data-unique-warning hidden></p>
  <% end %>
</div>
