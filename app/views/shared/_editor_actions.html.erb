<%# Full editor action header. Primary row (Save / Preview / (Un)publish +
    save-state indicator) wrapped in #primary-actions — the anchor the sticky
    bottom drawer watches — plus a secondary row (View / Send Test) and the
    right column (Duplicate / Delete). Which controls appear is derived from
    resource_type, so a new type "just works" and future tweaks live here.
    Sits inside the editor Stimulus controller.

      post/page/product → publish, view, duplicate, delete (+ send test on posts)
      email             → save + preview only

    Locals: resource, resource_type. %>
<% type_actions = %w[post page product].include?(resource_type) %>
<% viewable = type_actions && %w[published unlisted].include?(resource.metadata["status"].to_s.downcase) %>
<% send_test = resource_type == "post" && newsletters_enabled? %>
<div class="mb-5 flex justify-between items-start">
  <div class="flex flex-col gap-1.5">

    <!-- Primary actions (mirrored in the bottom drawer). #primary-actions is
         the anchor the drawer's IntersectionObserver watches. -->
    <div id="primary-actions">
      <%= render "shared/editor_primary_actions", resource: resource, resource_type: resource_type %>
    </div>

    <!-- Secondary actions: View / Send Test -->
    <% if viewable || send_test %>
      <div class="flex gap-1 items-baseline">
        <% if viewable %>
          <%= link_to "View", resource.public_url, target: "_blank",
                class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.2rem]" %>
        <% end %>
        <% if send_test %>
          <button type="button"
                  data-action="click->editor#sendTestEmail"
                  data-editor-test-email-url="<%= send_test_email_admin_post_path(resource) %>"
                  data-editor-default-email="<%= SiteConfig.current('site')&.config&.dig('author_email') %>"
                  class="uppercase text-xs px-1.5 py-0 border border-blue-600 bg-blue-50 hover:bg-blue-100 text-blue-700 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] flex">
            <span class="pt-[0.1rem]">Send Test</span>
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 18.9844 13.3496" class="max-w-4 inline-block ml-2 my-0">
            <g>
              <rect height="13.3496" opacity="0" width="18.9844" x="0" y="0"/>
              <path d="M2.49023 13.3496L16.4062 13.3496C17.793 13.3496 18.623 12.5391 18.623 10.8984L18.623 2.46094C18.623 0.820312 17.7832 0.00976562 16.1328 0.00976562L2.2168 0.00976562C0.820312 0.00976562 0 0.820312 0 2.46094L0 10.8984C0 12.5391 0.830078 13.3496 2.49023 13.3496ZM2.43164 12.0215C1.73828 12.0215 1.33789 11.6406 1.33789 10.8984L1.33789 2.45117C1.33789 1.71875 1.73828 1.33789 2.43164 1.33789L16.1816 1.33789C16.8848 1.33789 17.2852 1.71875 17.2852 2.46094L17.2852 10.9082C17.2852 11.6406 16.8848 12.0215 16.1816 12.0215ZM13.5645 5.13672L15.5078 5.13672C15.8496 5.13672 16.1035 4.88281 16.1035 4.54102L16.1035 3.125C16.1035 2.7832 15.8496 2.5293 15.5078 2.5293L13.5645 2.5293C13.2227 2.5293 12.9688 2.7832 12.9688 3.125L12.9688 4.54102C12.9688 4.88281 13.2227 5.13672 13.5645 5.13672ZM6.36719 7.95898L12.2461 7.95898C12.5488 7.95898 12.7832 7.72461 12.7832 7.42188C12.7832 7.12891 12.5488 6.89453 12.2461 6.89453L6.36719 6.89453C6.07422 6.89453 5.83008 7.12891 5.83008 7.42188C5.83008 7.72461 6.07422 7.95898 6.36719 7.95898ZM6.36719 10.0293L10.791 10.0293C11.0938 10.0293 11.3281 9.78516 11.3281 9.49219C11.3281 9.19922 11.0938 8.95508 10.791 8.95508L6.36719 8.95508C6.07422 8.95508 5.83008 9.19922 5.83008 9.49219C5.83008 9.78516 6.07422 10.0293 6.36719 10.0293Z" fill="black" fill-opacity="0.85"/>
            </g>
            </svg>
          </button>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Unpublish confirmation modal — only present when there's a published
      item to take down (the Unpublish button is showing). %>
  <% if type_actions && resource.published? %>
    <%= render "shared/unpublish_modal", resource: resource, resource_type: resource_type %>
  <% end %>

  <!-- Right: Duplicate + Delete -->
  <% if type_actions %>
    <div class="flex items-center gap-1">
      <%= button_to "Duplicate", send("duplicate_admin_#{resource_type}_path", resource), method: :post,
            form: { class: "inline" },
            class: "uppercase text-xs px-1.5 py-0 border border-gray-600 bg-gray-50 hover:bg-gray-100 text-gray-700 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer" %>
      <%# Triggers the same type-DELETE modal the index tables use. It was a
          button_to with turbo_confirm, so deleting from the editor got the
          browser's one-line confirm while deleting the identical file from
          the index asked you to type DELETE — the weaker guard on the screen
          where you've just been editing the thing. %>
      <button type="button"
              data-action="delete"
              data-resource-id="<%= resource.id %>"
              data-resource-title="<%= resource.title || resource.try(:filename) || "this #{resource_type}" %>"
              data-resource-type="<%= resource_type %>"
              class="uppercase text-xs px-1.5 py-0 border border-red-600 bg-red-50 hover:bg-red-100 text-red-700 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer">
        Delete
      </button>
    </div>
  <% end %>
</div>

<%# Rendered here rather than by each edit view, so the button and the modal it
    opens can't drift apart. They had: products/edit never rendered it, so its
    Delete would have opened nothing at all.

    No data-delete-url on the button above — a single-resource page keeps the
    form action this partial renders, which delete_modal.js relies on. %>
<% if type_actions %>
  <%= render "shared/delete_file_modal", resource: resource, resource_type: resource_type %>
<% end %>
