<h1>All Posts</h1>

<ul class="post-list">
  <% @posts.each do |post| %>
    <li>
      <h2>
        <%= link_to post.title, post_path(url_name: post.url_name) %>
      </h2>
      <div class="post-meta">
        <% if post.date %>
          <time datetime="<%= post.date %>">
            <%= post.date.strftime("%B %d, %Y") %>
          </time>
        <% end %>
        <% if post.author %>
          <span>• <%= post.author %></span>
        <% end %>
      </div>
    </li>
  <% end %>
</ul>
