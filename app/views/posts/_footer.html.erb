<footer class="post-footer">
  <% if post.tags.present? %>
    <div class="post-tags">
      <% post.tags.each do |tag| %>
        <%= link_to tag, collection_tag_path(tag), class: "tag" %>
      <% end %>
    </div>
  <% end %>

  <%= link_to "← Back to all posts", root_path, class: "back-link" %>
</footer>
