<% if @podcast_episodes.present?
     current_index = @podcast_episodes.index { |e| e.url_name == post.url_name }
     # Episodes are newest-first, so "next" is older (higher index), "prev" is newer (lower index)
     prev_episode = current_index && current_index > 0 ? @podcast_episodes[current_index - 1] : nil
     next_episode = current_index && current_index < @podcast_episodes.length - 1 ? @podcast_episodes[current_index + 1] : nil
   end %>
<div class="podcast-episode">

  <% has_cover = post.metadata['image'].present? %>
  <div class="podcast-hero <%= 'is-no-cover' unless has_cover %>">
    <% if has_cover %>
      <%# raw ResponsiveImageRenderer.render(post.metadata['image'], alt: post.title) %>
    <% end %>
    <div class="hero-player">
      <%= render 'posts/media_player', post: post, podcast_config: @podcast_config, prev_episode: prev_episode, next_episode: next_episode %>
    </div>
  </div>

  <div class="post-content">
    <%= render_post_content(post) %>
  </div>

  <% if @podcast_config.present? || post.metadata['podcast'].present? %>
    <div class="podcast-subscribe">
      <% if post.metadata['podcast'].present? %>
        <%# Show public feed unless podcast is paid-only (admins always see it) %>
        <% if authenticated? || @podcast_config&.dig('audience') != 'paid' %>
          <a href="/podcast/<%= post.metadata['podcast'] %>.xml" class="feed-link" target="_blank">
            RSS Feed
          </a>
        <% end %>
        <%# Show private feed to paid members and admins %>
        <% if authenticated? %>
          <a href="/podcast/<%= post.metadata['podcast'] %>/private.xml" class="feed-link feed-link-private" target="_blank">
            Private RSS Feed (Paid)
          </a>
        <% elsif current_member&.paid? && current_member&.active? %>
          <a href="/podcast/<%= post.metadata['podcast'] %>/private.xml?token=<%= current_member.access_token %>" class="feed-link feed-link-private" target="_blank">
            Private RSS Feed (Paid)
          </a>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <% if @podcast_episodes.present? && @podcast_episodes.length > 1 %>
    <div class="episode-list">
      <h2>All Episodes</h2>
      <ol>
        <% @podcast_episodes.each do |episode| %>
          <li class="episode-item <%= 'is-current' if episode.url_name == post.url_name %>">
            <a href="<%= post_path(episode.url_name) %>">
              <div class="episode-meta-row">
                <% if episode.metadata['season'].present? || episode.metadata['episode_number'].present? %>
                  <span class="episode-number">
                    <% if episode.metadata['season'].present? %>S<%= episode.metadata['season'] %><% end %>
                    <% if episode.metadata['episode_number'].present? %>E<%= episode.metadata['episode_number'] %><% end %>
                  </span>
                <% end %>
                <% if episode.metadata['duration'].present? %>
                  <span class="episode-duration"><%= format_duration(episode.metadata['duration']) %></span>
                <% end %>
                <% if episode.date.present? %>
                  <span class="episode-date"><%= episode.date.strftime("%-d %B %Y") rescue episode.date.to_s %></span>
                <% end %>
              </div>
              <span><%= episode.title %></span>
            </a>
          </li>
        <% end %>
      </ol>
    </div>
  <% end %>

</div>
