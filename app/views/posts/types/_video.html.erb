<%# A video post. The player is the same ```card type: player an author can
    put in the body — supplied here only when the body has none, and when
    content.yml's players.video is on (Post#show_template_player?). One
    player either way. %>
<% if post.show_template_player? %>
  <%= render "posts/template_player", post: post %>
<% end %>

<div class="post-content">
  <%= render_post_content(post) %>
</div>
