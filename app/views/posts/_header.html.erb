<header class="post-header">
  <div class="post-header-top">
    <h1 class="post-title"><%= post.title %></h1>
    <div>
      <%# Feed links %>
      <% if post.post_type == 'podcast' && post.metadata['podcast'].present? %>
        <%# Same rule the feed itself uses — a paid show with free episodes
            has a public feed, so it gets a link. %>
        <% if authenticated? || PodcastConfig.public_feed?(post.metadata['podcast']) %>
          <a href="/podcast/<%= post.metadata['podcast'] %>.xml" class="feed-link" target="_blank" title="RSS Feed">RSS</a>
        <% end %>
        <% if authenticated? %>
          <a href="/podcast/<%= post.metadata['podcast'] %>/private.xml" class="feed-link feed-link-private" target="_blank" title="Private RSS Feed (Paid)">RSS (Paid)</a>
        <% elsif current_member&.paid? && current_member&.active? %>
          <a href="/podcast/<%= post.metadata['podcast'] %>/private.xml?token=<%= current_member.media_token %>" class="feed-link feed-link-private" target="_blank" title="Private RSS Feed (Paid)">RSS (Paid)</a>
        <% end %>
      <%# A music track links to its release's feed, the same way an episode
          links to its show's. Only when the release actually publishes one —
          most releases won't. %>
      <% elsif post.post_type == 'music' && ReleaseConfig.feed_enabled?(post.metadata['release']) %>
        <% release_key = post.metadata['release'] %>
        <% if authenticated? || !ReleaseFeed.new(release_key).paid? %>
          <a href="/music/<%= release_key %>.xml" class="feed-link" target="_blank" title="RSS Feed">RSS</a>
        <% end %>
        <% if authenticated? %>
          <a href="/music/<%= release_key %>/private.xml" class="feed-link feed-link-private" target="_blank" title="Private RSS Feed (Paid)">RSS (Paid)</a>
        <% elsif current_member&.paid? && current_member&.active? %>
          <a href="/music/<%= release_key %>/private.xml?token=<%= current_member.media_token %>" class="feed-link feed-link-private" target="_blank" title="Private RSS Feed (Paid)">RSS (Paid)</a>
        <% end %>
      <% elsif post.post_type == 'newsletter' || post.post_type == 'article' %>
        <a href="/feed.xml" class="feed-link" target="_blank" title="RSS Feed">RSS</a>
      <% end %>
    </div>
  </div>
  <% if post.subtitle %>
    <p class="post-subtitle"><%= post.subtitle %></p>
  <% end %>

  <div class="post-meta">
    <% if post.date %>
      <time class="post-date" datetime="<%= post.date %>">
        <%= post.date.strftime("%B %d, %Y") %>
      </time>
    <% end %>
    <% display_author = post.author.presence || podcast_config&.dig('author') %>
    <% if display_author %>
      <span class="post-author"> • <%= display_author %></span>
    <% end %>
  </div>
  <% if post.image && post.metadata['image_in_header'].to_s == 'true' %>
    <%= ResponsiveImageRenderer.render(post.image, alt: post.title, class: "post-image", sizes: "(min-width: 1020px) 8rem, 100vw") %>
  <% end %>
</header>
