<header class="post-header">
  <h1 class="page-title"><%= post.title %></h1>

  <% if post.subtitle %>
    <p class="page-subtitle"><%= post.subtitle %></p>
  <% end %>

  <div class="post-meta">
    <% if post.date %>
      <time datetime="<%= post.date %>">
        <%= post.date.strftime("%B %d, %Y") %>
      </time>
    <% end %>
    <% if post.author %>
      <span>• <%= post.author %></span>
    <% end %>
  </div>
</header>
