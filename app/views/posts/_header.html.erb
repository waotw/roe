<header class="post-header">
  <div class="post-header-top">
    <h1><%= post.title %></h1>
    <div>
      <%# Feed links %>
      <% if post.post_type == 'podcast' && post.metadata['podcast'].present? %>
        <% if authenticated? || @podcast_config&.dig('audience') != 'paid' %>
          <a href="/podcast/<%= post.metadata['podcast'] %>.xml" class="feed-link" target="_blank" title="RSS Feed">RSS</a>
        <% end %>
        <% if authenticated? %>
          <a href="/podcast/<%= post.metadata['podcast'] %>/private.xml" class="feed-link feed-link-private" target="_blank" title="Private RSS Feed (Paid)">RSS (Paid)</a>
        <% elsif current_member&.paid? && current_member&.active? %>
          <a href="/podcast/<%= post.metadata['podcast'] %>/private.xml?token=<%= current_member.access_token %>" class="feed-link feed-link-private" target="_blank" title="Private RSS Feed (Paid)">RSS (Paid)</a>
        <% end %>
      <% elsif post.post_type == 'newsletter' || post.post_type == 'article' %>
        <a href="/feed.xml" class="feed-link" target="_blank" title="RSS Feed">RSS</a>
      <% end %>
    </div>
  </div>
  <% if post.subtitle %>
    <p><%= post.subtitle %></p>
  <% end %>

  <div class="post-meta">
    <% if post.date %>
      <time datetime="<%= post.date %>">
        <%= post.date.strftime("%B %d, %Y") %>
      </time>
    <% end %>
    <% display_author = post.author.presence || @podcast_config&.dig('author') %>
    <% if display_author %>
      <span>• <%= display_author %></span>
    <% end %>
  </div>
  <% if post.image && post.metadata['image_in_header'].to_s == 'true' %>
    <%= raw ResponsiveImageRenderer.render(post.image, alt: post.title, sizes: "(min-width: 1020px) 8rem, 100vw") %>
  <% end %>
</header>
