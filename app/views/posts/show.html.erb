<article>
  <header class="post-header">
    <h1 class="page-title"><%= @post.title %></h1>

    <% if @post.subtitle %>
      <p class="page-subtitle"><%= @post.subtitle %></p>
    <% end %>

    <div class="post-meta">
      <time datetime="<%= @post.date %>">
        <%= @post.date.strftime("%B %d, %Y") %>
      </time>
      <% if @post.author %>
        <span>• <%= @post.author %></span>
      <% end %>
    </div>
  </header>

  <div class="content">
    <%= raw @post.to_html %>
  </div>

  <%= link_to "← Back to all posts", root_path, class: "back-link" %>
</article>
