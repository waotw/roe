<%# The post's layout (site/layout/content/<type>.yml, or Roe's own) draws
    everything inside the article: header, player, body, subscribe links.
    See ContentLayoutHelper. %>
<article class="post post-<%= @post.post_type %>">
  <div class="content">
    <%= render_content_layout(@post) %>
  </div>
</article>

<%= render 'shared/preview_auto_refresh' if params[:preview] == 'true' %>
