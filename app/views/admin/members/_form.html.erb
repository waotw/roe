<%= form_with(model: [:admin, member], class: "space-y-6") do |f| %>
  <% if member.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 border border-red-200">
      <div class="text-sm text-red-700">
        <ul class="list-disc pl-5 space-y-1">
          <% member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div>
    <%= f.label :email, class: "block text-sm font-medium text-gray-700 uppercase" %>
    <%= f.email_field :email, class: "mt-1 block w-full rounded-xs border border-gray-500 focus:border-blue-50 focus:ring-blue-300 text-sm font-mono px-4 py-2", required: true %>
  </div>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-gray-700 uppercase" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-xs border border-gray-500 focus:border-blue-50 focus:ring-blue-300 text-sm font-mono px-4 py-2" %>
  </div>

  <div class="flex gap-6 pt-4">
    <%= f.submit class: "inline-flex items-center uppercase text-sm px-4 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs cursor-pointer" %>
    <%= link_to "Cancel", admin_members_path, class: "inline-flex items-center uppercase text-sm px-4 py-2 border border-gray-800 bg-gray-100 hover:bg-gray-300 font-mono rounded-xs" %>
  </div>
<% end %>
