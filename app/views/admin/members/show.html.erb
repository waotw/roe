<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center sm:justify-between">
    <div class="font-sans">
      <h1 class="text-3xl font-bold text-gray-900"><%= @member.name || @member.email %></h1>
      <p class="mt-2 text-sm text-gray-700"><%= @member.email %></p>
    </div>
    <div class="mt-4 sm:mt-0 flex gap-2">
      <% unless @member.anonymized? %>
        <%= link_to "Edit", edit_admin_member_path(@member), class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs" %>
      <% end %>
      <%= link_to "← Back to Members", admin_members_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-gray-100 hover:bg-gray-300 font-mono rounded-xs" %>
    </div>
  </div>

  <!-- Member Details Card -->
  <div class="mt-8 bg-white border border-gray-300 rounded-xs overflow-hidden">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 font-sans">Member Information</h3>
      <dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500 uppercase">Tier</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if @member.paid? %>
              <span class="inline-flex bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-500">Paid</span>
            <% else %>
              <span class="inline-flex bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-800">Free</span>
            <% end %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500 uppercase">Account Status</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if @member.active? %>
              <span class="inline-flex bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">Active</span>
            <% elsif @member.anonymized? %>
              <span class="inline-flex bg-gray-200 px-2 py-1 text-xs font-semibold text-gray-700">Deleted</span>
              <% if @member.cancelled_at %>
                <span class="mt-1 text-xs text-gray-500"><%= @member.cancelled_at.strftime("%b %d, %Y") %></span>
              <% end %>
            <% else %>
              <span class="inline-flex bg-red-100 px-2 py-1 text-xs font-semibold text-red-800">Cancelled</span>
            <% end %>
          </dd>
        </div>

        <!-- NEW: Newsletter Status -->
        <div>
          <dt class="text-sm font-medium text-gray-500 uppercase">Newsletter Status</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <% if @member.newsletter_subscribed? %>
              <span class="inline-flex bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">📬 Subscribed</span>
            <% elsif @member.newsletter_status == 'bounced' %>
              <span class="inline-flex bg-red-100 px-2 py-1 text-xs font-semibold text-red-800">⚠️ Bounced</span>
            <% else %>
              <span class="inline-flex bg-gray-100 px-2 py-1 text-xs font-semibold text-gray-800">🔕 Unsubscribed</span>
            <% end %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500 uppercase">Joined</dt>
          <dd class="mt-1 text-sm text-gray-900"><%= @member.subscribed_at&.strftime("%B %d, %Y at %I:%M %p") || @member.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
        </div>

        <% if @member.cancelled_at %>
          <div>
            <dt class="text-sm font-medium text-gray-500 uppercase">Cancelled</dt>
            <dd class="mt-1 text-sm text-gray-900"><%= @member.cancelled_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
          </div>
        <% end %>

        <%# Both tokens are regenerated when an account is deleted, so what's
            stored belongs to nobody and can't sign anyone in. Showing it just
            invites the question of whose it is. %>
        <% unless @member.anonymized? %>
        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500 uppercase">Access Token</dt>
          <dd class="mt-1 text-sm text-gray-900 font-mono bg-gray-50 p-2 border border-gray-200 rounded-xs break-all">
            <%= @member.access_token %>
          </dd>
          <p class="mt-1 text-xs text-gray-500 font-sans">
            <mark>Signs this member in.</mark> It's the magic-link token — treat it like a password
            and keep it out of anything shareable.
          </p>
        </div>

        <div class="sm:col-span-2">
          <dt class="text-sm font-medium text-gray-500 uppercase">Media Token</dt>
          <dd class="mt-1 text-sm text-gray-900 font-mono bg-gray-50 p-2 border border-gray-200 rounded-xs break-all">
            <%= @member.media_token %>
          </dd>
          <p class="mt-1 text-xs text-gray-500 font-sans">
            Read-only. Unlocks this member's private feeds and the files behind paid content —
            it can't sign anyone in. Appears in their feed URLs as
            <code>?token=…</code>
          </p>
        </div>
        <% end %>
      </dl>
    </div>
  </div>

  <!-- Actions Card -->
  <div class="mt-6 bg-white border border-gray-300 rounded-xs overflow-hidden">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 font-sans">Member Actions</h3>
      <div class="mt-5 space-y-4">
        <!-- Upgrade/Downgrade -->
        <%# The tier above stays as a matter of record — it says what they were
            when they left. Changing it is what stops making sense: there's no
            one to grant access to or bill. %>
        <% unless @member.anonymized? %>
        <div class="flex items-center justify-between">
          <% if @member.free? %>

            <div>
              <h4 class="text-sm font-medium text-gray-900">Upgrade to Paid</h4>
              <p class="text-sm text-gray-500 font-sans">Grant premium access and generate login password</p>
            </div>
            <%= button_to "Upgrade to Paid", upgrade_to_paid_admin_member_path(@member),
                method: :patch,
                class: "inline-flex items-center uppercase text-sm px-3 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs",
                form: { data: { turbo_confirm: "This will upgrade the member to paid tier and generate a password. Continue?" } } %>

          <% else %>

            <div>
              <h4 class="text-sm font-medium text-gray-900">Downgrade to Free</h4>
              <p class="text-sm text-gray-500 font-sans">Remove premium access and password</p>
            </div>
            <%= button_to "Downgrade to Free", downgrade_to_free_admin_member_path(@member),
                method: :patch,
                class: "inline-flex items-center uppercase text-sm px-3 py-2 border border-gray-800 bg-yellow-200 hover:bg-yellow-300 font-mono rounded-xs",
                form: { data: { turbo_confirm: "This will remove premium access. Continue?" } } %>

          <% end %>
        </div>
        <% end %>

        <!-- Cancel/Reactivate -->
        <div class="flex items-center justify-between border-t border-gray-200 pt-4">
          <% if @member.active? %>

            <div>
              <h4 class="text-sm font-medium text-gray-900">Cancel Membership</h4>
              <p class="text-sm text-gray-500 font-sans">Revoke access while preserving account data</p>
            </div>
            <%= button_to "Cancel Membership", cancel_membership_admin_member_path(@member),
                method: :patch,
                class: "inline-flex items-center uppercase text-sm px-3 py-2 border border-gray-800 bg-red-200 hover:bg-red-300 font-mono rounded-xs",
                form: { data: { turbo_confirm: "Cancel this membership?" } } %>

          <% elsif @member.anonymized? %>

            <div>
              <h4 class="text-sm font-medium text-gray-900">Account Deleted</h4>
              <p class="text-sm text-gray-500 font-sans">
                This person deleted their own account. Their name and email address
                are gone; the payment and delivery records below are kept. It can't
                be reactivated — there's no one left to sign in.
              </p>
            </div>

          <% else %>

            <div>
              <h4 class="text-sm font-medium text-gray-900">Reactivate Membership</h4>
              <p class="text-sm text-gray-500 font-sans">Restore access to this account</p>
            </div>
            <%= button_to "Reactivate", reactivate_membership_admin_member_path(@member),
                method: :patch,
                class: "inline-flex items-center uppercase text-sm px-3 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>

          <% end %>
        </div>

        <!-- Delete -->
        <%# What this button does depends on the member, so it has to say which.
            Someone with payments or newsletters behind them is anonymised —
            removing the row would take the site's own records with it. %>
        <% unless @member.anonymized? %>
          <div class="flex items-center justify-between border-t border-gray-200 pt-4">
            <div>
              <h4 class="text-sm font-medium text-gray-900">Delete Member</h4>
              <p class="text-sm text-gray-500 font-sans w-[80%]">
                <% if @member.erasable? %>

                  Remove this member account entirely. There are no payments or newsletters on this
                  account, this account will be entirely removed.

                <% else %>

                  Delete this account. All user indentifiable information will be removed. Their payment and newsletter
                  records are kept without their email and name.

                <% end %>
              </p>

              <%# Which of the two happens is decided by what's behind this
                  member, so name it. "Cancelled" reads like there's nothing
                  left, when there may be a payment from last year underneath. %>
              <% unless @member.erasable? %>
                <p class="mt-1 text-sm text-gray-500 font-sans w-[80%]">
                  Kept: <%= @member.retained_records.to_sentence %>.
                </p>
              <% end %>
            </div>
            <%= button_to "Delete Member", admin_member_path(@member),
                method: :delete,
                class: "inline-flex items-center uppercase text-sm text-red-800 px-3 py-2 border border-red-800 bg-red-200 hover:bg-red-300 font-mono rounded-xs text-nowrap",
                form: { data: { turbo_confirm: @member.erasable? ?
                  "This cannot be undone. Delete this member?" :
                  "This cannot be undone. Their name and email address will be removed; payment and newsletter records are kept. Continue?" } } %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Payment History -->
  <%# The money is what survives a deletion, and it's the reason a deleted
      member keeps a row at all — so it has to be readable here. Membership
      payments and donations are merged into one list; they read the same way
      to whoever is reconciling them. %>
  <div class="mt-6 bg-white border border-gray-300 rounded-xs overflow-hidden">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 font-sans">Payment History</h3>

      <% payments = MemberPayments.for(@member) %>

      <% if payments.any? %>
        <p class="mt-2 text-sm text-gray-600 font-sans">
          <%= payments.count %> payment<%= payments.count == 1 ? '' : 's' %> from this member
        </p>

        <div class="mt-5 border border-gray-200 rounded-xs overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Type
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Date
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Amount
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Status
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Stripe Reference
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% payments.each do |payment| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900"><%= payment.kind %></div>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <div class="text-sm text-gray-900"><%= payment.date&.strftime("%b %d, %Y") || "—" %></div>
                    <div class="text-xs text-gray-500"><%= payment.date&.strftime("%I:%M %p") %></div>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <div class="text-sm text-gray-900"><%= payment.amount || "—" %></div>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <% if payment.refunded? %>
                      <span class="inline-flex bg-yellow-100 px-2 py-1 text-xs font-semibold text-yellow-800">
                        Refunded<%= " #{payment.refund}" if payment.refund %>
                      </span>
                      <% if payment.refunded_at %>
                        <div class="mt-1 text-xs text-gray-500"><%= payment.refunded_at.strftime("%b %d, %Y") %></div>
                      <% end %>
                    <% else %>
                      <span class="inline-flex bg-green-100 px-2 py-1 text-xs font-semibold text-green-800">Paid</span>
                    <% end %>
                  </td>
                  <%# Kept through deletion on purpose: it names a transaction,
                      not a person, so a refund can still be matched in Stripe
                      after the account is gone. %>
                  <td class="px-4 py-3">
                    <div class="text-xs text-gray-500 font-mono break-all"><%= payment.reference || "—" %></div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <p class="mt-3 text-xs text-gray-500 font-sans">
          Refunds are issued in Stripe. Find the payment by its reference above —
          it stays on the record even if the account is deleted.
        </p>
      <% else %>
        <p class="mt-4 text-sm text-gray-500 font-sans">
          This member has not made any payments.
        </p>
      <% end %>
    </div>
  </div>

  <!-- Newsletter Delivery History -->
  <div class="mt-6 bg-white border border-gray-300 rounded-xs overflow-hidden">
    <div class="px-4 py-5 sm:p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 font-sans">Newsletter Delivery History</h3>

      <% newsletter_sends = @member.newsletter_sends.includes(:post).recent %>

      <% if newsletter_sends.any? %>
        <p class="mt-2 text-sm text-gray-600 font-sans">
          <%= newsletter_sends.count %> newsletter<%= newsletter_sends.count == 1 ? '' : 's' %> delivered to this member
        </p>

        <div class="mt-5 border border-gray-200 rounded-xs overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Post
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Sent At
                </th>
                <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Source
                </th>
                <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% newsletter_sends.each do |send| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-4 py-3 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900">
                      <%= send.post&.title || 'Untitled' %>
                    </div>
                    <div class="text-xs text-gray-500">
                      <%= send.post&.post_type&.titleize || 'Article' %>
                    </div>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <div class="text-sm text-gray-900">
                      <%= send.sent_at.strftime("%b %d, %Y") %>
                    </div>
                    <div class="text-xs text-gray-500">
                      <%= send.sent_at.strftime("%I:%M %p") %>
                    </div>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <% if send.import_id.present? %>
                      <span class="inline-flex bg-purple-100 px-2 py-1 text-xs font-semibold text-purple-800">
                        Substack Import
                      </span>
                    <% else %>
                      <span class="inline-flex bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-800">
                        Roe
                      </span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 whitespace-nowrap text-right text-sm font-medium">
                    <% if send.post %>
                      <%= link_to "View Post", edit_admin_post_path(send.post), class: "text-blue-600 hover:text-blue-900 text-xs" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

        <% if newsletter_sends.count > 10 %>
          <p class="mt-3 text-xs text-gray-500 font-sans">
            Showing most recent 50 deliveries
          </p>
        <% end %>
      <% else %>
        <p class="mt-4 text-sm text-gray-500 font-sans">
          No newsletters have been delivered to this member yet.
        </p>
      <% end %>
    </div>
  </div>
</div>
