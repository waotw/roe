<div class="font-mono text-sm text-gray-800 bg-[#fffdf9] px-4 sm:px-0 max-w-4xl tabular-nums">

  <!-- Top header bar -->
  <div class="flex justify-between items-baseline border-2 border-gray-800 px-3 py-1.5 mb-6">
    <h1 class="text-base font-bold tracking-widest uppercase">Roe Dashboard</h1>
    <span class="text-xs text-gray-500"><%= Time.current.strftime("%Y-%m-%d  %H:%M") %></span>
  </div>

  <!-- ─── CONTENT ─── -->
  <div class="relative border-2 border-gray-800 mb-8">
    <div class="absolute -top-2.5 left-4 bg-[#fffdf9] px-2 text-xs font-bold tracking-widest uppercase text-amber-700">
      ── Content ──
    </div>

    <table class="w-full  bg-[#fffdf9]">
      <thead>
        <tr class="border-b border-gray-300 text-xs uppercase tracking-wider text-gray-500">
          <th class="px-4 pt-4 pb-2 text-left font-semibold">Type</th>
          <th class="px-4 pt-4 pb-2 text-right font-semibold w-32">Count</th>
        </tr>
      </thead>
      <tbody>
        <tr class="border-b border-dashed border-gray-200 hover:bg-amber-50/40 cursor-pointer" onclick="window.location='<%= admin_posts_path %>'">
          <td class="px-4 py-1.5">
            <%= link_to "Total Posts", admin_posts_path, class: "text-blue-700 hover:underline" %>
          </td>
          <td class="px-4 py-1.5 text-right"><%= @posts_count %></td>
        </tr>
        <tr class="border-b border-dashed border-gray-200 hover:bg-amber-50/40 cursor-pointer" onclick="window.location='<%= admin_posts_path %>'">
          <td class="px-4 py-1.5">
            <%= link_to "Published Posts", admin_posts_path, class: "text-blue-700 hover:underline" %>
          </td>
          <td class="px-4 py-1.5 text-right"><%= @published_posts_count %></td>
        </tr>
        <tr class="border-b border-dashed border-gray-200 hover:bg-amber-50/40 cursor-pointer" onclick="window.location='<%= admin_posts_path(type: 'article', status: 'draft', sort: 'updated-desc') %>'">
          <td class="px-4 py-1.5">
            <%= link_to "Draft Posts", admin_posts_path(type: 'article', status: 'draft', sort: 'updated-desc'), class: "text-blue-700 hover:underline" %>
          </td>
          <td class="px-4 py-1.5 text-right"><%= @draft_posts_count %></td>
        </tr>
        <tr class="hover:bg-amber-50/40 cursor-pointer" onclick="window.location='<%= admin_pages_path %>'">
          <td class="px-4 py-1.5 pb-3">
            <%= link_to "Pages", admin_pages_path, class: "text-blue-700 hover:underline" %>
          </td>
          <td class="px-4 py-1.5 pb-3 text-right"><%= @pages_count %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ─── PAYMENTS ─── -->
  <% if SiteFeature.payments_enabled? %>
    <div class="relative border-2 border-gray-800">
      <div class="absolute -top-2.5 left-4 bg-[#fffdf9] px-2 text-xs font-bold tracking-widest uppercase text-amber-700">
        ── Payments ──
      </div>

      <% if @open_disputes_count.to_i > 0 %>
        <div class="m-3 mt-4 px-3 py-2 border-2 border-amber-500 bg-amber-50 text-xs flex items-center justify-between">
          <span class="text-amber-900">
            ⚠ <strong><%= pluralize(@open_disputes_count, "OPEN DISPUTE") %></strong> — REVIEW IN STRIPE BEFORE DEADLINE
          </span>
          <a href="<%= @stripe_disputes_url %>" target="_blank" rel="noopener" class="text-amber-900 underline whitespace-nowrap">
            [ View in Stripe → ]
          </a>
        </div>
      <% end %>

      <table class="w-full  bg-[#fffdf9]">
        <thead>
          <tr class="border-b border-gray-300 text-xs uppercase tracking-wider text-gray-500">
            <th class="px-4 pt-4 pb-2 text-left font-semibold">Source</th>
            <th class="px-4 pt-4 pb-2 text-right font-semibold w-20">Count</th>
            <th class="px-4 pt-4 pb-2 text-right font-semibold w-44">Total</th>
            <th class="px-4 pt-4 pb-2 text-right font-semibold w-40"></th>
          </tr>
        </thead>
        <tbody>
          <% if SiteFeature.memberships_enabled? %>
            <tr class="border-b border-dashed border-gray-200">
              <td class="px-4 py-1.5">Paid memberships</td>
              <td class="px-4 py-1.5 text-right text-gray-500"><%= @paid_members_count %></td>
              <td class="px-4 py-1.5 text-right text-emerald-700">
                +&nbsp;<%= number_to_currency(@membership_revenue_cents.to_i / 100.0, unit: (@membership_currency || 'usd').upcase + ' ') %>
                <% if @membership_untracked_count.to_i > 0 %>
                  <span class="text-xs text-gray-400 ml-1">(+<%= @membership_untracked_count %> pre-tracking)</span>
                <% end %>
              </td>
              <td></td>
            </tr>
          <% end %>
          <% if SiteFeature.donations_enabled? %>
            <tr class="border-b border-dashed border-gray-200">
              <td class="px-4 py-1.5">Donations</td>
              <td class="px-4 py-1.5 text-right text-gray-500"><%= @donations_count %></td>
              <td class="px-4 py-1.5 text-right text-emerald-700">
                +&nbsp;<%= number_to_currency(@donations_total_cents.to_i / 100.0, unit: (@donations_currency || 'usd').upcase + ' ') %>
              </td>
              <td></td>
            </tr>
          <% end %>
          <% if @refunds_count.to_i > 0 %>
            <tr class="border-b border-dashed border-gray-200">
              <td class="px-4 py-1.5">Refunds</td>
              <td class="px-4 py-1.5 text-right text-gray-500"><%= @refunds_count %></td>
              <td class="px-4 py-1.5 text-right text-rose-700">
                −&nbsp;<%= number_to_currency(@refunds_total_cents.to_i / 100.0, unit: (@refunds_currency || 'usd').upcase + ' ') %>
              </td>
              <td class="px-4 py-1.5 text-right">
                <a href="<%= @stripe_refunds_url %>" target="_blank" rel="noopener" class="text-blue-700 hover:underline text-xs whitespace-nowrap">[ View in Stripe → ]</a>
              </td>
            </tr>
          <% end %>
          <tr class="border-t-2 border-gray-800 bg-stone-600 text-[#fffdf9]">
            <td class="px-4 py-2 font-bold uppercase tracking-wider">Total</td>
            <td class="px-4 py-2 text-right font-bold"><%= @total_transactions_count %></td>
            <td class="px-4 py-2 text-right font-bold">
              <%= number_to_currency(@total_amount_cents / 100.0, unit: (@total_currency || 'usd').upcase + ' ') %>
            </td>
            <td></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>

</div>
