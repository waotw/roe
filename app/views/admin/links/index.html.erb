<%# COPY — The Links page: the last links check (LinkCheck), in full. Title,
    intro and the "None" lines are placeholder copy the user rewrites before
    commit. data-test anchors are stable; tests key off them, not this text. %>
<% problems = @result ? @result["problems"] : [] %>
<% records = link_problem_records(problems) %>
<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">Links</h1>
      <p class="mt-2 text-sm text-gray-700" data-test="links-checked">
        <% if @result %>
          Internal content and media links. Checked at <%= link_check_time(@result) %>.
        <% else %>
          Internal content and media links. Not checked yet.
        <% end %>
      </p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-4">
      <%= button_to "[ CHECK NOW ]", admin_check_links_path, method: :post,
            data: { test: "links-check-now" },
            class: "text-xs text-blue-700 hover:underline whitespace-nowrap cursor-pointer" %>
    </div>
  </div>

  <%# COPY — section titles and empty-section lines %>
  <% [
       [ "media", "Media", "missing", "None. Every media file is in the media library." ],
       [ "links", "Links", "broken", "None. Every link matches a post, page, product or doc." ],
       [ "drafts", "Links to drafts", "", "None. A link to a draft shows as plain text until the draft is published." ]
     ].each do |section, title, noun, empty| %>
    <% rows = problems.select { |p| p["section"] == section } %>
    <% counted = rows.count { |p| !p["warning"] } %>
    <section id="<%= section %>" class="mt-8" data-test="links-section-<%= section %>">
      <h2 class="text-xs font-bold tracking-widest uppercase text-gray-800">
        <%= title %> · <%= counted %><%= " #{noun}".upcase if noun.present? %>
      </h2>
      <div class="mt-2 border border-gray-200 bg-white overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-xs">
          <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
            <tr>
              <th class="text-left font-medium px-3 py-2 w-1/4">Item</th>
              <th class="text-left font-medium px-3 py-2 w-24">Where</th>
              <th class="text-left font-medium px-3 py-2">Problem</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% if rows.empty? %>
              <tr><td colspan="3" class="px-3 py-2 text-green-700" data-test="links-empty"><%= empty %></td></tr>
            <% end %>
            <% rows.each do |problem| %>
              <% path = link_problem_path(problem, records) %>
              <tr class="hover:bg-gray-50 align-top" data-test="links-row">
                <td class="px-3 py-2">
                  <% if path %>
                    <%= link_to problem["title"], path, class: "text-blue-600 hover:text-blue-800 underline", data: { test: "links-item" } %>
                  <% else %>
                    <%= problem["title"] %>
                  <% end %>
                  <div class="text-[10px] text-gray-400 uppercase">
                    <%= problem["item_type"] == "Documentation" ? "doc" : problem["item_type"].downcase %>
                    <% if problem["draft"] %>
                      <span class="ml-1 px-1 border border-gray-400 text-gray-600" data-test="links-draft">Draft</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-3 py-2 text-gray-700 whitespace-nowrap"><%= link_problem_where(problem) %></td>
                <td class="px-3 py-2 <%= problem['warning'] ? 'text-gray-500' : 'text-gray-800' %>"><%= problem["message"] %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</div>
