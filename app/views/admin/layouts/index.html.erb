<div class="px-4 sm:px-0 font-mono">
  <h1 class="text-3xl font-bold text-gray-900 font-sans">Layouts</h1>
  <p class="mt-2 text-sm text-gray-700 font-sans">Edit header and footer that appear on all pages.</p>

  <div class="mt-8">
    <table class="min-w-full divide-y divide-gray-300 border border-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">File</th>
          <th class="relative py-3.5 pl-3 pr-4 text-right">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% @layouts.each do |layout| %>
          <tr>
            <td class="py-4 pl-4 pr-3 text-sm font-medium text-gray-900">
              <%= layout[:name] %>
            </td>
            <td class="py-4 pl-3 pr-4 text-right text-sm">
              <% if layout[:exists] %>
                <div class="inline-flex items-center gap-4">
                  <% if layout[:file] == "sidebar" %>
                    <%# Sidebar is the only layout file that's optional.
                        Navigation and footer ship with every site. %>
                    <button type="button"
                            data-action="delete"
                            data-resource-id="<%= layout[:file] %>"
                            data-resource-title="<%= layout[:name] %>"
                            data-resource-type="sidebar"
                            class="text-red-600 hover:text-red-900">
                      Delete
                    </button>
                  <% end %>
                  <%= link_to "Edit", layout[:path], class: "text-blue-600 hover:text-blue-900" %>
                </div>
              <% else %>
                <%= button_to "Create",
                              admin_generate_missing_admin_layouts_path(file_key: layout[:file]),
                              method: :post,
                              class: "text-sm px-3 py-1 bg-blue-100 border border-blue-600 hover:bg-blue-200 text-blue-700 rounded-xs" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Delete-confirmation modal for the sidebar. Uses the shared
      "type DELETE to confirm" pattern from posts/pages, with a custom
      delete_path so it POSTs to layouts#destroy_sidebar. %>
  <%= render 'shared/delete_file_modal',
             resource: nil,
             resource_type: 'sidebar',
             delete_path: admin_destroy_layout_sidebar_path,
             delete_message: "This will permanently delete <code class=\"bg-gray-100 px-1\">site/layout/sidebar.md</code>. The sidebar will stop rendering on every page until you recreate it.".html_safe %>
</div>
