<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">Postmark Configuration</h1>
      <p class="mt-2 text-sm text-gray-700">Configure your Postmark server token for email delivery.</p>
    </div>
  </div>

  <% if @postmark_config.connected? && @stats %>
    <div class="mt-8 bg-white border border-gray-300 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Email Statistics</h3>

      <% if @stats[:error] %>
        <p class="text-sm text-red-800 bg-red-50 px-4 py-2 border border-red-200">
          Error fetching stats: <%= @stats[:error] %>
        </p>
      <% else %>
        <!-- Server Info -->
        <div class="mb-6 p-4 bg-gray-50 border border-gray-200">
          <div class="text-sm font-semibold text-gray-900">
            Server: <span class="font-mono text-blue-600"><%= @stats[:server_name] %></span>
          </div>
        </div>

        <!-- Member Stats -->
        <div class="grid grid-cols-3 gap-4 text-center mb-4">
          <div class="p-4 bg-blue-50 border border-blue-200">
            <div class="text-3xl font-bold text-blue-900"><%= @stats[:total_members] %></div>
            <div class="text-sm text-gray-600 mt-1">Total Members</div>
          </div>

          <div class="p-4 bg-green-50 border border-green-200">
            <div class="text-3xl font-bold text-green-900"><%= @stats[:subscribed] %></div>
            <div class="text-sm text-gray-600 mt-1">Newsletter Subscribers</div>
          </div>

          <div class="p-4 bg-gray-50 border border-gray-200">
            <div class="text-3xl font-bold text-gray-900"><%= @stats[:unsubscribed] %></div>
            <div class="text-sm text-gray-600 mt-1">Unsubscribed</div>
          </div>
        </div>

        <!-- Newsletter Stats -->
        <div class="grid grid-cols-3 gap-4 text-center">
          <div class="p-4 bg-purple-50 border border-purple-200">
            <div class="text-3xl font-bold text-purple-900"><%= @stats[:newsletters_sent] %></div>
            <div class="text-sm text-gray-600 mt-1">Newsletters Sent</div>
          </div>

          <div class="p-4 bg-indigo-50 border border-indigo-200">
            <div class="text-3xl font-bold text-indigo-900"><%= number_with_delimiter(@stats[:total_emails_sent]) %></div>
            <div class="text-sm text-gray-600 mt-1">Total Emails Delivered</div>
          </div>

          <div class="p-4 bg-pink-50 border border-pink-200">
            <% if @stats[:last_newsletter_at] %>
              <div class="text-lg font-bold text-pink-900">
                <%= time_ago_in_words(@stats[:last_newsletter_at]) %> ago
              </div>
            <% else %>
              <div class="text-lg font-bold text-gray-400">Never</div>
            <% end %>
            <div class="text-sm text-gray-600 mt-1">Last Newsletter</div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% if flash[:notice] %>
    <div class="mt-4 px-4 py-2 bg-green-50 border border-green-200 text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:error] %>
    <div class="mt-4 px-4 py-2 bg-red-50 border border-red-200 text-red-800 text-sm">
      <%= flash[:error] %>
    </div>
  <% end %>

  <div class="mt-8 bg-white border border-gray-300 p-6">
    <%= form_with model: @postmark_config, url: admin_postmark_config_path, method: :patch do |f| %>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-gray-900 mb-2">
            Postmark Server Token
          </label>
          <%= f.text_field :server_token,
              value: @postmark_config.connected? ? '••••••••••••••••' : '',
              placeholder: 'Your Postmark Server API Token',
              class: "w-full px-3 py-2 border border-gray-300 font-mono text-sm" %>
          <p class="mt-1 text-xs text-gray-500">
            Find this in your Postmark server under API Tokens
          </p>
        </div>

        <div class="flex gap-4">
          <%= f.submit "Save Configuration",
              class: "uppercase text-sm px-2 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>

          <% if @postmark_config.connected? %>
            <%= button_to "Disconnect",
                admin_postmark_config_path,
                method: :delete,
                data: { confirm: "Are you sure? This will disconnect Postmark integration." },
                class: "uppercase text-sm px-2 py-2 border border-gray-800 bg-red-200 hover:bg-red-300 font-mono rounded-xs" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @postmark_config.connected? %>
      <div class="mt-6 pt-6 border-t border-gray-300">
        <p class="text-sm text-green-800 bg-green-50 px-4 py-2 border border-green-200">
          ✓ Postmark is configured and ready to send
        </p>
      </div>
    <% end %>
  </div>

  <div class="mt-8 bg-blue-50 border border-blue-200 p-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-2">Setup Instructions</h3>
    <ol class="list-decimal list-inside space-y-2 text-sm text-gray-700">
      <li>Sign up for a Postmark account at <a href="https://postmarkapp.com" target="_blank" class="text-blue-600 hover:underline">postmarkapp.com</a></li>
      <li>Create a new Server or use an existing one</li>
      <li>Go to your Server → API Tokens tab</li>
      <li>Copy your Server API Token</li>
      <li>Paste it above and click Save Configuration</li>
      <li>Verify your sender email address in Sender Signatures</li>
    </ol>

    <div class="mt-4 p-4 bg-yellow-50 border border-yellow-200">
      <p class="text-sm font-semibold text-gray-900 mb-2">💡 Testing Tip</p>
      <p class="text-sm text-gray-700">
        Use <code class="px-1 py-0.5 bg-gray-100 text-gray-800">POSTMARK_API_TEST</code> as your token to test API calls without sending real emails.
      </p>
    </div>
  </div>
</div>
