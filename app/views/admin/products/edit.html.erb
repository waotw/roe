<!DOCTYPE html>
<html>
<head>
  <title>Edit: <%= @product.title || 'Untitled' %></title>
</head>
<body class="bg-white text-black p-5" data-turbo-action="replace" data-md-editor>

  <div class="flex justify-between items-center pb-2.5 relative">
    <h1 class="text-xl font-bold">Edit Product: <%= @product.title %></h1>
    <div class="flex items-center gap-2">
      <%= link_to "← Back to Products", admin_products_path, class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
    </div>
  </div>

  <% if flash[:warning] %>
    <div class="px-2.5 py-1 mb-5 border border-gray-300 bg-yellow-50"><%= flash[:warning] %></div>
  <% end %>

  <%# Shared issues box (same paradigm as posts). Two concerns unioned here:
      needs_attention? = published-only missing fields/media; group_issues =
      always-on structural group-setup problems (no/duplicate primary). %>
  <% if @product.flagged? %>
    <div class="bg-red-50 border border-amber-400 px-3 py-2 mb-5 text-sm">
      <strong class="text-amber-700">⚠ <%= @product.needs_attention? ? "This product is published but has issues:" : "This product needs attention:" %></strong>
      <ul class="list-disc ml-5 mt-1 text-amber-700">
        <% if @product.needs_attention? %>
          <% @product.missing_required_fields.each do |name| %>
            <li>Missing required field: <code><%= name %></code></li>
          <% end %>
          <% @product.missing_media_refs.each do |ref| %>
            <li>File not found: <code><%= ref[:path] %></code> (<%= ref[:field] %>)</li>
          <% end %>
        <% end %>
        <% @product.group_issues.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
        <% @product.group_row_issues.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
      <p class="text-xs text-amber-600 mt-2 italic">Save your changes to refresh this list.</p>
    </div>
  <% end %>

  <!-- Wrap everything in Stimulus controller -->
  <div data-controller="editor"
       data-editor-resource-type-value="product"
       data-editor-resource-id-value="<%= @product.id %>"
       data-editor-preview-path-value="<%= @preview_path || preview_admin_product_path(@product) %>"
       data-editor-product-template-value="<%= SiteConfig.feature('store', 'product_button_template') %>"
       data-editor-currency-symbol-value="<%= store_currency_symbol %>">

    <turbo-frame id="sku-generator-modal"></turbo-frame>

    <div class="mb-5 flex justify-between items-center">
      <div class="flex gap-2.5 items-baseline">
        <button type="submit" form="product-form" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">Save</button>

        <button type="button"
                data-action="click->editor#preview"
                class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
          Preview
        </button>

        <%# View link shows when the product is publicly reachable on the
            live site — status: published OR status: unlisted. Reading
            metadata["status"] directly (rather than .published? / .public?)
            because HasMetadata#status defaults to "published" when the
            field is absent, which would falsely show View on items that
            haven't been explicitly published yet. %>
        <% if %w[published unlisted].include?(@product.metadata["status"].to_s.downcase) %>
          <%= link_to "View", @product.public_url, target: "_blank", class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.2rem]" %>
        <% end %>

        <div id="publish-button-container">
          <% if @product.status != 'published' %>
            <button type="button"
                    data-action="click->editor#confirmPublish"
                    data-editor-post-id="<%= @product.id %>"
                    class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
              Publish
            </button>
          <% else %>
            <form action="<%= unpublish_admin_product_path(@product) %>"
                  method="post"
                  data-turbo="false">
              <input type="hidden" name="_method" value="patch">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <button type="submit"
                      class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
                Unpublish
              </button>
            </form>
          <% end %>
        </div>
      </div>

      <!-- Right: Delete button -->
      <%= button_to "Delete", admin_product_path(@product),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this product?" } },
          class: "uppercase text-xs px-1.5 py-0 border border-red-600 bg-red-50 hover:bg-red-100 text-red-700 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]" %>
    </div>

    <%= render 'shared/editor',
          form_url: admin_product_path(@product),
          resource_type: 'product',
          metadata: @metadata.gsub(/^---\n/, ''),
          content: @content,
          show_metadata: true,
          preview_path: @preview_path || preview_admin_product_path(@product),
          item: @product %>

  </div>
  <!-- End Stimulus controller -->

  <%# Trigger preview-window refresh for both plain saves AND save-and-
      publish (controller flashes "Product published" in that case). %>
  <% if flash[:notice]&.match?(/\AProduct (saved|published)/) %>
    <div id="product-saved-trigger" data-trigger="refresh" style="display: none;"></div>
  <% end %>
</body>
</html>
