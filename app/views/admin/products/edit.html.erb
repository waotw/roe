<!DOCTYPE html>
<html>
<head>
  <title>Edit: <%= @product.title || 'Untitled' %></title>
</head>
<body class="bg-white text-black p-5" data-turbo-action="replace" data-md-editor>

  <div class="flex justify-between gap-3 items-start pb-2.5 relative">
    <div class="">
      <h1 class="text-xl font-bold leading-none">Edit Product: <%= @product.title %></h1>
      <div class="flex items-center">
      <%= render 'shared/inline_rename', resource: @product, resource_type: 'product', return_to: edit_admin_product_path(@product) %>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "← Back to Products", admin_products_path, class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
    </div>
  </div>

  <% if flash[:warning] %>
    <div class="px-2.5 py-1 mb-5 border border-gray-300 bg-yellow-50" data-clears-on-save><%= flash[:warning] %></div>
  <% end %>

  <%= render "admin/products/issues", product: @product %>

  <!-- Wrap everything in Stimulus controller -->
  <div data-controller="editor collection-builder card-builder gallery-builder action-builder markdown-doctor"
       data-markdown-doctor-check-url-value="<%= admin_check_markdown_path %>"
       data-markdown-doctor-fix-url-value="<%= admin_fix_markdown_path %>"
       data-editor-resource-type-value="product"
       data-editor-resource-id-value="<%= @product.id %>"
       data-editor-preview-path-value="<%= @preview_path || preview_admin_product_path(@product) %>"
       data-editor-product-template-value="<%= SiteConfig.feature('store', 'product_button_template') %>"
       data-editor-currency-symbol-value="<%= store_currency_symbol %>"
       data-editor-highlight-media-value="<%= params[:highlight] %>"
       data-editor-highlight-line-value="<%= params[:line].to_i %>"
       data-editor-highlight-field-value="<%= params[:field] %>"
       data-editor-highlight-link-value="<%= params[:link].present? %>"
       data-editor-original-url-name-value="<%= @product.url_name %>"
       data-editor-filename-slug-value="<%= File.basename(@product.file_path.to_s, '.md') %>"
       data-editor-published-value="<%= @product.published? %>"
       data-editor-public-path-prefix-value="/products/">

    <%# Set by the editor when the user picks "Save new URL & redirect" in the
        slug-change modal; ProductsController#update writes the 301 (RenameRedirect). %>
    <input type="hidden" name="create_redirect_from" value=""
           form="product-form" data-editor-target="redirectFromField">

    <turbo-frame id="sku-generator-modal"></turbo-frame>

    <%= render 'shared/editor_actions', resource: @product, resource_type: 'product' %>

    <%= render 'shared/editor',
          form_url: admin_product_path(@product),
          resource_type: 'product',
          metadata: @metadata.gsub(/^---\n/, ''),
          content: @content,
          show_metadata: true,
          preview_path: @preview_path || preview_admin_product_path(@product),
          item: @product %>

    <%= render 'shared/editor_drawer', resource: @product, resource_type: 'product' %>
    <%= render 'shared/leave_modal' %>

    <%# Slug-change decision modal for a published product (see editor#save). %>
    <%= render 'admin/posts/redirect_modal', noun: "product" %>

  </div>
  <!-- End Stimulus controller -->

  <%# Trigger preview-window refresh for both plain saves AND save-and-
      publish (controller flashes "Product published" in that case). %>
</body>
</html>
