<div class="px-4 sm:px-0 font-mono">

  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">Products</h1>
      <p class="mt-2 text-sm text-gray-700">Manage your store products.</p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "New Product", new_admin_product_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
    </div>
  </div>

  <div class="mt-4 flex flex-col">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <% if @rows.any? %>
          <div class="overflow-hidden ring-1 ring-black ring-opacity-5">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th scope="col" class="py-2 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 uppercase">Product</th>
                  <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Price</th>
                  <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">SKU</th>
                  <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Status</th>
                  <th scope="col" class="relative py-1.5 pl-3 pr-4 sm:pr-6">
                    <span class="sr-only">Actions</span>
                  </th>
                </tr>
              </thead>

              <%# Each row-block is its own <tbody> so a future client-side
                  sort/filter/search can reorder or hide whole blocks — a
                  group's members can never be split apart. Default order
                  (groups first alphabetically, then standalone products
                  alphabetically, primary on top within a group) is done in
                  ProductGroup. %>
              <% @rows.each do |row| %>
                <% if row.is_a?(ProductGroup) %>
                  <% members = row.ordered_members %>
                  <% primary = row.primary %>
                  <tbody class="divide-y divide-gray-200 bg-white"
                         data-row-kind="group"
                         data-group="<%= row.name %>"
                         data-updated="<%= ProductGroup.rank(row) %>"
                         data-search="<%= members.map { |m| "#{m.title} #{m.sku}" }.join(' ').downcase %>">
                    <tr>
                      <td colspan="5" class="pt-2 pb-1 pl-4 pr-3 text-xs font-semibold uppercase tracking-wide text-blue-400 font-mono bg-blue-50">
                        Group: <%= row.name %>
                        <% if row.warnings.any? %>
                          <span class="inline-block text-base text-amber-600 font-semibold font-sans leading-0"
                                title="<%= row.warnings.join('; ') %>">⚠</span>
                        <% end %>
                      </td>
                    </tr>
                    <% members.each do |member| %>
                      <%= render "admin/products/product_row",
                            product: member,
                            dimmed: (primary.present? && member != primary) %>
                    <% end %>
                  </tbody>
                <% else %>
                  <tbody class="bg-white"
                         data-row-kind="product"
                         data-status="<%= row.status %>"
                         data-updated="<%= row.updated_at.to_i %>"
                         data-search="<%= "#{row.title} #{row.sku}".downcase %>">
                    <%= render "admin/products/product_row", product: row %>
                  </tbody>
                <% end %>
              <% end %>
            </table>
          </div>
        <% else %>
          <div class="text-center py-12 border border-gray-300 bg-white">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900 font-sans">No products</h3>
            <p class="mt-1 text-sm text-gray-500 font-sans">Get started by creating a new product.</p>
            <div class="mt-6">
              <%= link_to "New Product", new_admin_product_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
