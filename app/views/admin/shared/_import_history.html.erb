<%#
  Previous-imports table with per-import draft/published counts and a scoped
  delete. Shared by File Imports and Feed Imports.
  locals:
    imports  — an Import relation (already scoped by source_type)
    resource — route resource name: "file_import" | "feed_import"
%>
<% show_path   = ->(imp) { send("admin_#{resource}_path", imp) } %>
<% delete_path = show_path %>

<% if imports.any? %>
  <h2 class="text-lg font-medium mt-8 mb-3">Previous imports</h2>
  <div class="bg-white shadow overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="text-left text-xs uppercase text-gray-400 border-b border-gray-200">
          <th class="px-4 py-2 font-medium">Import</th>
          <th class="px-4 py-2 font-medium">When</th>
          <th class="px-4 py-2 font-medium">Content</th>
          <th class="px-4 py-2 font-medium text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% imports.each do |import| %>
          <% drafts = import.ref_draft_count; published = import.ref_published_count %>
          <tr class="border-b border-gray-100">
            <td class="px-4 py-2">
              <%= link_to "Import ##{import.id}", show_path.call(import), class: "text-blue-700 hover:underline font-medium" %>
            </td>
            <td class="px-4 py-2 text-gray-500"><%= import.created_at.strftime("%b %-d, %Y · %-l:%M %p") %></td>
            <td class="px-4 py-2 text-gray-600">
              <%= pluralize(drafts, "draft") %><% if published.positive? %> · <span class="text-gray-500"><%= published %> published</span><% end %>
            </td>
            <td class="px-4 py-2 text-right">
              <button type="button"
                      data-action="delete"
                      data-resource-id="<%= import.id %>"
                      data-resource-title="Import #<%= import.id %>"
                      data-resource-type="import"
                      data-delete-url="<%= delete_path.call(import) %>"
                      class="uppercase text-xs px-3 py-1 border border-red-700 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs cursor-pointer">
                Delete
              </button>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# One delete modal for the whole table; delete_modal.js retargets its form
      to the clicked row via data-delete-url. Only DRAFT content is removed. %>
  <%= render "shared/delete_file_modal",
             resource_type: "import",
             resource: imports.first,
             delete_path: delete_path.call(imports.first),
             delete_message: "This deletes the DRAFT posts and pages from this import (file and record). Published content is kept — remove those manually. You can always re-import.".html_safe %>
<% end %>
