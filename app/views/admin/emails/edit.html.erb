<div class="px-4 sm:px-0 font-mono" data-controller="editor"
     data-editor-resource-type-value="email"
     data-editor-resource-id-value="<%= @filename %>"
     data-editor-preview-path-value="<%= @preview_path %>">

  <div class="sm:flex sm:items-center pb-2.5">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-xl font-bold text-gray-900">
        Edit Email: <%= @template_name %>
      </h1>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "← Back to Emails", admin_emails_path, class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
    </div>
  </div>

  <div class="flex gap-2.5 items-baseline mb-5">
    <%= button_tag "Preview", type: "button",
        data: { action: "click->editor#preview" },
        class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]" %>
    <%= button_tag "Save Email", type: "submit", form: "email-form",
        class: "uppercase text-xs px-1.5 py-0 border border-green-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]" %>
  </div>

  <!-- Available Variables Panel -->
  <% if @available_variables.any? %>
    <div class="mb-4 p-4 bg-blue-50 border border-blue-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Available Variables</h3>
      <div class="flex flex-wrap gap-2">
        <% @available_variables.each do |variable| %>
          <code class="inline-block bg-white px-2 py-1 text-xs border border-blue-300 text-blue-900"><%= variable %></code>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-gray-600">Use these variables in your email template. They'll be replaced with actual data when the email is sent.</p>
    </div>
  <% end %>

  <%= render 'shared/editor',
      form_url: admin_email_path(@filename),
      content: @content,
      metadata: nil,
      show_metadata: false,
      resource_type: 'email' %>
</div>
