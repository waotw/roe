<div class="px-4 sm:px-0 font-mono" data-controller="editor markdown-doctor"
       data-markdown-doctor-check-url-value="<%= admin_check_markdown_path %>"
       data-markdown-doctor-fix-url-value="<%= admin_fix_markdown_path %>"
     data-editor-resource-type-value="email"
     data-editor-resource-id-value="<%= @filename %>"
     data-editor-preview-path-value="<%= @preview_path %>">

  <div class="sm:flex sm:items-center pb-2.5">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-xl font-bold text-gray-900">
        Edit Email: <%= @template_name %>
      </h1>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "← Back to Emails", admin_emails_path, class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
    </div>
  </div>

  <%# Invite mode: compose_invite stashed a member selection. A banner says who
      this is going to, and a Send button (below, next to Save) writes the
      template AND mails it. Without a pending selection this whole block is
      absent and the page is an ordinary template edit. %>
  <% if @invite_mode %>
    <div class="mb-4 p-3 border border-blue-300 bg-blue-50 rounded-xs font-sans">
      <p class="text-sm text-blue-900 mb-2">
        <strong>Send a password invite</strong> to
        <strong><%= pluralize(@invite_count, "member") %></strong>.
        Edit the email below, then <strong>Send</strong>. Your changes are
        saved as the template for future invite emails. You'll always be able to review before sending.
      </p>
      <p class="text-sm text-blue-900 mb-2 ">Each member gets a new temporary password which they can reset after they sign in.</p>

      <div class="flex justify-end">
        <%= link_to "← Cancel (Back to Members)", admin_members_path, class: "inline-flex uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-gray-100 hover:bg-gray-300 font-mono rounded-xs" %>
      </div>

      <%# The Send button lives in the editor form (below) so it submits the
          edited content. This form only carries the CSRF token + method; the
          actual button is rendered inside the editor via @invite_mode. %>
    </div>
  <% end %>

  <%= render 'shared/editor_actions', resource: @filename, resource_type: 'email' %>

  <!-- Available Variables Panel -->
  <% if @available_variables.any? %>
    <div class="mb-4 p-4 bg-blue-50 border border-blue-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Available Variables</h3>
      <div class="flex flex-wrap gap-2">
        <% @available_variables.each do |variable| %>
          <code class="inline-block bg-white px-2 py-1 text-xs border border-blue-300 text-blue-900"><%= variable %></code>
        <% end %>
      </div>
      <p class="mt-2 text-xs text-gray-600">Use these variables in your email template. They'll be replaced with actual data when the email is sent.</p>
    </div>
  <% end %>

  <%= render 'shared/editor',
      form_url: admin_email_path(@filename),
      content: @content,
      metadata: nil,
      show_metadata: false,
      resource_type: 'email' %>

  <%= render 'shared/editor_drawer', resource: @filename, resource_type: 'email' %>
  <%= render 'shared/leave_modal' %>
</div>
