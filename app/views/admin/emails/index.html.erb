<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">Email Templates</h1>
      <p class="mt-2 text-sm text-gray-700">Transactional emails sent to members. Edit the markdown to customize messaging.</p>
    </div>
  </div>

  <div class="mt-8 overflow-hidden ring-1 ring-black ring-opacity-5">
    <table class="min-w-full divide-y divide-gray-300">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="py-2 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 uppercase">Email</th>
          <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Filename</th>
          <th scope="col" class="relative py-1.5 pl-3 pr-4 sm:pr-6">
            <span class="sr-only">Actions</span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200 bg-white">
        <% if @emails.empty? %>
          <tr>
            <td colspan="3" class="px-4 py-8 text-center text-sm text-gray-500">
              No email templates found in <code class="bg-gray-100 px-2 py-1">site/emails/</code>
            </td>
          </tr>
        <% else %>
          <% @emails.each do |email| %>
            <tr>
              <td class="whitespace-nowrap py-1.5 pl-4 pr-3 text-sm font-medium text-gray-900">
                <%= link_to email[:name], edit_admin_email_path(email[:filename]), class: "text-blue-600 hover:text-blue-900" %>
              </td>
              <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500 font-mono">
                <%= email[:filename] %>.md
              </td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-xs font-medium">
                <%= link_to "Edit", edit_admin_email_path(email[:filename]), class: "text-blue-600 hover:text-blue-900" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
