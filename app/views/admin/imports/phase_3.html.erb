<% content_for :title, "Import Members - Import ##{@import.id}" %>
<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">Import Members from Substack</h1>
  <!-- Progress Steps -->
  <div class="mb-8">
    <div class="flex items-center">
      <div class="flex items-center text-green-600">
        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center font-medium">1</div>
        <span class="ml-2 text-sm font-medium">Upload</span>
      </div>
      <div class="flex-1 h-px bg-green-300 mx-4"></div>
      <div class="flex items-center text-green-600">
        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center font-medium">2</div>
        <span class="ml-2 text-sm font-medium">Posts</span>
      </div>
      <div class="flex-1 h-px bg-green-300 mx-4"></div>
      <div class="flex items-center text-blue-600">
        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center font-medium">3</div>
        <span class="ml-2 text-sm font-medium">Members</span>
      </div>
      <div class="flex-1 h-px bg-gray-300 mx-4"></div>
      <div class="flex items-center text-gray-400">
        <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center font-medium">4</div>
        <span class="ml-2 text-sm font-medium">Deliveries</span>
      </div>
    </div>
  </div>
  <% unless @has_email_list %>
    <div class="mb-6 p-4 border border-amber-300 bg-amber-50 rounded-lg">
      <div class="flex items-start gap-2">
        <span class="text-amber-600">⚠️</span>
        <div>
          <p class="text-sm font-medium text-amber-800">No email list found in export</p>
          <p class="text-xs text-amber-700 mt-1">No <code>email_list.csv</code> was found in your Substack export. The member import will be skipped automatically. You can still continue to proceed to the next step.</p>
        </div>
      </div>
    </div>
  <% end %>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-medium mb-4">Phase 3: Configure Member Import</h2>
    <%= form_with model: [:admin, @import], url: phase_3_run_admin_import_path(@import), method: :post, local: true do |f| %>
      <div class="mb-6">
        <h3 class="text-sm font-medium text-gray-700 mb-3">Import Options</h3>
        <div class="space-y-3">
          <div class="flex items-start">
            <%= check_box_tag "import[options][auto_gift_lifetime]", "1", @import.options["auto_gift_lifetime"],
                class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded mt-1" %>
            <div class="ml-3">
              <%= label_tag "import[options][auto_gift_lifetime]", "Auto-set lifetime members to paid",
                  class: "block text-sm font-medium text-gray-900" %>
              <p class="text-xs text-gray-500">Members with "lifetime" Substack plan will get tier: paid</p>
            </div>
          </div>
          <div class="flex items-start">
            <%= check_box_tag "import[options][auto_gift_paid]", "1", @import.options["auto_gift_paid"],
                class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded mt-1" %>
            <div class="ml-3">
              <%= label_tag "import[options][auto_gift_paid]", "Auto-gift all paid members",
                  class: "block text-sm font-medium text-gray-900" %>
              <p class="text-xs text-gray-500">All paid plan members (monthly, yearly, etc.) will get tier: paid</p>
            </div>
          </div>
        </div>
      </div>
      <div class="bg-blue-50 rounded-lg p-4 mb-6">
        <h3 class="text-sm font-medium text-blue-900 mb-2">What will happen:</h3>
        <ul class="text-sm text-blue-800 list-disc list-inside space-y-1">
          <li>Parse email_list CSV from your Substack export</li>
          <li>Import members with active subscriptions or enabled emails</li>
          <li>Skip inactive members and those with disabled emails</li>
          <li>Match by email address (update existing, create new)</li>
          <li>Extract name from email (e.g., "john.doe" from "john.doe@email.com")</li>
          <li>Apply tier settings based on options above</li>
          <li>Store Substack plan information in metadata</li>
        </ul>
      </div>
      <div class="flex items-center justify-between">
        <%= link_to "← Back to Import", admin_import_path(@import), class: "uppercase text-xs px-1.5 py-0.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
        <%= f.submit "Start Member Import", class: "uppercase text-xs px-1.5 py-0.5 border border-green-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>
      </div>
    <% end %>
  </div>
</div>
