<%#
  Publish-to-live panel for the imports/show page. Renders one of:

    - "Deploy your live site first" (no peer URL configured)
    - The two-step flow: site-sync first, then members/deliveries
    - In-progress / completed / failed status (after Publish was clicked)

  Local: `import` (the @import record).
%>

<%
  # Authoritative "this import was published" record lives on the
  # Import row itself (set by ImportPublishJob on completion). The
  # cache entry below is just transient progress display.
  published    = import.stats && import.stats["published_to_live"]
  status        = Rails.cache.read(ImportPublishJob.status_cache_key(import.id))
  peer_set_up   = SiteSync::Exchange.can_call_peer?
  local_fp      = peer_set_up ? SiteSync::Ledger.fingerprint_for(RoeSitePaths::SITE_PATH) : nil
  peer_state    = peer_set_up ? SiteSync::Exchange.peer_state : nil
  peer_fp       = peer_state&.dig(:fingerprint)
  site_in_sync  = local_fp.present? && peer_fp.present? && local_fp == peer_fp
%>

<div class="mb-6 bg-white shadow p-6">
  <h2 class="text-lg font-medium mb-1">Publish this import to live</h2>
  <p class="text-sm text-gray-600 mb-4">
    Includes all members and newsletter deliveries from this import.
    Posts, pages, and media must already be synced to live first
    (deliveries reference posts that need to exist on the other side).
  </p>

  <% if published %>
    <%# ─── Completed (persistent, from import.stats) ─── %>
    <%# Once a publish has succeeded, this panel becomes the
        permanent record of it. No dismiss — there's no reason to
        re-publish the same import, and historical visibility beats
        screen real estate. %>
    <% counts = published["counts"] || {} %>
    <% published_at = (Time.iso8601(published["at"]) rescue nil) %>
    <div class="bg-green-50 border border-green-200 p-4">
      <div class="font-medium text-green-900 mb-2">
        ✓ Published to live<% if published_at %> on <%= published_at.strftime("%b %d, %Y at %H:%M") %><% end %>
      </div>
      <div class="text-sm text-green-800 font-mono">
        Members: <%= counts["members_inserted"] %> inserted,
                 <%= counts["members_skipped"] %> already on live<br>
        Deliveries: <%= counts["sends_inserted"] %> inserted,
                    <%= counts["sends_skipped"] %> already on live
        <% if counts["sends_no_post"].to_i > 0 %>
          , <%= counts["sends_no_post"] %> with no matching post on live
        <% end %>
        <% if counts["sends_no_member"].to_i > 0 %>
          , <%= counts["sends_no_member"] %> with no matching member on live
        <% end %>
      </div>
      <% if published["errors"].present? %>
        <details class="mt-3 text-xs">
          <summary class="cursor-pointer text-green-700">
            <%= published["errors"].size %> per-record warnings
          </summary>
          <ul class="mt-2 ml-4 list-disc text-green-700">
            <% published["errors"].first(20).each do |err| %><li><%= err %></li><% end %>
          </ul>
        </details>
      <% end %>
    </div>

  <% elsif status && status[:state] == :running %>
    <%# ─── Running ───────────────────────────────────── %>
    <div class="bg-blue-50 border border-blue-200 p-4">
      <div class="flex items-center gap-3">
        <div class="animate-spin h-5 w-5 border-b-2 border-blue-600"></div>
        <div>
          <div class="font-medium text-blue-900">
            <%= ImportPublishJob::STEPS[status[:step]] || "Working…" %>
          </div>
          <% if status[:counts] %>
            <div class="text-xs text-blue-700 mt-1 font-mono">
              members: <%= status[:counts][:members_inserted] %> inserted,
                       <%= status[:counts][:members_skipped] %> skipped
              <% if status[:counts][:sends_total].to_i > 0 || status[:counts][:sends_inserted].to_i > 0 %>
                · sends: <%= status[:counts][:sends_inserted] %> inserted,
                         <%= status[:counts][:sends_skipped] %> skipped
              <% end %>
            </div>
          <% end %>
          <div class="text-xs text-blue-600 mt-1">Refresh the page to update.</div>
        </div>
      </div>
    </div>

  <% elsif status && status[:state] == :failed %>
    <%# ─── Failed ────────────────────────────────────── %>
    <div class="bg-red-50 border border-red-200 p-4">
      <div class="font-medium text-red-900 mb-2">
        ✗ Publish failed
        <% if status[:step] %>
          during <%= ImportPublishJob::STEPS[status[:step]] || status[:step] %>
        <% end %>
      </div>
      <div class="text-sm text-red-800 font-mono"><%= status[:error] %></div>
      <% if status[:counts] %>
        <div class="text-xs text-red-700 mt-2 font-mono">
          Got through: members <%= status[:counts][:members_inserted] %> inserted /
          <%= status[:counts][:members_skipped] %> skipped · sends
          <%= status[:counts][:sends_inserted] %> inserted /
          <%= status[:counts][:sends_skipped] %> skipped
        </div>
      <% end %>
      <p class="text-xs text-red-700 mt-2">
        Re-running is safe — already-published members and deliveries will be skipped.
      </p>
      <div class="mt-3 flex gap-2">
        <%= button_to "Retry publish", publish_to_live_admin_import_path(import),
                      method: :post,
                      class: "inline-flex items-center uppercase text-xs px-1.5 py-0.5 border border-red-800 bg-red-200 hover:bg-red-300 font-mono rounded-xs" %>
        <%= button_to "Dismiss", dismiss_publish_status_admin_import_path(import),
                      method: :post,
                      class: "inline-flex items-center uppercase text-xs px-1.5 py-0.5 border border-gray-700 bg-gray-100 hover:bg-gray-200 font-mono rounded-xs" %>
      </div>
    </div>

  <% elsif !peer_set_up %>
    <%# ─── No peer configured ────────────────────────── %>
    <div class="bg-amber-50 border border-amber-200 p-4">
      <div class="font-medium text-amber-900 mb-1">Set up your live site first</div>
      <p class="text-sm text-amber-800 mb-3">
        You haven't connected this dev environment to a live site yet.
        Once it's deployed and configured, you can publish imports here.
      </p>
      <%= link_to "Deployment documentation →",
                  "/documentation/roe/deployment",
                  class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-amber-800 bg-amber-200 hover:bg-amber-300 font-mono rounded-xs" %>
    </div>

  <% else %>
    <%# ─── Ready to publish (two-step) ───────────────── %>
    <ol class="space-y-3">
      <%# Step 1: site sync %>
      <li class="flex items-start gap-3">
        <span class="<%= site_in_sync ? 'text-green-600' : 'text-gray-400' %> font-mono mt-0.5">
          <%= site_in_sync ? '✓' : '①' %>
        </span>
        <div class="flex-1">
          <% if site_in_sync %>
            <div class="text-sm text-gray-700">
              <span class="text-green-700 font-medium">Posts and media are synced to live.</span>
            </div>
          <% else %>
            <div class="text-sm text-gray-700 mb-1">
              Sync posts, pages, and media to live first.
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <%= link_to "Sync posts and media to live →",
                          admin_site_sync_path,
                          class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
              <%# Safety net for when the user already pushed but the
                  cached peer state hasn't caught up yet (e.g. an older
                  push that didn't update peer_state synchronously).
                  Synchronously calls the peer and reloads. %>
              <%= button_to "Already synced? Refresh sync state",
                            refresh_peer_exchange_admin_import_path(import),
                            method: :post,
                            class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-700 bg-gray-100 hover:bg-gray-200 font-mono rounded-xs" %>
            </div>
            <% if peer_fp.blank? %>
              <p class="text-xs text-gray-500 mt-1">
                (Haven't heard from the live site yet — refresh peer state or open Site Sync.)
              </p>
            <% end %>
          <% end %>
        </div>
      </li>

      <%# Step 2: publish members + deliveries %>
      <li class="flex items-start gap-3">
        <span class="<%= site_in_sync ? 'text-gray-700' : 'text-gray-400' %> font-mono mt-0.5">②</span>
        <div class="flex-1">
          <div class="text-sm text-gray-700 mb-1">
            Publish members and newsletter deliveries from this import.
          </div>
          <% if site_in_sync %>
            <%= button_to "Sync members and deliveries to live",
                          publish_to_live_admin_import_path(import),
                          method: :post,
                          class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-green-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>
          <% else %>
            <span class="inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-400 bg-gray-100 text-gray-400 font-mono rounded-xs cursor-not-allowed">
              Sync members and deliveries to live
            </span>
            <p class="text-xs text-gray-500 mt-1">Complete step 1 first.</p>
          <% end %>
        </div>
      </li>
    </ol>
  <% end %>
</div>
