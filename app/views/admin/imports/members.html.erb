<% content_for :title, "Imported Members — Import ##{@import.id}" %>
<div class="max-w-6xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-2xl font-bold">Imported Members</h1>
    </div>
    <%= link_to "← Back to Import", admin_import_path(@import),
                class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs text-nowrap" %>
  </div>

  <%# Read-only by design: the Members admin section is production-only,
      but this verification view is dev-only (scoped to a single import).
      No edit/delete actions — anything that should change about these
      members should happen on live after publish_to_live. %>
  <div class="bg-amber-50 border border-amber-200 p-3 mb-4 text-sm text-amber-900">
    Read-only view. Member editing happens on the live site after publishing this import.
  </div>

  <% if @members.empty? %>
    <div class="bg-white shadow p-6 text-sm text-gray-600">
      No members were created by this import.
    </div>
  <% else %>
    <div class="bg-white shadow overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-gray-50 text-xs uppercase font-mono text-gray-600">
          <tr>
            <th class="px-3 py-2 text-left">Email</th>
            <th class="px-3 py-2 text-left">Name</th>
            <th class="px-3 py-2 text-left">Tier</th>
            <th class="px-3 py-2 text-left">Status</th>
            <th class="px-3 py-2 text-left">Newsletter</th>
            <th class="px-3 py-2 text-left">Subscribed</th>
            <th class="px-3 py-2 text-right">Deliveries</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% @members.each do |m| %>
            <tr>
              <td class="px-3 py-2 font-mono text-xs"><%= m.email %></td>
              <td class="px-3 py-2"><%= m.name %></td>
              <td class="px-3 py-2">
                <span class="text-xs px-2 py-0.5 rounded font-mono <%= m.tier_paid? ? 'bg-purple-100 text-purple-800' : 'bg-gray-100 text-gray-700' %>">
                  <%= m.tier %>
                </span>
              </td>
              <td class="px-3 py-2">
                <span class="text-xs px-2 py-0.5 rounded font-mono <%= m.status_active? ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-700' %>">
                  <%= m.status %>
                </span>
              </td>
              <td class="px-3 py-2">
                <% case m.newsletter_status %>
                <% when "subscribed" %>
                  <span class="text-xs px-2 py-0.5 rounded font-mono bg-green-100 text-green-800">subscribed</span>
                <% when "unsubscribed" %>
                  <span class="text-xs px-2 py-0.5 rounded font-mono bg-gray-100 text-gray-700">unsubscribed</span>
                <% when "bounced" %>
                  <span class="text-xs px-2 py-0.5 rounded font-mono bg-red-100 text-red-800">bounced</span>
                <% end %>
              </td>
              <td class="px-3 py-2 text-xs text-gray-600 font-mono">
                <%= m.subscribed_at&.strftime("%b %d, %Y") %>
              </td>
              <td class="px-3 py-2 text-right font-mono text-xs">
                <%= m.sends_count %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Quick totals at the bottom so the user can sanity-check at a
        glance — matches what a Substack export typically reports. %>
    <% paid_count   = @members.count { |m| m.tier_paid? } %>
    <% active_count = @members.count { |m| m.status_active? } %>
    <% sub_count    = @members.count { |m| m.newsletter_status_subscribed? } %>
    <div class="mt-4 bg-white shadow p-4 text-sm text-gray-700">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <div class="text-xs uppercase text-gray-500 font-mono">Total</div>
          <div class="text-xl font-bold"><%= @members.size %></div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500 font-mono">Paid</div>
          <div class="text-xl font-bold"><%= paid_count %></div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500 font-mono">Active</div>
          <div class="text-xl font-bold"><%= active_count %></div>
        </div>
        <div>
          <div class="text-xs uppercase text-gray-500 font-mono">Subscribed to newsletter</div>
          <div class="text-xl font-bold"><%= sub_count %></div>
        </div>
      </div>
    </div>
  <% end %>
</div>
