<% content_for :title, "Configure Import" %>
<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">Import from Substack</h1>
  <!-- Progress Steps -->
  <div class="mb-8">
    <div class="flex items-center">
      <div class="flex items-center text-green-600">
        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center font-medium">1</div>
        <span class="ml-2 text-sm font-medium">Upload</span>
      </div>
      <div class="flex-1 h-px bg-green-300 mx-4"></div>
      <div class="flex items-center text-blue-600">
        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center font-medium">2</div>
        <span class="ml-2 text-sm font-medium">Configure</span>
      </div>
      <div class="flex-1 h-px bg-gray-300 mx-4"></div>
      <div class="flex items-center text-gray-400">
        <div class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center font-medium">3</div>
        <span class="ml-2 text-sm font-medium">Import</span>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-medium mb-4">Phase 2: Configure Import</h2>
    <%= form_with model: [:admin, @import], url: phase_2_run_admin_import_path(@import), method: :post, local: true do |f| %>
      <div class="mb-6">
        <%= f.label :base_url, "Substack Base URL", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= f.text_field :base_url, name: "import[base_url]", value: @import.base_url || "https://yourname.substack.com", class: "block w-full border border-gray-300 py-1.5 px-1.5 focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "https://yourname.substack.com" %>
        <p class="mt-1 text-sm text-gray-500">Your Substack publication URL (used for resolving relative links)</p>
      </div>

      <div class="mb-6">
        <%= label_tag "import[rss_url]", "Podcast RSS Feed URL (Optional)", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= text_field_tag "import[rss_url]", nil, class: "block w-full border border-gray-300 py-1.5 px-1.5 focus:border-blue-500 focus:ring-blue-500 sm:text-sm", placeholder: "https://api.substack.com/feed/podcast/.../private/....rss", autocomplete: "off" %>
        <div class="mt-2 p-3 bg-amber-50 border-l-4 border-amber-400 text-sm text-amber-800">
          <strong>Why this matters:</strong> When provided, the importer pulls each episode's <strong>GUID</strong>,
          <strong>duration</strong>, <strong>per-episode artwork</strong>, audio file, and other iTunes metadata directly
          from the feed. The GUID is what podcast apps use to deduplicate episodes — preserving Substack's GUIDs means
          your subscribers won't see every episode as "new" on the day you migrate.
          <br><br>
          For paid podcasts, this URL contains a private token. <strong>It is not stored or logged</strong> — only the parsed metadata is
          used during this import, then scrubbed. Get the URL from your Substack publication's podcast page.
        </div>
      </div>
      <div class="mb-6">
        <h3 class="text-sm font-medium text-gray-700 mb-3">Filters</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
          <div>
            <%= label_tag "import[filters][type]", "Post Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= select_tag "import[filters][type]", options_for_select([["All Types", ""], ["Newsletter", "newsletter"], ["Podcast", "podcast"], ["Page", "page"]], @import.filters["type"]), class: "block w-full border border-gray-300 py-1.5 px-1.5 focus:border-blue-500 focus:ring-blue-500 sm:text-sm appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.20rem_center] bg-no-repeat" %>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= label_tag "import[filters][after]", "After Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= date_field_tag "import[filters][after]", @import.filters["after"], class: "block w-full border border-gray-300 py-1.5 px-1.5 focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
          <div>
            <%= label_tag "import[filters][before]", "Before Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= date_field_tag "import[filters][before]", @import.filters["before"], class: "block w-full border border-gray-300 py-1.5 px-1.5 focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
          <p class="text-xs"><mark class="bg-amber-100 px-1 py-0.5">Leave both dates blank to import everything.</mark></p>
        </div>
      </div>
      <div class="mb-6">
        <h3 class="text-sm font-medium text-gray-700 mb-3">Options</h3>
        <div class="flex items-center">
          <%= check_box_tag "import[options][include_drafts]", "1", @import.options["include_drafts"], class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
          <%= label_tag "import[options][include_drafts]", "Include draft posts", class: "ml-2 block text-sm text-gray-900" %>
        </div>
        <p class="mt-1 text-sm text-gray-500 ml-6">By default, only published posts are imported</p>
      </div>

      <div class="mb-6">
        <h3 class="text-sm font-medium text-gray-700 mb-3">Newsletter Status</h3>
        <p class="text-sm text-gray-600 mb-3">Where should imported posts be published to? (Pages are always site-only.)</p>
        <% selected = @import.options["default_published_to"].presence || "site" %>
        <div class="space-y-2">
          <% [
            ["site", "Site only"],
            ["newsletter", "Newsletter"],
            ["both", "Both site and newsletter"]
          ].each do |value, label| %>
            <div class="flex items-center">
              <%= radio_button_tag "import[options][default_published_to]", value, selected == value, class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300" %>
              <%= label_tag "import_options_default_published_to_#{value}", label, class: "ml-2 block text-sm text-gray-900" %>
            </div>
          <% end %>
        </div>
        <div class="mt-3 bg-amber-50 border-l-4 border-amber-400 p-3 text-sm text-amber-800">
          <strong>Note:</strong> No newsletters or emails will be sent as part of this import. This sets the <code>published_to</code> field on each imported post; you can change it per post later in the editor.
        </div>
      </div>
      <div class="mb-6">
        <div class="flex items-center">
          <%= check_box_tag "import[options][insert_paywalls]", "1", @import.options["insert_paywalls"], id: "insert_paywalls_toggle", class: "h-4 w-4 text-blue-600 focus:ring-blue-500 border-gray-300 rounded" %>
          <%= label_tag "import[options][insert_paywalls]", "Insert paywalls for paid posts", class: "ml-2 block text-sm text-gray-900" %>
        </div>
        <p class="mt-1 text-sm text-gray-500 ml-6">Replaces Substack's paywall marker with Roe's paywall syntax</p>

        <div id="paywall_options" class="mt-4 ml-6 space-y-3 <%= @import.options["insert_paywalls"] ? '' : 'hidden' %>">
          <div>
            <%= label_tag "import[options][paywall_text]", "Paywall message", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_field_tag "import[options][paywall_text]", @import.options["paywall_text"], placeholder: "Upgrade to continue reading.", class: "block w-full border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
          <div>
            <%= label_tag "import[options][paywall_button_text]", "Button text", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= text_field_tag "import[options][paywall_button_text]", @import.options["paywall_button_text"], placeholder: "Become a paid member", class: "block w-full border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" %>
          </div>
        </div>
      </div>

      <script>
        document.getElementById('insert_paywalls_toggle').addEventListener('change', function() {
          document.getElementById('paywall_options').classList.toggle('hidden', !this.checked);
        });
      </script>
      <div class="bg-blue-50 rounded-md p-4 mb-6">
        <h3 class="text-sm font-medium text-blue-900 mb-2">What will happen:</h3>
        <ul class="text-sm text-blue-800 list-disc list-inside space-y-1">
          <li>Posts will be converted from HTML to Markdown</li>
          <li>Images will be downloaded to /site/media/images/</li>
          <li>Audio files (podcasts) will be downloaded to /site/media/audio/</li>
          <li>Video files will be downloaded to /site/media/video/</li>
          <li>Existing posts (by Substack ID) will be skipped</li>
          <li>Existing media (by source URL) will be reused</li>
          <li>Missing media (failed downloads) will be tracked for manual handling</li>
        </ul>
      </div>
      <div class="flex items-center justify-between">
        <%= link_to "← Back", new_admin_import_path, class: "uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
        <%= f.submit "Start Import", class: "uppercase text-sm px-1.5 py-0.5 border border-green-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>
      </div>
    <% end %>
  </div>
</div>
