<% content_for :title, "Import Deliveries - Import ##{@import.id}" %>
<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold mb-6">Import Deliveries from Substack</h1>
  <!-- Progress Steps -->
  <div class="mb-8">
    <div class="flex items-center">
      <div class="flex items-center text-green-600">
        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center font-medium">1</div>
        <span class="ml-2 text-sm font-medium">Upload</span>
      </div>
      <div class="flex-1 h-px bg-green-300 mx-4"></div>
      <div class="flex items-center text-green-600">
        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center font-medium">2</div>
        <span class="ml-2 text-sm font-medium">Posts</span>
      </div>
      <div class="flex-1 h-px bg-green-300 mx-4"></div>
      <div class="flex items-center text-green-600">
        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center font-medium">3</div>
        <span class="ml-2 text-sm font-medium">Members</span>
      </div>
      <div class="flex-1 h-px bg-green-300 mx-4"></div>
      <div class="flex items-center text-blue-600">
        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center font-medium">4</div>
        <span class="ml-2 text-sm font-medium">Deliveries</span>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-lg font-medium mb-4">Phase 4: Import Delivery History</h2>
    <div class="bg-blue-50 rounded-lg p-4 mb-6">
      <h3 class="text-sm font-medium text-blue-900 mb-2">What will happen:</h3>
      <ul class="text-sm text-blue-800 list-disc list-inside space-y-1">
        <li>Find all delivery history files (*.delivers.csv) in your export</li>
        <li>Match each delivery to the corresponding post and member</li>
        <li>Create delivery records showing who received which newsletter and when</li>
        <li>Skip if member not found (they weren't imported in Phase 3)</li>
        <li>Skip duplicate deliveries (if record already exists)</li>
      </ul>
    </div>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
      <h3 class="text-sm font-medium text-yellow-900 mb-2">Requirements:</h3>
      <ul class="text-sm text-yellow-800 list-disc list-inside space-y-1">
        <li>Posts must be imported (Phase 2 completed)</li>
        <li>Members must be imported (Phase 3 completed)</li>
        <li>Export must contain *.delivers.csv files in posts/ directory</li>
      </ul>
    </div>
    <div class="flex items-center justify-between">
      <%= link_to "← Back to Import", admin_import_path(@import), class: "uppercase text-xs px-1.5 py-0.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
      <%= button_to "Start Delivery Import", phase_4_run_admin_import_path(@import),
          method: :post,
          class: "uppercase text-xs px-1.5 py-0.5 border border-green-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs",
          data: { confirm: "This will import delivery history linking posts to members. Continue?" } %>
    </div>
  </div>
</div>
