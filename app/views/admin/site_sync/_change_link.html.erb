<%# A file in a Sync History entry. Opens the file in the entry's panel. %>
<%= link_to admin_site_sync_history_change_path(change[:id], frame: frame),
      data: { turbo_frame: frame }, class: "flex items-center gap-2 px-4 py-1 text-xs hover:bg-blue-50 group" do %>
  <span class="text-gray-400 group-hover:text-gray-700">▸</span>
  <span class="w-14 shrink-0 <%= change[:action] == "deleted" ? "text-red-700" : "text-gray-500" %>"><%= change[:action] %></span>
  <span class="truncate text-gray-900" title="<%= change[:path] %>"><%= change[:path] %></span>
<% end %>
