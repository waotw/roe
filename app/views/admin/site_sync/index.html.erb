<% content_for :editor_js, false %>
<div class="px-4 sm:px-0">
  <div class="mb-8">
    <h1 class="text-3xl font-semibold text-gray-900">Site Sync</h1>
    <p class="mt-2 text-sm text-gray-700">
      Track changes to your <code class="text-xs bg-gray-100 px-1 rounded">/site</code> folder, sync content between local/live sites and manage backups.
    </p>
  </div>

  <%# ─── Post-restore recovery banner (production only) ───────────── %>
  <%= render "restore_recovery" %>

  <%# ─── About ────────────────────────────────────────────────────── %>
  <%# Hidden on production — the page on live is for configuration only. %>
  <% unless Rails.env.production? %>
    <details class="mt-8 py-4 border-t border-gray-200 group">
      <summary class="text-lg font-semibold text-gray-900 mb-2 cursor-pointer select-none flex items-center gap-2 list-none">
        <span class="inline-block transition-transform group-open:rotate-90 text-gray-500">▸</span>
        About Site Sync
      </summary>
      <ul class="text-sm text-gray-600 space-y-1 list-disc ml-5 mt-3">
        <li>Tracks & syncs every file in your <code class="text-xs px-1 py-0.5 bg-gray-200 rounded-xs">/site</code> folder</li>
        <li>Excludes databases in <code class="text-xs px-1 py-0.5 bg-gray-200 rounded-xs">db/</code> folder (separate backup system)</li>
        <li>The local backups use a tool called <code class="text-xs px-1 py-0.5 bg-gray-200 rounded-xs">rsync</code> to create exact copies of your files. For new backups, the system only saves the files that actually changed. For any file that stayed the same, it creates a 'shortcut' (link) to the previous version instead of copying it again. This gives you multiple points in time you can restore from, but saves a massive amount of storage space.</li>
        <li>If you restore from a backup and wish to <code class="text-xs px-1 py-0.5 bg-gray-200 rounded-xs">UNDO</code>, simply restore from the most recent Local Backup below.</li>
      </ul>

      <% if SiteConfig.current("site")&.static_generation_enabled %>
        <h4 class="text-base font-semibold text-gray-900 mt-6 mb-2">Static Site Sync (SFTP)</h4>
        <ul class="text-sm text-gray-600 space-y-1 list-disc ml-5">
          <li>Generated HTML, CSS and JS output lives in <code class="text-xs px-1 py-0.5 bg-gray-200 rounded-xs">/static_site</code> as static files.</li>
          <li>Static Site Sync syncs <code class="text-xs px-1 py-0.5 bg-gray-200 rounded-xs">/static_site</code> directly with your webhost — only changed files are sent on each push.</li>
        </ul>
      <% end %>
    </details>
  <% end %>

  <%# ─── Post-restore confirmation panel ─────────────────────────── %>
  <%# Sticks around for an hour after a restore so the user has clear
      evidence the operation worked. Older restores fall out (no
      reason to surface them — they're history, not current state). %>
  <% if @last_restore && @last_restore[:restored_at] && @last_restore[:restored_at] > 1.hour.ago %>
    <div class="bg-green-50 border border-green-200 rounded-xs p-6 mb-6">
      <h3 class="text-sm font-semibold text-green-900 mb-2">
        Restore Completed
      </h3>
      <p class="text-sm text-green-800">
        Restored <code class="text-xs bg-white px-1 rounded font-mono"><%= @last_restore[:name] %></code>
        <%= time_ago_in_words(@last_restore[:restored_at]) %> ago.
        <strong><%= @last_restore[:file_count] %></strong> files written to <code class="text-xs bg-white px-1 rounded">/site</code>.
      </p>
      <p class="text-xs text-green-700 mt-2">
        If this was unintentional, you can restore to the most recent backup in the list below. This will bring your site back to exactly as it was before it was restored.
      </p>
    </div>
  <% end %>

  <%# ─── Tabs ────────────────────────────────────────────────────── %>
  <%# Three sections — live cross-environment sync, SFTP push of the
      static output, and the backup list — share this page but are
      independent enough that surfacing them all at once was getting
      noisy. Uses the shared tabs Stimulus controller (same one the
      Stripe Test/Live config uses). Static Site Sync tab only renders
      when SSG is enabled. %>
  <div data-controller="tabs">
    <%# ─── Pending changes ───────────────────────────────────────── %>
    <%# Single at-a-glance panel for both sync flows. Amber when
        either has drift, green when both are caught up. Each amber
        line is a button that jumps to its tab — relying on Stimulus
        action dispatch from inside the same `tabs` controller scope,
        so the panel must live inside `<div data-controller="tabs">`
        even though it sits above the nav. Static site row renders
        only when SSG is enabled (controller-gated). %>
    <%
      live_drift_count = if @status[:state] == :local_drift
                          # Collapsed counts (documentation/roe etc. count as
                          # one) so an update's docs don't inflate the tally.
                          (collapsed_sync_count(@status[:local][:modified]) +
                           collapsed_sync_count(@status[:local][:added]) +
                           collapsed_sync_count(@status[:local][:deleted]))
                        else
                          0
                        end
      live_in_error = @status[:state] == :error

      static_visible       = @static_site_sync_config.present?
      static_protocol_zip  = static_visible && @static_site_sync_config.protocol_zip?
      static_configured    = static_visible && @static_site_sync_config.configured?
      static_never_pushed  = static_configured && @static_site_sync_manifest&.empty?
      static_drift_count   = (@static_site_sync_diff&.count).to_i
      static_has_drift     = !static_protocol_zip && static_configured && (static_never_pushed || static_drift_count > 0)
      static_unconfigured  = static_visible && !static_protocol_zip && !static_configured
      # ZIP "drift" = the user has never downloaded an archive yet.
      # Once they download once we trust them to keep doing it on
      # their own cadence — the row reports the timestamp, not drift.
      static_zip_never_downloaded = static_protocol_zip && @static_site_sync_config.last_pushed_at.nil?

      any_drift = live_drift_count > 0 || live_in_error || static_has_drift || static_unconfigured || static_zip_never_downloaded
    %>

    <div class="<%= any_drift ? 'bg-amber-50 border border-amber-300' : 'bg-green-50 border border-green-300' %> rounded-xs p-4 mb-6">
      <h3 class="text-xs font-semibold uppercase tracking-wide <%= any_drift ? 'text-amber-900' : 'text-green-900' %> mb-2">
        <%= any_drift ? 'Pending changes' : 'All up to date' %>
      </h3>
      <ul class="space-y-1 text-sm">

        <%# Live site sync row — always shown. %>
        <li>
          <% if live_in_error %>
            <button type="button"
                    data-action="click->tabs#show"
                    data-tabs-panel="live-sync"
                    class="flex items-center gap-2 text-red-900 hover:text-red-700 cursor-pointer w-full">
              <span class="inline-block h-2 w-2 rounded-full bg-red-500"></span>
              <span class="font-medium">Live site sync:</span>
              <span>status check failed</span>
              <span class="ml-auto text-xs">→</span>
            </button>
          <% elsif live_drift_count > 0 %>
            <button type="button"
                    data-action="click->tabs#show"
                    data-tabs-panel="live-sync"
                    class="flex items-center gap-2 text-amber-900 hover:text-amber-700 cursor-pointer w-full">
              <span class="inline-block h-2 w-2 rounded-full bg-amber-500"></span>
              <span class="font-medium">Live site sync:</span>
              <span><%= live_drift_count %> file<%= "s" unless live_drift_count == 1 %> changed</span>
              <span class="ml-auto text-xs">→</span>
            </button>
          <% else %>
            <span class="flex items-center gap-2 text-green-900">
              <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
              <span class="font-medium">Live site sync:</span>
              <span>in sync<% if @last_synced_at %> · last synced <%= time_ago_in_words(@last_synced_at) %> ago<% end %></span>
            </span>
          <% end %>
        </li>

        <%# Static site sync row — only when SSG is enabled. ZIP is a
            manual download flow, so it doesn't carry a drift state in
            the way SFTP/FTPS do — it reports "last downloaded …" as
            an event timestamp instead. %>
        <% if static_visible %>
          <% protocol_zip = @static_site_sync_config.protocol_zip? %>
          <li>
            <% if static_unconfigured && !protocol_zip %>
              <button type="button"
                      data-action="click->tabs#show"
                      data-tabs-panel="static-sync"
                      class="flex items-center gap-2 text-amber-900 hover:text-amber-700 cursor-pointer w-full">
                <span class="inline-block h-2 w-2 rounded-full bg-amber-500"></span>
                <span class="font-medium">Static site:</span>
                <span>connection not configured</span>
                <span class="ml-auto text-xs">→</span>
              </button>
            <% elsif protocol_zip %>
              <% last = @static_site_sync_config.last_pushed_at %>
              <% if last.nil? %>
                <button type="button"
                        data-action="click->tabs#show"
                        data-tabs-panel="static-sync"
                        class="flex items-center gap-2 text-amber-900 hover:text-amber-700 cursor-pointer w-full">
                  <span class="inline-block h-2 w-2 rounded-full bg-amber-500"></span>
                  <span class="font-medium">Static site ZIP:</span>
                  <span>never downloaded</span>
                  <span class="ml-auto text-xs">→</span>
                </button>
              <% else %>
                <button type="button"
                        data-action="click->tabs#show"
                        data-tabs-panel="static-sync"
                        class="flex items-center gap-2 text-green-900 hover:text-green-700 cursor-pointer w-full">
                  <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
                  <span class="font-medium">Static site ZIP:</span>
                  <span>downloaded on <%= last.strftime("%b %-d, %Y") %> at <%= last.strftime("%-I:%M %p") %></span>
                  <span class="ml-auto text-xs">→</span>
                </button>
              <% end %>
            <% elsif static_never_pushed %>
              <button type="button"
                      data-action="click->tabs#show"
                      data-tabs-panel="static-sync"
                      class="flex items-center gap-2 text-amber-900 hover:text-amber-700 cursor-pointer w-full">
                <span class="inline-block h-2 w-2 rounded-full bg-amber-500"></span>
                <span class="font-medium">Static site:</span>
                <span>never pushed</span>
                <span class="ml-auto text-xs">→</span>
              </button>
            <% elsif static_drift_count > 0 %>
              <button type="button"
                      data-action="click->tabs#show"
                      data-tabs-panel="static-sync"
                      class="flex items-center gap-2 text-amber-900 hover:text-amber-700 cursor-pointer w-full">
                <span class="inline-block h-2 w-2 rounded-full bg-amber-500"></span>
                <span class="font-medium">Static site:</span>
                <span><%= static_drift_count %> file<%= "s" unless static_drift_count == 1 %> ready to push</span>
                <span class="ml-auto text-xs">→</span>
              </button>
            <% else %>
              <span class="flex items-center gap-2 text-green-900">
                <span class="inline-block h-2 w-2 rounded-full bg-green-500"></span>
                <span class="font-medium">Static site:</span>
                <span>up to date</span>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="border-b border-gray-200 mb-6">
      <nav class="flex gap-4">
        <button type="button"
                data-tabs-target="tab"
                data-action="click->tabs#show"
                data-tabs-panel="live-sync"
                class="py-2 px-1 text-sm font-medium border-b-2 border-blue-600 text-blue-600">
          Site Sync
        </button>
        <% if @static_site_sync_config %>
          <button type="button"
                  data-tabs-target="tab"
                  data-action="click->tabs#show"
                  data-tabs-panel="static-sync"
                  class="py-2 px-1 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">
            Static Site Sync
          </button>
        <% end %>
        <button type="button"
                data-tabs-target="tab"
                data-action="click->tabs#show"
                data-tabs-panel="backups"
                class="py-2 px-1 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700">
          Site Backups
        </button>
      </nav>
    </div>

  <%# Live-sync tab. The transfer status + all cross-env sync status below
      is the CONTENT of this panel (it used to sit outside every panel, so
      it leaked onto the Backups tab). Static-sync + Backups are siblings,
      rendered after this panel closes. %>
  <div data-tabs-target="panel" data-tabs-panel="live-sync">

  <%# ─── Transfer status ──────────────────────────────────────────── %>
  <%# Surfaces in-flight or recently-finished push/pull jobs at the
      top of the page so the user gets immediate feedback after
      kicking one off. Cache-backed (see SiteSyncTransferJob); cleared
      via the Dismiss button or auto-expires after the cache TTL. %>
  <% if @transfer_status %>
    <% kind_label = { push: "Push to live", pull: "Pull from live", clone: "Clone to live", resolve: "Conflict resolution" }[@transfer_status[:kind]] || "Sync" %>
    <% case @transfer_status[:state] %>
      <% when :running %>
        <% progress = @transfer_status[:progress] %>
        <% progress_pct = progress && progress[:total].to_i.positive? ? (progress[:completed].to_f / progress[:total] * 100).round : 0 %>
        <div class="bg-blue-50 border border-blue-200 rounded-xs p-6 mb-6"
           data-controller="site-sync">
          <div class="flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <h3 class="text-sm font-semibold text-blue-900 mb-2">⏳ <%= kind_label %> in progress</h3>
              <p class="text-sm text-blue-900 font-mono mb-2"
               data-site-sync-target="step">
                <%= SiteSyncTransferJob::STEPS[@transfer_status[:step]] || @transfer_status[:step] || "Starting…" %>
              </p>
              <%# Progress line — hidden until rsync starts emitting
                to-chk lines. The Stimulus controller toggles visibility
                and rewrites label + bar width as new polls arrive. %>
              <div class="mb-2" data-site-sync-target="progress" <%= "hidden" unless progress %>>
                <p class="text-sm text-blue-900 font-mono mb-1" data-site-sync-target="progressLabel">
                  <% if progress %><%= progress[:completed] %> of <%= progress[:total] %> files transferred<% end %>
                </p>
                <div class="h-1.5 w-full max-w-sm bg-blue-100 rounded-full overflow-hidden">
                  <div class="h-full bg-blue-600 transition-all"
                     style="width: <%= progress_pct %>%;"
                     data-site-sync-target="progressBar"></div>
                </div>
              </div>
              <p class="text-sm text-blue-800">
                Started <%= time_ago_in_words(@transfer_status[:started_at]) %> ago.
                This page will auto-refresh to show progress.
              </p>
            </div>
            <%# Force-clear the status — useful if the worker died or
              rsync hung. Only clears the UI flag; doesn't actually
              kill any subprocess that might still be running. %>
            <%= button_to "Dismiss",
                        admin_dismiss_site_transfer_status_path,
                        method: :post,
                        data: { confirm: "Clear the running-status flag? Only do this if you've confirmed the job isn't actually running (check Rails logs for SiteSync activity). This won't kill any subprocess that might still be working." },
                        class: "inline-flex items-center px-3 py-1 border border-blue-700 bg-blue-100 hover:bg-blue-200 text-blue-800 font-mono text-xs rounded-xs cursor-pointer whitespace-nowrap" %>
          </div>
        </div>
      <%# :completed intentionally renders nothing — the always-on status
          panel above ("in sync · last synced …") is the success signal, so
          there's no transient banner to dismiss. %>
      <% when :conflicts %>
        <% conflicts = Array(@transfer_status[:conflicts]) %>
        <div class="bg-amber-50 border border-amber-300 rounded-xs p-6 mb-6">
          <h3 class="text-sm font-semibold text-amber-900 mb-1">
            ⚠️ <%= kind_label %> paused — <%= conflicts.size %> conflict<%= "s" if conflicts.size != 1 %>
          </h3>
          <p class="text-sm text-amber-800 mb-4">
            These files changed on <strong>both</strong> this machine and live since the last sync,
            so nothing was overwritten. Pick which version wins for each, then apply.
          </p>

          <%= form_with url: admin_resolve_site_sync_conflicts_path, method: :post, data: { turbo: false } do %>
            <div class="space-y-2 mb-4">
              <% conflicts.each do |c| %>
                <% type_label = { "edit_edit" => "edited on both sides",
                                  "edit_delete" => "edited here, deleted on live",
                                  "delete_edit" => "deleted here, edited on live" }[c["type"]] || c["type"] %>
                <div class="flex items-center justify-between gap-3 bg-white border border-amber-200 rounded-xs px-3 py-2">
                  <div class="min-w-0">
                    <p class="font-mono text-xs text-gray-800 truncate" title="<%= c["path"] %>"><%= c["path"] %></p>
                    <p class="text-[11px] text-gray-500">
                      <%= type_label %><%
                        %><% if c["newer"] == "local" %> · yours is newer<% elsif c["newer"] == "live" %> · live is newer<% end %>
                    </p>
                  </div>
                  <div class="flex gap-3 shrink-0 text-xs">
                    <label class="flex items-center gap-1 cursor-pointer">
                      <input type="radio" name="resolutions[<%= c["path"] %>]" value="local" <%= "checked" if c["newer"] != "live" %>> Keep mine
                    </label>
                    <label class="flex items-center gap-1 cursor-pointer">
                      <input type="radio" name="resolutions[<%= c["path"] %>]" value="live" <%= "checked" if c["newer"] == "live" %>> Keep live
                    </label>
                  </div>
                </div>
              <% end %>
            </div>
            <div class="flex flex-wrap gap-2">
              <button type="submit"
                      class="inline-flex items-center px-3 py-1.5 border border-amber-700 bg-amber-600 hover:bg-amber-700 text-white font-mono text-xs rounded-xs cursor-pointer">
                APPLY CHOICES
              </button>
              <button type="submit" name="resolve_all" value="recent"
                      class="inline-flex items-center px-3 py-1.5 border border-amber-700 bg-amber-100 hover:bg-amber-200 text-amber-800 font-mono text-xs rounded-xs cursor-pointer">
                RESOLVE ALL BY MOST-RECENT
              </button>
            </div>
          <% end %>

          <div class="mt-2">
            <%= button_to "CANCEL",
                        admin_dismiss_site_transfer_status_path,
                        method: :post,
                        data: { confirm: "Clear the conflict notice without resolving? The files stay diverged until you sync again." },
                        class: "inline-flex items-center px-3 py-1 border border-amber-700 bg-amber-50 hover:bg-amber-100 text-amber-800 font-mono text-xs rounded-xs cursor-pointer" %>
          </div>
        </div>

      <% when :failed %>
        <%# Reassessment compares the current local + peer fingerprints
          to determine whether the transfer's *content* actually went
          through despite the failure (which would mean only the
          bookkeeping step failed). Different copy + actions for each
          case. %>
        <% reassessment = @transfer_status[:reassessment] %>
        <% step_label = SiteSyncTransferJob::STEPS[@transfer_status[:step]] || @transfer_status[:step] %>

        <% if reassessment && reassessment[:in_sync] %>
          <%# Bookkeeping-only failure — content is actually synced. %>
          <div class="bg-amber-50 border border-amber-200 rounded-xs p-6 mb-6">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-sm font-semibold text-amber-900 mb-1">⚠️ <%= kind_label %> hit a bookkeeping issue</h3>
                <p class="text-sm text-amber-800 mb-1">
                  Both sides report the same content fingerprint, so the actual
                  file transfer succeeded. The error happened in a follow-up step
                  (likely <code class="text-xs"><%= step_label %></code>).
                </p>
                <p class="text-xs text-amber-700">
                  The sync status will resolve (within ~60s).
                  You can dismiss this safely.
                </p>
              </div>
              <%= button_to "Dismiss",
                          admin_dismiss_site_transfer_status_path,
                          method: :post,
                          class: "inline-flex items-center px-3 py-1 border border-amber-700 bg-amber-100 hover:bg-amber-200 text-amber-800 font-mono text-xs rounded-xs cursor-pointer whitespace-nowrap" %>
            </div>
            <% if @transfer_status[:error].present? %>
              <details class="mt-2">
                <summary class="text-xs text-amber-700 cursor-pointer hover:text-amber-900">Show error details</summary>
                <pre class="mt-2 p-3 bg-white border border-amber-200 rounded-xs font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap"><%= @transfer_status[:error] %></pre>
              </details>
            <% end %>
          </div>

        <% else %>
          <%# Real partial failure — content is NOT in sync (or we
            couldn't verify). %>
          <div class="bg-red-50 border border-red-200 rounded-xs p-6 mb-6">
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h3 class="text-sm font-semibold text-red-900 mb-1">❌ <%= kind_label %> didn't complete</h3>
                <p class="text-sm text-red-700 mb-1">
                  Failed <%= time_ago_in_words(@transfer_status[:completed_at] || @transfer_status[:started_at]) %> ago
                  during <code class="text-xs"><%= step_label %></code>.
                </p>
                <% if reassessment && reassessment[:intended_count] %>
                  <%# Per-file detail available — show concrete numbers. %>
                  <p class="text-sm text-red-700">
                    <strong><%= reassessment[:done_count] %></strong> of
                    <strong><%= reassessment[:intended_count] %></strong>
                    files synced.
                    <strong><%= reassessment[:pending_count] %></strong>
                    still pending. Click Retry to finish — only the
                    pending files will be re-sent.
                  </p>
                <% elsif reassessment && reassessment[:local_fingerprint] && reassessment[:peer_fingerprint] %>
                  <%# Aggregate fingerprint check only — no per-file detail. %>
                  <p class="text-sm text-red-700">
                    Local and live are out of sync. Click Retry
                    to re-run — only the still-pending files will be re-sent.
                  </p>
                <% else %>
                  <%# No reassessment data at all. %>
                  <p class="text-sm text-red-700">
                    Couldn't reach the live site to verify sync status. Click Retry once the underlying
                    issue is resolved — only the still-pending files will be
                    re-sent.
                  </p>
                <% end %>
              </div>
              <div class="flex flex-col gap-2 items-end">
                <%= button_to "Retry",
                            admin_retry_site_transfer_path,
                            method: :post,
                            data: { turbo_submits_with: "⏳ Retrying…" },
                            class: "inline-flex items-center px-3 py-1 border border-red-700 bg-red-200 hover:bg-red-300 text-red-900 font-mono text-xs rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait whitespace-nowrap" %>
                <%= button_to "Dismiss",
                            admin_dismiss_site_transfer_status_path,
                            method: :post,
                            class: "inline-flex items-center px-3 py-1 border border-red-700 bg-red-100 hover:bg-red-200 text-red-800 font-mono text-xs rounded-xs cursor-pointer whitespace-nowrap" %>
              </div>
            </div>

            <%# Per-file pending list (collapsible). Only renders when
              the reassessment got per-file detail back from the peer. %>
            <% if reassessment && reassessment[:pending_count].to_i > 0 %>
              <details class="mt-3">
                <summary class="text-sm font-semibold text-red-900 cursor-pointer hover:text-red-700">
                  Show pending files
                </summary>
                <div class="mt-2 ml-4 space-y-3 max-h-96 overflow-y-auto">
                  <% [
                  [ "Modified", reassessment[:pending_modified] ],
                  [ "Added",    reassessment[:pending_added] ],
                  [ "Deleted",  reassessment[:pending_deleted] ]
                ].each do |label, list| %>
                    <% next if list.blank? %>
                    <div>
                      <h4 class="text-xs font-semibold text-red-900 mb-1">
                        <%= label %> (<%= list.size %>)
                      </h4>
                      <ul class="text-xs font-mono text-red-800 space-y-1">
                        <% list.each do |path| %>
                          <li><%= path %></li>
                        <% end %>
                      </ul>
                    </div>
                  <% end %>
                </div>
              </details>
            <% end %>

            <% if @transfer_status[:error].present? %>
              <pre class="mt-3 p-3 bg-white border border-red-200 rounded-xs font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap"><%= @transfer_status[:error] %></pre>
            <% end %>

            <%# Troubleshooting docs entry point — shown only on real
                (non-bookkeeping) failure so it doesn't add noise to
                the "actually synced, just hiccuped" amber panel. %>
            <p class="mt-3 text-sm text-red-800">
              Need help? <%= link_to "Troubleshoot Site Sync →", "/documentation/roe/ts-site-sync", target: "_blank", rel: "noopener", class: "underline hover:text-red-600 font-medium" %>
            </p>
          </div>
        <% end %>
    <% end %>
  <% end %>

  <%# ─── Drift state ──────────────────────────────────────────────── %>
  <%# :clean renders nothing — no point shouting "no changes" when
      nothing's wrong. Errors and drift get their own panels. %>
  <% case @status[:state] %>
    <% when :error %>
      <div class="bg-red-50 border border-red-200 rounded-xs p-6 mb-6">
        <h2 class="text-lg font-semibold text-red-900 mb-2">Sync Status Checked Failed</h2>
        <pre class="p-3 bg-white border border-red-200 rounded-xs font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap"><%= @status[:error] %></pre>
      </div>

    <% when :local_drift %>
      <%# Shown only when peer is unreachable (offline-fallback mode).
        When peer is reachable, the same info is folded into the
        cross-env panel below — no need to display it twice. %>
      <% unless @peer_reachable %>
        <div class="bg-amber-50 border border-amber-200 rounded-xs p-6 mb-6">
          <% counts = @status[:local] %>
          <%# Collapse Roe-managed groups (documentation/roe) into one row so
              an update's docs don't read as dozens of changes the user never
              made. Display only — the sync still transfers every file. %>
          <% display = { modified: collapse_sync_paths(counts[:modified]), added: collapse_sync_paths(counts[:added]), deleted: collapse_sync_paths(counts[:deleted]) } %>
          <h2 class="text-lg font-semibold text-amber-900 mb-2">Unsynced Changes</h2>
          <p class="text-amber-800 mb-3">
            You've made these changes since your last sync:
          </p>
          <ul class="list-disc ml-6 mb-4 text-sm text-amber-800 space-y-1">
            <% if display[:modified].any? %>
              <li><strong><%= display[:modified].size %></strong> file<%= 's' if display[:modified].size != 1 %> modified</li>
            <% end %>
            <% if display[:added].any? %>
              <li><strong><%= display[:added].size %></strong> file<%= 's' if display[:added].size != 1 %> added</li>
            <% end %>
            <% if display[:deleted].any? %>
              <li><strong><%= display[:deleted].size %></strong> file<%= 's' if display[:deleted].size != 1 %> deleted</li>
            <% end %>
          </ul>
          <% if @status[:recorded_at] %>
            <p class="text-xs text-amber-700 mb-4 font-mono">
              Last sync: <%= @status[:recorded_at] %>
            </p>
          <% end %>

          <%# Single collapsible "Show changes" containing all three
          groups. Easier to scan than three separate disclosures. %>
          <details class="mb-4">
            <summary class="text-sm font-semibold text-amber-900 cursor-pointer hover:text-amber-700">
              Show changes
            </summary>
            <div class="mt-2 ml-4 space-y-3 max-h-96 overflow-y-auto">
              <% [ [ "Modified", display[:modified] ], [ "Added", display[:added] ], [ "Deleted", display[:deleted] ] ].each do |label, list| %>
                <% next if list.empty? %>
                <div>
                  <h4 class="text-xs font-semibold text-amber-900 mb-1">
                    <%= label %> (<%= list.size %>)
                  </h4>
                  <ul class="text-xs font-mono text-amber-800 space-y-1">
                    <% list.each do |path| %>
                      <li><%= path %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          </details>

          <% if SiteSync::Exchange.can_call_peer? %>
            <div class="mt-6 pt-4 border-t border-amber-200">
              <h3 class="text-sm font-semibold text-amber-900 mb-2">Sync with live</h3>
              <p class="text-sm text-amber-800 mb-3">
                Syncs changes both ways. Any file changed on <em>both</em> sides pauses for you to resolve — nothing is overwritten — and both sides are backed up first.
              </p>
              <%= button_to "SYNC WITH LIVE",
                            admin_sync_site_path,
                            method: :post,
                            data: { turbo_submits_with: "⏳ Starting sync…" },
                            class: "inline-flex items-center px-4 py-2 border border-gray-800 bg-amber-300 hover:bg-amber-400 font-mono text-sm rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait whitespace-nowrap" %>
            </div>
          <% end %>

        </div>
      <% end %>
  <% end %>

  <%# ─── Cross-environment sync status ───────────────────────────── %>
  <%# Debug-friendly view of what we know about the peer environment.
      Phase 4 will hide most of this once cross-env exchange is
      considered the source of truth; for now it's surfaced explicitly
      so you can verify the wiring is working. %>
  <div class="bg-white border border-gray-200 rounded-xs p-6 mb-6">
    <div class="flex items-center justify-between mb-3 gap-4">
      <h2 class="text-lg font-semibold text-gray-900">Public/Local Site Sync</h2>
      <%# Synchronous exchange ping — handy for testing without
          waiting on the hourly job or the 60s on-render debounce.
          Only meaningful on the side that initiates (dev). %>
      <% if @peer_call_configured %>
        <%= button_to "Refresh Sync Status",
                      admin_refresh_site_sync_exchange_path,
                      method: :post,
                      data: { turbo_submits_with: "⏳ Refreshing…" },
                      class: "uppercase inline-flex items-center px-3 py-1.5 border border-gray-600 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait whitespace-nowrap" %>
      <% end %>
    </div>

    <%# ─── Connection status alerts ─────────────────────────────────── %>
    <% if @last_exchange_result && !@last_exchange_result[:success] %>
      <% error_type = @last_exchange_result[:error_type] %>
      <% attempted_at = @last_exchange_result[:attempted_at] %>

      <% if error_type == :auth_error %>
        <%# Token mismatch - most critical error %>
        <div class="p-4 bg-red-50 border border-red-200 rounded-xs mb-4">
          <h3 class="text-sm font-semibold text-red-900 mb-2">
            ⚠️ Token Mismatch — Cannot Connect to Live Site
          </h3>
          <p class="text-sm text-red-800 mb-3">
            The shared token doesn't match between environments. Site Sync cannot authenticate with the live site.
          </p>
          <p class="text-sm text-red-800 mb-4">
            <strong>To fix this:</strong> Copy the Shared token from below and add it to the production environment.
            <% if Rails.env.development? && @peer_url.present? %>
              <a href="<%= @peer_url %>/admin/site_sync"
                 target="_blank"
                 class="underline font-semibold">
                Open production Site Sync →
              </a>
            <% end %>
          </p>
          <% if attempted_at %>
            <p class="text-xs text-red-600">
              Last attempt: <%= time_ago_in_words(attempted_at) %> ago
            </p>
          <% end %>
        </div>

      <% elsif error_type == :not_found %>
        <%# 404 - endpoint doesn't exist %>
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xs mb-4">
          <h3 class="text-sm font-semibold text-amber-900 mb-2">
            ⚠️ Site Sync Endpoint Not Found
          </h3>
          <p class="text-sm text-amber-800 mb-3">
            The live URL might be incorrect, or the production site doesn't have Site Sync enabled.
          </p>
          <p class="text-sm text-amber-800">
            <strong>Check:</strong> Is the live URL correct? Does the production site have the latest Roe version?
          </p>
        </div>

      <% elsif error_type == :network_error %>
        <%# Network issues %>
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xs mb-4">
          <h3 class="text-sm font-semibold text-amber-900 mb-2">
            ⚠️ Cannot Reach Live Site
          </h3>
          <p class="text-sm text-amber-800 mb-3">
            Network error when trying to connect. The live site might be down or unreachable.
          </p>
          <% if @last_exchange_result[:error_message] %>
            <p class="text-xs text-amber-600 font-mono">
              <%= @last_exchange_result[:error_message] %>
            </p>
          <% end %>
        </div>

      <% else %>
        <%# Generic error %>
        <div class="p-4 bg-amber-50 border border-amber-200 rounded-xs mb-4">
          <h3 class="text-sm font-semibold text-amber-900 mb-2">
            ⚠️ Connection Issue
          </h3>
          <p class="text-sm text-amber-800 mb-3">
            Unable to sync with live site.
            <% if @last_exchange_result[:http_code] %>
              (HTTP <%= @last_exchange_result[:http_code] %>)
            <% end %>
          </p>
          <% if @last_exchange_result[:error_message].present? %>
            <p class="text-xs text-amber-700 font-mono mb-3 break-words">
              <%= @last_exchange_result[:error_message] %>
            </p>
          <% end %>
          <p class="text-xs text-amber-600">
            Try clicking "Refresh now" to retry the connection.
          </p>
        </div>
      <% end %>
    <% end %>

    <%# ─── Production-specific: Show if never received contact ────── %>
    <% if Rails.env.production? && !@peer_state %>
      <div class="p-4 bg-blue-50 border border-blue-200 rounded-xs mb-4">
        <h3 class="text-sm font-semibold text-blue-900 mb-2">
          ⏳ Waiting for Local Environment
        </h3>
        <p class="text-sm text-blue-800 mb-3">
          Production receives sync requests but doesn't initiate them.
          No connection from your local environment yet.
        </p>
        <p class="text-sm text-blue-800">
          <strong>To connect:</strong> Go to your local Site Sync page, set the Peer URL to this production site,
          ensure both environments have the same Shared token, then click "Refresh now".
        </p>
      </div>
    <% end %>

    <% if @peer_state %>
      <p class="text-sm text-gray-700 mb-2">
        Last contact with
        <strong><%= SiteSync::Exchange.peer_label || @peer_state[:env] %></strong>:
        <%= time_ago_in_words(@peer_state[:received_at]) %> ago.
      </p>
      <%
        # One panel for both directions. Live changes come from the peer's
        # drift payload; local changes from our own ledger diff. Either or
        # both may be present — a single Sync reconciles it all.
        live_changes  = @peer_drift ? (@peer_state && @peer_state[:drift]) : nil
        local_changes = (@peer_reachable && @status[:state] == :local_drift) ? @status[:local] : nil
        # Neither side reports drift but the fingerprints still differ:
        # the ledgers diverged and a sync realigns them.
        ledger_diverged = @peer_drift.blank? && local_changes.nil? &&
                          @status[:state] == :clean && !@in_sync_with_peer
        has_changes = @peer_drift || local_changes.present? || ledger_diverged

        # While a sync is actively running, the status panel up top owns the
        # display — hide the changes/in-sync section so it doesn't contradict
        # it. It comes back on its own once the run ends: a completed sync
        # clears drift, and conflicts/failed/cancelled aren't "running" so
        # the section reappears for the user to act on.
        sync_running = @transfer_status.present? && @transfer_status[:state].to_s == "running"
      %>
      <% if has_changes && !sync_running %>
        <div class="p-4 bg-amber-50 border border-amber-300 rounded-xs mb-2">
          <h3 class="text-sm font-semibold text-amber-900 mb-3">Changes to sync</h3>

          <%# ── Live changes (from the peer's drift payload) ── %>
          <% if @peer_drift %>
            <div class="mb-3">
              <p class="text-sm text-amber-800 mb-1">
                ⬇️ <strong><%= SiteSync::Exchange.peer_label %></strong> has changes to pull in.
              </p>
              <% if live_changes %>
                <%# Collapse Roe-managed groups for display. Counts derive from
                    the (possibly capped) lists — accurate for a normal diff; a
                    truncated one keeps its "first N per group" note below. %>
                <% live_display = { modified: collapse_sync_paths(live_changes[:modified]), added: collapse_sync_paths(live_changes[:added]), deleted: collapse_sync_paths(live_changes[:deleted]) } %>
                <ul class="list-disc ml-6 text-sm text-amber-800 space-y-1">
                  <% if live_display[:modified].any? %><li><strong><%= live_display[:modified].size %></strong> modified</li><% end %>
                  <% if live_display[:added].any? %><li><strong><%= live_display[:added].size %></strong> added</li><% end %>
                  <% if live_display[:deleted].any? %><li><strong><%= live_display[:deleted].size %></strong> deleted</li><% end %>
                </ul>
                <details class="mt-1">
                  <summary class="text-xs font-semibold text-amber-900 cursor-pointer hover:text-amber-700">
                    Show live changes<% if live_changes[:truncated] %> <span class="font-normal text-amber-700">(first <%= SiteSync::Exchange::DRIFT_LIST_CAP %> per group)</span><% end %>
                  </summary>
                  <div class="mt-2 ml-4 space-y-3 max-h-96 overflow-y-auto">
                    <% [ [ "Modified", live_display[:modified] ], [ "Added", live_display[:added] ], [ "Deleted", live_display[:deleted] ] ].each do |label, list| %>
                      <% next if list.blank? %>
                      <div>
                        <h4 class="text-xs font-semibold text-amber-900 mb-1"><%= label %> (<%= list.size %>)</h4>
                        <ul class="text-xs font-mono text-amber-800 space-y-1">
                          <% list.each do |path| %><li><%= path %></li><% end %>
                        </ul>
                      </div>
                    <% end %>
                  </div>
                </details>
              <% end %>
            </div>
          <% end %>

          <%# ── Local changes (from our own ledger diff) ── %>
          <% if local_changes %>
            <div class="mb-3">
              <p class="text-sm text-amber-800 mb-1">
                ⬆️ <strong>This <%= Rails.env.production? ? "server" : "machine" %></strong> has local changes<%= Rails.env.production? ? " to pull to dev" : " to push to live" %>.
              </p>
              <% local_display = { modified: collapse_sync_paths(local_changes[:modified]), added: collapse_sync_paths(local_changes[:added]), deleted: collapse_sync_paths(local_changes[:deleted]) } %>
              <ul class="list-disc ml-6 text-sm text-amber-800 space-y-1">
                <% if local_display[:modified].any? %><li><strong><%= local_display[:modified].size %></strong> modified</li><% end %>
                <% if local_display[:added].any? %><li><strong><%= local_display[:added].size %></strong> added</li><% end %>
                <% if local_display[:deleted].any? %><li><strong><%= local_display[:deleted].size %></strong> deleted</li><% end %>
              </ul>
              <details class="mt-1">
                <summary class="text-xs font-semibold text-amber-900 cursor-pointer hover:text-amber-700">Show local changes</summary>
                <div class="mt-2 ml-4 space-y-3 max-h-96 overflow-y-auto">
                  <% [ [ "Modified", local_display[:modified] ], [ "Added", local_display[:added] ], [ "Deleted", local_display[:deleted] ] ].each do |label, list| %>
                    <% next if list.empty? %>
                    <div>
                      <h4 class="text-xs font-semibold text-amber-900 mb-1"><%= label %> (<%= list.size %>)</h4>
                      <ul class="text-xs font-mono text-amber-800 space-y-1">
                        <% list.each do |path| %><li><%= path %></li><% end %>
                      </ul>
                    </div>
                  <% end %>
                </div>
              </details>
            </div>
          <% end %>

          <%# ── Ledger divergence recovery ── %>
          <% if ledger_diverged %>
            <p class="text-sm text-amber-800 mb-3">
              ⚠️ Content differs from <%= SiteSync::Exchange.peer_label %>, but neither side reports drift — the ledgers diverged. A sync will realign them.
            </p>
          <% end %>

          <%# ── One action for everything above ── %>
          <% if @site_sync_first_sync %>
            <%# First sync: no shared history, so a merge would flag every file as
                a conflict. Clone local → live wholesale instead (live's starter
                content is removed). Live is backed up first, so it's reversible. %>
            <div class="mt-2 pt-3 border-t border-amber-200">
              <p class="text-sm text-amber-800 mb-2">
                <strong>First sync.</strong> Local and live have never synced, so there's no shared history to merge — make live an exact copy of local (its starter content is removed). Live is backed up first, so it's reversible.
              </p>
              <%= form_with url: admin_clone_site_to_live_path, method: :post, data: { turbo: false }, class: "flex flex-wrap items-center gap-2" do %>
                <%= text_field_tag :confirm, nil,
                      placeholder: "Type LIVE to confirm",
                      autocomplete: "off",
                      class: "font-mono text-sm p-2 border border-amber-400 rounded-xs" %>
                <%= submit_tag "MAKE LIVE MATCH LOCAL",
                      data: { turbo_submits_with: "⏳ Starting clone…" },
                      class: "inline-flex items-center px-4 py-2 border border-gray-800 bg-amber-300 hover:bg-amber-400 font-mono text-sm rounded-xs cursor-pointer whitespace-nowrap" %>
              <% end %>
            </div>
          <% elsif @peer_call_configured %>
            <%= button_to "SYNC WITH LIVE",
                          admin_sync_site_path,
                          method: :post,
                          data: { turbo_submits_with: "⏳ Starting sync…" },
                          class: "mt-1 inline-flex items-center px-4 py-2 border border-gray-800 bg-amber-300 hover:bg-amber-400 font-mono text-sm rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait whitespace-nowrap" %>

            <%# Escape hatch when the two have diverged and local should win:
                mirror local → live wholesale (deletes anything not in local).
                Destructive on live, so gated behind a confirm dialog; live is
                snapshotted first. Same clone path as the first-sync card. %>
            <div class="mt-3" data-controller="force-mirror-modal">
              <button type="button"
                      data-action="force-mirror-modal#open"
                      class="inline-flex items-center px-2.5 py-1 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono text-[10px] rounded-xs cursor-pointer whitespace-nowrap">
                RESET: FORCE LIVE TO MIRROR LOCAL
              </button>
              <!--<p class="text-xs text-amber-700 mt-1.5">Overwrites live entirely with local. Use when the two have diverged and local should win.</p>-->

              <%# Custom confirm modal (matches the delete-page/post modal) — the
                  typed "LIVE" both enables the button and is the confirm param. %>
              <div data-force-mirror-modal-target="modal"
                   data-action="click->force-mirror-modal#backdrop"
                   class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
                <div class="bg-white p-6 shadow-xl max-w-md w-full mx-4">
                  <h3 class="text-lg font-bold text-gray-900 mb-2">Force mirror to live?</h3>
                  <p class="text-sm text-gray-600 mb-4">
                    This <strong>replaces the entire live site</strong> with an exact copy of local — everything on live that isn't in local is deleted. Live is backed up first, so it's reversible.
                  </p>
                  <%= form_with url: admin_clone_site_to_live_path, method: :post do %>
                    <div class="mb-4">
                      <label class="block text-sm font-medium text-gray-700 mb-1">Type <strong>LIVE</strong> to confirm:</label>
                      <%= text_field_tag :confirm, nil,
                            autocomplete: "off",
                            placeholder: "LIVE",
                            data: { "force-mirror-modal-target": "input",
                                    action: "input->force-mirror-modal#validate keydown.enter->force-mirror-modal#submitIfValid keydown.esc->force-mirror-modal#close" },
                            class: "w-full px-3 py-2 border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500" %>
                    </div>
                    <div class="flex gap-3 justify-end">
                      <button type="button" data-action="force-mirror-modal#close"
                              class="px-4 py-2 border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">Cancel</button>
                      <%= submit_tag "Make Live Match Local",
                            disabled: true,
                            data: { "force-mirror-modal-target": "confirm",
                                    turbo_submits_with: "⏳ Starting mirror…",
                                    action: "force-mirror-modal#submit" },
                            class: "px-4 py-2 border border-transparent text-sm font-medium text-white bg-red-600 hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% else %>
            <p class="text-xs text-amber-700 mt-1">
              Sync is controlled from your <strong>local</strong> development environment — visit your local admin Site Sync page.
            </p>
          <% end %>
        </div>
      <% elsif @in_sync_with_peer && !sync_running %>
        <p class="text-sm text-green-800">
          ✓ Local content matches <%= SiteSync::Exchange.peer_label %>.
        </p>
      <% end %>

      <details class="mt-3">
        <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-700">
          Show debug info
        </summary>
        <ul class="mt-2 text-xs font-mono text-gray-600 space-y-1">
          <li>Peer env:                   <code><%= @peer_state[:env] %></code></li>
          <li>Peer fingerprint:           <code><%= @peer_state[:fingerprint] %></code></li>
          <li>Peer recorded fingerprint:  <code><%= @peer_state[:recorded_fingerprint] || '(none)' %></code></li>
          <li>Peer reported version:      <code><%= @peer_state[:version] %></code></li>
          <li>Received at:                <code><%= @peer_state[:received_at] %></code></li>
        </ul>
      </details>

    <% elsif @peer_call_configured %>
      <p class="text-sm text-gray-600">
        Configured to call <code class="text-xs bg-gray-100 px-1 rounded"><%= @peer_url %></code>,
        but no exchange has happened yet. The hourly background job will run shortly,
        or visit this page again in a minute to trigger a refresh.
      </p>

    <% elsif Rails.env.production? %>
      <p class="text-sm text-gray-600">
        This side receives exchanges (no outbound calls — production never initiates).
        No peer has called in yet.
      </p>

    <% end %>

    <%# ─── Settings form ─────────────────────────────────────────── %>
    <div class="mt-6 pt-6 border-t border-gray-200">
      <div class="flex items-center justify-between mb-3 gap-4">
        <h3 class="text-sm font-semibold text-gray-900">Settings</h3>
        <%# Auto-detected deploy target. SiteSync.transport routes
            push/pull/backup through the matching FlyRsync or
            KamalRsync service. %>
        <span class="text-xs text-gray-500">
          Deploy target:
          <code class="px-2 py-0.5 bg-gray-100 text-gray-700 rounded font-mono">
            <%= @deploy_target_label %>
          </code>
        </span>
      </div>

      <%# Token display — must be outside the settings form since token actions are separate forms %>
      <div class="mb-4">
        <label class="block text-sm font-medium text-gray-700 mb-1">
          Shared token
        </label>
        <% if @sync_config.token.present? %>
          <div class="flex gap-2">
            <input type="text"
                   value="<%= @sync_config.token %>"
                   readonly
                   id="sync-token-field"
                   class="flex-1 px-3 py-2 border border-gray-300 rounded-xs font-mono text-xs text-gray-800 bg-gray-50"
                   onclick="this.select();">
            <button type="button"
                    onclick="const f=document.getElementById('sync-token-field');f.select();navigator.clipboard.writeText(f.value);this.textContent='Copied!';setTimeout(()=>this.textContent='Copy',2000);"
                    class="uppercase inline-flex items-center px-3 py-2 border border-gray-600 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs cursor-pointer">
              Copy
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-1">
            Click Copy to copy to clipboard. This token must be set on the live site.<br>
            <%= "Paste this into the your live Site Sync settings." if Rails.env.development? %>
          </p>
        <% else %>
          <div class="p-4 bg-amber-50 border border-amber-200 rounded-xs">
            <% if Rails.env.production? %>

              <p class="text-sm text-amber-800 mb-3">
                ⚠️ No shared token has been set yet. Deploy from your local environment to push the token to this site, or paste your local token below.
              </p>
              <%= form_with url: admin_update_site_sync_config_path, method: :patch, local: true, class: "flex gap-2" do |form| %>
                <%= form.text_field :token,
                                    placeholder: "Paste local token here",
                                    required: true,
                                    autocomplete: "off",
                                    class: "flex-1 px-3 py-2 border border-amber-300 rounded-xs font-mono text-xs text-gray-800 bg-white" %>
                <%= form.submit "Save token",
                                class: "uppercase inline-flex items-center px-4 py-2 border border-amber-700 bg-amber-200 hover:bg-amber-300 text-amber-900 font-mono text-sm rounded-xs cursor-pointer" %>
              <% end %>

            <% else %>

              <p class="text-sm text-amber-800 mb-3">
                ⚠️ No token has been generated yet. Site Sync requires a shared token to authenticate exchanges between environments.
              </p>
              <%= button_to "Generate token",
                            admin_regenerate_site_sync_token_path,
                            method: :post,
                            class: "inline-flex items-center px-4 py-2 border border-amber-700 bg-amber-200 hover:bg-amber-300 text-amber-900 font-mono text-sm rounded-xs cursor-pointer" %>

            <% end %>
          </div>
        <% end %>
      </div>

      <%= form_with url: admin_update_site_sync_config_path, method: :patch, local: true, class: "space-y-4" do |form| %>
        <%# Peer URL — only meaningful on dev. Defaults to Site URL from settings. %>
        <% if Rails.env.development? %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1 mt-4">
              Live Site URL <span class="text-xs font-normal text-gray-500">— your live/production site</span>
            </label>
            <%= form.text_field :peer_url,
                                value: @sync_config.peer_url,
                                placeholder: @site_url,
                                class: "w-full px-3 py-2 border border-gray-300 rounded-xs font-mono text-xs text-gray-800" %>
            <p class="text-xs text-gray-500 mt-1">
              Defaults to your Site URL
              (<code class="text-xs bg-gray-100 px-1"><%= @site_url %></code>) if left blank.
            </p>
          </div>
        <% else %>
          <p class="text-xs text-gray-500">
            This production site receives sync requests at
            <code class="text-xs bg-gray-100 px-1"><%= @site_url %></code>.
            It never initiates connections.
          </p>
        <% end %>

        <div class="pt-2">
          <%= form.submit "Save settings",
                          class: "uppercase inline-flex items-center px-4 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono text-sm rounded-xs cursor-pointer" %>
        </div>
      <% end %>

      <%# Regenerate / Replace is its own form — must be outside the settings form.
          Local: Regenerate (local is source of truth — generate fresh, push via deploy).
          Production: Replace (paste local's token as a fallback if deploy didn't sync). %>
      <% if @sync_config.token.present? %>
        <div class="mt-4 pt-4 border-t border-gray-200">
          <div>
            <% if Rails.env.production? %>

              <button type="button"
                      onclick="showReplaceTokenModal()"
                      class="uppercase inline-flex items-center px-3 py-1.5 border border-amber-600 bg-amber-200 hover:bg-amber-400 text-amber-900 font-mono text-xs rounded-xs cursor-pointer">
                Replace token
              </button>
              <p class="text-xs text-gray-500 mt-1.5">
                Fallback for when a deploy didn't sync the token. Paste the value shown on your local Site Sync page — both sides must match.
              </p>

            <% else %>

              <button type="button"
                      onclick="showRegenerateTokenModal()"
                      class="uppercase inline-flex items-center px-3 py-1.5 border border-amber-600 bg-amber-200 hover:bg-amber-400 text-amber-900 font-mono text-xs rounded-xs cursor-pointer">
                Regenerate token
              </button>
              <p class="text-xs text-gray-500 mt-1.5">Replaces the current token with a fresh random one. The next deploy will push the new value to the live site.</p>

            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  </div><%# /data-tabs-panel="live-sync" %>

  <% if @static_site_sync_config %>
    <div data-tabs-target="panel" data-tabs-panel="static-sync" class="hidden">
      <%# Renders only when SSG is enabled — controller gates
          @static_site_sync_config behind that check. SFTP push of the
          generated /static_site output to a webhost, plus drift
          detection and progress UI that mirror the live-sync tab. %>
      <%= render "static_site_sync_section" %>
    </div>
  <% end %>

  <div data-tabs-target="panel" data-tabs-panel="backups" class="hidden">

  <%# ─── Database backup encryption ──────────────────────────────── %>
  <%# Shows on both sides: the passphrase form on production (where the DB
      is staged + encrypted), an explainer note on local. Sits above the
      local backups list. %>
  <%= render "backup_encryption" %>

  <%# ─── Restore database to live (production only, worst-case) ───── %>
  <%= render "restore_database" %>

  <%# ─── Backups: Local / Live Site sub-tabs ─────────────────────── %>
  <%# Hidden in production — local + live-site backups only exist on the
      dev machine that runs the sync. Split into sub-tabs so the Live Site
      list isn't buried under a long Local list. %>
  <% unless Rails.env.production? %>
    <%# Reuses the shared `tabs` controller (already registered) with its own
        URL key so it persists like the top tabs and doesn't collide with
        them. First tab (Local) carries the active classes so it reads right
        on initial paint; the controller toggles from there. %>
    <div data-controller="tabs" data-tabs-param-value="backups-tab" class="mb-6">
      <div class="border-b border-gray-200 mb-6">
        <nav class="flex gap-4">
          <button type="button" data-tabs-target="tab" data-action="click->tabs#show" data-tabs-panel="local"
                  class="py-2 px-1 text-sm font-medium border-b-2 border-blue-600 text-blue-600 cursor-pointer">Local</button>
          <button type="button" data-tabs-target="tab" data-action="click->tabs#show" data-tabs-panel="live"
                  class="py-2 px-1 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 cursor-pointer">Live Site</button>
        </nav>
      </div>

      <div data-tabs-target="panel" data-tabs-panel="local">
        <div class="bg-white border border-gray-200 rounded-xs p-6 mb-6">
      <div class="flex items-center justify-between mb-4 gap-4">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">Local Backups</h2>
          <p class="text-sm text-gray-600 mb-2">
            Backups are stored in <code class="text-xs bg-gray-100 px-1 rounded"><%= roe_folder_path("backups", "local") %>/</code>
            <ul class="list-disc ml-6">
              <li>Each backup is a complete, browsable copy of the <code class="text-xs bg-gray-100 px-1 rounded">/site</code> folder</li>
              <li>Files unchanged between backups share disk space</li>
              <li>Last <%= SiteSync::BackupManager::BACKUP_RETENTION %> are kept.</li>
            </ul>
          </p>
        </div>
        <%= button_to "Create backup",
                    admin_create_site_backup_path,
                    method: :post,
                    data: { turbo_submits_with: "⏳ Creating new backup. Please hold…" },
                    class: "uppercase inline-flex items-center px-4 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs whitespace-nowrap cursor-pointer disabled:opacity-60 disabled:cursor-wait" %>
      </div>

      <% if @local_backups.empty? %>
        <p class="text-sm text-gray-500 italic">No local backups yet.</p>
      <% else %>
        <ol class="divide-y divide-gray-200 list-decimal">
          <% @local_backups.each do |backup| %>
            <li class="py-3 flex items-center justify-between">
              <div>
                <div class="font-mono text-sm <%= backup[:active] ? 'text-green-900 font-semibold' : 'text-gray-900' %>">
                  <%= backup[:name] %>
                  <% if backup[:active] %>
                    <span class="ml-2 text-xs font-normal text-green-700 bg-green-100 px-2 py-0.5 rounded">matches current /site</span>
                  <% end %>
                </div>
                <div class="text-xs text-gray-500">
                  <%= time_ago_in_words(backup[:created_at]) %> ago
                  <% if backup[:size] %> · <%= number_to_human_size(backup[:size]) %><% end %>
                </div>
              </div>
              <% if backup[:active] %>
                <span class="inline-flex items-center px-3 py-1 border border-gray-300 bg-gray-50 text-gray-400 font-mono text-xs rounded-xs cursor-not-allowed"
                    title="Backup matches current /site — nothing to restore.">
                  Restore
                </span>
              <% else %>
                <%= button_to "Restore",
                            admin_restore_site_backup_path(name: backup[:name]),
                            method: :post,
                            data: {
                              confirm: "Restore /site from #{backup[:name]}? Your current /site contents will be snapshotted first as a safety net.",
                              turbo_submits_with: "⏳ Restoring from backup. Please hold…"
                            },
                            class: "uppercase inline-flex items-center px-3 py-1 border border-gray-600 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait" %>
              <% end %>
            </li>
          <% end %>
        </ol>
      <% end %>
    </div>
      </div><%# /data-tabs-panel="local" %>

      <%# ── Live Site backups (encrypted database DR bundles) ── %>
      <div data-tabs-target="panel" data-tabs-panel="live" class="hidden">
        <div class="bg-white border border-gray-200 rounded-xs p-6 mb-6">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Public/Live Site Backups</h2>
        <p class="text-sm text-gray-600 mb-2">
          Encrypted backups of your live database are stored locally in <code class="text-xs bg-gray-100 px-1 rounded-xs"><%= inline_system_svg("folder.svg", class: "text-sky-600 w-3 h-3 inline-block") %><%= roe_folder_path("backups", "live", "database") %></code>. A fresh one is captured every time you sync your local ↔ live sites. Each is a self-contained disaster-recovery bundle — the database plus the encryption keys needed to read it — locked with your backup passphrase.
        </p>
        <p class="text-xs text-gray-500 mb-4 max-w-3xl">
          To restore one to your live site, <strong>Download .enc</strong>, then visit <a href="<%= @site_url %>/admin/site_sync" class="font-mono text-xs underline">Site Sync</a> on your live site and click <code class="font-mono text-sm bg-red-200 px-1 rounded-xs">RESTORE DATABASE…</code> to upload it. Only do this if absolutely necessary. <strong>Decrypt & download</strong> gives you a plain SQLite copy to inspect locally — it never touches any live database.
        </p>
      </div>

      <% if @live_db_backups.empty? %>
        <p class="text-sm text-gray-500 italic">No live database backups yet. They're captured automatically each time you sync — set a <strong>backup passphrase</strong> on your live site first, then run a sync.</p>
      <% else %>
        <ul class="divide-y divide-gray-200">
          <% @live_db_backups.each do |backup| %>
            <li class="py-3">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <div class="font-mono text-sm text-gray-900 flex gap-1.5 items-center">
                    <span title="Encrypted disaster-recovery bundle">🔒</span> <%= backup[:name] %>
                  </div>
                  <div class="text-xs text-gray-500">
                    <%= time_ago_in_words(backup[:created_at]) %> ago
                    <% if backup[:size] %> · <%= number_to_human_size(backup[:size]) %><% end %>
                  </div>
                </div>
                <%= link_to "Download .enc",
                          admin_download_backup_database_path(name: backup[:name]),
                          class: "uppercase inline-flex items-center px-3 py-1 border border-gray-600 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs cursor-pointer whitespace-nowrap" %>
              </div>

              <%# Local, non-destructive: unpack this bundle's DB and download
                  it as plain SQLite. Never touches the live/dev database. %>
              <details class="mt-2">
                <summary class="cursor-pointer text-xs text-gray-600 hover:text-gray-900">🔓 Decrypt & download database…</summary>
                <%= form_with url: admin_decrypt_backup_database_path, method: :post, local: true, class: "mt-2 flex flex-wrap items-center gap-2" do |f| %>
                  <%= f.hidden_field :name, value: backup[:name] %>
                  <%= f.password_field :passphrase,
                        placeholder: "Backup passphrase",
                        autocomplete: "off",
                        data: { "1p-ignore": true, lpignore: "true", bwignore: true, "form-type": "other" },
                        class: "px-2 py-1 border border-gray-300 rounded-xs font-mono text-xs text-gray-800" %>
                  <%= f.submit "Decrypt & download",
                        class: "uppercase text-xs px-3 py-1 border border-gray-600 bg-gray-100 hover:bg-gray-200 font-mono rounded-xs cursor-pointer" %>
                <% end %>
                <p class="text-xs text-gray-400 mt-1">Downloads a decrypted database file. Inspect and delete as needed.</p>
              </details>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
      </div><%# /data-tabs-panel="live" %>
    </div><%# /backups Local/Live sub-tabs %>
  <% end %>

  </div><%# /data-tabs-panel="backups" %>
  </div><%# /data-controller="tabs" %>
</div>

<%# ─── Replace Token Modal (production only) ──────────────────────── %>
<% if Rails.env.production? && @sync_config.token.present? %>
  <div id="replace-token-modal" class="fixed inset-0 flex items-center justify-center z-50 hidden" style="background-color: rgba(0,17,52,0.35);">
    <div class="bg-white border-2 border-gray-900 p-8 max-w-lg w-full mx-4">
      <h2 class="text-2xl font-bold text-amber-900 mb-3">Replace shared token?</h2>
      <p class="text-gray-700 mb-4">
        Paste the token shown on your local Site Sync page. Both sides must match for Site Sync to authenticate.
      </p>
      <%= form_with url: admin_update_site_sync_config_path, method: :patch, local: true, class: "space-y-4" do |form| %>
        <%= form.text_field :token,
                          placeholder: "Paste local token here",
                          required: true,
                          autocomplete: "off",
                          class: "w-full px-3 py-2 border border-gray-300 rounded-xs font-mono text-xs text-gray-800" %>
        <p class="text-sm text-gray-600">
          <strong>Note:</strong> Use this only as a fallback when a deploy didn't sync the token. Normally, deploying from local pushes the current token here automatically.
        </p>
        <div class="flex gap-3">
          <%= form.submit "Save token",
                        class: "uppercase text-sm px-4 py-2.5 border border-amber-800 bg-amber-600 hover:bg-amber-700 text-white font-mono rounded-xs cursor-pointer" %>
          <button type="button"
                onclick="hideReplaceTokenModal()"
                class="uppercase text-sm px-4 py-2.5 border border-gray-400 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono rounded-xs cursor-pointer">
            Cancel
          </button>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# ─── Regenerate Token Modal ──────────────────────────────────────── %>
<% unless Rails.env.production? %>
  <div id="regenerate-token-modal" class="fixed inset-0 flex items-center justify-center z-50 hidden" style="background-color: rgba(0,17,52,0.35);">
    <div class="bg-white border-2 border-gray-900 p-8 max-w-lg w-full mx-4">
      <h2 class="text-2xl font-bold text-amber-900 mb-3">⚠️ Regenerate Token?</h2>
      <p class="text-gray-700 mb-4">
        This will <strong>delete the current token</strong> and generate a new one.
      </p>
      <div class="bg-red-50 border border-red-200 p-4 mb-6">
        <p class="text-sm text-amber-800 font-semibold mb-2">You should:</p>
        <ol class="text-sm text-red-amber list-decimal list-inside space-y-1">
          <li>Copy the new token</li>
          <li>Paste it into your live site in: Admin → Site Sync</li>
        </ol>
      </div>
      <p class="text-sm text-gray-600 mb-6">
        <strong>Warning:</strong> Site Sync will stop working until the local token matches the live/public token.
      </p>
      <div class="flex gap-3">
        <%= button_to "Yes, Regenerate Token",
                    admin_regenerate_site_sync_token_path,
                    method: :post,
                    id: "modal-regenerate-confirm",
                    class: "uppercase text-sm px-4 py-2.5 border border-amber-800 bg-amber-600 hover:bg-amber-700 text-white font-mono rounded-xs" %>
        <button type="button"
              onclick="hideRegenerateTokenModal()"
              class="uppercase text-sm px-4 py-2.5 border border-gray-400 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono rounded-xs">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <script>
    function showRegenerateTokenModal() {
    const modal = document.getElementById('regenerate-token-modal');
    modal.classList.remove('hidden');
    }

    function hideRegenerateTokenModal() {
    const modal = document.getElementById('regenerate-token-modal');
    modal.classList.add('hidden');
    }

    // Close modal when clicking outside
    document.getElementById('regenerate-token-modal').addEventListener('click', function(e) {
    if (e.target === this) {
    hideRegenerateTokenModal();
    }
    });

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
    hideRegenerateTokenModal();
    }
    });
  </script>
<% end %>

<% if Rails.env.production? && @sync_config.token.present? %>
  <script>
    function showReplaceTokenModal() {
    const modal = document.getElementById('replace-token-modal');
    modal.classList.remove('hidden');
    const input = modal.querySelector('input[type="text"]');
    if (input) input.focus();
    }

    function hideReplaceTokenModal() {
    const modal = document.getElementById('replace-token-modal');
    modal.classList.add('hidden');
    }

    // Close modal when clicking outside
    document.getElementById('replace-token-modal').addEventListener('click', function(e) {
    if (e.target === this) {
    hideReplaceTokenModal();
    }
    });

    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
    hideReplaceTokenModal();
    }
    });
  </script>
<% end %>

<%# ─── Restore staged — restart instructions modal (production only) ─── %>
<%# Pops automatically after a restore is staged. No action buttons — just the
    command to run locally. Close by clicking outside, the ×, or Esc. %>
<% if Rails.env.production? %>
  <div id="restore-staged-modal" class="fixed inset-0 flex items-center justify-center z-50 hidden" style="background-color: rgba(0,17,52,0.35);">
    <div class="relative bg-white border-2 border-gray-900 p-8 max-w-lg w-full mx-4">
      <button type="button" onclick="hideRestoreStagedModal()" aria-label="Close"
              class="absolute top-2 right-3 text-gray-400 hover:text-gray-700 text-3xl leading-none cursor-pointer">&times;</button>
      <h2 class="text-2xl font-bold text-gray-900 mb-3">Restore staged — restart to apply</h2>
      <p class="text-gray-700 mb-4">
        Your database restore is saved and loads on the <strong>next restart</strong>. It won't take effect until then.
      </p>
      <div class="mb-4"><%= render "restart_instructions" %></div>
    </div>
  </div>

  <script>
    function showRestoreStagedModal() {
    document.getElementById('restore-staged-modal').classList.remove('hidden');
    }
    function hideRestoreStagedModal() {
    document.getElementById('restore-staged-modal').classList.add('hidden');
    }
    document.getElementById('restore-staged-modal').addEventListener('click', function(e) {
    if (e.target === this) { hideRestoreStagedModal(); }
    });
    document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') { hideRestoreStagedModal(); }
    });
    // Auto-open right after a restore is staged, then strip the flag from the
    // URL so a refresh doesn't reopen it.
    (function () {
    const params = new URLSearchParams(window.location.search);
    if (params.get('restore_staged') === '1') {
    showRestoreStagedModal();
    params.delete('restore_staged');
    const q = params.toString();
    history.replaceState({}, '', window.location.pathname + (q ? '?' + q : ''));
    }
    })();
  </script>
<% end %>
