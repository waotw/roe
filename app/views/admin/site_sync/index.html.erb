<% content_for :editor_js, false %>
<div class="px-4 sm:px-0">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Site Sync</h1>
    <p class="mt-2 text-sm text-gray-700">
      Track changes to your <code class="text-xs bg-gray-100 px-1 rounded">/site</code> folder and manage backups.
    </p>
  </div>

  <%# ─── Post-restore confirmation panel ─────────────────────────── %>
  <%# Sticks around for an hour after a restore so the user has clear
      evidence the operation worked. Older restores fall out (no
      reason to surface them — they're history, not current state). %>
  <% if @last_restore && @last_restore[:restored_at] && @last_restore[:restored_at] > 1.hour.ago %>
    <div class="bg-green-50 border border-green-200 rounded-sm p-6 mb-6">
      <h3 class="text-sm font-semibold text-green-900 mb-2">
        Restore Completed
      </h3>
      <p class="text-sm text-green-800">
        Restored <code class="text-xs bg-white px-1 rounded font-mono"><%= @last_restore[:name] %></code>
        <%= time_ago_in_words(@last_restore[:restored_at]) %> ago.
        <strong><%= @last_restore[:file_count] %></strong> files written to <code class="text-xs bg-white px-1 rounded">/site</code>.
      </p>
      <p class="text-xs text-green-700 mt-2">
        If this was unintentional, you can restore to the most recent backup in the list below. This will bring your site back to exactly as it was before it was restored.
      </p>
    </div>
  <% end %>

  <%# ─── Transfer status ──────────────────────────────────────────── %>
  <%# Surfaces in-flight or recently-finished push/pull jobs at the
      top of the page so the user gets immediate feedback after
      kicking one off. Cache-backed (see SiteSyncTransferJob); cleared
      via the Dismiss button or auto-expires after the cache TTL. %>
  <% if @transfer_status %>
    <% kind_label = @transfer_status[:kind] == :push ? "Push to live" : "Pull from live" %>
    <% case @transfer_status[:state] %>
    <% when :running %>
      <div class="bg-blue-50 border border-blue-200 rounded-sm p-6 mb-6">
        <div class="flex items-start justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold text-blue-900 mb-2">⏳ <%= kind_label %> in progress</h3>
            <p class="text-sm text-blue-800">
              Started <%= time_ago_in_words(@transfer_status[:started_at]) %> ago.
              Refresh this page to check for completion (usually 1–3 minutes for a 2GB site).
            </p>
          </div>
          <%# Force-clear the status — useful if the worker died or
              rsync hung. Only clears the UI flag; doesn't actually
              kill any subprocess that might still be running. %>
          <%= button_to "Force clear",
                        admin_dismiss_site_transfer_status_path,
                        method: :post,
                        data: { confirm: "Clear the running-status flag? Only do this if you've confirmed the job isn't actually running (check Rails logs for SiteSync::FlyRsync activity). This won't kill any subprocess that might still be working." },
                        class: "inline-flex items-center px-3 py-1 border border-blue-700 bg-blue-100 hover:bg-blue-200 text-blue-800 font-mono text-xs rounded-xs cursor-pointer whitespace-nowrap" %>
        </div>
      </div>
    <% when :completed %>
      <% if @transfer_status[:completed_at] && @transfer_status[:completed_at] > 5.minutes.ago %>
        <div class="bg-green-50 border border-green-200 rounded-sm p-6 mb-6 flex items-start justify-between gap-4">
          <div>
            <h3 class="text-sm font-semibold text-green-900 mb-1">✓ <%= kind_label %> completed</h3>
            <p class="text-sm text-green-800">
              Finished <%= time_ago_in_words(@transfer_status[:completed_at]) %> ago.
            </p>
          </div>
          <%= button_to "Dismiss",
                        admin_dismiss_site_transfer_status_path,
                        method: :post,
                        class: "inline-flex items-center px-3 py-1 border border-green-700 bg-green-100 hover:bg-green-200 text-green-800 font-mono text-xs rounded-xs cursor-pointer" %>
        </div>
      <% end %>
    <% when :failed %>
      <div class="bg-red-50 border border-red-200 rounded-sm p-6 mb-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <div>
            <h3 class="text-sm font-semibold text-red-900 mb-1">❌ <%= kind_label %> failed</h3>
            <p class="text-sm text-red-700">
              Failed <%= time_ago_in_words(@transfer_status[:completed_at] || @transfer_status[:started_at]) %> ago.
              Live and local should be unchanged from the pre-transfer state — the destination's safety backup is in the backup list below.
            </p>
          </div>
          <%= button_to "Dismiss",
                        admin_dismiss_site_transfer_status_path,
                        method: :post,
                        class: "inline-flex items-center px-3 py-1 border border-red-700 bg-red-100 hover:bg-red-200 text-red-800 font-mono text-xs rounded-xs cursor-pointer whitespace-nowrap" %>
        </div>
        <% if @transfer_status[:error].present? %>
          <pre class="p-3 bg-white border border-red-200 rounded-sm font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap"><%= @transfer_status[:error] %></pre>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <%# ─── Cross-environment sync status ───────────────────────────── %>
  <%# Debug-friendly view of what we know about the peer environment.
      Phase 4 will hide most of this once cross-env exchange is
      considered the source of truth; for now it's surfaced explicitly
      so you can verify the wiring is working. %>
  <div class="bg-white border border-gray-200 rounded-sm p-6 mb-6">
    <div class="flex items-center justify-between mb-3 gap-4">
      <h2 class="text-lg font-semibold text-gray-900">Public/Local Site Sync</h2>
      <%# Synchronous exchange ping — handy for testing without
          waiting on the hourly job or the 60s on-render debounce.
          Only meaningful on the side that initiates (dev). %>
      <% if @peer_call_configured %>
        <%= button_to "Refresh now",
                      admin_refresh_site_sync_exchange_path,
                      method: :post,
                      data: { turbo_submits_with: "⏳ Refreshing…" },
                      class: "inline-flex items-center px-3 py-1.5 border border-gray-600 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait whitespace-nowrap" %>
      <% end %>
    </div>

    <% if @peer_state %>
      <p class="text-sm text-gray-700 mb-2">
        Last contact with
        <strong><%= SiteSync::Exchange.peer_label || @peer_state[:env] %></strong>:
        <%= time_ago_in_words(@peer_state[:received_at]) %> ago.
      </p>
      <% if @peer_drift %>
        <div class="p-3 bg-amber-50 border border-amber-200 rounded-sm mb-2">
          <p class="text-sm text-amber-800 mb-3">
            ⚠️ <%= SiteSync::Exchange.peer_label %> reports unsynced changes — you should pull them in before editing here.
          </p>
          <% if @peer_call_configured %>
            <%= button_to "Pull from live",
                          admin_pull_site_from_live_path,
                          method: :post,
                          data: {
                            confirm: "Pull live's content over your local /site? Your current local /site will be backed up first to site_backups/local/.",
                            turbo_submits_with: "⏳ Starting pull…"
                          },
                          class: "inline-flex items-center px-4 py-2 border border-gray-800 bg-amber-200 hover:bg-amber-300 font-mono text-sm rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait" %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-green-800">
          ✓ <%= SiteSync::Exchange.peer_label %> reports no unsynced changes.
        </p>
      <% end %>
      <details class="mt-3">
        <summary class="text-xs text-gray-500 cursor-pointer hover:text-gray-700">
          Show debug info
        </summary>
        <ul class="mt-2 text-xs font-mono text-gray-600 space-y-1">
          <li>Peer env:                   <code><%= @peer_state[:env] %></code></li>
          <li>Peer fingerprint:           <code><%= @peer_state[:fingerprint] %></code></li>
          <li>Peer recorded fingerprint:  <code><%= @peer_state[:recorded_fingerprint] || '(none)' %></code></li>
          <li>Peer reported version:      <code><%= @peer_state[:version] %></code></li>
          <li>Received at:                <code><%= @peer_state[:received_at] %></code></li>
        </ul>
      </details>

    <% elsif @peer_call_configured %>
      <p class="text-sm text-gray-600">
        Configured to call <code class="text-xs bg-gray-100 px-1 rounded"><%= @peer_url %></code>,
        but no exchange has happened yet. The hourly background job will run shortly,
        or visit this page again in a minute to trigger a refresh.
      </p>

    <% elsif Rails.env.production? %>
      <p class="text-sm text-gray-600">
        This side receives exchanges (no outbound calls — production never initiates).
        No peer has called in yet.
      </p>

    <% end %>

    <%# ─── Settings form ─────────────────────────────────────────── %>
    <div class="mt-6 pt-6 border-t border-gray-200">
      <h3 class="text-sm font-semibold text-gray-900 mb-3">Settings</h3>

      <%= form_with url: admin_update_site_sync_config_path, method: :patch, local: true, class: "space-y-4" do |form| %>
        <%# Token — must match between dev and prod. Auto-generated
            on first access (so the field is never empty), but the
            user can paste a different value to match the other side. %>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">
            Shared token
          </label>
          <%= form.text_field :token,
                              value: @sync_config.token,
                              onclick: "this.select();",
                              class: "w-full px-3 py-2 border border-gray-300 rounded-sm font-mono text-xs text-gray-800" %>
          <p class="text-xs text-gray-500 mt-1">
            Click to select. The same value must be set on both sides — copy from
            here to the other environment's Site Sync settings, or use Regenerate
            (below) to make a new one.
          </p>
        </div>

        <%# Peer URL — only meaningful on dev. Hidden on prod with
            a brief note (rather than disabled-but-shown, which
            invites the question "why is this disabled?"). %>
        <% if Rails.env.development? %>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">
              Peer URL <span class="text-xs font-normal text-gray-500">— your live site, e.g. https://yourblog.com</span>
            </label>
            <%= form.text_field :peer_url,
                                value: @sync_config.peer_url,
                                placeholder: "https://yourblog.com",
                                class: "w-full px-3 py-2 border border-gray-300 rounded-sm font-mono text-xs text-gray-800" %>
            <p class="text-xs text-gray-500 mt-1">
              Where this side sends its state. Only used on dev — production receives, never initiates.
            </p>
          </div>
        <% else %>
          <p class="text-xs text-gray-500">
            Peer URL isn't set on production — this side only receives exchanges, never initiates them.
          </p>
        <% end %>

        <div class="pt-2">
          <%= form.submit "Save settings",
                          class: "inline-flex items-center px-4 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono text-sm rounded-xs cursor-pointer" %>
        </div>
      <% end %>

      <%# Regenerate is its own form — keeping it nested inside the
          settings form_with would produce nested <form> tags, which
          browsers silently break (and which previously caused Save
          to do nothing). %>
      <div class="mt-3 flex items-center gap-3">
        <%= button_to "Regenerate token",
                      admin_regenerate_site_sync_token_path,
                      method: :post,
                      data: { confirm: "Generate a new random token? You'll need to copy it to the other side, or exchanges will start failing." },
                      class: "inline-flex items-center px-3 py-1.5 border border-gray-600 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs cursor-pointer" %>
        <span class="text-xs text-gray-500">Replaces the current token with a fresh random one.</span>
      </div>

      <p class="text-xs text-gray-500 mt-4">
        💡 Once Kamal/Fly deploy automation is wired up, the token will sync to
        production on deploy and you won't need to copy it manually.
      </p>
    </div>
  </div>

  <%# ─── Drift state ──────────────────────────────────────────────── %>
  <% case @status[:state] %>
  <% when :clean %>
    <div class="bg-green-50 border border-green-200 rounded-sm p-6 mb-6">
      <h2 class="text-lg font-semibold text-green-900">No Unsynced Changes</h2>
      <p class="text-green-800 mt-2">
        Your <code class="text-xs bg-white px-1 rounded">/site</code> hasn't changed since the last sync.
      </p>
      <%# When cross-env verification lands this can confidently say
          "your local /site matches the public /site as of <time>" —
          today we can only confirm there have been no local edits
          since the last backup/restore/mark-as-synced operation. %>
      <% if @status[:recorded_at] %>
        <p class="text-xs text-green-700 mt-2 font-mono">
          Last sync: <%= @status[:recorded_at] %>
        </p>
      <% end %>
    </div>

  <% when :error %>
    <div class="bg-red-50 border border-red-200 rounded-sm p-6 mb-6">
      <h2 class="text-lg font-semibold text-red-900 mb-2">Sync Status Checked Failed</h2>
      <pre class="p-3 bg-white border border-red-200 rounded-sm font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap"><%= @status[:error] %></pre>
    </div>

  <% else %>
    <%# :local_drift %>
    <div class="bg-amber-50 border border-amber-200 rounded-sm p-6 mb-6">
      <% counts = @status[:local] %>
      <h2 class="text-lg font-semibold text-amber-900 mb-2">Unsynced Changes</h2>
      <p class="text-amber-800 mb-3">
        You've made these changes since your last sync:
      </p>
      <ul class="list-disc ml-6 mb-4 text-sm text-amber-800 space-y-1">
        <% if counts[:modified].any? %>
          <li><strong><%= counts[:modified].size %></strong> file<%= 's' if counts[:modified].size != 1 %> modified</li>
        <% end %>
        <% if counts[:added].any? %>
          <li><strong><%= counts[:added].size %></strong> file<%= 's' if counts[:added].size != 1 %> added</li>
        <% end %>
        <% if counts[:deleted].any? %>
          <li><strong><%= counts[:deleted].size %></strong> file<%= 's' if counts[:deleted].size != 1 %> deleted</li>
        <% end %>
      </ul>
      <% if @status[:recorded_at] %>
        <p class="text-xs text-amber-700 mb-4 font-mono">
          Last sync: <%= @status[:recorded_at] %>
        </p>
      <% end %>

      <%# Per-file paths, collapsed by default. Useful when the
          counts above leave the user wondering "which files?" %>
      <% [ [ "Modified", counts[:modified] ], [ "Added", counts[:added] ], [ "Deleted", counts[:deleted] ] ].each do |label, list| %>
        <% next if list.empty? %>
        <details class="mb-3">
          <summary class="text-sm font-semibold text-amber-900 cursor-pointer hover:text-amber-700">
            Show <%= label.downcase %> files
          </summary>
          <ul class="mt-2 ml-4 text-xs font-mono text-amber-800 space-y-1 max-h-64 overflow-y-auto">
            <% list.each do |path| %>
              <li><%= path %></li>
            <% end %>
          </ul>
        </details>
      <% end %>

      <% if SiteSync::Exchange.can_call_peer? %>
        <div class="mt-6 pt-4 border-t border-amber-200">
          <details>
            <summary class="text-sm font-semibold text-amber-900 cursor-pointer hover:text-amber-700">
              Push these changes to live →
            </summary>
            <div class="mt-3 space-y-3">
              <p class="text-sm text-amber-800">
                This overwrites Live with your Local content. Files on Live not present
                locally <strong>will be deleted</strong>. Live site is backed up first to
                <code class="text-xs bg-white px-1 rounded">site_backups/production/</code>
                so the push is reversible.
              </p>
              <%= form_with url: admin_push_site_to_live_path, method: :post, local: true do |form| %>
                <div class="flex gap-2">
                  <%= form.text_field :confirm,
                                      placeholder: "Type LIVE to confirm",
                                      autocomplete: "off",
                                      class: "flex-1 px-3 py-2 border border-amber-400 rounded-sm font-mono text-xs" %>
                  <%= form.submit "Push to live now",
                                  data: { turbo_submits_with: "⏳ Starting push…" },
                                  class: "inline-flex items-center px-4 py-2 border border-gray-800 bg-amber-300 hover:bg-amber-400 font-mono text-sm rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait whitespace-nowrap" %>
                </div>
              <% end %>
            </div>
          </details>
        </div>
      <% end %>

      <%# Manual fallback for "I already synced from terminal" — kept
          alongside the real Push button so user has an escape hatch
          if rsync from CLI is preferred. Will go away in Phase 4
          when local-drift display becomes the offline-only fallback. %>
      <div class="mt-4 text-xs text-amber-700">
        Already synced manually?
        <%= button_to "Mark current state as synced",
                      admin_mark_site_synced_path,
                      method: :post,
                      form: { style: "display: inline;" },
                      data: { confirm: "Mark the current /site state as the new sync baseline? Only do this if you've already synced this state to the other environment." },
                      class: "inline underline bg-transparent border-0 p-0 text-xs text-amber-700 hover:text-amber-900 cursor-pointer" %>
      </div>
    </div>
  <% end %>

  <%# ─── Local backups ───────────────────────────────────────────── %>
  <div class="bg-white border border-gray-200 rounded-sm p-6 mb-6">
    <div class="flex items-center justify-between mb-4 gap-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Local Backups</h2>
        <p class="text-sm text-gray-600 mb-2">
          Backups are stored in <code class="text-xs bg-gray-100 px-1 rounded">site_backups/local/</code>
          <ul class="list-disc ml-6">
            <li>Each backup is a complete, browsable copy of the <code class="text-xs bg-gray-100 px-1 rounded">/site</code> folder</li>
            <li>Files unchanged between backups share disk space</li>
            <li>Last <%= SiteSync::BackupManager::BACKUP_RETENTION %> are kept.</li>
          </ul>
        </p>
      </div>
      <%= button_to "Create backup",
                    admin_create_site_backup_path,
                    method: :post,
                    data: { turbo_submits_with: "⏳ Creating new backup. Please hold…" },
                    class: "inline-flex items-center px-4 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs whitespace-nowrap cursor-pointer disabled:opacity-60 disabled:cursor-wait" %>
    </div>

    <% if @local_backups.empty? %>
      <p class="text-sm text-gray-500 italic">No local backups yet.</p>
    <% else %>
      <ol class="divide-y divide-gray-200 list-decimal">
        <% @local_backups.each do |backup| %>
          <li class="py-3 flex items-center justify-between">
            <div>
              <div class="font-mono text-sm <%= backup[:active] ? 'text-green-900 font-semibold' : 'text-gray-900' %>">
                <%= backup[:name] %>
                <% if backup[:active] %>
                  <span class="ml-2 text-xs font-normal text-green-700 bg-green-100 px-2 py-0.5 rounded">matches current /site</span>
                <% end %>
              </div>
              <div class="text-xs text-gray-500">
                <%= time_ago_in_words(backup[:created_at]) %> ago
                <% if backup[:size] %> · <%= number_to_human_size(backup[:size]) %><% end %>
              </div>
            </div>
            <% if backup[:active] %>
              <span class="inline-flex items-center px-3 py-1 border border-gray-300 bg-gray-50 text-gray-400 font-mono text-xs rounded-xs cursor-not-allowed"
                    title="Backup matches current /site — nothing to restore.">
                Restore
              </span>
            <% else %>
              <%= button_to "Restore",
                            admin_restore_site_backup_path(name: backup[:name]),
                            method: :post,
                            data: {
                              confirm: "Restore /site from #{backup[:name]}? Your current /site contents will be snapshotted first as a safety net.",
                              turbo_submits_with: "⏳ Restoring from backup. Please hold…"
                            },
                            class: "inline-flex items-center px-3 py-1 border border-gray-600 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs cursor-pointer disabled:opacity-60 disabled:cursor-wait" %>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>

  <%# ─── Production backups ──────────────────────────────────────── %>
  <div class="bg-white border border-gray-200 rounded-sm p-6 mb-6">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Public/Live Site Backups</h2>
      <p class="text-sm text-gray-600 mb-2">
        Backups are stored in <code class="text-xs bg-gray-100 px-1 rounded">site_backups/production/</code>, these are created when you sync your local site with the hosted site.
      </p>
      <p class="text-xs text-gray-500 mb-4">
        To restore a production backup, run <code class="text-xs bg-gray-100 px-1 rounded">rake site:rollback[&lt;name&gt;]</code> from your terminal.
        An admin-UI restore button for production is coming with the cross-env sync work.
      </p>
    </div>

    <% if @production_backups.empty? %>
      <p class="text-sm text-gray-500 italic">No production backups yet. Run <code class="text-xs bg-gray-100 px-1 rounded">rake site:backup</code> to create one.</p>
    <% else %>
      <ul class="divide-y divide-gray-200">
        <% @production_backups.each do |backup| %>
          <li class="py-3 flex items-center justify-between">
            <div>
              <div class="font-mono text-sm text-gray-900"><%= backup[:name] %></div>
              <div class="text-xs text-gray-500">
                <%= time_ago_in_words(backup[:created_at]) %> ago
                <% if backup[:size] %> · <%= number_to_human_size(backup[:size]) %><% end %>
              </div>
            </div>
            <code class="text-xs text-gray-500 font-mono">
              rake site:rollback[<%= backup[:name] %>]
            </code>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <%# ─── About ────────────────────────────────────────────────────── %>
  <div class="mt-8 pt-6 border-t border-gray-200">
    <h3 class="text-sm font-semibold text-gray-900 mb-2">About Site Sync</h3>
    <ul class="text-sm text-gray-600 space-y-1 list-disc list-inside">
      <li>Tracks every file under <code class="text-xs">/site</code> via size + mtime (matches what rsync uses)</li>
      <li>Excludes <code class="text-xs">db/</code> (separate backup system), <code class="text-xs">.git/</code>, and macOS noise</li>
      <li>Local backups are rsync mirrors with <code class="text-xs">--link-dest</code> hardlinks — multiple snapshots dedupe unchanged files</li>
      <li>Each restore auto-creates a fresh backup of the pre-restore state — to undo, restore that one</li>
    </ul>
  </div>
</div>
