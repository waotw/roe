<%# Worst-case DB restore, PRODUCTION only. Upload an encrypted backup +
    passphrase over HTTPS; production decrypts on its own disk and stages
    the DB to swap in on next boot. No SSH, no sync token — just the
    authenticated admin upload. Destructive: it replaces the live DB. %>
<% if Rails.env.production? %>
  <div class="bg-white border border-red-200 rounded-xs p-6 mb-6">
    <h2 class="text-lg font-semibold text-red-900 mb-1">Restore database to this live site</h2>
    <p class="text-sm text-gray-600 mb-3">
      Worst-case recovery only. Upload an encrypted database backup and its passphrase; the live
      database is replaced on the next restart.
    </p>

    <% if SiteSync::PendingRestore.pending? %>
      <div class="bg-amber-50 border border-amber-300 rounded-xs p-3 mb-3 text-sm text-amber-900">
        ⏳ A database restore is <strong>staged</strong>. Redeploy or restart this app to apply it.
      </div>
    <% end %>

    <details>
      <summary class="cursor-pointer inline-flex items-center px-4 py-2 border border-red-600 bg-red-100 hover:bg-red-200 text-red-800 font-mono text-sm uppercase rounded-xs">
        Restore database…
      </summary>

      <div class="mt-4 border border-red-300 rounded-xs p-4 bg-red-50">
        <div class="bg-red-100 border border-red-300 rounded-xs p-3 mb-4 text-sm text-red-900">
          <strong>⚠️ This is destructive and irreversible.</strong>
          It <strong>overwrites the live database</strong>, discarding <em>everything</em> that has
          changed since this backup — new members, orders, and newsletter history. Only use this on a
          <strong>fresh deploy</strong> or a site you <strong>can't otherwise recover</strong>.
          The current database is kept as a <span class="font-mono text-xs">.pre-restore</span> copy.
          <br>
          <span class="text-xs">Note: restoring also reverts DB-resident config (the sync token, backup passphrase) to this backup's values — you may need to re-paste the token afterward.</span>
        </div>

        <%= form_with url: admin_restore_database_path, method: :post, local: true, html: { multipart: true }, class: "space-y-3" do |f| %>
          <div>
            <label class="block text-xs font-mono text-gray-700 mb-1">Encrypted backup file (<span class="font-mono">.enc</span>)</label>
            <%= f.file_field :database, required: true, class: "block w-full text-sm text-gray-700" %>
          </div>
          <div>
            <label class="block text-xs font-mono text-gray-700 mb-1">Backup passphrase</label>
            <%= f.password_field :passphrase, required: true, autocomplete: "off",
                  placeholder: "The passphrase this backup was encrypted with",
                  class: "w-full px-3 py-2 border border-gray-300 rounded-xs font-mono text-xs text-gray-800" %>
          </div>
          <label class="flex items-start gap-2 text-sm text-red-900">
            <%= f.check_box :confirm_understood, class: "mt-1" %>
            <span>I understand this permanently overwrites the live database, discarding all changes since this backup.</span>
          </label>
          <%= f.submit "Stage restore (applies on next restart)",
                data: { turbo_confirm: "Last check: this OVERWRITES your live database on the next restart. Continue?" },
                class: "uppercase text-sm px-4 py-2 border border-red-700 bg-red-200 hover:bg-red-300 text-red-900 font-mono rounded-xs cursor-pointer" %>
        <% end %>
      </div>
    </details>
  </div>
<% end %>
