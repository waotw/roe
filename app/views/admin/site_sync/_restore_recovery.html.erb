<%# Post-restore recovery banner (production only). After a DB-only restore,
    if the restored database's encrypted settings can't be read with this
    site's current credentials, offer the backup's parked credentials — applied
    on a restart, validated, and auto-reverted if they don't work. %>
<% if Rails.env.production? %>
  <% if SiteSync::RestoreCheck.apply_failed? %>
    <div class="bg-red-50 border border-red-300 rounded-xs p-4 mb-6">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-red-900 mb-1">Couldn't recover encryption from the backup</h2>
          <p class="text-sm text-red-900 max-w-3xl">
            The backup's credentials were installed but didn't unlock this database's encrypted settings, so they were
            <strong>automatically reverted</strong> — your site is running on its previous credentials and is otherwise fine.
            On hosts where the encryption key is managed by your deploy (e.g. <code class="text-xs bg-red-100 px-1 rounded-xs">RAILS_MASTER_KEY</code>
            as a Kamal secret), the real key lives with your deploy secrets, not in the backup — recover it there.
          </p>
        </div>
        <%= button_to "Dismiss", admin_dismiss_restore_recovery_path, method: :post,
              class: "shrink-0 uppercase text-xs px-3 py-1 border border-red-600 bg-red-100 hover:bg-red-200 text-red-900 font-mono rounded-xs cursor-pointer" %>
      </div>
    </div>
  <% elsif SiteSync::RestoreCheck.credentials_mismatch? %>
    <div class="bg-amber-50 border border-amber-300 rounded-xs p-4 mb-6">
      <h2 class="text-lg font-semibold text-amber-900 mb-1">Restored database needs its encryption keys</h2>

      <% if running_on_fly? %>
        <%# Fly: keys are Fly secrets, not files — re-push them from local. The
            keys come from the local install's credentials, nothing by hand. %>
        <p class="text-sm text-amber-900 mb-3 max-w-3xl">
          Your restored database's encrypted settings can't be read with this app's current keys. On Fly the
          encryption keys live in your <strong>Fly secrets</strong> (not in the backup), so re-push them from your
          local machine — the keys come straight from your local install, nothing to copy by hand.
        </p>
        <div class="mb-3"><%= render "restart_instructions", command: fly_sync_secrets_command(@sync_config, ENV["FLY_APP_NAME"]) %></div>
        <%= button_to "Dismiss", admin_dismiss_restore_recovery_path, method: :post,
              class: "uppercase text-xs px-3 py-1 border border-amber-600 bg-amber-100 hover:bg-amber-200 text-amber-900 font-mono rounded-xs cursor-pointer" %>

      <% elsif SiteSync::PendingRestore.backup_credentials_available? %>
        <p class="text-sm text-amber-900 mb-3 max-w-3xl">
          Your restored database's encrypted settings can't be read with this site's current credentials.
          Your backup has the matching pair — apply them? They're installed on the next restart, verified, and
          <strong>automatically reverted</strong> if they don't work, so this is safe.
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-3">
          <%= button_to "Apply backup credentials", admin_apply_backup_credentials_path, method: :post,
                data: { turbo_confirm: "Install the backup's encryption credentials on the next restart? They're verified and auto-reverted if they don't fit." },
                class: "uppercase text-sm px-4 py-2 border border-amber-700 bg-amber-200 hover:bg-amber-300 text-amber-900 font-mono rounded-xs cursor-pointer" %>
          <%= button_to "Dismiss", admin_dismiss_restore_recovery_path, method: :post,
                class: "uppercase text-xs px-3 py-1 border border-amber-600 bg-amber-100 hover:bg-amber-200 text-amber-900 font-mono rounded-xs cursor-pointer" %>
        </div>
        <div class="text-amber-900">
          <p class="text-xs mb-2">After clicking apply, restart the live app from your local machine:</p>
          <%= render "restart_instructions" %>
        </div>

      <% else %>
        <p class="text-sm text-amber-900 mb-3 max-w-3xl">
          Your restored database's encrypted settings can't be read with this site's current credentials, and the
          matching credentials aren't available on this server. Recover them from your backup or deploy secrets.
        </p>
        <%= button_to "Dismiss", admin_dismiss_restore_recovery_path, method: :post,
              class: "uppercase text-xs px-3 py-1 border border-amber-600 bg-amber-100 hover:bg-amber-200 text-amber-900 font-mono rounded-xs cursor-pointer" %>
      <% end %>
    </div>
  <% end %>
<% end %>
