<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">Mailjet Configuration</h1>
      <p class="mt-2 text-sm text-gray-700">Configure your Mailjet API credentials for newsletter delivery.</p>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mt-4 px-4 py-2 bg-green-50 border border-green-200 text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:error] %>
    <div class="mt-4 px-4 py-2 bg-red-50 border border-red-200 text-red-800 text-sm">
      <%= flash[:error] %>
    </div>
  <% end %>

  <div class="mt-8 bg-white border border-gray-300 p-6">
    <%= form_with model: @mailjet_config, url: admin_mailjet_config_path, method: :patch do |f| %>
      <div class="space-y-6">
        <div>
          <label class="block text-sm font-semibold text-gray-900 mb-2">
            Mailjet API Key
          </label>
          <%= f.text_field :api_key,
              value: @mailjet_config.connected? ? '••••••••••••••••' : '',
              placeholder: 'Your Mailjet API Key',
              class: "w-full px-3 py-2 border border-gray-300 font-mono text-sm" %>
          <p class="mt-1 text-xs text-gray-500">
            Find this in your Mailjet account under Account Settings → REST API
          </p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-900 mb-2">
            Mailjet Secret Key
          </label>
          <%= f.password_field :secret_key,
              value: @mailjet_config.connected? ? '••••••••••••••••' : '',
              placeholder: 'Your Mailjet Secret Key',
              class: "w-full px-3 py-2 border border-gray-300 font-mono text-sm" %>
          <p class="mt-1 text-xs text-gray-500">
            Your API Secret Key (keep this secure)
          </p>
        </div>

        <div class="flex gap-4">
          <%= f.submit "Save Configuration",
              class: "uppercase text-sm px-2 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>

          <% if @mailjet_config.connected? %>
            <%= button_to "Disconnect",
                admin_mailjet_config_path,
                method: :delete,
                data: { confirm: "Are you sure? This will disconnect Mailjet integration." },
                class: "uppercase text-sm px-2 py-2 border border-gray-800 bg-red-200 hover:bg-red-300 font-mono rounded-xs" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @mailjet_config.connected? %>
      <div class="mt-6 pt-6 border-t border-gray-300">
        <p class="text-sm text-green-800 bg-green-50 px-4 py-2 border border-green-200">
          ✓ Mailjet is configured and ready to send
        </p>
      </div>
    <% end %>
  </div>

  <% if @mailjet_config.connected? %>
    <div class="mt-8 bg-white border border-gray-300 p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Sync Status</h3>

      <% stats = @mailjet_config.stats %>

      <% if stats[:error] %>
        <p class="text-sm text-red-800 bg-red-50 px-4 py-2 border border-red-200">
          Error fetching stats: <%= stats[:error] %>
        </p>
      <% else %>
        <div class="grid grid-cols-3 gap-4 text-center mb-4">
          <div class="p-4 bg-blue-50 border border-blue-200">
            <div class="text-3xl font-bold text-blue-900"><%= stats[:total_members] %></div>
            <div class="text-sm text-gray-600 mt-1">Total Members (DB)</div>
          </div>

          <div class="p-4 bg-green-50 border border-green-200">
            <div class="text-3xl font-bold text-green-900"><%= stats[:synced_members] %></div>
            <div class="text-sm text-gray-600 mt-1">Synced to Mailjet</div>
          </div>

          <div class="p-4 bg-indigo-50 border border-indigo-200">
            <div class="text-3xl font-bold text-indigo-900"><%= stats[:mailjet_total] %></div>
            <div class="text-sm text-gray-600 mt-1">Contacts in Mailjet</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 text-center">
          <div class="p-4 bg-purple-50 border border-purple-200">
            <div class="text-3xl font-bold text-purple-900"><%= stats[:subscribed] %></div>
            <div class="text-sm text-gray-600 mt-1">Newsletter Subscribed</div>
          </div>

          <div class="p-4 bg-gray-50 border border-gray-200">
            <div class="text-3xl font-bold text-gray-900"><%= stats[:unsubscribed] %></div>
            <div class="text-sm text-gray-600 mt-1">Unsubscribed</div>
          </div>
        </div>

        <% if stats[:unsynced_members] > 0 %>
          <div class="mt-4">
            <%= button_to "Sync All Members Now",
                sync_all_admin_mailjet_config_path,
                method: :post,
                class: "uppercase text-sm px-2 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-8 bg-blue-50 border border-blue-200 p-6">
    <h3 class="text-sm font-semibold text-gray-900 mb-2">Setup Instructions</h3>
    <ol class="list-decimal list-inside space-y-2 text-sm text-gray-700">
      <li>Sign up for a free Mailjet account at <a href="https://www.mailjet.com" target="_blank" class="text-blue-600 hover:underline">mailjet.com</a></li>
      <li>Go to Account Settings → REST API → API Key Management (Primary and Sub-account)</li>
      <li>Copy your API Key and Secret Key</li>
      <li>Paste them above and click Save Configuration</li>
    </ol>
  </div>
</div>
