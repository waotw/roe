<%# A content layout: a YAML list of parts. A plain textarea — the list is
    short, and the parts it can hold are listed beside it.
    COPY: placeholder wording — owner will rewrite %>
<% content_for :title, "Edit #{@name} layout" %>

<div class="flex justify-between items-center mb-5 pb-2.5 border-b border-gray-300 relative">
  <h1 class="text-3xl font-bold mb-5 font-sans">Edit Layout: <%= @name %></h1>
  <%= link_to "\u2190 Back to Layouts", admin_layouts_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs" %>
</div>

<p class="mb-3 text-sm text-gray-700 font-mono">
  <% if @customised %>
    site/layout/content/<%= @name %>.yml
    <% if @roe_default %><span class="text-gray-500">— your site's copy of Roe's default.</span><% end %>
  <% else %>
    <span class="text-gray-500">Roe's default. Saving makes it your site's copy, in site/layout/content/<%= @name %>.yml.</span>
  <% end %>
</p>

<% if @warnings.any? %>
  <div class="mb-4 border border-amber-600 bg-amber-50 text-amber-900 text-sm px-3 py-2 font-sans">
    <% @warnings.each do |warning| %><p><%= warning %></p><% end %>
  </div>
<% end %>

<div class="mb-5 flex gap-2.5 items-center">
  <button type="submit" form="content-layout-form" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">Save</button>
  <% if @customised %>
    <%= button_to (@roe_default ? "Use Roe's default" : "Delete"), admin_content_layout_path(@name),
          method: :delete, form_class: "leading-0", form: { style: "display: inline; margin: 0;" },
          data: { turbo_confirm: (@roe_default ? "Delete your copy and go back to Roe's default #{@name} layout?" : "Delete the #{@name} layout? Posts using it go back to their type's layout.") },
          class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]" %>
  <% end %>
</div>

<div class="grid grid-cols-[1fr_16rem] gap-6">
  <%= form_with url: admin_content_layout_path(@name), method: :patch, id: "content-layout-form" do |f| %>
    <%= f.text_area :content, value: @content, spellcheck: false,
        class: "w-full bg-white font-mono text-sm p-1 border border-gray-300 box-border h-[500px]" %>
  <% end %>

  <aside class="text-sm font-sans text-gray-700">
    <h2 class="text-xs font-semibold uppercase text-gray-600 mb-1">Writing it</h2>
    <p class="mb-3">One part per line, in page order. <code class="bg-gray-100 px-1">- [title, subtitle]</code> puts parts in one group, styled together.</p>
    <p class="mb-3">A part the post's body already has isn't shown twice: a player card in the body replaces <code class="bg-gray-100 px-1">player</code>.</p>

    <h2 class="text-xs font-semibold uppercase text-gray-600 mb-1">Parts</h2>
    <ul class="font-mono text-xs leading-6">
      <% ContentLayout::BUILT_PARTS.each do |part| %><li><%= part %></li><% end %>
    </ul>
    <p class="mt-2">Any other metadata field, such as <code class="bg-gray-100 px-1">location</code>, shows its value.</p>
  </aside>
</div>

<script>
  (function() {
    const textarea = document.querySelector('#content-layout-form [name="content"]');
    const original = textarea.value;
    const warn = (e) => { if (textarea.value !== original) { e.preventDefault(); e.returnValue = ''; } };
    window.addEventListener('beforeunload', warn);
    document.getElementById('content-layout-form').addEventListener('submit', () => window.removeEventListener('beforeunload', warn));
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 's') {
        e.preventDefault();
        document.getElementById('content-layout-form').requestSubmit();
      }
    });
  })();
</script>
