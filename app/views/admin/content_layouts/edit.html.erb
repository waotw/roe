<%# A content layout: rows of [boxes] in blocks (see ContentLayout). A plain
    textarea — it's short, and the parts it can hold are listed beside it.
    COPY: placeholder wording — owner will rewrite %>
<% content_for :title, "Edit #{@name} layout" %>

<div class="flex justify-between items-center mb-5 pb-2.5 border-b border-gray-300 relative">
  <h1 class="text-3xl font-bold mb-5 font-sans">Edit Layout: <%= @name %></h1>
  <%= link_to "\u2190 Back to Layouts", admin_layouts_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs" %>
</div>

<p class="mb-3 text-sm text-gray-700 font-mono">
  <% if @customised %>
    site/layout/content/<%= @name %>.txt
    <span class="text-gray-500">— custom</span>
  <% else %>
    <span class="text-gray-500">Below is the default <%= @name %> layout. Edit and save to create a custom layout in site/layout/content/<%= @name %>.txt.</span>
  <% end %>
</p>

<% if @warnings.any? %>
  <div class="mb-4 border border-amber-600 bg-amber-50 text-amber-900 text-sm px-3 py-2 font-sans">
    <% @warnings.each do |warning| %><p><%= warning %></p><% end %>
  </div>
<% end %>

<div class="mb-5 flex gap-2.5 items-center">
  <button type="submit" form="content-layout-form" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">Save</button>
  <% if @customised %>
    <%= button_to (@roe_default ? "Use default" : "Delete"), admin_content_layout_path(@name),
          method: :delete, form_class: "leading-0", form: { style: "display: inline; margin: 0;" },
          data: { turbo_confirm: (@roe_default ? "Delete your custom #{@name} layout and go back to the default?" : "Delete the #{@name} layout? Posts using it go back to their type's layout.") },
          class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]" %>
  <% end %>
</div>

<div class="grid grid-cols-[minmax(min-content,1fr)_minmax(16rem,26rem)] gap-6"
     data-controller="layout-explain"
     data-layout-explain-url-value="<%= admin_explain_content_layout_path(@name) %>"
     data-layout-explain-initial-value="<%= @explain.to_json %>">
  <%= form_with url: admin_content_layout_path(@name), method: :patch, id: "content-layout-form" do |f| %>
    <%# The site's header, sidebar and footer, drawn as labelled boxes around
        the textarea so it reads as the middle of a page. Each box links to
        its file. Abstract on purpose: names, not a preview. %>
    <% frame_box = "flex items-center justify-center border border-dashed border-gray-400 bg-gray-100 text-gray-600 hover:bg-gray-200 hover:text-gray-900 font-mono text-xs uppercase tracking-widest" %>
    <% frame = lambda do |label, file, path, extra_class, style = nil|
         if LayoutFiles.exist?(file)
           link_to label, path, class: "#{frame_box} #{extra_class}", style: style, title: "Edit #{label.downcase}", data: { layout_frame: file }
         else
           tag.div(label, class: "#{frame_box} #{extra_class} opacity-60", style: style, data: { layout_frame: file })
         end
       end %>
    <% sidebar_box = -> { frame.call("Sidebar", "sidebar", admin_layout_sidebar_edit_path, "w-8 shrink-0", "writing-mode: vertical-rl; transform: rotate(180deg);") } %>

    <div class="flex flex-col gap-2">
      <%= frame.call("Header", "header", admin_layout_header_edit_path, "h-10") %>
      <div class="flex gap-2">
        <%= sidebar_box.call if @sidebar_position == "left" %>
        <%= f.text_area :content, value: @content, spellcheck: false,
            "aria-label": "#{@name} layout",
            style: layout_textarea_min_width(@content),
            data: { layout_explain_target: "input", controller: "tab-indent", action: "keydown->tab-indent#keydown" },
            class: "min-w-0 flex-1 bg-white font-mono text-sm p-1 border border-gray-300 box-border h-[500px]" %>
        <%= sidebar_box.call if @sidebar_position == "right" %>
      </div>
      <%= frame.call("Footer", "footer", admin_layout_footer_edit_path, "h-10") %>
    </div>

  <% end %>

  <%# Live help (layout_explain_controller): the HTML this layout draws, with
      the caret's line highlighted, any problems, then what the line or box
      under the caret does. Before the textarea is focused, the general
      rules show instead. %>
  <aside class="text-sm font-sans text-gray-700 min-w-0">
    <%# COPY: placeholder wording — owner will rewrite %>
    <%# As tall as the header box and the gap under it (h-10 + gap-2), so the
        example's top lines up with the textarea's. %>
    <h2 class="flex h-12 items-end pb-1 text-xs font-semibold uppercase text-gray-600">HTML</h2>
    <pre class="mb-3 overflow-x-auto border border-gray-200 bg-white p-2 font-mono text-[0.7rem] leading-5 text-gray-800" data-layout-explain-target="html"></pre>
    <ul class="mb-3 text-xs text-red-800 list-disc pl-4 empty:hidden" data-layout-explain-target="warnings"></ul>

    <h2 class="text-xs font-semibold uppercase text-gray-600 mb-1">DETAILS</h2>
    <%# How a layout is written, as a labelled diagram. Click to open it large
        (diagram_zoom_controller): zoom with the buttons or ⌘/Ctrl + scroll,
        drag or scroll to move around, Esc or a click outside to close. %>
    <div class="mb-3" data-controller="diagram-zoom">
      <button type="button" class="block w-full cursor-zoom-in border border-gray-300 hover:border-gray-500"
              data-action="diagram-zoom#open" title="View large version" aria-label="Open the layout diagram larger">
        <%= image_tag "roe-layout-diagram.svg", alt: "How a layout is written: blocks, rows, boxes and their CSS classes", class: "block w-full h-auto" %>
      </button>

      <dialog data-diagram-zoom-target="dialog"
              class="m-auto h-[90vh] w-[95vw] max-w-none max-h-none overflow-hidden bg-[#202020] p-0 backdrop:bg-black/70 [color-scheme:dark]"
              data-action="click->diagram-zoom#closeOnBackdrop">
        <div class="absolute right-3 top-3 z-10 flex gap-1 font-mono text-xs">
          <button type="button" class="border border-gray-500 bg-gray-800 px-2 py-1 text-gray-100 hover:bg-gray-700" data-action="diagram-zoom#zoomOut" aria-label="Zoom out">−</button>
          <button type="button" class="border border-gray-500 bg-gray-800 px-2 py-1 text-gray-100 hover:bg-gray-700" data-action="diagram-zoom#reset" data-diagram-zoom-target="level">100%</button>
          <button type="button" class="border border-gray-500 bg-gray-800 px-2 py-1 text-gray-100 hover:bg-gray-700" data-action="diagram-zoom#zoomIn" aria-label="Zoom in">+</button>
          <button type="button" class="ml-2 border border-gray-500 bg-gray-800 px-2 py-1 text-gray-100 hover:bg-gray-700" data-action="diagram-zoom#close" aria-label="Close">CLOSE</button>
        </div>
        <div class="flex h-full w-full overflow-auto cursor-grab" data-diagram-zoom-target="viewport"
             data-action="wheel->diagram-zoom#wheel pointerdown->diagram-zoom#dragStart">
          <%= image_tag "roe-layout-diagram.svg", alt: "", draggable: false,
                class: "m-auto block h-auto max-w-none shrink-0 select-none", data: { diagram_zoom_target: "image" } %>
        </div>
      </dialog>
    </div>
    <p class="text-gray-500 mb-4">Click a line in the layout to see what it does.</p>
    <%# What the clicked line or box does. Stays after the textarea loses
        focus, so it can be selected and copied; the general rules below
        are always there. %>
    <div class="mb-4 border-l-2 border-amber-400 bg-amber-50 px-2 py-1 leading-6 empty:hidden" data-layout-explain-target="detail"></div>
    <div class="mb-4 min-h-[4rem] leading-6">
      <p class="mb-2">Layouts use <code class="bg-gray-100 px-1">blocks</code> and <code class="bg-gray-100 px-1">[boxes]</code>:</p>
      <ul class="list-disc ml-4 text-xs">
        <li class="mb-2">A <code class="bg-gray-100 px-1">block</code> is a group of <code class="bg-gray-100 px-1">[box]</code>es. A blank line creates a new block.</li>
        <li class="mb-2">A <code class="bg-gray-100 px-1">[box]</code> represents an element in the layout. You can group <code class="bg-gray-100 px-1">[boxes]</code> by putting them next to each other. This gives them their own <code class="bg-gray-100 px-1">&lt;div&gt;</code>.</li>
      </ul>
      <p class="mb-2">The <code class="bg-gray-100 px-1">[body]</code> block is the content from the post or page. The simplest layout would only include <code class="bg-gray-100 px-1">[body]</code> and would only show the content.</p>
      <p class="mb-2">You can add a <code class="bg-gray-100 px-1">&lt;header&gt;</code> by including a <code class="bg-gray-100 px-1">block</code> above <code class="bg-gray-100 px-1">[body]</code>.</p>
      <p class="mb-2">You can add a <code class="bg-gray-100 px-1">&lt;footer&gt;</code> by including a <code class="bg-gray-100 px-1">block</code> below <code class="bg-gray-100 px-1">[body]</code>.</p>
      <p class="mb-2">There are 2 ways to add a CSS class. Put <code class="bg-gray-100 px-1">class-name:</code> on a block's first line. Put <code class="bg-gray-100 px-1">css-name:</code> in front of a group of blocks to give that group that class: <code class="bg-gray-100 px-1">post-header-top: [title] [feed links]</code></p>
    </div>

    <h2 class="text-xs font-semibold uppercase text-gray-600 mb-1">Blocks</h2>
    <ul class="font-mono text-xs leading-6">
      <% ContentLayout::BUILT_PARTS.each do |part| %><li>[<%= part.tr("_", " ") %>]</li><% end %>
    </ul>
  </aside>
</div>

<script>
  (function() {
    const textarea = document.querySelector('#content-layout-form [name="content"]');
    const original = textarea.value;
    const warn = (e) => { if (textarea.value !== original) { e.preventDefault(); e.returnValue = ''; } };
    window.addEventListener('beforeunload', warn);
    document.getElementById('content-layout-form').addEventListener('submit', () => window.removeEventListener('beforeunload', warn));
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 's') {
        e.preventDefault();
        document.getElementById('content-layout-form').requestSubmit();
      }
    });
  })();
</script>
