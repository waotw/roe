<%# The theme editor: the theme's CSS on the left, the site on the right with
    the unsaved CSS applied as you type. Four controllers share this element,
    each with its own job:

      css-editor       the CodeMirror editor, saving, SAVE AS…, find
      theme-sections   the SECTIONS list beside the code
      theme-preview    the preview, its page menu, WIDE / PHONE
      theme-inspector  INSPECT: click something in the preview, see its rules

    They talk through the css-editor's events (css-editor:ready,
    css-editor:change) and the preview's (theme-preview:load). %>
<% content_for :title, "Edit Theme: #{@theme_name}" %>
<% button = "uppercase text-xs px-1.5 py-0 border border-gray-800 font-mono rounded-xs h-5 leading-none whitespace-nowrap" %>
<div id="theme-editor"
     class="h-full flex flex-col"
     data-controller="css-editor theme-sections theme-preview theme-inspector"
     data-css-editor-theme-name-value="<%= @theme_name %>"
     data-css-editor-highlight-value="<%= params[:highlight] %>"
     data-css-editor-save-as-url-value="<%= save_as_admin_theme_path(@theme_name) %>"
     data-theme-preview-theme-value="<%= @theme_name %>"
     data-theme-preview-reference-value="<%= ThemeReference::PAGES.map { |p| { title: p.title, path: admin_theme_reference_path(p.slug) } }.to_json %>"
     data-action="keydown@window->theme-inspector#escape">

  <%# Title row %>
  <div class="flex items-center justify-between gap-4 px-4 pt-3 pb-2 border-b border-gray-200">
    <div class="flex items-baseline gap-3 min-w-0">
      <h1 class="text-2xl font-bold whitespace-nowrap">Edit Theme: <%= @theme_header&.name || @theme_name.titleize %></h1>
      <span class="text-xs text-gray-500 font-mono truncate">
        <%= @theme_name %>.css<% if @theme_header&.version %> · v<%= @theme_header.version %><% end %>
        <%# COPY: where the theme came from %>
        · <%= @theme_shipped ? "installed from Roe" : "your own theme" %>
      </span>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "← Themes", admin_themes_path, class: "#{button} inline-flex items-center bg-blue-200 hover:bg-blue-300",
                  data: { action: "click->css-editor#confirmLeave" } %>
      <% if @theme_shipped %>
        <button type="button" onclick="showResetThemeModal()"
                class="<%= button %> bg-red-100 hover:bg-red-200 text-red-800">Reset to original</button>
      <% end %>
    </div>
  </div>

  <%# Toolbar %>
  <div class="flex items-center justify-between gap-3 px-4 py-2 border-b border-gray-200">
    <div class="flex items-center gap-2 min-w-0">
      <button type="submit" form="theme-form" data-action="click->css-editor#save"
              class="<%= button %> bg-blue-200 hover:bg-blue-300">Save</button>
      <button type="button" data-action="click->css-editor#openSaveAs"
              class="<%= button %> bg-gray-200 hover:bg-gray-300">Save as…</button>
      <%= link_to "Cancel", admin_themes_path, class: "#{button} inline-flex items-center bg-gray-200 hover:bg-gray-300",
                  data: { action: "click->css-editor#confirmLeave" } %>
      <span class="text-xs font-mono truncate">
        <span data-css-editor-target="saveStatus" aria-live="polite"></span>
        <%# COPY: unsaved changes %>
        <span data-css-editor-target="unsavedIndicator" class="hidden text-amber-600">● Unsaved changes · undo keeps working after you save</span>
      </span>
    </div>
    <div class="flex items-center gap-2">
      <button type="button" data-action="click->css-editor#find"
              class="<%= button %> bg-gray-200 hover:bg-gray-300">Find &amp; replace</button>
      <button type="button" data-action="click->theme-preview#togglePreview" data-theme-preview-target="previewToggle"
              class="<%= button %> te-preview-toggle bg-gray-200 hover:bg-gray-300">Preview</button>
      <button type="button" data-action="click->theme-inspector#toggle" data-theme-inspector-target="button"
              aria-pressed="false" class="<%= button %> te-inspect-button bg-gray-200 hover:bg-gray-300">
        <span data-theme-inspector-target="buttonLabel">◎ Inspect</span>
      </button>
    </div>
  </div>

  <%# Sections · code · preview %>
  <div class="te-body flex-1 min-h-0" data-theme-preview-target="body">
    <aside class="te-sections" data-theme-sections-target="panel" data-state="open"
           data-action="mouseleave->theme-sections#unpeek">
      <button type="button" class="te-sections-strip" data-action="mouseenter->theme-sections#peek click->theme-sections#pin"
              aria-label="Show sections">
        <span aria-hidden="true">›</span>
        <span class="te-sections-strip-label">Sections</span>
      </button>
      <div class="te-sections-list">
        <div class="te-sections-head">
          <span>Sections</span>
          <button type="button" class="<%= button %> bg-gray-100 hover:bg-gray-200" data-action="click->theme-sections#hideOrPin"
                  data-theme-sections-target="hideButton">Hide ‹</button>
        </div>
        <ol data-theme-sections-target="list"></ol>
        <%# COPY: a theme with no headings in the format %>
        <p class="te-sections-empty hidden" data-theme-sections-target="empty">
          No sections. A heading written as <code>/* ==== NAME ==== */</code> on its own line shows up here.
        </p>
      </div>
    </aside>

    <section class="te-code">
      <div class="te-inspect hidden" data-theme-inspector-target="panel"></div>
      <%= form_with url: admin_theme_path(@theme_name), method: :patch, id: "theme-form", class: "te-code-form" do |form| %>
        <%= form.text_area :content, value: @theme_content, data: { css_editor_target: "textarea" },
                           class: "w-full h-full font-mono text-sm p-2", spellcheck: "false" %>
        <div data-css-editor-target="editorContainer" class="te-code-editor"></div>
      <% end %>
    </section>

    <section class="te-preview" data-theme-preview-target="pane">
      <div class="te-preview-bar">
        <div class="te-page-menu">
          <button type="button" class="te-page-button" data-action="click->theme-preview#toggleMenu"
                  data-theme-preview-target="pathButton" aria-haspopup="true" aria-expanded="false"></button>
          <div class="te-page-list hidden" data-theme-preview-target="menu"></div>
        </div>
        <div class="flex items-center gap-1">
          <button type="button" class="<%= button %> bg-gray-200 hover:bg-gray-300" data-action="click->theme-preview#wide"
                  data-theme-preview-target="wideButton">Wide</button>
          <button type="button" class="<%= button %> bg-gray-200 hover:bg-gray-300" data-action="click->theme-preview#phone"
                  data-theme-preview-target="phoneButton">Phone</button>
        </div>
      </div>
      <div class="te-preview-frame" data-theme-preview-target="frameWrap">
        <iframe data-theme-preview-target="frame" title="Preview" data-action="load->theme-preview#loaded"></iframe>
      </div>
    </section>
  </div>

  <%# SAVE AS… %>
  <dialog class="te-dialog" data-css-editor-target="saveAsDialog">
    <form method="dialog" data-action="submit->css-editor#saveAs">
      <%# COPY: SAVE AS… dialog %>
      <h2 class="text-lg font-bold mb-1">Save as a new theme</h2>
      <p class="text-sm text-gray-600 mb-3">
        Saves what's in the editor as a new theme next to this one and opens it.
        <%= @theme_name %>.css stays as it was saved. The new theme isn't used
        on the site until you click ACTIVATE on the Themes page.
      </p>
      <label class="block text-sm font-medium mb-1" for="te-save-as-name">Name</label>
      <input id="te-save-as-name" type="text" class="w-full border border-gray-400 px-2 py-1 font-mono text-sm"
             value="<%= @suggested_copy_name&.titleize %>" data-css-editor-target="saveAsName"
             data-action="input->css-editor#saveAsNameChanged" autocomplete="off">
      <p class="text-xs text-gray-500 font-mono mt-1" data-css-editor-target="saveAsFile"></p>
      <p class="text-sm text-red-700 mt-2" data-css-editor-target="saveAsError" aria-live="polite"></p>
      <div class="flex justify-end gap-2 mt-4">
        <button type="button" class="<%= button %> bg-gray-200 hover:bg-gray-300" data-action="click->css-editor#closeSaveAs">Cancel</button>
        <button type="submit" class="<%= button %> bg-blue-200 hover:bg-blue-300">Save as new theme</button>
      </div>
    </form>
  </dialog>

  <% if @theme_shipped %>
    <%= render "reset_theme_modal" %>
  <% end %>
</div>
