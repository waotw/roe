<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">Themes</h1>
      <p class="mt-2 text-sm text-gray-700">Preview, activate, and customize your site's appearance</p>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mt-4 px-4 py-2 bg-green-50 border border-green-200 text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:error] %>
    <div class="mt-4 px-4 py-2 bg-red-50 border border-red-200 text-red-800 text-sm">
      <%= flash[:error] %>
    </div>
  <% end %>

  <!-- Active Theme -->
  <div class="mt-8 bg-blue-50 border border-blue-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 mb-1 uppercase">Active Theme</h2>
        <p class="text-2xl font-bold text-blue-600"><%= @active_theme.capitalize %></p>

        <% unless @active_theme_exists %>
          <p class="text-sm text-red-600 mt-2">
            ⚠️ Theme file not found in /site/theme/. Activate it below to install.
          </p>
        <% end %>
      </div>

      <% if @active_theme_exists %>
        <%= link_to "Edit CSS",
                    edit_admin_theme_path(@active_theme),
                    class: "inline-flex items-center uppercase text-sm px-2 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
      <% end %>
    </div>
  </div>

  <!-- Available Themes -->
  <div class="mt-8">
    <h2 class="text-sm font-semibold text-gray-900 mb-4 uppercase">Available Themes</h2>

    <div class="overflow-hidden ring-1 ring-black ring-opacity-5">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-2 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 uppercase">Name</th>
            <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Size</th>
            <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Status</th>
            <th scope="col" class="relative py-1.5 pl-3 pr-4 sm:pr-6">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @available_themes.each do |theme| %>
            <tr class="hover:bg-gray-50">
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">
                <%= theme[:name].capitalize %>
              </td>
              <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
                <%= number_to_human_size(theme[:size]) %>
              </td>
              <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
                <% is_active = theme[:name] == @active_theme %>
                <% is_installed = theme[:installed] %>

                <% if is_active %>
                  <span class="inline-flex bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">ACTIVE</span>
                <% elsif is_installed %>
                  <span class="inline-flex bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-800">Installed</span>
                <% else %>
                  <span class="inline-flex bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-500">Available</span>
                <% end %>
              </td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium">
                <div class="flex gap-2 justify-end">
                  <%= link_to "Preview",
                              root_path(preview_theme: theme[:name]),
                              target: "_blank",
                              class: "uppercase text-xs px-2 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>

                  <% if is_active && !is_installed %>
                    <%= button_to "Install",
                                  activate_admin_theme_path(theme[:name]),
                                  method: :post,
                                  class: "uppercase text-xs px-2 py-1 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>
                  <% elsif !is_active %>
                    <%= button_to "Activate",
                                  activate_admin_theme_path(theme[:name]),
                                  method: :post,
                                  class: "uppercase text-xs px-2 py-1 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
