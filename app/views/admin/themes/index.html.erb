<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">Themes</h1>
      <p class="mt-2 text-sm text-gray-700">Preview, activate, and customize your site's appearance</p>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mt-4 px-4 py-2 bg-green-50 border border-green-200 text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:error] %>
    <div class="mt-4 px-4 py-2 bg-red-50 border border-red-200 text-red-800 text-sm">
      <%= flash[:error] %>
    </div>
  <% end %>

  <!-- Active Theme -->
  <div class="mt-8 bg-blue-50 border border-blue-200 p-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-semibold text-gray-900 mb-1 uppercase">Active Theme</h2>
        <p class="text-2xl font-bold text-blue-600"><%= @active_theme.capitalize %></p>

        <% unless @active_theme_exists %>
          <p class="text-sm text-red-600 mt-2">
            ⚠️ Theme file not found in /site/theme/. Activate it below to install.
          </p>
        <% end %>
      </div>

      <% if @active_theme_exists %>
        <%= link_to "Edit CSS",
                    edit_admin_theme_path(@active_theme),
                    class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
      <% end %>
    </div>
  </div>

  <!-- Available Themes -->
  <div class="mt-8">
    <h2 class="text-sm font-semibold text-gray-900 mb-4 uppercase">Available Themes</h2>

    <div class="overflow-hidden ring-1 ring-black ring-opacity-5">
      <table class="min-w-full divide-y divide-gray-300">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="py-2 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 uppercase">Name</th>
            <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Size</th>
            <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Status</th>
            <th scope="col" class="relative py-1.5 pl-3 pr-4 sm:pr-6">
              <span class="sr-only">Actions</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% @available_themes.each do |theme| %>
            <tr class="hover:bg-gray-50">
              <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900">
                <%= theme[:display_name] %>
                <span class="ml-1 text-xs font-normal text-gray-400">
                  (<%= theme[:name] %>.css)
                </span>
                <% if theme[:installed_version] || theme[:bundled_version] %>
                  <span class="ml-1 text-xs font-normal text-gray-400">
                    v<%= theme[:installed_version] || theme[:bundled_version] %>
                  </span>
                <% end %>
              </td>
              <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
                <%= number_to_human_size(theme[:size]) %>
              </td>
              <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
                <% is_active = theme[:name] == @active_theme %>
                <% is_installed = theme[:installed] %>
                <% is_master = theme[:master] %>

                <div class="flex gap-1 flex-wrap">
                  <% if is_active %>
                    <span class="inline-flex bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">ACTIVE</span>
                  <% end %>
                  <% if is_installed %>
                    <span class="inline-flex bg-blue-100 px-2 text-xs font-semibold leading-5 text-blue-800">Installed</span>
                  <% end %>
                  <% unless is_master %>
                    <span class="inline-flex bg-purple-100 px-2 text-xs font-semibold leading-5 text-purple-800">Custom</span>
                  <% end %>
                  <% if is_master && !is_installed %>
                    <span class="inline-flex bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-500">Available</span>
                  <% end %>

                  <%# Update-related badges only apply to installed bundled themes. %>
                  <% if is_installed && is_master %>
                    <% case theme[:status] %>
                    <% when :tracked_outdated %>
                      <span class="inline-flex bg-amber-100 px-2 text-xs font-semibold leading-5 text-amber-800" title="Bundled v<%= theme[:bundled_version] %> available">
                        Update to v<%= theme[:bundled_version] %>
                      </span>
                    <% when :tracked_ahead %>
                      <span class="inline-flex bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-600" title="Installed version is ahead of bundled — usually means Roe was downgraded">
                        Newer than bundled
                      </span>
                    <% when :custom %>
                      <span class="inline-flex bg-purple-100 px-2 text-xs font-semibold leading-5 text-purple-800" title="Header missing or theme name changed — treated as custom">
                        Custom
                      </span>
                    <% end %>
                  <% end %>
                </div>
              </td>
              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium">
                <div class="flex gap-2 justify-end">
                  <%= link_to "Preview",
                              root_path(preview_theme: theme[:name]),
                              target: "_blank",
                              class: "uppercase text-xs px-2 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>

                  <% if !is_active %>
                    <%= button_to "Activate",
                                  activate_admin_theme_path(theme[:name]),
                                  method: :post,
                                  class: "uppercase text-xs px-2 py-1 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
                  <% end %>

                  <% if is_installed && is_master && theme[:status] == :tracked_outdated %>
                    <%# Opens the shared update-theme modal (rendered once
                        at the bottom of this template). The modal lets the
                        user pick between Overwrite and Preserve-and-update;
                        both submit to the `reset` action with the
                        appropriate reset_type. %>
                    <button type="button"
                            data-update-theme-trigger
                            data-theme-name="<%= theme[:name] %>"
                            data-display-name="<%= theme[:display_name] %>"
                            data-installed-version="<%= theme[:installed_version] %>"
                            data-bundled-version="<%= theme[:bundled_version] %>"
                            data-suggested-name="<%= theme[:display_name] %> v<%= theme[:installed_version] %>"
                            class="uppercase text-xs px-2 py-1 border border-amber-700 bg-amber-100 hover:bg-amber-200 text-amber-900 font-mono rounded-xs">
                      Update to v<%= theme[:bundled_version] %>
                    </button>
                  <% end %>

                  <% if is_installed && !is_active %>
                    <button type="button"
                            data-action="delete"
                            data-resource-id="<%= theme[:name] %>"
                            data-resource-title="<%= theme[:name].capitalize %>"
                            data-resource-type="theme"
                            class="uppercase text-xs px-2 py-1 border border-gray-800 bg-red-100 hover:bg-red-200 text-red-800 font-mono rounded-xs">
                      Uninstall
                    </button>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<%= render "update_theme_modal" %>

<!-- Delete Theme Modal -->
<div id="delete-modal-theme" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
  <div class="bg-white p-6 shadow-xl max-w-md w-full mx-4">
    <h3 class="text-lg font-bold text-gray-900 mb-2">Uninstall "<span id="delete-item-title-theme"></span>"?</h3>
    <p class="text-sm text-gray-600 mb-4">
      This will permanently delete the theme file from <code class="bg-gray-100 px-1">site/theme/</code>.
      This action cannot be undone.
    </p>
    <div class="mb-4">
      <label class="block text-sm font-medium text-gray-700 mb-1">
        Type <strong>DELETE</strong> to confirm:
      </label>
      <input type="text"
             id="delete-confirmation-input-theme"
             class="w-full px-3 py-2 border border-gray-300 focus:ring-2 focus:ring-red-500 focus:border-red-500"
             placeholder="DELETE"
             autocomplete="off">
    </div>
    <div class="flex gap-3 justify-end">
      <button type="button"
              onclick="hideThemeDeleteConfirmation()"
              class="px-4 py-2 border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
        Cancel
      </button>
      <%= button_to "Uninstall Theme",
          admin_theme_path('THEME_NAME_PLACEHOLDER'),
          method: :delete,
          id: "delete-confirm-btn-theme",
          disabled: true,
          class: "px-4 py-2 border border-transparent text-sm font-medium text-white bg-red-600 hover:bg-red-700 disabled:opacity-50 disabled:cursor-not-allowed",
          form: {
            id: "delete-theme-form",
            onsubmit: "return document.getElementById('delete-confirmation-input-theme').value === 'DELETE'",
            style: "display: inline; margin: 0;"
          } %>
    </div>
  </div>
</div>

<script>
function showThemeDeleteConfirmation(themeName, themeTitle) {
  document.getElementById("delete-item-title-theme").textContent = themeTitle;
  document.getElementById("delete-modal-theme").classList.remove("hidden");
  document.getElementById("delete-confirmation-input-theme").value = "";
  document.getElementById("delete-confirmation-input-theme").focus();
  document.getElementById("delete-confirm-btn-theme").disabled = true;

  // Update the form action to point to the correct theme
  var form = document.getElementById("delete-theme-form");
  form.action = "/admin/themes/" + encodeURIComponent(themeName);
}

function hideThemeDeleteConfirmation() {
  document.getElementById("delete-modal-theme").classList.add("hidden");
}

document.addEventListener("turbo:load", function () {
  // Handle theme uninstall button clicks
  document.querySelectorAll('[data-action="delete"][data-resource-type="theme"]').forEach((button) => {
    button.addEventListener("click", function () {
      const themeName = this.dataset.resourceId;
      const themeTitle = this.dataset.resourceTitle;
      showThemeDeleteConfirmation(themeName, themeTitle);
    });
  });

  // Set up the confirmation input for theme deletion
  const deleteInput = document.getElementById("delete-confirmation-input-theme");
  const deleteBtn = document.getElementById("delete-confirm-btn-theme");

  if (deleteInput && deleteBtn) {
    deleteInput.addEventListener("input", function () {
      deleteBtn.disabled = this.value !== "DELETE";
    });

    deleteInput.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && this.value === "DELETE") {
        deleteBtn.form.requestSubmit();
      } else if (e.key === "Escape") {
        hideThemeDeleteConfirmation();
      }
    });
  }
});
</script>
