<div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
  <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
    <div class="overflow-hidden ring-1 ring-black ring-opacity-5">
  <table class="min-w-full divide-y divide-gray-300">
    <thead class="bg-gray-50">
      <tr>
        <th scope="col" class="py-2 pl-6 md:pl-4 pr-3 text-left text-sm font-semibold text-gray-900 uppercase">Title</th>
        <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Filename <span class="text-xs normal-case text-gray-500 font-normal">(double click to rename)</span></th>
        <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Status</th>
        <th scope="col" class="relative py-1.5 pl-3 md:pr-4 pr-6">
          <span class="sr-only">Actions</span>
        </th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200 bg-white">
      <% if pages.empty? %>
        <tr>
          <td colspan="4" class="px-4 py-8 text-center text-sm text-gray-500">
            No pages yet
          </td>
        </tr>
      <% else %>
        <% pages.each do |page| %>
          <tr>
            <td class="max-w-[12rem] py-1.5 pl-6 md:pl-4 pr-3 text-sm font-medium text-gray-900">
              <div class="flex items-center gap-1.5">
                <%= link_to page.title || "Untitled", edit_admin_page_path(page), class: "min-w-0 truncate text-blue-600 hover:text-blue-900" %>
                <% if local_assigns[:show_member_badge] %>
                  <span class="shrink-0 inline-flex bg-blue-100 px-2 text-xs font-mono leading-5 text-blue-800">Member</span>
                <% end %>
                <% if page.needs_attention? %>
                  <%
                    reasons = []
                    page.missing_site_gated_fields.each { |name| reasons << "missing #{name}" }
                    page.missing_media_refs.each { |ref| reasons << "file not found: #{ref[:path]}" }
                  %>
                  <span class="shrink-0 inline-block text-base text-amber-600 font-semibold font-sans"
                        title="<%= reasons.join(', ') %>">
                    ⚠
                  </span>
                <% end %>
              </div>
            </td>
            <td class="max-w-0 px-1.5 py-4 text-sm text-gray-500">
              <%= render 'shared/inline_rename',
                  resource: page,
                  resource_type: 'page',
                  display_class: "inline-block max-w-full truncate align-bottom" %>
            </td>
            <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
              <% case page.status %>
              <% when 'published' %>
                <span class="inline-flex bg-green-100 px-2 text-xs font-mono leading-5 text-green-800">Published</span>
              <% when 'unlisted' %>
                <span class="inline-flex bg-yellow-100 px-2 text-xs font-mono leading-5 text-yellow-800">Unlisted</span>
              <% else %>
                <span class="inline-flex bg-gray-100 px-2 text-xs font-mono leading-5 text-gray-800">Draft</span>
              <% end %>
            </td>
            <td class="relative whitespace-nowrap py-4 pl-3 md:pr-4 pr-6 text-right text-xs font-medium">
              <div class="flex items-center justify-end gap-3">
                <%= link_to icon_svg("edit", class: "w-4 h-4"), edit_admin_page_path(page),
                      class: "text-slate-500 hover:text-blue-700", title: "Edit", "aria-label": "Edit" %>
                <%= link_to icon_svg("view", class: "w-4 h-4"), page_path(url_name: page.url_name), target: "_blank",
                      class: "text-slate-500 hover:text-gray-900", title: "View", "aria-label": "View" %>
                <%= button_to icon_svg("duplicate", class: "w-4 h-4"), duplicate_admin_page_path(page), method: :post,
                      form: { class: "inline-flex" },
                      class: "text-slate-500 hover:text-blue-700 cursor-pointer", title: "Duplicate", "aria-label": "Duplicate" %>
                <button type="button"
                        data-action="delete"
                        data-resource-id="<%= page.id %>"
                        data-resource-title="<%= page.title || 'Untitled' %>"
                        data-resource-type="page"
                        data-delete-url="<%= admin_page_path(page) %>"
                        class="text-slate-500 hover:text-red-700 cursor-pointer" title="Delete" aria-label="Delete">
                  <%= icon_svg("delete", class: "w-4 h-4") %>
                </button>
              </div>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  </table>
    </div>
  </div>
</div>
