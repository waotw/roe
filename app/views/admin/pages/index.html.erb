<div class="px-4 sm:px-0">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold text-gray-900">Pages</h1>
      <p class="mt-2 text-sm text-gray-700">Standalone pages on your site.</p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "New Page", new_admin_page_path, class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium text-white bg-blue-600 hover:bg-blue-700" %>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mt-4 px-4 py-2 bg-green-50 border border-green-200 text-green-800 text-sm">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:error] %>
    <div class="mt-4 px-4 py-2 bg-red-50 border border-red-200 text-red-800 text-sm">
      <%= flash[:error] %>
    </div>
  <% end %>

  <div class="mt-8 flex flex-col">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <div class="overflow-hidden ring-1 ring-black ring-opacity-5">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-2 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">Title</th>
                <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900">Filename <span class="text-xs text-gray-500 font-normal">(double click to rename)</span></th>
                <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900">Status</th>
                <th scope="col" class="relative py-1.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% @pages.each do |page| %>
                <tr>
                  <td class="whitespace-nowrap py-1.5 pl-4 pr-3 text-sm font-medium text-gray-900">
                    <%= page.title || "Untitled" %>
                  </td>
                  <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
                    <%= render 'shared/inline_rename',
                        resource: page,
                        resource_type: 'page' %>
                  </td>
                  <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
                    <% case page.status %>
                    <% when 'published' %>
                      <span class="inline-flex  bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Published</span>
                    <% when 'unlisted' %>
                      <span class="inline-flex  bg-yellow-100 px-2 text-xs font-semibold leading-5 text-yellow-800">Unlisted</span>
                    <% else %>
                      <span class="inline-flex  bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-800">Draft</span>
                    <% end %>
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium">
                    <%= link_to "Edit", edit_admin_page_path(page), class: "text-blue-600 hover:text-blue-900 mr-4" %>
                    <%= link_to "View", page_path(url_name: page.url_name), class: "text-gray-600 hover:text-gray-900", target: "_blank" %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
