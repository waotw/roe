<!DOCTYPE html>
<html>
<head>
  <title>Edit: <%= @page.title || 'Untitled' %></title>
  <% content_for :editor_js, true %>
</head>
<body class="bg-white text-black p-5" data-turbo-action="replace" data-md-editor>

  <div class="flex justify-between gap-3 items-start pb-2.5 relative">
    <div class="">
      <h1 class="text-xl font-bold leading-none">Edit Page: <%= @page.title %></h1>
      <div class="flex items-center">
      <%= render 'shared/inline_rename', resource: @page, resource_type: 'page', return_to: edit_admin_page_path(@page) %>
      </div>
    </div>
    <div class="flex items-center gap-2">
    <%= link_to "← Back to Pages", admin_pages_path, class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
    </div>
  </div>

  <% if flash[:warning] %>
    <div class="px-2.5 py-1 mb-5 border border-gray-300 bg-yellow-50"><%= flash[:warning] %></div>
  <% end %>

  <% if @page.needs_attention? %>
    <div class="bg-red-50 border border-amber-400 px-3 py-2 mb-5 text-sm">
      <strong class="text-amber-700">⚠ This page is published but has issues:</strong>
      <ul class="list-disc ml-5 mt-1 text-amber-700">
        <% @page.missing_site_gated_fields.each do |name| %>
          <li>Missing required field: <code><%= name %></code></li>
        <% end %>
        <% @page.missing_media_refs.each do |ref| %>
          <li>File not found: <code><%= ref[:path] %></code> (<%= ref[:field] %>)</li>
        <% end %>
      </ul>
      <p class="text-xs text-amber-600 mt-2 italic">Save your changes to refresh this list.</p>
    </div>
  <% end %>

  <!-- Wrap everything in Stimulus controller -->
  <div data-controller="editor collection-builder card-builder gallery-builder action-builder"
       data-editor-resource-type-value="page"
       data-editor-resource-id-value="<%= @page.id %>"
       data-editor-preview-path-value="<%= @preview_path || preview_admin_page_path(@page) %>"
       data-editor-collection-template-value="<%= SiteConfig.default('collections', 'button_template') %>"
       data-editor-aside-template-value="<%= SiteConfig.default('cards', 'aside_button_template') %>"
       data-editor-page-link-template-value="<%= SiteConfig.default('cards', 'page_link_button_template') %>"
       data-editor-pullquote-template-value="<%= SiteConfig.default('cards', 'pullquote_button_template') %>"
       data-editor-product-template-value="<%= SiteConfig.feature('store', 'product_button_template') %>"
       data-editor-currency-symbol-value="<%= store_currency_symbol %>">

    <%= render 'shared/editor_actions', resource: @page, resource_type: 'page' %>

    <%= render 'shared/editor',
          form_url: admin_page_path(@page),
          resource_type: 'page',
          metadata: @metadata.gsub(/^---\n/, ''),
          content: @content,
          show_metadata: true,
          preview_path: @preview_path || preview_admin_page_path(@page),
          item: @page,
          metadata_config: @metadata_config,
          default_author: @default_author %>

    <%= render 'shared/editor_drawer', resource: @page, resource_type: 'page' %>
    <%= render 'shared/leave_modal' %>

  </div>
  <!-- End Stimulus controller -->

  <%= render 'shared/delete_file_modal', resource: @page, resource_type: 'page' %>

  <%# Trigger preview-window refresh for both plain saves AND save-and-
      publish (controller flashes "Page published" in that case). %>
  <% if flash[:notice]&.match?(/\APage (saved|published)/) %>
    <div id="page-saved-trigger" data-trigger="refresh" style="display: none;"></div>
  <% end %>
</body>
</html>
