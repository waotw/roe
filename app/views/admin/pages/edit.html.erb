<!DOCTYPE html>
<html>
<head>
  <title>Edit: <%= @page.title || 'Untitled' %></title>
</head>
<body class="bg-white text-black p-5">

  <div class="flex justify-between items-center mb-5 pb-2.5 border-b border-gray-300 relative">
    <div class="flex items-center gap-2">
    <%= link_to "← Back to Posts", admin_posts_path, class: "text-blue-600 hover:text-blue-800" %> |
    <%= link_to "Media", browse_admin_medium_index_path, target: "_blank", id: "browse-media-link", class: "text-blue-600 hover:text-blue-800" %>
    </div>
    <% if flash[:notice] %>
      <div class="flash-notice px-2 py-0.5 border border-gray-300 bg-green-100 absolute right-0"><%= flash[:notice] %></div>
    <% end %>
    <% if flash[:trigger_refresh] %>
      <script>
        setTimeout(() => {
          localStorage.setItem('content-updated', Date.now());
        }, 100);
      </script>
    <% end %>
  </div>

  <% if flash[:warning] %>
    <div class="px-2.5 py-1 mb-5 border border-gray-300 bg-yellow-50"><%= flash[:warning] %></div>
  <% end %>

  <h1 class="text-3xl font-bold mb-5">Edit Page: <%= @page.title %></h1>

  <div class="mb-5 flex gap-2.5 items-center">
    <span style="display: inline; margin: 0;">
      <button type="submit" form="page-form" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-[18px] leading-none pt-[0.1rem]">Save</button>
    </span>

    <button type="button" onclick="previewPost()" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-[18px] leading-none pt-[0.1rem]">Preview</button>

        <% if @page.draft? %>
          <%= button_to "Publish", publish_admin_page_path(@page),
              method: :patch,
              class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-[18px] leading-none pt-[0.1rem]",
              form: {
                onsubmit: "window.removeEventListener('beforeunload', handleBeforeUnload); return confirm('Publishing this page will save your changes and make it live on your site. Continue?')",
                style: "display: inline; margin: 0;"
              } %>
        <% else %>
          <%= button_to "Unpublish", unpublish_admin_page_path(@page),
              method: :patch,
              class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-[18px] leading-none pt-[0.1rem]",
              form: {
                onsubmit: "window.removeEventListener('beforeunload', handleBeforeUnload); return confirm('Unpublishing this page will save your changes and remove it from your site. Continue?')",
                style: "display: inline; margin: 0;"
              } %>
        <% end %>
  </div>

  <%= render 'shared/editor',
      form_url: admin_page_path(@page),
      resource_type: 'page',
      metadata: @metadata.gsub(/^---\n/, ''),
      content: @content,
      show_metadata: true,
      preview_path: @preview_path || preview_admin_page_path(@page) %>
</body>
</html>
