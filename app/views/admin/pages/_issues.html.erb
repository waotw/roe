<%# The page's issues, above the editor. Also sent back after every
    background save (EditorSave#finish_editor_save, issues_html), so the box
    appears and goes as the page changes, without a reload. %>
<div id="editor-issues">
  <%# A page named like a layout part gets no page-<url_name> class (see
      Page#name_class). %>
  <% if page.name_class_clash? %>
    <div class="px-2.5 py-1 mb-5 border border-gray-300 bg-yellow-50 text-sm" data-name-class-clash>
      <%= render "admin/pages/name_class_clash", page: page %>
    </div>
  <% end %>

  <% if page.needs_attention? %>
    <div class="bg-red-50 border border-amber-400 px-3 py-2 mb-5 text-sm">
      <strong class="text-amber-700">⚠ This page is published but has issues:</strong>
      <ul class="list-disc ml-5 mt-1 text-amber-700">
        <% page.missing_site_gated_fields.each do |name| %>
          <li>Missing required field: <code><%= name %></code></li>
        <% end %>
        <% page.missing_media_refs.each do |ref| %>
          <li>File not found: <code><%= ref[:path] %></code> (<%= ref[:field] %>)</li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
