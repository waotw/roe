<!DOCTYPE html>
<html>
<head>
  <title>New Page</title>
</head>
<body>
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold mb-6">New Page</h1>
    <%= link_to "← Back to Pages", admin_pages_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs" %>
  </div>

  <%= form_with url: admin_pages_path, method: :page do |f| %>
    <label>
      Filename:
      <%= f.text_field :filename, placeholder: "my page", autofocus: true, class: "bg-white font-mono text-sm p-1 border border-gray-300" %>
      <p class="inline">.md</p>
    </label>

    <%= f.hidden_field :content, value: @template %>

    <p class="mt-5">
      <button type="submit" class="uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs">Create Page</button>
      <span class="text-gray-500 text-xs">(Enter/Return)</span>
    </p>
  <% end %>
</body>
</html>
