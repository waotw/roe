<%# COPY: placeholder wording — owner will rewrite %>
<div class="px-4 sm:px-0 max-w-2xl mx-auto mt-12">
  <div class="bg-white border-2 border-gray-900 p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-4">Turn off email for members?</h1>

    <div class="bg-yellow-50 border border-yellow-400 p-4 mb-6">
      <p class="text-sm text-gray-800 leading-7">
        Your members sign in with an emailed link. If you turn email off, that
        link stops working and
        <strong><%= @affected_member_count %>
        <%= "member".pluralize(@affected_member_count) %></strong>
        will need a password instead. Choose how to continue:
      </p>
    </div>

    <div class="space-y-4">
      <div class="bg-gray-50 border border-gray-300 p-6">
        <h3 class="font-semibold text-gray-900 mb-2">Switch to passwords</h3>
        <p class="text-sm text-gray-700 mb-4">
          Send every current member one final email with a temporary password
          they can reset after signing in. After that, email is off and members
          sign in with a password. This is the last email the site will send.
        </p>
        <%= form_with url: confirm_members_passwords_admin_configs_path, method: :post do |f| %>
          <%= hidden_field_tag :content, @config_content %>
          <%= f.submit "Switch to passwords & email everyone once",
              class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer",
              data: { turbo_confirm: "Send a temporary password to #{@affected_member_count} #{'member'.pluralize(@affected_member_count)} and switch to password sign-in?" } %>
        <% end %>
      </div>

      <div class="bg-gray-50 border border-gray-300 p-6">
        <h3 class="font-semibold text-gray-900 mb-2">Turn off members entirely</h3>
        <p class="text-sm text-gray-700 mb-4">
          Disable the members feature. No emails are sent and nobody can sign
          in any longer. Member records are kept.
        </p>
        <%= form_with url: delete_members_admin_configs_path, method: :delete do |f| %>
          <%= f.submit "Turn off members",
              class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-red-200 hover:bg-red-300 font-mono rounded-xs cursor-pointer",
              data: { turbo_confirm: "Turn off the members feature? Members will no longer be able to sign in." } %>
        <% end %>
      </div>
    </div>

    <div class="mt-6">
      <%= link_to "Cancel — keep email on", admin_edit_members_config_path,
          class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-white hover:bg-gray-100 font-mono rounded-xs" %>
    </div>
  </div>
</div>
