<% content_for :editor_js, false %>
<div class="px-4 sm:px-0">
  <div class="sm:flex sm:items-center mb-6">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold text-gray-900">Edit <%= @config_type.capitalize %> Configuration</h1>
      <p class="mt-2 text-sm text-gray-700">
        Configure your site settings using the form below or edit the raw YAML.
      </p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "← Back to Settings", admin_configs_path, class: "inline-flex items-center uppercase text-sm mb-2 px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none" %>
      <% if Rails.env.development? && !File.exist?(File.join(RoeSitePaths::SITE_PATH, 'system', 'global', 'development.yml')) %>
        <%= button_to "Enable Dev Settings",
                      admin_enable_development_admin_configs_path,
                      method: :post,
                      class: "inline-flex items-center uppercase text-xs px-1.5 py-0.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
      <% end %>
    </div>
  </div>

  <% if flash[:error] %>
    <div class="mb-4 bg-red-50 border border-red-200 p-4">
      <p class="text-sm text-red-800"><%= flash[:error] %></p>
    </div>
  <% end %>

  <% if @config_type == 'site' %>
    <%= render 'shared/config_editor',
               form_url: admin_site_config_path,
               config_content: @config_content,
               config_hash: @config_hash,
               flattened_config: @flattened_config,
               config_schema: @config_schema,
               available_themes: @available_themes %>
  <% elsif @config_type == 'content' %>
    <%= render 'shared/config_editor',
               form_url: admin_content_config_path,
               config_content: @config_content,
               config_hash: @config_hash,
               config_schema: @config_schema,
               available_themes: [] %>
  <% elsif @config_type == 'security' %>
    <%= render 'shared/config_editor',
               form_url: admin_update_security_config_path,
               config_content: @config_content,
               config_hash: @config_hash,
               config_schema: @config_schema,
               available_themes: [] %>
  <% elsif @config_type == 'fonts' %>
    <%= render 'shared/config_editor',
              form_url: admin_fonts_config_path,
              config_content: @config_content,
              config_hash: @config_hash,
              config_schema: @config_schema,
              available_themes: @available_themes %>
  <% elsif @config_type == 'cards' %>
    <%= render 'shared/config_editor',
               form_url: admin_cards_config_path,
               config_content: @config_content,
               config_hash: @config_hash %>
  <% elsif @config_type == 'collections' %>
    <%= render 'shared/config_editor',
               form_url: admin_collections_config_path,
               config_content: @config_content,
               config_hash: @config_hash,
               extra_field_defaults: @extra_field_defaults %>
  <% elsif @config_type == 'members' %>
    <%= render 'shared/config_editor',
               form_url: admin_members_config_path,
               config_content: @config_content,
               config_hash: @config_hash,
               section_labels: { "everyone" => "Paid Content" } %>
    <div class="px-8 py-4 bg-red-50 border-t border-red-200">
      <h4 class="text-sm font-semibold text-red-900 mb-2">Danger Zone</h4>
      <p class="text-xs text-red-700 mb-3">Deleting this will remove all member-related configuration (payments, newsletter, audience settings).<br>Your member pages and integration keys are untouched.</p>
      <%= button_to "Disable Members | Delete Config",
                  delete_members_admin_configs_path,
                  method: :delete,
                  data: {
                    turbo_confirm: "Are you sure? This will permanently delete your members configuration."
                  },
                  class: "uppercase text-xs px-2 py-1.5 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>
    </div>
  <% elsif @config_type == 'podcast' %>
    <div class="px-8 py-4 bg-blue-50 border-b border-blue-200">
      <h4 class="text-sm font-semibold text-blue-900 mb-2">Seed from an RSS feed or Apple Podcasts link</h4>
      <p class="text-xs text-blue-800 mb-3">
        Paste a podcast RSS feed URL (public or private/paid), or an Apple Podcasts link — Roe resolves it to the feed and also fills in the Apple Podcasts and Overcast subscribe links. Either way it auto-fills a podcast.yml entry from the feed's iTunes metadata, and the artwork is downloaded too. The URL is not stored or logged — only the parsed metadata is used. <mark class="bg-white px-0.5 py-0.5 text-amber-700">Running this twice overwrites the existing iTunes metadata</mark> (your subscribe links are kept).
      </p>
      <%= form_with url: admin_seed_podcast_config_from_rss_path, method: :post, local: true, class: "flex gap-2" do %>
        <%= text_field_tag :rss_url, nil,
                           class: "flex-1 font-mono text-xs p-2 border border-blue-300",
                           placeholder: "RSS feed URL, or https://podcasts.apple.com/…/id123456789",
                           autocomplete: "off" %>
        <%= submit_tag "Seed",
                       class: "uppercase text-xs px-3 py-2 border border-blue-700 bg-blue-200 hover:bg-blue-300 text-blue-900 font-mono rounded-xs" %>
      <% end %>
    </div>

    <%= render 'shared/config_editor',
               form_url: admin_podcast_config_path,
               config_content: @config_content,
               config_hash: @config_hash,
               field_options: @field_options %>
               <div class="px-8 py-4 bg-red-50 border-t border-red-200">
                 <h4 class="text-sm font-semibold text-red-900 mb-2">Danger Zone</h4>
                 <%# Per-podcast removal — deletes just that entry from
                     podcast.yml. Published episodes are always kept; when the
                     show has draft episodes, offer to delete those too. %>
                 <% @config_hash.each do |pkey, pval| %>
                   <% next unless pval.is_a?(Hash) %>
                   <% ptitle = pval['title'].to_s.strip.presence || pkey %>
                   <% drafts = @draft_episode_counts[pkey].to_i %>
                   <div class="mb-3">
                     <% if drafts.positive? %>
                       <p class="text-xs text-red-800 mb-1">
                         <%= pluralize(drafts, "draft episode") %> belong to “<%= ptitle %>.” Published episodes are always kept — remove those from Posts by hand.
                       </p>
                       <div class="flex flex-wrap gap-2">
                         <%= button_to "Delete “#{ptitle}” + #{pluralize(drafts, 'draft')}",
                                       delete_podcast_entry_admin_configs_path(key: pkey, delete_drafts: 1),
                                       method: :delete,
                                       data: { turbo_confirm: "Permanently delete “#{ptitle}” and its #{pluralize(drafts, 'draft episode')}? This can't be undone — but you can re-import them. Published episodes are kept." },
                                       class: "uppercase text-xs px-2 py-1.5 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>
                         <%= button_to "Delete “#{ptitle}” only",
                                       delete_podcast_entry_admin_configs_path(key: pkey),
                                       method: :delete,
                                       data: { turbo_confirm: "Remove “#{ptitle}” from podcast.yml? Its #{pluralize(drafts, 'draft episode')} and any published episodes are kept." },
                                       class: "uppercase text-xs px-2 py-1.5 border border-red-400 bg-red-50 hover:bg-red-100 text-red-700 font-mono rounded-xs" %>
                       </div>
                     <% else %>
                       <%= button_to "Delete “#{ptitle}”",
                                     delete_podcast_entry_admin_configs_path(key: pkey),
                                     method: :delete,
                                     data: { turbo_confirm: "Remove the “#{ptitle}” podcast from podcast.yml? Published episodes are kept — remove those from Posts by hand if needed." },
                                     class: "uppercase text-xs px-2 py-1.5 border border-red-500 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>
                     <% end %>
                   </div>
                 <% end %>
                 <p class="text-xs text-red-700 mt-3 mb-3">Or remove everything — deletes all configuration and feeds for all podcasts.<br>Any podcast posts are untouched.</p>
                 <%= button_to "Disable Podcasts | Delete Config",
                            delete_podcast_admin_configs_path,
                             method: :delete,
                             data: {
                               turbo_confirm: "Are you sure? This will permanently delete your podcast configuration and remove all podcast feeds."
                             },
                             class: "uppercase text-xs px-2 py-1.5 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>
              </div>
  <% elsif @config_type == 'store' %>
    <%= render 'shared/config_editor',
                form_url: admin_store_config_path,
                config_content: @config_content,
                config_hash: @config_hash %>
    <div class="px-8 py-4 bg-red-50 border-t border-red-200">
      <h4 class="text-sm font-semibold text-red-900 mb-2">Danger Zone</h4>
      <p class="text-xs text-red-700 mb-3">Deleting this will remove all store configuration.</p>
      <%= button_to "Delete Store",
                  delete_store_admin_configs_path,
                  method: :delete,
                  data: {
                    turbo_confirm: "Are you sure? This will permanently delete your store configuration."
                  },
                  class: "uppercase text-xs px-2 py-1.5 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>
    </div>
  <% end %>
</div>
