<%# One field of the Music settings form, drawn from MusicConfigSchema.
    Locals:
      field       — a schema entry ({key:, label:, kind:, required:, ...})
      name        — the form param name
      value       — current value
      image_paths — every image under site/media/, for the :image typeahead
%>
<%
  field       = local_assigns[:field]
  name        = local_assigns[:name]
  value       = local_assigns[:value].to_s
  image_paths = local_assigns[:image_paths] || []
  input_class = "w-full font-mono text-sm p-2 border border-gray-300"
%>
<div class="config-field-row">
  <%# A checkbox carries its own label beside the box, so it doesn't get one above. %>
  <% unless field[:kind] == :checkbox %>
    <label class="block text-sm font-medium text-gray-700 mb-1">
      <%= field[:label] %><% if field[:required] %><span class="text-red-600 ml-0.5">*</span><% end %>
    </label>
  <% end %>

  <% case field[:kind] %>
  <% when :checkbox %>
    <%# The hidden field means an unticked box still posts, so unticking it
        actually turns the setting off rather than leaving the old value. %>
    <input type="hidden" name="<%= name %>" value="false">
    <label class="flex items-start gap-2 cursor-pointer">
      <input type="checkbox"
             name="<%= name %>"
             value="true"
             <%= "checked" if ReleaseConfig.truthy?(value) %>
             class="mt-0.5">
      <span class="text-sm text-gray-700"><%= field[:label] %></span>
    </label>

  <% when :select %>
    <select name="<%= name %>" class="<%= input_class %> appearance-none">
      <% field[:options].each do |option| %>
        <option value="<%= option %>"<%= " selected" if value == option.to_s %>>
          <%= option.blank? ? "-- use the default --" : option %>
        </option>
      <% end %>
    </select>

  <% when :image %>
    <%# Same widget the post editor uses for image: — a typeahead over every
        image in the media library, plus an existence warning on blur, so a
        path that doesn't resolve shows up here rather than as missing
        artwork on the page. %>
    <div class="flex flex-col gap-1 <%= "relative" if image_paths.any? %>"
         data-controller="media-field<%= " autocomplete" if image_paths.any? %>"
         data-media-field-kind-value="image"
         <% if image_paths.any? %>data-autocomplete-options-value="<%= ERB::Util.html_escape(image_paths.to_json) %>"<% end %>>
      <input type="text"
             name="<%= name %>"
             value="<%= value %>"
             placeholder="<%= field[:placeholder] %>"
             <% if image_paths.any? %>autocomplete="off"<% end %>
             class="<%= input_class %>"
             data-media-field-target="input"
             <% if image_paths.any? %>data-autocomplete-target="input"<% end %>
             data-action="input->media-field#checkDebounced<%= " input->autocomplete#filter keydown->autocomplete#navigate" if image_paths.any? %> blur->media-field#check change->media-field#check">
      <% if image_paths.any? %>
        <div data-autocomplete-target="dropdown"
             class="hidden absolute top-full left-0 right-0 mt-1 bg-white border border-gray-800 shadow-lg z-50 max-h-48 overflow-y-auto"></div>
      <% end %>
      <%# media-field only toggles `hidden` — the message has to be in the markup. %>
      <p class="hidden text-xs text-red-600" data-media-field-target="warning">
        ⚠ File not found under <code>site/media/</code>.
      </p>
    </div>

  <% else %>
    <input type="text"
           name="<%= name %>"
           value="<%= value %>"
           placeholder="<%= field[:placeholder] %>"
           class="<%= input_class %>">
  <% end %>

  <% if field[:hint].present? %>
    <p class="text-xs text-gray-500 mt-1"><%= field[:hint] %></p>
  <% end %>
</div>
