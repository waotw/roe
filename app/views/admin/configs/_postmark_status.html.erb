<%# COPY — Postmark status checklist. Shown at the top of the Email (Postmark)
    settings page in place of the generic "Connected" box, because email needs
    several things right (token, sender confirmed, DKIM, webhook), not one. Each
    row is a PostmarkStatus::Item with a state that picks its colour/icon.
    Placeholder copy — rewrite before commit. %>
<% items = PostmarkStatus.for(@postmark_config) %>
<%
  icon = ->(state) do
    case state
    when :ok      then %(<span class="text-green-700">✓</span>)
    when :todo    then %(<span class="text-amber-700">•</span>)
    when :warn    then %(<span class="text-red-700">✕</span>)
    when :unknown then %(<span class="text-gray-400">…</span>)
    else               %(<span class="text-gray-400">·</span>)
    end.html_safe
  end
  label_class = ->(state) do
    { ok: "text-gray-900", todo: "text-amber-900", warn: "text-red-900",
      unknown: "text-gray-500", info: "text-gray-700" }[state] || "text-gray-700"
  end
%>

<div class="config-section mb-6 p-4 border border-gray-200 bg-gray-50">
  <h3 class="text-base font-semibold text-gray-900 mb-3">Integration status</h3>
  <ul class="space-y-2">
    <% items.each do |item| %>
      <li class="flex items-start gap-2 text-sm">
        <span class="mt-0.5 w-4 text-center font-mono"><%= icon.call(item.state) %></span>
        <span>
          <span class="font-medium <%= label_class.call(item.state) %>"><%= item.label %></span>
          <% if item.detail.present? %>
            <span class="text-gray-500"> — <%= item.detail %></span>
          <% end %>

          <%# On-demand webhook proof (production). The status service flags the
              "registered but not yet proven" row with action :offer_webhook_test
              — show a button to send the test event, plus a poller that flips
              the row to ✓ when Postmark's callback lands. %>
          <% if item.action == :offer_webhook_test %>
            <div class="mt-1" data-controller="postmark-webhook-test"
                 data-postmark-webhook-test-status-url-value="<%= admin_postmark_webhook_status_config_path %>">
              <%= button_to "Send a test event", admin_postmark_send_test_event_config_path,
                    method: :post,
                    class: "uppercase text-xs px-2 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs cursor-pointer" %>
              <p class="text-xs mt-1" data-postmark-webhook-test-target="result"
                 data-pending="<%= @postmark_config.webhook_probe_message_id.present? %>">
                <% if @postmark_config.webhook_probe_message_id.present? %>
                  <span class="text-gray-500">Waiting for Postmark's delivery callback…</span>
                <% end %>
              </p>
            </div>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>
</div>
