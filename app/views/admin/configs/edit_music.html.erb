<%# Music settings. The structured form is the primary editor; the YAML
    toggle below it is the escape hatch, and posts to the same action —
    update_music prefers `content` when it's present. %>
<% content_for :editor_js, false %>
<div class="px-4 sm:px-0" data-controller="music-releases">
  <div class="flex items-baseline justify-between mb-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Music</h1>
      <p class="mt-1 text-sm text-gray-700">
        A release is a group of tracks. A track is a post with
        <span class="font-mono text-sm bg-gray-200 px-1 py-0.5">post_type: music</span> and connects to a release in it's metadata.
      </p>
    </div>
    <%= link_to "← BACK TO SETTINGS", admin_configs_path, class: "inline-flex items-center uppercase text-sm mb-2 px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none text-nowrap" %>
  </div>

  <div class="mb-5 bg-white p-8 border border-gray-200">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-gray-900">Releases</h2>
      <button type="button"
              data-action="music-releases#toggleYaml"
              data-music-releases-target="yamlToggle"
              class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono h-4.5 rounded-xs leading-none pt-[0.1rem]">
        EDIT YAML
      </button>
    </div>

    <div data-music-releases-target="formView">
      <%= form_with url: admin_music_config_path, method: :patch, class: "space-y-8" do %>
        <div class="config-section">
          <h3 class="text-base font-semibold text-gray-800 mb-1">Defaults</h3>
          <p class="text-xs text-gray-500 mb-4">Applied to every release that doesn't set its own.</p>
          <div class="space-y-3 pl-4 border-l-2 border-gray-200">
            <% MusicConfigSchema.global_fields.each do |field| %>
              <%= render "admin/configs/music_field",
                         field: field,
                         name: "music_globals[#{field[:key]}]",
                         value: @config_hash[field[:key]],
                         image_paths: @image_paths %>
            <% end %>
          </div>
        </div>

        <div class="config-section">
          <div class="flex items-center gap-3 mb-4">
            <h3 class="text-base font-semibold text-gray-800">Your releases</h3>
            <button type="button"
                    data-action="music-releases#addRelease"
                    class="uppercase text-xs px-1.5 py-0.5 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs leading-none cursor-pointer">
              + New Release
            </button>
            <span class="text-xs text-gray-500">Added releases are saved when you click Save Music.</span>
          </div>

          <p class="text-sm text-gray-500 pl-4 border-l-2 border-gray-200 py-3 <%= "hidden" if @releases.any? %>"
             data-music-releases-target="empty">
            No releases yet. <span class="font-mono">+ New Release</span> adds one.
          </p>

          <div class="space-y-8" data-music-releases-target="list">
            <% @releases.each_with_index do |(key, release), index| %>
              <%= render "admin/configs/music_release",
                         index: index,
                         key: key,
                         release: release,
                         image_paths: @image_paths,
                         removable: key != ReleaseConfig::DEFAULT_RELEASE %>
            <% end %>
          </div>

          <%# The blank row the + New Release button clones. Inside <template>
              so its inputs are inert — a browser doesn't submit them, and
              __INDEX__ never reaches the server. %>
          <template data-music-releases-target="template">
            <%= render "admin/configs/music_release",
                       index: "__INDEX__",
                       key: "",
                       release: MusicConfigSchema.blank_release,
                       image_paths: @image_paths,
                       removable: true %>
          </template>
        </div>

        <div class="flex items-center gap-3 p-4 border border-gray-400 fixed bottom-8 right-12 bg-white">
          <%= submit_tag "Save Music",
              class: "inline-flex items-center uppercase text-sm px-2 py-1 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer" %>
          <%= link_to "Cancel", admin_configs_path,
              class: "inline-flex items-center uppercase text-sm px-2 py-1 border border-gray-800 bg-white hover:bg-gray-100 font-mono rounded-xs" %>
        </div>
      <% end %>
    </div>

    <div data-music-releases-target="yamlView" class="hidden">
      <p class="text-xs text-gray-600 mb-3">
        <span class="font-mono">features/music.yml</span> — releases live under a
        <span class="font-mono">releases:</span> key. Anything the form doesn't cover can go here.
      </p>
      <%= form_with url: admin_music_config_path, method: :patch do |f| %>
        <%= f.text_area :content, value: @config_content,
            class: "w-full bg-white font-mono text-sm p-2 border border-gray-300 box-border h-[420px]" %>
        <div class="mt-3 flex gap-2">
          <%= f.submit "Save YAML",
              class: "inline-flex items-center uppercase text-sm px-2 py-1 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer" %>
          <%= link_to "Cancel", admin_configs_path,
              class: "inline-flex items-center uppercase text-sm px-2 py-1 border border-gray-800 bg-white hover:bg-gray-100 font-mono rounded-xs" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
