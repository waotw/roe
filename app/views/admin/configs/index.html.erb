<div class="px-4 sm:px-0">
  <div class="">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Configuration Files</h1>
      <p class="mt-2 mb-4 text-sm text-gray-700">Edit YAML configuration files for your site.</p>
    </div>

    <div class="flex gap-2">
      <% unless File.exist?(File.join(RoeSitePaths::SITE_PATH, 'system', 'features', 'members.yml')) %>
        <%= link_to "Enable Members",
                    new_members_setup_admin_configs_path,
                    class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>
      <% end %>

      <% unless File.exist?(File.join(RoeSitePaths::SITE_PATH, 'system', 'features', 'podcast.yml')) %>
        <%= button_to "Enable Podcasts",
                      generate_podcast_admin_configs_path,
                      method: :post,
                      class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
      <% end %>
      <% unless File.exist?(File.join(RoeSitePaths::SITE_PATH, 'system', 'features', 'store.yml')) %>
        <%= link_to "Enable Store",
                    new_store_setup_admin_configs_path,
                    class: "inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-gray-800 bg-purple-200 hover:bg-purple-300 font-mono rounded-xs" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8 space-y-8">
    <% @config_files.each do |section| %>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-1 flex items-center"> <?xml version="1.0" encoding="UTF-8"?>
        <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 17.8711 14.2676" class="max-h-4 mr-2">
         <g>
          <rect height="14.2676" opacity="0" width="17.8711" x="0" y="0"/>
          <path d="M2.49023 14.1602L15.3027 14.1602C16.6895 14.1602 17.5098 13.3398 17.5098 11.6992L17.5098 3.84766C17.5098 2.20703 16.6797 1.39648 15.0195 1.39648L7.70508 1.39648C7.22656 1.39648 6.91406 1.25977 6.54297 0.957031L6.05469 0.566406C5.54688 0.146484 5.12695 0 4.38477 0L2.19727 0C0.820312 0 0 0.800781 0 2.43164L0 11.6992C0 13.3398 0.830078 14.1602 2.49023 14.1602ZM2.50977 12.7441C1.80664 12.7441 1.40625 12.373 1.40625 11.6309L1.40625 2.5C1.40625 1.77734 1.79688 1.40625 2.5 1.40625L4.01367 1.40625C4.49219 1.40625 4.80469 1.54297 5.17578 1.8457L5.66406 2.23633C6.16211 2.64648 6.5918 2.80273 7.33398 2.80273L15 2.80273C15.7031 2.80273 16.1035 3.18359 16.1035 3.92578L16.1035 11.6406C16.1035 12.373 15.7031 12.7441 15 12.7441ZM0.859375 5.58594L16.6406 5.58594L16.6406 4.26758L0.859375 4.26758Z" fill="black" fill-opacity="0.85"/>
         </g>
        </svg>
 <%= section[:section] %></h2>
        <% if section[:description] %>
          <p class="text-sm text-gray-500 mb-3"><%= section[:description] %></p>
        <% end %>
        <table class="min-w-full divide-y divide-gray-300">
          <tbody class="divide-y border border-gray-200 divide-gray-200 bg-white">
            <% section[:files].each do |file| %>
              <tr>
                <td class="py-4 pl-4 pr-3 text-sm font-medium text-gray-900 font-mono">
                  <%= link_to file[:name], file[:edit_path], class: "text-blue-600 hover:text-blue-900 block mb-0.5" %>
                  <span class="text-xs text-gray-400"><%= file[:description] %></span>
                </td>
                <td class="py-4 pl-3 pr-4 text-right text-sm">
                  <%= link_to "Edit", file[:edit_path], class: "text-blue-600 hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
