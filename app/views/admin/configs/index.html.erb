<div class="px-4 sm:px-0">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Configuration Files</h1>
      <p class="mt-2 text-sm text-gray-700">Edit YAML configuration files for your site.</p>
    </div>

    <div class="flex gap-2">
      <% unless File.exist?(Rails.root.join('site', 'system', 'defaults', 'members.yml')) %>
        <%= link_to "Enable Members",
                    new_members_setup_admin_configs_path,
                    class: "inline-flex items-center uppercase text-sm px-2 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs" %>
      <% end %>

      <% unless File.exist?(Rails.root.join('site', 'system', 'defaults', 'podcast.yml')) %>
        <%= button_to "Enable Podcasts",
                      generate_podcast_admin_configs_path,
                      method: :post,
                      class: "inline-flex items-center uppercase text-sm px-2 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
      <% end %>
    </div>
  </div>

  <div class="mt-8 space-y-8">
    <% @config_files.each do |section| %>
      <div>
        <h2 class="text-lg font-semibold text-gray-900 mb-3"><%= section[:section] %></h2>
        <table class="min-w-full divide-y divide-gray-300">
          <tbody class="divide-y divide-gray-200 bg-white">
            <% section[:files].each do |file| %>
              <tr>
                <td class="py-4 pl-4 pr-3 text-sm font-medium text-gray-900 font-mono">
                  <%= link_to file[:name], file[:path], class: "text-blue-600 hover:text-blue-900 block mb-0.5" %>
                  <span class="text-xs text-gray-400"><%= file[:description] %></span>
                </td>
                <td class="py-4 pl-3 pr-4 text-right text-sm">
                  <%= link_to "Edit", file[:path], class: "text-blue-600 hover:text-blue-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
