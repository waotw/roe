<%# Shown by the config-guard controller before an action that reloads the
    page. Click to confirm — no typing. The delete buttons keep their own
    turbo_confirm as well; this one is only about losing what you typed. %>
<div data-config-guard-target="modal"
     data-action="click->config-guard#backdrop"
     class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
  <div class="bg-white p-6 shadow-xl max-w-md w-full mx-4">
    <h3 class="text-lg font-bold text-gray-900 mb-2">Unsaved changes</h3>
    <p class="text-sm text-gray-600 mb-4" data-config-guard-target="message">
      This reloads the page, so anything you've typed and not saved will be lost.
    </p>
    <div class="flex gap-3 justify-end">
      <button type="button"
              data-action="click->config-guard#cancel"
              class="px-4 py-2 border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 cursor-pointer">
        Go back
      </button>
      <button type="button"
              data-action="click->config-guard#confirm"
              class="px-4 py-2 border border-transparent text-sm font-medium text-white bg-red-600 hover:bg-red-700 cursor-pointer">
        Continue without saving
      </button>
    </div>
  </div>
</div>
