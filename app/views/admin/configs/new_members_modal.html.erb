<div class="px-4 sm:px-0 max-w-2xl mx-auto mt-12">
  <div class="bg-white border-2 border-gray-900 p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-4">Enable Members Feature</h1>

    <div class="mb-6">
      <p class="text-gray-700 mb-4">
        Once enabled, you'll see extra settings in the upper right of the Admin ↗ where you can set up Postmark for newsletters, Payments with Stripe and manage Members.
      </p>
      <div class="bg-blue-50 border border-blue-300 p-4">
        <p class="text-sm text-gray-700 leading-7">
          <strong>Note:</strong> You can change these settings anytime at: <br>
          <code class="bg-white px-2 py-1 text-xs font-mono border border-gray-300">Settings → Defaults → members.yml </code>
        </p>
      </div>
    </div>

    <%= form_with url: create_members_admin_configs_path, method: :post, class: "space-y-6" do |f| %>

      <!-- Payments -->
      <div class="bg-gray-50 border border-gray-300 p-6">
        <h3 class="font-semibold text-gray-900 mb-3">Paid Memberships</h3>

        <p class="text-sm text-gray-700 mb-4">
          Enable one-time payments via Stripe (requires Stripe connection)
        </p>

        <div class="space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :payments_enabled, 'false', checked: true, class: "mt-1", data: { action: "change->admin-config#togglePaymentPrice" } %>
            <div>
              <div class="font-medium text-gray-900">Disabled</div>
              <div class="text-sm text-gray-600">Free members only</div>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :payments_enabled, 'true', class: "mt-1", data: { action: "change->admin-config#togglePaymentPrice" } %>
            <div>
              <div class="font-medium text-gray-900">Enabled</div>
              <div class="text-sm text-gray-600">Allow users to become paid members</div>
            </div>
          </label>
        </div>

        <div id="payment-price-field" class="mt-4">
          <label class="block">
            <span class="text-sm font-medium text-gray-900">Price (one-time payment)</span>
            <div class="mt-1 flex items-center gap-2">
              <span class="text-gray-700">$</span>
              <%= f.text_field :payment_price,
                  value: "0.00",
                  placeholder: "0.00",
                  class: "w-32 px-3 py-2 border border-gray-300 rounded text-sm font-mono" %>
              <span class="text-sm text-gray-600">USD</span>
            </div>
            <p class="text-xs text-gray-500 mt-1">Enter amount in dollars (e.g., 49.00)</p>
          </label>
        </div>
      </div>

      <!-- Newsletter -->
      <div class="bg-gray-50 border border-gray-300 p-6">
        <h3 class="font-semibold text-gray-900 mb-3">Newsletter</h3>

        <p class="text-sm text-gray-700 mb-4">
          Send newsletters to members via Postmark (requires Postmark configuration)
        </p>

        <div class="space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :newsletter_enabled, 'false', checked: true, class: "mt-1" %>
            <div>
              <div class="font-medium text-gray-900">Disabled</div>
              <div class="text-sm text-gray-600">No newsletter sending</div>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :newsletter_enabled, 'true', class: "mt-1" %>
            <div>
              <div class="font-medium text-gray-900">Enabled</div>
              <div class="text-sm text-gray-600">Send newsletters when publishing posts</div>
            </div>
          </label>
        </div>
      </div>

      <!-- Paid Content Visibility -->
      <div class="bg-gray-50 border border-gray-300 p-6">
        <h3 class="font-semibold text-gray-900 mb-3">Paid Content Visibility</h3>

        <p class="text-sm text-gray-700 mb-4">
          Should everyone see paid content in collections and feeds?
        </p>

        <div class="space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :show_paid_content, 'true', checked: true, class: "mt-1" %>
            <div>
              <div class="font-medium text-gray-900">Show to everyone</div>
              <div class="text-sm text-gray-600">
                Show visitors and free members what they're missing with a
                <span class="inline-block w-4 h-4 align-text-bottom">
                  <svg viewBox="0 0 16 16" fill="currentColor">
                    <path d="M7.88 15.76c4.36 0 7.89-3.53 7.89-7.88 0-4.36-3.53-7.88-7.89-7.88C3.54 0 0 3.52 0 7.88c0 4.35 3.54 7.88 7.88 7.88zm0-1.48c-3.54 0-6.39-2.86-6.39-6.4 0-3.54 2.85-6.4 6.39-6.4 3.54 0 6.4 2.86 6.4 6.4 0 3.54-2.86 6.4-6.4 6.4z"/>
                    <path d="M5.12 10.89c0 .56.24.82.77.82h3.97c.52 0 .77-.26.77-.82V7.87c0-.51-.22-.77-.64-.81v-.86c0-1.45-.85-2.42-2.12-2.42-1.26 0-2.12.97-2.12 2.42v.86c-.42.04-.64.3-.64.82zm1.52-3.84V6.1c0-.88.49-1.46 1.23-1.46s1.24.58 1.24 1.46v.95z"/>
                  </svg>
                </span>
                indicator.
              </div>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :show_paid_content, 'false', class: "mt-1" %>
            <div>
              <div class="font-medium text-gray-900">Hide from non-paying users</div>
              <div class="text-sm text-gray-600">
                Don't show visitors and free members what they're missing. Only paid members see paid posts/pages.
              </div>
            </div>
          </label>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <%= f.submit "Enable Members",
            class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer" %>
        <%= link_to "Cancel", admin_configs_path,
            class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-white hover:bg-gray-100 font-mono rounded-xs" %>
      </div>
    <% end %>
  </div>
</div>
