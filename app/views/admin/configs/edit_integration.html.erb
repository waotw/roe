<%
  # Determine the integration record and verify path based on config type
  integration_record = case @config_type
    when 'payments'    then @stripe_config
    when 'newsletters' then @postmark_config
    when 'snipcart'    then @snipcart_config
  end

  verify_path = case @config_type
    when 'payments'    then admin_verify_payments_config_path
    when 'newsletters' then admin_verify_newsletters_config_path
    when 'snipcart'    then admin_verify_snipcart_integration_config_path
  end

  update_path = case @config_type
    when 'payments'    then admin_payments_config_path
    when 'newsletters' then admin_newsletters_config_path
    when 'snipcart'    then admin_snipcart_integration_config_path
  end

  live_update_path = case @config_type
    when 'payments'    then admin_live_payments_config_path
    when 'newsletters' then admin_live_newsletters_config_path
    when 'snipcart'    then admin_live_snipcart_integration_config_path
  end

  mode_update_path = case @config_type
    when 'payments'    then admin_mode_payments_config_path
    when 'newsletters' then admin_mode_newsletters_config_path
    when 'snipcart'    then admin_mode_snipcart_integration_config_path
  end

  disconnect_path = case @config_type
    when 'payments'    then admin_disconnect_payments_config_path
    when 'newsletters' then admin_disconnect_newsletters_config_path
    when 'snipcart'    then admin_disconnect_snipcart_integration_config_path
  end

  title = case @config_type
    when 'payments'    then 'Payments (Stripe)'
    when 'newsletters' then 'Email (Postmark)'
    when 'snipcart'    then 'Store (Snipcart)'
  end

  is_production = Rails.env.production?
  has_mode      = integration_record&.respond_to?(:mode)
  live_ready    = integration_record&.respond_to?(:live_mode_ready?) && integration_record.live_mode_ready?

  # Snipcart has no secret keys and its live snippet runs locally + on the
  # static build, so its mode is selectable in every environment. Stripe and
  # Postmark keep live mode production-only (real secrets / real charges).
  mode_selectable = has_mode && (is_production || @config_type == "snipcart")
%>

<div class="max-w-3xl mx-auto p-8 bg-white">
  <div class="mb-6 flex justify-between items-center">
    <div>
      <h2 class="text-xl font-semibold text-gray-900 mb-2"><%= title %></h2>
      <p class="text-sm text-gray-600">Configure API keys for <%= title %>.</p>
    </div>
    <div>
      <%= link_to "← Back to Settings", admin_configs_path,
          class: "uppercase text-sm px-3 py-2 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
    </div>
  </div>

  <%# Decryption-failure banner. Surfaces when the integration record
      holds encrypted ciphertext that can't be decrypted with the
      current master key — usually because keys were rotated or
      because the dev DB is being opened with RAILS_ENV=production.
      The page no longer 500s in this state, but the integration is
      effectively disconnected until the operator re-saves the
      affected fields, so we make that explicit. %>
  <% if integration_record&.respond_to?(:decryption_failed?) && integration_record.decryption_failed? %>
    <div class="p-4 mb-4 border border-amber-300 bg-amber-50">
      <h3 class="text-sm font-semibold text-amber-900 mb-1">
        ⚠ Some keys couldn't be decrypted
      </h3>
      <p class="text-sm text-amber-800">
        The following fields hold ciphertext that doesn't match the current
        master key:
        <code class="font-mono text-xs"><%= integration_record.decryption_errors.to_a.join(', ') %></code>.
        This usually means master credentials were rotated. Re-enter the
        affected keys below to repair the integration.
      </p>
    </div>
  <% end %>

  <%# Connection status — async Stimulus verify %>
  <div class="p-4 border border-gray-200 bg-gray-50 mb-6"
       data-controller="integration-verify"
       data-integration-verify-url-value="<%= verify_path %>"
       data-integration-verify-verified-value="<%= integration_record&.connected? %>"
       data-integration-verify-verified-at-value="<%= integration_record&.verified_at&.iso8601 %>">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span data-integration-verify-target="status"></span>
        <% if integration_record&.respond_to?(:mode) %>
          <span class="text-xs text-gray-500 font-mono text-nowrap">
            Mode: <%= integration_record.mode_test? ? 'Test' : 'Live' %>
          </span>
        <% end %>
      </div>
      <span data-integration-verify-target="timestamp" class="text-xs text-gray-400 font-mono"></span>
    </div>
  </div>

  <%# Active mode. Sits above the tabs because it's a global state for the
      integration, not specific to test/live input. Live radio is disabled
      until live keys are saved. Production-only for Stripe/Postmark; always
      available for Snipcart (public snippet, runs live locally + on static). %>
  <% if mode_selectable %>
    <%# What "live" costs differs per integration, so say the real thing.
        "no real charges" on the Postmark page described Stripe's stakes on a
        screen that never takes a payment. %>
    <%
      test_consequence, live_consequence = case @config_type
        when 'newsletters' then [ "no email delivered", "real email sent!" ]
        else                    [ "no real charges",    "real charges!"    ]
      end
    %>
    <div class="config-section mb-6 p-4 border border-gray-200 bg-gray-50">
      <h3 class="text-base font-semibold text-gray-900 mb-3">Active Mode</h3>
      <p class="text-xs text-gray-500 mt-1">Here you change which mode you are in.<br>This allows you to use Test Mode on the live site before switching to Live Mode.</p>
      <%= form_with url: mode_update_path, method: :patch, class: "flex items-center gap-6" do |f| %>
        <label class="flex items-center gap-2">
          <%= f.radio_button :mode, "test", checked: integration_record.mode_test?, class: "form-radio" %>
          <span class="text-sm">Test Mode (<%= test_consequence %>)</span>
        </label>
        <label class="flex items-center gap-2">
          <%= f.radio_button :mode, "live", checked: integration_record.mode_live?, disabled: !live_ready, class: "form-radio" %>
          <span class="text-sm <%= live_ready ? 'font-semibold text-red-600' : 'text-gray-400' %>">
            Live Mode <%= live_ready ? "(#{live_consequence})" : '(add live keys to enable)' %>
          </span>
        </label>
        <%= f.submit "Update Mode",
                    class: "uppercase text-sm px-3 py-2 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs cursor-pointer ml-auto" %>
      <% end %>
    </div>
  <% end %>

  <%# Webhook endpoint. Postmark embeds a per-install token in the path
      and verifies it server-side (webhooks/postmark_controller.rb).
      Stripe uses one URL and authenticates via signing_secret. Snipcart
      isn't webhook-driven in Roe so we skip the section.
      The URL is computed via WebhookUrlHelper — production uses the
      live site domain, dev uses dev_host (or the first public-looking
      allowed_hosts entry as a fallback), dev without either renders
      the disabled-state UI below. %>
  <%
    webhook_path = case @config_type
      when 'payments'
        "/webhooks/stripe"
      when 'newsletters'
        token = integration_record&.respond_to?(:webhook_token) ? integration_record.webhook_token : nil
        token.present? ? "/webhooks/postmark/#{token}" : nil
      end
    resolved_webhook_url = webhook_path ? webhook_url(webhook_path) : nil
  %>
  <% if webhook_path %>
    <% if resolved_webhook_url %>
      <div class="config-section mb-6 p-4 border border-gray-200 bg-gray-50">
        <h3 class="text-base font-semibold text-gray-900 mb-2">Webhook URL</h3>
        <p class="text-sm text-gray-600 mb-3">
          <% if @config_type == 'newsletters' %>
            Add this as your Webhook URL in your Postmark Server's Webhook settings so delivery
            events (opens, clicks, bounces) reach Roe. The token at the end is unique
            to this install — keep it secret. <span class="text-amber-600">You can regenerate a new token in the Danger Zone below.</span>
          <% elsif @config_type == 'payments' %>
            Add this URL as a webhook endpoint in your Stripe dashboard. Stripe will
            give you a signing secret in return — paste that into the
            <em>Webhook Signing Secret</em> field in the appropriate tab below.
            Test and Live modes use the same URL but separate domains / signing secrets.
          <% end %>
        </p>
        <input type="text"
               value="<%= resolved_webhook_url %>"
               readonly
               onclick="this.select()"
               class="w-full font-mono text-xs p-2 border border-gray-300 bg-white">
      </div>
    <% else %>
      <div class="config-section mb-6 p-4 border border-amber-200 bg-amber-50">
        <h3 class="text-base font-semibold text-gray-900 mb-2">Webhook URL — not available in development</h3>
        <p class="text-sm text-gray-700 mb-2">
          Webhooks from <%= @config_type == 'payments' ? 'Stripe' : 'Postmark' %> can't reach
          <code class="font-mono text-xs bg-amber-100 px-0.5">localhost</code> from the public
          internet, so this URL is disabled in development by default. Two options:
        </p>
        <ul class="text-sm text-gray-700 list-disc pl-5 space-y-1 mb-2">
          <li>
            Set up an HTTPS tunnel (ngrok, cloudflared, etc.) and add its host either as the
            first entry under <code class="font-mono text-xs bg-amber-100 px-0.5">allowed_hosts:</code>
            or explicitly as <code class="font-mono text-xs bg-amber-100 px-0.5">dev_host:</code> in your
            <%= link_to "development.yml", admin_edit_development_config_path, class: "underline" %>.
            The webhook URL will switch to that host automatically.
          </li>
          <li>
            Skip local webhook testing and verify after deploying — production uses your live
            site domain automatically, no extra config needed.
          </li>
        </ul>
      </div>
    <% end %>
  <% end %>

  <%# Tabs — the controller wraps BOTH the nav and the panels below so
      Stimulus target lookups (this.panelTargets) actually find them.
      Without this wrapping, panelTargets is empty and clicking Live
      only restyles the buttons; the visible form never changes. %>
  <% if @config_type == "snipcart" %>
    <%= render "admin/configs/snipcart_tabs",
               update_path: update_path,
               live_update_path: live_update_path,
               record: integration_record %>
  <% else %>
  <div data-controller="tabs" data-tabs-default-value="<%= integration_record&.mode %>">
    <div class="border-b border-gray-200 mb-6">
      <nav class="flex gap-4">
        <button type="button"
                data-tabs-target="tab"
                data-action="click->tabs#show"
                data-tabs-panel="test"
                class="py-2 px-1 text-sm font-medium border-b-2 border-blue-600 text-blue-600">
          Test
        </button>
        <button type="button"
                data-tabs-target="tab"
                data-action="click->tabs#show"
                data-tabs-panel="live"
                class="py-2 px-1 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 <%= 'opacity-50 cursor-not-allowed pointer-events-auto' unless is_production %>"
                <%= 'disabled' unless is_production %>
                <%= 'title="Live mode is only available in production"'.html_safe unless is_production %>>
          Live <%= '(production only)' unless is_production %>
        </button>
      </nav>
    </div>

    <%# Dev-only note explaining the test/live split so an admin doesn't
        wonder why the Live tab is greyed out. Skipped in production
        where the tab is interactive. %>
    <% unless is_production %>
      <p class="text-sm pl-2 mb-2 bg-amber-200 border border-amber-600 text-amber-600 rounded-xs font-mono">DO NOT PUT LIVE KEYS IN TEST MODE.</p>
      <ul class="text-sm text-gray-500 italic mb-4 list-disc ml-4">
        <li>Test keys are stored as plain text in <code class="text-xs font-mono">site/system/integrations/<%= @config_type %>.yml</code>.</li>
        <li>Live keys are stored encrypted in the database.</li>
        <% if @config_type == 'payments' %>
          <li>If you're testing Stripe payments locally or on the live site, you can find test credit card numbers here: <a href="https://docs.stripe.com/testing?testing-method=card-numbers#visa" class="underline text-blue-500">Stripe: Test Card Numbers</a>
        <% end %>
      </ul>
      <hr class="border border-gray-300 mb-4">
    <% end %>

  <%# Test tab %>
  <div data-tabs-target="panel" data-tabs-panel="test">
    <%= form_with url: update_path, method: :patch, class: "space-y-6" do |f| %>
      <% [ @schema[:test_keys] ].compact.each do |section| %>
        <div class="config-section">
          <h3 class="text-base font-semibold text-gray-900 mb-1"><%= section[:label] %></h3>
          <div class="space-y-4 pl-4 border-l-2 border-gray-200">
            <% section[:fields].each do |field_name, field_config| %>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  <%= field_config[:label] %>
                </label>
                <% current_value = @config_hash[field_name].to_s %>
                <% case field_config[:type] %>
                <% when :password %>
                  <%# Sensitive: hide existing value behind mask, render as
                      a password input so OS/browser autofill and shoulder-
                      surfing can't reveal it. %>
                  <input type="password"
                         name="test[<%= field_name %>]"
                         value="<%= current_value.present? ? '••••••••••••••••' : '' %>"
                         placeholder="<%= field_config[:hint] %>"
                         class="w-full font-mono text-sm p-2 border border-gray-300"
                         autocomplete="off">
                <% when :textarea %>
                  <%# Multi-line non-sensitive content (e.g. Snipcart snippet).
                      Render the real value so the user can see + edit; no mask. %>
                  <textarea name="test[<%= field_name %>]"
                            placeholder="<%= field_config[:hint] %>"
                            rows="7"
                            class="w-full font-mono text-sm p-2 border border-gray-300"><%= current_value %></textarea>
                <% else %>
                  <input type="text"
                         name="test[<%= field_name %>]"
                         value="<%= current_value.present? ? '••••••••••••••••' : '' %>"
                         placeholder="<%= field_config[:hint] %>"
                         class="w-full font-mono text-sm p-2 border border-gray-300">
                <% end %>
                <% if field_config[:hint] %>
                  <p class="text-xs text-gray-500 mt-1"><%= field_config[:hint] %></p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
        <input type="submit" value="Save Test Keys"
               class="uppercase text-sm px-3 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs cursor-pointer">
      </div>
    <% end %>
  </div>

  <%# Live tab — production-only form. In dev we show a notice instead
      of inputs since the controller refuses to persist live keys
      outside production anyway. %>
  <div data-tabs-target="panel" data-tabs-panel="live" class="hidden">
    <% if is_production %>
      <%= form_with url: live_update_path, method: :patch, class: "space-y-6" do |f| %>
        <% live_section = @schema[:live_keys] %>
        <% if live_section %>
          <div class="config-section">
            <h3 class="text-base font-semibold text-gray-900 mb-1"><%= live_section[:label] %></h3>
            <p class="text-xs text-gray-600 mb-3">
              Live keys are stored encrypted in the database. Fields are masked when already set.
            </p>
            <div class="space-y-4 pl-4 border-l-2 border-gray-200">
              <% live_section[:fields].each do |field_name, field_config| %>
                <%# `rescue ''` used to wrap this read, so a model with no
                    `<field>_live` reader rendered an empty box — indistinguishable
                    from "nothing saved yet". That's how a saved Postmark token
                    looked like a failed save. Name the problem instead. %>
                <% reader  = "#{field_name}_live" %>
                <% wired   = integration_record.respond_to?(reader) %>
                <% current_value = wired ? integration_record.public_send(reader).to_s : "" %>
                <% masked = current_value.present? %>
                <div>
                <% unless wired %>
                  <p class="text-xs text-red-700 mb-1">
                    <strong><%= integration_record.class.name %> has no <code><%= reader %></code>.</strong>
                    This field can't show or save a value until the model provides it.
                  </p>
                <% end %>
                  <label class="block text-sm font-medium text-gray-700 mb-1">
                    <%= field_config[:label] %>
                  </label>
                  <input type="<%= field_config[:type] == :password ? 'password' : 'text' %>"
                         name="live[<%= field_name %>]"
                         value="<%= masked ? '••••••••••••••••' : '' %>"
                         placeholder="<%= field_config[:hint] %>"
                         class="w-full font-mono text-sm p-2 border border-gray-300"
                         autocomplete="off">
                  <% if field_config[:hint] %>
                    <p class="text-xs text-gray-500 mt-1"><%= field_config[:hint] %></p>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="flex items-center gap-3 pt-4 border-t border-gray-200">
          <input type="submit" value="Save Live Keys"
                 class="uppercase text-sm px-3 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs cursor-pointer">
        </div>
        <% if @config_type == 'payments' %>
          <ul class="text-sm text-gray-500 italic mt-4 list-disc ml-4">
            <li>If you're testing Stripe payments locally or on the live site, you can find test credit card numbers here: <a href="https://docs.stripe.com/testing?testing-method=card-numbers#visa" class="underline text-blue-500">Stripe: Test Card Numbers</a></li>
          </ul>
        <% end %>
      <% end %>
    <% else %>
      <div class="p-4 bg-gray-50 border border-gray-200">
        <p class="text-sm text-gray-600">
          Live keys are only available in production. Deploy your site and configure live keys there.
        </p>
        <% if @config_type == 'payments' %>
          <ul class="text-sm text-gray-500 italic mt-4 list-disc ml-4">
            <li>If you're testing Stripe payments locally or on the live site, you can find test credit card numbers here: <a href="https://docs.stripe.com/testing?testing-method=card-numbers#visa" class="underline text-blue-500">Stripe: Test Card Numbers</a></li>
          </ul>
        <% end %>
      </div>
    <% end %>
  </div>
  </div><%# /data-controller="tabs" %>
  <% end %>

  <%# Danger zone — disconnect clears all keys for this integration
      across both modes. Postmark also exposes a webhook-token rotate
      action here since it's destructive (invalidates old endpoints). %>
  <div class="mt-12 pt-6 border-t border-red-200">
    <h3 class="text-sm font-semibold text-red-900 mb-3">Danger Zone</h3>
    <div class="flex items-center gap-3 flex-wrap">
      <%= button_to "Disconnect #{title.split(' ').first}",
                    disconnect_path,
                    method: :delete,
                    data: { turbo_confirm: "Are you sure? This will clear ALL keys (test and live) for this integration." },
                    class: "uppercase text-sm px-3 py-2 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>

      <% if @config_type == 'newsletters' %>
        <%= button_to "Regenerate Webhook Token",
                      admin_regenerate_webhook_token_newsletters_config_path,
                      method: :post,
                      data: { turbo_confirm: "Regenerate the webhook token? You'll need to update the URL in your Postmark dashboard." },
                      class: "uppercase text-sm px-3 py-2 border border-amber-600 bg-amber-50 hover:bg-amber-100 text-amber-800 font-mono rounded-xs" %>
      <% end %>
    </div>
  </div>
</div>
