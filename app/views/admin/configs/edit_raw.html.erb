<div class="px-4 sm:px-0">
  <div class="flex items-center justify-between mb-2">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Edit raw YAML</h1>
      <p class="mt-1 text-sm text-gray-700">
        <span class="font-mono"><%= @raw_type %>.yml</span> — the settings form couldn't parse this file, so edit it directly here.
      </p>
    </div>
    <%= link_to "← BACK TO SETTINGS", admin_configs_path, class: "inline-flex items-center uppercase text-sm mb-2 px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none text-nowrap" %>
  </div>

  <div class="mb-4 p-3 border border-amber-400 bg-amber-50 rounded text-sm text-amber-800">
    Fix the YAML below and save. Once it parses, you'll be sent back to the
    <%= link_to "settings form", @structured_path, class: "underline" %>.
  </div>

  <%= form_with url: admin_raw_config_path, method: :patch do |f| %>
    <%= hidden_field_tag :type, @raw_type %>
    <%= f.text_area :content, value: @config_content,
        class: "w-full bg-white font-mono text-sm p-2 border border-gray-300 box-border h-[480px]" %>
    <div class="mt-3">
      <%= f.submit "Save YAML",
          class: "inline-flex items-center uppercase text-sm px-2 py-1 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer" %>
    </div>
  <% end %>
</div>
