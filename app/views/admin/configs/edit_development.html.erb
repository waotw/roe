<% content_for :editor_js, false %>
<div class="px-4 sm:px-0">
  <div class="sm:flex sm:items-center mb-6">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold text-gray-900">Edit Development Configuration</h1>
      <p class="mt-2 text-sm text-gray-700">
        Configure development settings. These are only used in development mode.
      </p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "← Back to Settings", admin_configs_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none" %>
    </div>
  </div>

  <% if flash[:error] %>
    <div class="mb-4 bg-red-50 border border-red-200 p-4">
      <p class="text-sm text-red-800"><%= flash[:error] %></p>
    </div>
  <% end %>

  <%= form_with url: admin_development_config_path, method: :patch, local: true, class: "space-y-6" do |f| %>
    <div class="bg-white border border-gray-200">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-900">Allowed Hosts</h3>
        <p class="text-sm text-gray-500 mt-1">
          Add development hosts (approved URLs). The app only responds to requests from addresses you've told it to trust. Everything else gets blocked.
          One host per line.
        </p>
      </div>

      <div class="px-6 py-4">
        <div id="allowed-hosts-container" class="space-y-2">
          <% if @allowed_hosts.any? %>
            <% @allowed_hosts.each_with_index do |host, index| %>
              <div class="flex gap-2 allowed-host-row">
                <%= text_field_tag "allowed_hosts[]", host,
                    class: "flex-1 font-mono text-sm p-2 border border-gray-300 rounded-xs",
                    placeholder: "your-site.ngrok-free.app" %>
                <%= button_tag type: :button,
                    class: "remove-host-btn font-mono px-3 text-xs py-2 border border-red-300 bg-red-50 hover:bg-red-100 text-red-700 rounded-xs",
                    data: { action: "remove-host" } do %>
                  Remove
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="flex gap-2 allowed-host-row">
              <%= text_field_tag "allowed_hosts[]", "",
                  class: "flex-1 font-mono text-sm p-2 border border-gray-300 rounded-xs",
                  placeholder: "your-site.ngrok-free.app" %>
              <%= button_tag type: :button,
                  class: "remove-host-btn font-mono px-3 text-xs py-2 border border-red-300 bg-red-50 hover:bg-red-100 text-red-700 rounded-xs",
                  data: { action: "remove-host" } do %>
                Remove
              <% end %>
            </div>
          <% end %>
        </div>

        <%= button_tag type: :button,
            id: "add-host-btn",
            class: "mt-3 inline-flex font-mono text-xs items-center px-3 py-2 border border-gray-300 bg-gray-50 hover:bg-gray-100 text-sm font-medium text-gray-700 rounded-xs" do %>
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          Add Host
        <% end %>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <%= f.submit "SAVE",
          class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer" %>
      <%= link_to "CANCEL", admin_configs_path, class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
    </div>
  <% end %>

  <div class="mt-8 px-6 py-4 bg-red-50 border border-red-200 rounded-xs">
    <h4 class="text-sm font-semibold text-red-900 mb-2">Danger Zone</h4>
    <p class="text-xs text-red-700 mb-3">Deleting this will remove all development configuration.</p>
    <%= button_to "Delete Development Config",
                admin_delete_development_admin_configs_path,
                method: :delete,
                data: {
                  turbo_confirm: "Are you sure? This will permanently delete your development configuration."
                },
                class: "uppercase text-xs px-4 py-2 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.getElementById('allowed-hosts-container');
    const addBtn = document.getElementById('add-host-btn');

    addBtn.addEventListener('click', function() {
      const newRow = document.createElement('div');
      newRow.className = 'flex gap-2 allowed-host-row';
      newRow.innerHTML = `
        <input type="text" name="allowed_hosts[]"
          class="flex-1 font-mono text-sm p-2 border border-gray-300 rounded-xs"
          placeholder="your-site.ngrok-free.app" />
        <button type="button"
          class="remove-host-btn px-3 py-2 border border-red-300 bg-red-50 hover:bg-red-100 text-red-700 rounded-xs"
          data-action="remove-host">
          Remove
        </button>
      `;
      container.appendChild(newRow);
      attachRemoveHandler(newRow.querySelector('.remove-host-btn'));
    });

    function attachRemoveHandler(btn) {
      btn.addEventListener('click', function() {
        const rows = container.querySelectorAll('.allowed-host-row');
        if (rows.length > 1) {
          btn.closest('.allowed-host-row').remove();
        } else {
          // Clear the input instead of removing the last row
          btn.closest('.allowed-host-row').querySelector('input').value = '';
        }
      });
    }

    // Attach handlers to existing remove buttons
    document.querySelectorAll('.remove-host-btn').forEach(attachRemoveHandler);
  });
</script>
