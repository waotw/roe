<%# In-progress / failed / rolled-back update panels, pinned to the top of
    the Updates page so the progress log and any failure aren't below the
    fold. Rendered only when one applies (see the active-operation box at
    the top of index.html.erb). The Stimulus `updates` controller finds its
    inProgressPanel / progressBar / currentStep / log targets here. %>
<% if @in_progress %>
  <div class="bg-amber-50 border border-amber-200 rounded-xs p-6"
       data-updates-target="inProgressPanel">
    <h2 class="text-lg font-semibold text-amber-900 mb-2">Update in Progress</h2>
    <p class="text-amber-800 mb-4">
      An update is currently being applied to your site.
      Please do not close this window.
    </p>

    <div class="mb-4">
      <div class="w-full bg-amber-200 rounded-full h-2.5">
        <div class="bg-amber-600 h-2.5 rounded-full"
             style="width: <%= @last_update&.progress_percent || 0 %>%"
             data-updates-target="progressBar"></div>
      </div>
      <p class="text-sm text-amber-700 mt-2"
         data-updates-target="currentStep">
        <%= @last_update&.current_step || 'Starting...' %>
      </p>
    </div>

    <%# COPY: shown when the new version's installer has been quiet for 10 minutes %>
    <p class="text-sm text-amber-900 mb-4 <%= 'hidden' unless @handoff&.slow %>"
       data-updates-target="slowNotice" data-test="update-slow">
      This is taking longer than usual. It may still be working: the log
      below shows what it's doing.
    </p>
    <div class="text-sm text-amber-900 mb-4 [&_a]:underline <%= 'hidden' unless @handoff&.help %>"
         data-updates-target="help" data-test="update-help">
      <%= update_help_html(@handoff&.help) %>
    </div>

    <div class="bg-white rounded-xs p-4 font-mono text-xs text-gray-600 h-48 overflow-y-auto"
         data-updates-target="log">
      <%= simple_format(@last_update&.log || '') %>
    </div>
  </div>

<% elsif @last_update && @last_update.status == "awaiting_input" && @handoff&.question %>
  <%# A question from the new version's own update script (Handoff). Its
      title, text and button labels come from the script, so a future release
      can ask anything without this page knowing about it in advance. %>
  <% question = @handoff.question %>
  <div class="bg-blue-50 border border-blue-200 rounded-xs p-6" data-test="update-question">
    <h2 class="text-lg font-semibold text-blue-900 mb-2"><%= question["title"] %></h2>
    <div class="text-blue-800 mb-4 [&_a]:underline [&_p+p]:mt-2"><%= update_help_html(question["text"]) %></div>
    <% if @handoff.help %>
      <div class="text-sm text-blue-700 mb-4 [&_a]:underline"><%= update_help_html(@handoff.help) %></div>
    <% end %>
    <div class="flex gap-3">
      <%= button_to (question["confirm"].presence || "CONTINUE"),
                    admin_answer_update_path, params: { confirm: "1" }, method: :post,
                    data: { test: "update-question-confirm" },
                    class: "inline-flex items-center px-4 py-2 border border-blue-700 bg-blue-600 hover:bg-blue-700 text-white font-mono text-xs rounded-xs" %>
      <%= button_to (question["cancel"].presence || "CANCEL"),
                    admin_answer_update_path, params: { confirm: "0" }, method: :post,
                    data: { test: "update-question-cancel" },
                    class: "inline-flex items-center px-4 py-2 border border-gray-400 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs" %>
    </div>
  </div>

<% elsif @last_update && @last_update.status == "failed" && @handoff %>
  <%# An update the new version ran itself, which stopped partway or couldn't
      roll itself back. The commands work from any terminal. %>
  <div class="bg-red-50 border border-red-200 rounded-xs p-6" data-test="update-failed-handoff">
    <%# COPY: an update that stopped or couldn't roll back %>
    <h3 class="text-sm font-semibold text-red-900 mb-2">
      <%= @handoff.interrupted ? "The update stopped partway" : "The update didn't finish" %>
    </h3>
    <% if @last_update.error_message.present? %>
      <p class="text-sm text-red-700 mb-2"><%= @last_update.error_message %></p>
    <% end %>
    <% if @handoff.help %>
      <div class="text-sm text-red-800 mb-3 [&_a]:underline"><%= update_help_html(@handoff.help) %></div>
    <% end %>
    <p class="text-sm text-red-700 mb-2">To carry on from where it stopped, run this in Terminal:</p>
    <code class="block mb-3 px-3 py-2 bg-white border border-red-200 rounded-xs font-mono text-xs select-all"><%= @handoff.commands[:resume] %></code>
    <p class="text-sm text-red-700 mb-2">Or to go back to the version you had before:</p>
    <code class="block mb-3 px-3 py-2 bg-white border border-red-200 rounded-xs font-mono text-xs select-all"><%= @handoff.commands[:rollback] %></code>
    <details class="mt-3">
      <summary class="text-xs text-red-700 cursor-pointer hover:text-red-900">Show the log</summary>
      <pre class="mt-2 p-3 bg-white border border-red-200 rounded-xs font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap max-h-96"><%= @last_update.log %></pre>
    </details>
  </div>

<% elsif @last_update && @last_update.status == "awaiting_ruby" %>
  <div class="bg-blue-50 border border-blue-200 rounded-xs p-6">
    <h2 class="text-lg font-semibold text-blue-900 mb-2">
      Ruby <%= @awaiting_required_ruby %> required
    </h2>
    <p class="text-blue-800 mb-4">
      This update requires Ruby <%= @awaiting_required_ruby %>, which is not
      installed on this computer. Roe can install it for you automatically
      (via <a href="/documentation/roe/glossary#mise"
              class="underline hover:text-blue-900">mise</a>, ~30s).
    </p>
    <p class="text-sm text-blue-700 mb-4">
      Nothing has been changed on your site yet — the update paused here and
      will continue once Ruby is installed.
    </p>
    <div class="flex gap-3">
      <%= button_to "Install & continue",
                    admin_confirm_ruby_update_path,
                    method: :post,
                    class: "inline-flex items-center px-4 py-2 border border-blue-700 bg-blue-600 hover:bg-blue-700 text-white font-mono text-xs rounded-xs" %>
      <%= button_to "Cancel",
                    admin_cancel_ruby_update_path,
                    method: :post,
                    class: "inline-flex items-center px-4 py-2 border border-gray-400 bg-gray-100 hover:bg-gray-200 text-gray-700 font-mono text-xs rounded-xs" %>
    </div>
  </div>

<% elsif @last_update && @last_update.status == "failed" %>
  <div class="bg-red-50 border border-red-200 rounded-xs p-6">
    <h3 class="text-sm font-semibold text-red-900 mb-2">Last Update Failed</h3>
    <p class="text-sm text-red-700 mb-2">
      Both the update AND the automatic rollback failed. Manual
      intervention may be required.
    </p>
    <% if @last_update.error_message.present? %>
      <pre class="mb-4 p-3 bg-white border border-red-200 rounded-xs font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap"><%= @last_update.error_message %></pre>
    <% end %>
    <%= button_to "Attempt Rollback",
                  admin_rollback_update_path,
                  method: :post,
                  data: { confirm: "This will restore the previous version. Continue?" },
                  class: "inline-flex items-center px-4 py-2 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono text-xs rounded-xs" %>
  </div>

<% elsif @last_update && @last_update.status == "rolled_back" %>
  <div class="bg-amber-50 border border-amber-200 rounded-xs p-6">
    <h3 class="text-sm font-semibold text-amber-900 mb-2">
      Last Update Rolled Back
    </h3>
    <p class="text-sm text-amber-800 mb-2">
      Update from <span class="font-mono"><%= @last_update.from_version %></span>
      → <span class="font-mono"><%= @last_update.to_version %></span>
      was attempted <%= time_ago_in_words(@last_update.completed_at || @last_update.updated_at) %> ago
      and was automatically rolled back. Your site is running normally on
      <span class="font-mono"><%= @current_version %></span>.
    </p>
    <% if @handoff&.help %>
      <div class="text-sm text-amber-900 mb-2 [&_a]:underline" data-test="update-rolled-back-help">
        <% if @last_update.error_message.present? %><p class="mb-1"><%= @last_update.error_message %></p><% end %>
        <%= update_help_html(@handoff.help) %>
      </div>
    <% end %>
    <% if @last_update.error_message.present? %>
      <details class="mt-3">
        <summary class="text-xs text-amber-700 cursor-pointer hover:text-amber-900">
          Show failure details
        </summary>
        <pre class="mt-2 p-3 bg-white border border-amber-200 rounded-xs font-mono text-xs text-gray-700 overflow-x-auto whitespace-pre-wrap"><%= @last_update.error_message %></pre>
      </details>
    <% end %>
  </div>
<% end %>
