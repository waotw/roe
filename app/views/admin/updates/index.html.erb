<% content_for :editor_js, false %>
<div class="px-4 sm:px-0" data-controller="updates">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Updates<%= " & Deploy" unless Rails.env.production? %></h1>
    <p class="mt-2 text-sm text-gray-700">
      <%= Rails.env.production? ? "Check and install updates to Roe." : "Check for updates to Roe and deploy the current build to your live server." %>
    </p>
  </div>

  <%# ─── Active operation (update or deploy), pinned to the top so the
      progress log / failure isn't below the fold. They can't run at once,
      so one box shows whichever is active. Only in-progress + failure land
      here; a successful run renders in its section below and the page
      scrolls to it. The Stimulus `updates` controller finds its polling
      targets here just as well as in the sections. %>
  <% deploy_active = !Rails.env.production? && @deploy_status&.dig(:state).in?([ :running, :failed ]) %>
  <% update_active = @in_progress || (@last_update && %w[failed rolled_back].include?(@last_update.status)) %>
  <% if update_active || deploy_active %>
    <div class="mb-6">
      <% if update_active %>
        <%= render "update_active" %>
      <% else %>
        <%= render "deploy_active" %>
      <% end %>
    </div>
  <% end %>

  <%# Production banner — updates can't run from a deployed instance.
      Page itself is still useful (current version, latest-available
      indicator, release notes) so the user knows whether to switch to
      their local install and run the update from there. %>
  <% if Rails.env.production? %>
    <div class="mb-6 p-4 border border-amber-300 bg-amber-50 rounded-xs">
      <h3 class="text-sm font-semibold text-amber-900 mb-1">⚠ Updates run from your local install</h3>
      <p class="text-sm text-amber-800">
        Roe's in-app updater swaps files in <code class="font-mono text-xs bg-amber-100 px-0.5">current/</code>,
        which a deployed container image can't do. This page is read-only here — the
        amber dot in the nav tells you when an update is available, but to actually
        apply it, open your <strong>local</strong> Roe install's Updates & Deploy
        page and run it there. Then deploy to push the new version to your live site.
      </p>
    </div>
  <% end %>

  <%# Dev-install banner — Roe-maintainer warning. Page loads normally
      so the maintainer can see the dot/release info, but Start and
      Rollback buttons are hidden (see render conditions below) because
      running the in-app updater would clobber the active branch. %>
  <% if @dev_install %>
    <div class="mb-6 p-4 border border-amber-300 bg-amber-50 rounded-xs">
      <h3 class="text-sm font-semibold text-amber-900 mb-1">⚠ Dev install of Roe — Update System disabled</h3>
      <p class="text-sm text-amber-800">
        You're on a git branch (not a release tag), so the in-app updater is
        disabled here to avoid clobbering your working tree. Use <code class="font-mono text-xs bg-amber-100 px-0.5">git pull</code>
        to sync. The page below is informational only.
      </p>
    </div>
  <% end %>

  <div class="mt-8 mb-8 py-3 border-t border-b px-4 border-gray-200 flex gap-2">
    <details class="<%= Rails.env.production? ? 'w-full' : 'flex-1' %> group">
      <summary class="text-sm font-semibold text-gray-900 cursor-pointer select-none flex items-center gap-2 list-none">
        <span class="inline-block transition-transform group-open:rotate-90 text-gray-500">▸</span>
        About Updates
      </summary>
      <ul class="text-sm text-gray-600 space-y-1 list-disc ml-4 mt-3">
        <li>Updates include new features, bug fixes, and security patches</li>
        <li>Your content in the <code class="text-xs rounded-xs py-0.5 px-0.5 bg-gray-200">site/</code> folder is preserved during updates</li>
        <li>Configuration files are not overwritten</li>
        <li>If an update fails, the system will automatically roll back</li>
      </ul>
    </details>
    <% unless Rails.env.production? %>
    <details class="flex-1 group">
      <summary class="text-sm font-semibold text-gray-900 cursor-pointer select-none flex items-center gap-2 list-none">
        <span class="inline-block transition-transform group-open:rotate-90 text-gray-500">▸</span>
        About Deploy
      </summary>
      <ul class="text-sm text-gray-600 space-y-1 list-disc ml-4 mt-3">
        <li>Deploys only apply to Roe's codebase, not your site content</li>
        <li>Your content in the <code class="text-xs rounded-xs py-0.5 px-0.5 bg-gray-200">site/</code> folder is always preserved &mdash; it lives on a separate persistent volume</li>
        <li><b>Kamal:</b> if the build fails, your server is untouched. If the container fails to start, run <code class="text-xs rounded-xs py-0.5 px-0.5 bg-gray-200">kamal rollback</code> from the terminal to restore the previous image</li>
        <li><b>Fly:</b> Fly starts the new instance before stopping the old one &mdash; if health checks fail, traffic stays on the previous version automatically</li>
      </ul>
    </details>
    <% end %>
  </div>

  <h2 class="mt-4 text-2xl font-bold text-gray-900 mb-4">Roe Version & Updates</h2>

  <%# Update channel toggle — visible to everyone. Stable is the
      default; Nightly opts the install in to pre-release tags
      (`-nightly`, `-rc`, `-dev`, etc.) for testing the update flow.
      Dev checkouts effectively run as Nightly regardless of this
      setting because the predicate ORs in dev_install?. %>
  <div class="bg-white border border-gray-200 rounded-xs p-4 mb-6 flex items-start justify-between gap-4">
    <div class="flex-1 min-w-0">
      <h3 class="text-sm font-semibold text-gray-900 mb-1">Update channel</h3>
      <p class="text-xs text-gray-600">
        <% if @update_channel == "nightly" %>
          You're on the <strong>Nightly</strong> channel — pre-release tags from Codeberg are visible below. Use only for testing the update flow; nightly builds may be unstable.
        <% else %>
          You're on the <strong>Stable</strong> channel — only released versions show up. Switch to Nightly to test the update flow against pre-release tags.
        <% end %>
      </p>
    </div>
    <div class="shrink-0 flex gap-1">
      <%= button_to "Stable",
                    admin_update_channel_path,
                    method: :post,
                    params: { channel: "stable" },
                    disabled: @update_channel == "stable",
                    class: "uppercase inline-flex items-center px-3 py-1.5 border font-mono text-xs rounded-xs cursor-pointer #{@update_channel == 'stable' ? 'border-green-700 bg-green-200 text-green-900 cursor-default' : 'border-gray-700 bg-gray-100 hover:bg-gray-200 text-gray-800'}" %>
      <%= button_to "Nightly",
                    admin_update_channel_path,
                    method: :post,
                    params: { channel: "nightly" },
                    disabled: @update_channel == "nightly",
                    data: { confirm: ("Switch to the Nightly channel? Pre-release tags will be offered as updates. Stable channel users never see them." unless @update_channel == "nightly") },
                    class: "uppercase inline-flex items-center px-3 py-1.5 border font-mono text-xs rounded-xs cursor-pointer #{@update_channel == 'nightly' ? 'border-purple-700 bg-purple-200 text-purple-900 cursor-default' : 'border-gray-700 bg-gray-100 hover:bg-gray-200 text-gray-800'}" %>
    </div>
  </div>

  <%# Pre-release panel — renders when the install can see prereleases
      (dev clone OR nightly channel) AND VersionChecker found a newer
      `-suffix` tag. The actionable button is shown ONLY to real user
      installs on the nightly channel; on a development checkout the
      in-app updater is disabled (it would clone a release over your
      working tree), so we show a "use git" note instead. %>
  <% if @update_info && @update_info[:prerelease_available] %>
    <div class="bg-purple-50 border border-purple-300 rounded-xs p-6 mb-6">
      <div class="flex items-start justify-between gap-4">
        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-semibold text-purple-900 mb-1">
            Pre-release available: <code class="font-mono text-xs bg-purple-100 px-1 rounded">v<%= @update_info[:prerelease_version] %></code>
          </h3>
          <p class="text-sm text-purple-800 mb-2">
            A <code class="font-mono text-xs bg-purple-100 px-1 rounded">-nightly</code> tag is available on Codeberg. This panel appears because you're on the <strong>Nightly</strong> release channel — switch to Stable for official releases.
          </p>
          <% if @update_info[:prerelease_url].present? %>
            <p class="text-xs text-purple-700">
              <a href="<%= @update_info[:prerelease_url] %>" target="_blank" rel="noopener" class="underline hover:text-purple-900">View release notes on Codeberg →</a>
            </p>
          <% end %>
        </div>
        <div class="shrink-0">
          <% if @dev_install %>
            <p class="text-xs text-purple-700 max-w-[16rem]">
              You're on a development checkout — switch versions with
              <code class="font-mono bg-purple-100 px-1 rounded">git</code>, not the in-app updater.
            </p>
          <% else %>
            <%= button_to "Test pre-release update",
                          admin_start_update_path,
                          method: :post,
                          params: { version: @update_info[:prerelease_version], prerelease: "true" },
                          data: { confirm: "Run the updater against v#{@update_info[:prerelease_version]}? This will overwrite your install with the tagged release contents." },
                          class: "uppercase inline-flex items-center px-4 py-2 border border-purple-800 bg-purple-200 hover:bg-purple-300 text-purple-900 font-mono text-sm rounded-xs cursor-pointer whitespace-nowrap" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# Top status block. Picks one state by priority, in the order
      they're checked: in-progress > restart-pending > restart-complete
      > update-available > up-to-date > no-info. The restart states
      take priority over update-available/up-to-date so the page
      reflects "what just happened" first when there's a fresh update
      in the picture. %>
  <%# Rolled-back / failed update states are shown in the active-operation
      box pinned to the top of the page (see _update_active). %>
  <% if @in_progress %>
    <%# In-progress panel is pinned to the top of the page (_update_active). %>
  <% elsif @restart_pending %>
    <%# Update installed but the running Puma is still on the old
        version. The server's in-memory VersionChecker has cached the
        boot-time version which is still < @last_update.to_version.
        Detailed terminal restart instructions because the beta
        audience (Substack/Ghost/WordPress users) isn't all comfortable
        in a terminal. %>
    <div id="update-result" class="bg-blue-50 border border-blue-200 rounded-xs p-6 mb-4">
      <h3 class="text-base font-semibold text-blue-900 mb-2">
        Update Installed — Restart Roe to Finish
      </h3>
      <p class="text-sm text-blue-800 mb-5">
        Roe <span class="font-mono"><%= @last_update.to_version %></span>
        is installed and ready. The server is still on the previous version</span>
        — restart it to load the new code.
      </p>

      <div class="bg-white border border-blue-200 rounded-xs p-5 mb-3">
        <h4 class="text-sm font-semibold text-gray-900 mb-4">Restart your Roe server</h4>

        <ol class="space-y-5 text-sm text-gray-800">
          <li>
            <p class="font-medium mb-1">1. Find the terminal window where Roe is running.</p>
            <p class="text-xs text-gray-600 leading-relaxed">
              Look for the terminal window/tab showing a lot of text in varied colors.
            </p>
          </li>

          <li>
            <p class="font-medium mb-1">
              2. Press
              <kbd class="px-1.5 py-0.5 border border-gray-400 bg-gray-100 rounded-xs font-mono text-xs">Control</kbd>
              +
              <kbd class="px-1.5 py-0.5 border border-gray-400 bg-gray-100 rounded-xs font-mono text-xs">C</kbd>
              to stop the server.
            </p>
            <p class="text-xs text-gray-600 leading-relaxed">
              Wait until your command prompt comes back. It usually looks like
              <code class="text-xs bg-gray-100 px-1 py-0.5 rounded-xs">$</code> or
              your username followed by
              <code class="text-xs bg-gray-100 px-1 py-0.5 rounded-xs">%</code>.
            </p>
          </li>

          <li>
            <p class="font-medium mb-2">3. Paste this command and press Enter:</p>
            <div class="flex items-center gap-2">
              <code class="flex-1 px-3 py-2 bg-gray-100 border border-gray-300 rounded-xs font-mono text-sm select-all">./roe.sh start</code>
              <button type="button"
                      data-action="click->updates#copyCommand"
                      data-command="./roe.sh start"
                      class="px-3 py-2 border border-gray-400 bg-white hover:bg-gray-50 text-xs font-mono rounded-xs">
                Copy
              </button>
            </div>
            <p class="mt-2 text-xs text-gray-600 leading-relaxed">
              Once the new server is up, refresh this page (
              <kbd class="px-1.5 py-0.5 border border-gray-400 bg-gray-100 rounded-xs font-mono text-xs">⌘</kbd>
              +
              <kbd class="px-1.5 py-0.5 border border-gray-400 bg-gray-100 rounded-xs font-mono text-xs">R</kbd>)
              to confirm Roe updated successfully.
            </p>
          </li>
        </ol>
      </div>

      <details class="mt-3">
        <summary class="text-sm text-blue-700 cursor-pointer hover:text-blue-900 select-none">
          Lost the terminal window? →
        </summary>
        <div class="mt-3 bg-white border border-blue-200 rounded-xs p-5">
          <p class="text-sm text-gray-800 mb-4 leading-relaxed">
            If you closed the terminal where Roe was running, open a new one
            (on macOS: search for <strong>Terminal</strong> in Spotlight with
            <kbd class="px-1.5 py-0.5 border border-gray-400 bg-gray-100 rounded-xs font-mono text-xs">⌘</kbd>
            +
            <kbd class="px-1.5 py-0.5 border border-gray-400 bg-gray-100 rounded-xs font-mono text-xs">Space</kbd>),
            then paste these two commands one at a time:
          </p>

          <div class="mb-3">
            <p class="text-xs text-gray-600 mb-1">First, move to the Roe folder:</p>
            <div class="flex items-center gap-2">
              <code class="flex-1 px-3 py-2 bg-gray-100 border border-gray-300 rounded-xs font-mono text-sm select-all">cd "<%= RoeSitePaths::ROE_ROOT %>"</code>
              <button type="button"
                      data-action="click->updates#copyCommand"
                      data-command='cd "<%= RoeSitePaths::ROE_ROOT %>"'
                      class="px-3 py-2 border border-gray-400 bg-white hover:bg-gray-50 text-xs font-mono rounded-xs">
                Copy
              </button>
            </div>
          </div>

          <div class="mb-3">
            <p class="text-xs text-gray-600 mb-1">Then start Roe:</p>
            <div class="flex items-center gap-2">
              <code class="flex-1 px-3 py-2 bg-gray-100 border border-gray-300 rounded-xs font-mono text-sm select-all">./roe.sh start</code>
              <button type="button"
                      data-action="click->updates#copyCommand"
                      data-command="./roe.sh start"
                      class="px-3 py-2 border border-gray-400 bg-white hover:bg-gray-50 text-xs font-mono rounded-xs">
                Copy
              </button>
            </div>
          </div>

          <p class="text-xs text-gray-600 mt-4 leading-relaxed">
            Or, if you'd rather not use the terminal: open the Roe folder
            in Finder and double-click
            <code class="text-xs bg-gray-100 px-1 py-0.5 rounded-xs">start.command</code>.
          </p>
        </div>
      </details>
    </div>
  <% elsif @restart_complete %>
    <%# Update is done AND the server has restarted — VersionChecker
        re-read VERSION on boot and now matches to_version. Green
        confirmation shows for the rest of the 5-minute window from
        completed_at, then naturally falls back to "Up to Date" once
        @recent_update is false. %>
    <div class="bg-green-50 border border-green-200 rounded-xs p-6 mb-4">
      <h2 class="text-lg font-semibold text-green-900 mb-2">
        Update Successful
      </h2>
      <p class="text-sm text-green-800">
        Roe restarted on
        <span class="font-mono font-bold"><%= @current_version %></span>
        — the new code is now live.
      </p>
      <p class="text-xs text-green-700 mt-2">
        Completed <%= time_ago_in_words(@last_update.completed_at) %> ago.
      </p>
    </div>
  <% elsif @update_info %>
    <% if @update_info[:update_available] %>
      <div class="bg-blue-50 border border-blue-200 rounded-xs p-6 mb-6">
        <div class="flex items-start gap-4">
          <div class="flex-1">
            <h2 class="text-lg font-semibold text-blue-900 mb-2">
              Update Available
            </h2>
            <p class="text-blue-800 mb-4">
              A new version of Roe is available:
              <span class="font-mono font-bold"><%= @update_info[:latest_version] %></span>
            </p>
            <p class="text-sm text-blue-700 mb-2">
              Released: <%= time_ago_in_words(@update_info[:published_at]) %> ago
            </p>
          </div>
        </div>

        <% if @update_info[:release_notes].present? %>
          <div class="mt-4 p-4 bg-white border border-blue-200 rounded-xs">
            <h3 class="text-sm font-semibold text-gray-900 mb-2">Release Notes</h3>
            <div class="prose prose-sm max-w-none text-gray-700">
              <%= simple_format(@update_info[:release_notes]) %>
            </div>
          </div>
          <%= link_to "View full release notes on Codeberg →",
                      @update_info[:release_url],
                      target: "_blank",
                      class: "text-sm text-blue-600 hover:text-blue-900 underline" %>
        <% end %>

        <div class="mt-6 pt-4 border-t border-blue-200">
          <h3 class="text-sm font-semibold text-blue-900 mb-2">Before Updating</h3>
          <ul class="text-sm text-blue-700 list-disc list-inside space-y-1">
            <li>A backup of your site will be created automatically</li>
            <li>Your site will be unavailable for approximately 30 seconds</li>
            <li>Static site generation will be paused during the update</li>
          </ul>
        </div>

        <div class="mt-6 flex items-center gap-3">
          <%# Hide the action button on dev installs (would clobber the
              branch) and in production (the in-app updater can't run
              inside a deployed image). Both states show their own
              explanatory banner at the top of the page. %>
          <% unless @dev_install || Rails.env.production? %>
            <%= button_to "Update Now",
                          admin_start_update_path(version: @update_info[:latest_version]),
                          method: :post,
                          data: { confirm: "This will update Roe to v#{@update_info[:latest_version]}. Your site will be briefly unavailable. Continue?" },
                          class: "inline-flex items-center px-4 py-2 border border-gray-800 bg-blue-600 hover:bg-blue-700 text-white font-mono rounded-xs" %>
          <% end %>

          <%= link_to "View full release notes on Codeberg →",
                      @update_info[:release_url],
                      target: "_blank",
                      class: "text-sm text-blue-600 hover:text-blue-900 underline" %>
        </div>
      </div>
    <% else %>
      <div class="bg-green-50 border border-green-200 rounded-xs p-4 mb-4">
        <h2 class="text-base font-semibold text-green-900">You're Up to Date</h2>
        <p class="text-green-800 mt-2 text-sm">
          You're running the latest version of Roe (<%= @current_version %>).
        </p>
      </div>
    <% end %>
  <% else %>
    <div class="bg-gray-50 border border-gray-200 rounded-xs p-6">
      <p class="text-gray-600">
        Click "Check for Updates" to see if a new version is available.
      </p>
    </div>
  <% end %>
  <div class="bg-white border border-gray-200 rounded-xs p-6 mb-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Current Version</h2>
        <p class="text-2xl font-mono font-bold text-gray-900 mt-1">
          Roe <%= @current_version %>
        </p>
      </div>
      <div class="flex items-center gap-3">
        <%= button_to "Check for Updates",
                      admin_check_updates_path,
                      method: :post,
                      class: "uppercase text-sm inline-flex items-center px-4 py-2 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>

        <% if @update_info && @update_info[:update_available] %>
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-blue-500"></span>
          </span>
        <% end %>
      </div>
    </div>
  </div>

  <%# ══════════════════════════════════════════════════════════════════════
      Deploy section — only show in development/staging
  ══════════════════════════════════════════════════════════════════════ %>

  <% unless Rails.env.production? %>
  <div class="mt-12 pt-2 border-t-2 border-gray-300">
    <h2 class="mt-6 text-2xl font-bold text-gray-900 mb-6">Deploy to Live Server</h2>

    <%
      deploy_state     = @deploy_status&.dig(:state)
      # Use current status if available, otherwise fall back to persisted last deploy time
      last_deployed_at = @deploy_status&.dig(:completed_at) || @last_deploy_time
    %>

    <div class="bg-white border border-gray-200 rounded-xs p-6 mb-6">

      <%# Card header — always visible %>
      <div class="flex items-start justify-between mb-6">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="inline-flex items-center font-mono text-xs px-1.5 py-0.5 border border-gray-400 bg-gray-100 rounded-xs">
              <%= @deploy_target_label %>
            </span>
            <span class="text-sm text-gray-600 font-mono"><%= @deploy_server_desc %></span>
          </div>
          <% if last_deployed_at %>
            <p class="text-xs text-gray-400">Last deployed <%= time_ago_in_words(last_deployed_at) %> ago</p>
          <% elsif deploy_state == :running %>
            <p class="text-xs text-amber-600">Deploy in progress…</p>
          <% else %>
            <p class="text-xs text-gray-400">Not yet deployed from this machine</p>
          <% end %>
        </div>
        <%= link_to "Edit deploy config",
                    admin_edit_deploy_config_path,
                    class: "text-xs text-gray-400 hover:text-gray-700 underline" %>
      </div>

      <%# ── Running / failed are shown in the active-deploy box pinned to
          the top of the page — nothing to render here. ── %>
      <% if deploy_state == :running || deploy_state == :failed %>

      <%# ── Completed state (only show if not dismissed) ── %>
      <% elsif deploy_state == :completed && !@deploy_status[:dismissed] %>
        <div id="deploy-result" class="bg-green-50 border border-green-200 rounded-xs p-4">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-semibold text-green-900">Deploy completed successfully</h3>
              <% if @deploy_status[:completed_at] %>
                <p class="text-xs text-green-700 mt-0.5">
                  Finished <%= time_ago_in_words(@deploy_status[:completed_at]) %> ago
                  <% if @deploy_status[:version_tag].present? && @deploy_target == 'kamal' %>
                    &middot; version tag <span class="font-mono"><%= @deploy_status[:version_tag] %></span>
                  <% end %>
                </p>
              <% end %>
            </div>
            <%= button_to "Dismiss",
                          admin_dismiss_deploy_path,
                          method: :post,
                          class: "uppercase text-xs font-mono px-3 py-1.5 border border-green-600 bg-green-100 hover:bg-green-200 text-green-800 rounded-xs" %>
          </div>
          <% if @deploy_status[:log].present? %>
            <details class="mt-3">
              <summary class="text-xs text-green-700 cursor-pointer hover:text-green-900">Show deploy log</summary>
              <div class="mt-2 bg-white border border-green-200 rounded-xs p-3 font-mono text-xs text-gray-700 h-48 overflow-y-auto">
                <%= simple_format(@deploy_status[:log]) %>
              </div>
            </details>
          <% end %>
        </div>

      <%# ── Not ready — prerequisites unmet ── %>
      <% elsif @deploy_issues.any? %>
        <div class="bg-amber-50 border border-amber-200 rounded-xs p-4">
          <h3 class="text-sm font-semibold text-amber-900 mb-2">Not ready to deploy</h3>
          <ul class="text-sm text-amber-800 list-disc list-inside space-y-1 mb-3">
            <% @deploy_issues.each do |issue| %>
              <li><%= issue %></li>
            <% end %>
          </ul>
          <%= link_to "Edit deploy config →",
                      admin_edit_deploy_config_path,
                      class: "text-xs font-mono underline text-amber-800 hover:text-amber-900" %>
        </div>

      <%# ── Ready — show deploy button ── %>
      <% else %>
        <div>
          <% if @deploy_target == 'kamal' && !@kamal_cli_available %>
            <p class="text-sm text-amber-700 mb-3">
              Kamal CLI is not available on this machine. Run
              <code class="font-mono text-xs bg-amber-50 px-0.5">bundle install</code>
              in <code class="font-mono text-xs bg-amber-50 px-0.5">current/</code> first.
            </p>
          <% elsif @deploy_target == 'fly' && !@fly_cli_available %>
            <p class="text-sm text-amber-700 mb-3">
              The Fly CLI is not installed.
              <%= link_to "See install instructions →", admin_edit_deploy_config_path, class: "underline" %>
            </p>
          <% else %>
            <button type="button"
                    data-action="click->updates#checkBeforeDeploy"
                    data-deploy-url="<%= admin_start_deploy_path %>"
                    data-confirm-msg="<%= @deploy_confirm_msg %>"
                    class="inline-flex items-center px-2 py-1.5 border border-gray-800 bg-blue-600 hover:bg-blue-700 text-white font-mono text-sm rounded-xs">
              Deploy
            </button>
            <p class="mt-2 text-xs text-gray-500">
              Deploys the current build on disk.
              <% if @deploy_target == 'kamal' %>
                Kamal builds on the remote server — expect 5–10 minutes.
              <% else %>
                Fly builds in the cloud — typically 2–5 minutes.
              <% end %>
            </p>
          <% end %>
        </div>
      <% end %>

    </div><%# /deploy card %>
  </div><%# /deploy section %>
  <% end %>

</div>
