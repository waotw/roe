<%# Primary editor actions: Save / Preview / (Un)publish + the save-state
    indicator. Rendered twice — in-flow at the top of the editor AND inside the
    sticky bottom drawer (see editor-drawer) — so the markup lives here once.
    Sits inside the editor Stimulus controller, so the button actions and the
    saveDot/saveMessage targets resolve to it (targets are read as *plural* in
    editor#updateSaveState so both copies stay in sync).
    Locals: post %>
<div class="flex gap-1 items-baseline overflow-hidden">
  <button type="submit" form="post-form" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">Save</button>

  <button type="button"
          data-action="click->editor#preview"
          class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
    Preview
  </button>

  <div class="publish-button-container">
    <% unless post.published? %>
      <button type="button"
              data-action="click->editor#confirmPublish"
              data-editor-post-id="<%= post.id %>"
              class="uppercase text-xs px-1.5 py-0 border border-slate-800 bg-slate-200 hover:bg-slate-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
        Publish
      </button>
    <% else %>
      <form action="<%= unpublish_admin_post_path(post) %>"
            method="post"
            data-turbo="false"
            data-action="submit->editor#confirmUnpublish">
        <input type="hidden" name="_method" value="patch">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit"
                class="uppercase text-xs text-white px-1.5 py-0 border border-slate-800 bg-slate-400 hover:bg-slate-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
          Unpublish
        </button>
      </form>
    <% end %>
  </div>

  <%# Save-state indicator — amber "unsaved changes" / green "saved changes" /
      pristine (blank). Driven by editor#updateSaveState (isDirty). %>
  <div class="flex items-center gap-1.5 font-mono text-[0.65rem] uppercase text-gray-500 select-none pl-1.5">
    <span class="inline-block w-2 h-2 rounded-full bg-green-500" data-editor-target="saveDot"></span>
    <span data-editor-target="saveMessage"></span>
  </div>
</div>
