<%
  media_field_kinds = { 'audio' => 'audio', 'video' => 'video', 'image' => 'image', 'captions' => 'file' }
  resource_label = local_assigns[:resource_label] || @resource_label || 'Post'
  show_postmark_warning = local_assigns.fetch(:show_postmark_warning) { @show_postmark_warning }
%>
  <div class="fixed inset-0 bg-amber-700/35 flex items-center justify-center z-50"
       data-publish-modal>
    <div class="bg-white border-2 border-gray-900 p-8 max-w-2xl mx-auto">
      <h2 class="text-2xl font-bold text-gray-900 mb-4">Publish <%= resource_label %></h2>

      <p class="text-gray-700 mb-6">
        <% if @missing_requirements.any? %>
          Before publishing, fill in the fields below.
        <% else %>
          Are you ready to publish this <%= resource_label.downcase %>? Your current edits will be saved.
        <% end %>
      </p>

      <% if show_postmark_warning %>
        <div class="bg-yellow-50 border border-yellow-400 px-3 py-2 mb-6 text-sm">
          <strong class="text-yellow-800">⚠ Postmark isn't configured.</strong>
          <span class="text-yellow-800">
            You can still publish, but if Distribution is set to <em>Newsletter</em> or <em>Site &amp; Newsletter</em>, no email will actually go out until you
            <%= link_to "configure Postmark", admin_edit_newsletters_config_path, class: "underline hover:text-yellow-900" %>.
          </span>
        </div>
      <% end %>

      <%# No form wrapper — Confirm injects these values into the main editor %>
      <%# form and submits that, so the post's content + metadata save in one  %>
      <%# go (along with status: published).                                    %>
      <div class="space-y-6">
        <% @missing_requirements.each do |req| %>
          <%
            kind = media_field_kinds[req[:name].to_s]
            is_media = kind.present?
            has_paired_duration = is_media && @paired_duration_for == req[:name]
          %>
          <div class="bg-gray-50 border border-gray-300 p-6"
               <% if is_media %>
                 data-controller="media-field"
                 data-media-field-kind-value="<%= kind %>"
               <% end %>>
            <h3 class="font-semibold text-gray-900 mb-3">
              <%= req[:label] %>
              <span class="text-red-600"><sup>*</sup></span>
            </h3>
            <% if req[:hint] %>
              <p class="text-sm <%= req[:missing_file] ? 'text-red-600' : 'text-gray-700' %> mb-4">
                <%= req[:hint] %>
              </p>
            <% end %>

            <% case req[:type].to_sym %>
            <% when :radio %>
              <div class="space-y-3">
                <% req[:options].each do |value, label, description| %>
                  <label class="flex items-start gap-3 cursor-pointer">
                    <input type="radio"
                           name="metadata_fields[<%= req[:name] %>]"
                           value="<%= value %>"
                           <%= 'checked' if req[:current] == value || (req[:current].blank? && req[:default] == value) %>
                           class="mt-1">
                    <div>
                      <div class="font-medium text-gray-900"><%= label %></div>
                      <% if description %>
                        <div class="text-sm text-gray-600"><%= description %></div>
                      <% end %>
                    </div>
                  </label>
                <% end %>
              </div>

            <% when :select %>
              <select name="metadata_fields[<%= req[:name] %>]"
                      class="w-full font-mono text-sm p-2 border border-gray-300">
                <option value="">-- select --</option>
                <% Array(req[:options]).each do |option| %>
                  <option value="<%= option %>"<% if req[:current] == option %> selected<% end %>>
                    <%= option %>
                  </option>
                <% end %>
              </select>

            <% else # :text and media types %>
              <input type="text"
                     name="metadata_fields[<%= req[:name] %>]"
                     value="<%= req[:current] %>"
                     class="w-full font-mono text-sm p-2 border border-gray-300"
                     <% if is_media %>
                       data-media-field-target="input"
                       data-action="input->media-field#checkDebounced blur->media-field#check change->media-field#check"
                     <% end %>
                     <% if req[:hint] && !req[:missing_file] %>placeholder="<%= req[:hint] %>"<% end %>>

              <% if is_media %>
                <p class="text-xs text-red-600 mt-2 <%= req[:missing_file] ? '' : 'hidden' %>"
                   data-media-field-target="warning">
                  ⚠ This file doesn't exist under <code>site/media/</code>.
                </p>
              <% end %>

              <% if req[:name] == 'sku' && @sku_generator_path %>
                <%# Closes the publish modal first (cancelPublish) and then
                    Turbo loads the generator into its sku-generator-modal frame. %>
                <a href="<%= @sku_generator_path %>"
                   data-turbo-frame="sku-generator-modal"
                   data-action="click->editor#cancelPublish"
                   class="text-xs text-blue-600 hover:text-blue-800 underline mt-2 inline-block">
                  Generate SKU →
                </a>
              <% end %>
            <% end %>

            <% if has_paired_duration && @paired_duration %>
              <div class="mt-4">
                <label class="block text-xs font-medium text-gray-700 mb-1">
                  Duration<span class="text-red-600"><sup>*</sup></span>
                </label>
                <input type="text"
                       name="metadata_fields[duration]"
                       value="<%= @paired_duration[:current] %>"
                       placeholder="Auto-filled from file (HH:MM:SS)"
                       class="w-full font-mono text-sm p-2 border border-gray-300"
                       data-media-field-target="duration">
              </div>
            <% end %>
          </div>
        <% end %>

        <%
          # GUID confirmation box for Substack-imported podcast episodes.
          # The GUID is what podcast clients use to dedupe episodes — once
          # this post is published, Roe locks it. We surface it here so
          # the user can verify (read-only) that the original Substack
          # GUID is what'll be published.
          imported_post = local_assigns[:item] || @post
          show_guid_confirmation = imported_post.respond_to?(:metadata) &&
                                   imported_post.metadata['substack_post_id'].present? &&
                                   imported_post.metadata['guid'].present? &&
                                   imported_post.post_type == 'podcast'
        %>
        <% if show_guid_confirmation %>
          <div class="bg-blue-50 border border-blue-300 p-4 text-sm">
            <p class="font-semibold text-blue-900 mb-1">Imported podcast GUID</p>
            <p class="text-blue-800 text-xs mb-2">
              Inherited from the Substack RSS feed. Locked once published so podcast subscribers' apps continue to recognize this episode.
            </p>
            <code class="block font-mono text-xs bg-white border border-blue-200 px-2 py-1 select-all"><%= imported_post.metadata['guid'] %></code>
          </div>
        <% end %>

        <div class="flex items-center gap-3 pt-2">
          <button type="button"
                  data-action="click->editor#completePublish"
                  class="uppercase text-sm px-4 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer">
            Save & Publish
          </button>
          <button type="button"
                  data-action="click->editor#cancelPublish"
                  class="uppercase text-sm px-4 py-2 border border-gray-800 bg-white hover:bg-gray-100 font-mono rounded-xs">
            Cancel
          </button>
        </div>
      </div>
    </div>
  </div>
