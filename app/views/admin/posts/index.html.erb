<div class="px-4 sm:px-0 font-mono"
     data-controller="posts-filter"
     data-posts-filter-total-value="<%= @posts.count %>">

  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900"><%= @title || "Posts" %></h1>
      <p class="mt-2 text-sm text-gray-700"><%= @description || "A list of all posts including drafts and published." %></p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "New Post", new_admin_post_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs" %>
      <%= link_to "Edit Post Template", admin_settings_post_template_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs" %>
    </div>
  </div>

  <!-- Tabs for Post Types -->
  <div class="mt-6 border-b border-gray-200">
    <nav class="-mb-px flex space-x-8" data-posts-filter-target="tabContainer">
      <h2 class="inline-flex items-center text-sm font-medium uppercase py-2">Type:</h2>
      <!-- Always show 'All' -->
      <button data-action="click->posts-filter#filterByType" data-type="all" data-posts-filter-target="tab"
              class="whitespace-nowrap border-b-2 pt-2 pb-[0.4rem] px-1 text-sm font-medium uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
        All
      </button>

      <!-- Show tabs for types that exist -->
      <% ['article', 'podcast', 'music', 'audio', 'video', 'docs'].each do |type| %>
        <% if @existing_types.include?(type) %>
          <button data-action="click->posts-filter#filterByType" data-type="<%= type %>" data-posts-filter-target="tab"
                  class="whitespace-nowrap border-b-2 pt-2 pb-[0.4rem] px-1 text-sm font-medium uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
            <%= type %>
          </button>
        <% end %>
      <% end %>
    </nav>
  </div>

  <!-- Filters & Search -->
  <div class="mt-4 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
    <!-- Status Filter -->
    <div class="shrink-0">
      <select
        data-posts-filter-target="statusFilter"
        data-action="change->posts-filter#filterByStatus"
        class="block w-full bg-white rounded-xs border border-gray-500 text-xs focus:border-blue-50 focus:ring-blue-300 pl-2 pr-7 py-2 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-position-[right_0.20rem_center] bg-no-repeat <%= 'bg-yellow-200 border-yellow-500' if params[:status].present? && params[:status] != 'all' %>">
        <option value="all">All</option>
        <option value="draft"<% if params[:status] == 'draft' %> selected<% end %>>Drafts</option>
        <option value="published"<% if params[:status] == 'published' %> selected<% end %>>Published</option>
        <option value="unlisted"<% if params[:status] == 'unlisted' %> selected<% end %>>Unlisted</option>
      </select>
    </div>

    <!-- Sort Dropdown -->
    <div class="flex-shrink-0">
      <select
        data-posts-filter-target="sortFilter"
        data-action="change->posts-filter#sortBy"
        class="block w-full bg-white rounded-xs border border-gray-500 text-xs focus:border-blue-50 focus:ring-blue-300 pl-2 pr-7 py-2 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-position-[right_0.20rem_center] bg-no-repeat">
        <option value="date-desc">Date (newest first)</option>
        <option value="date-asc">Date (oldest first)</option>
        <option value="title-asc">Title (A-Z)</option>
        <option value="title-desc">Title (Z-A)</option>
        <option value="updated-desc">Recently Modified</option>
      </select>
    </div>

    <!-- Search Input -->
    <div class="grow">
      <!--<label class="block text-xs font-medium text-gray-700 mb-1 uppercase">Search</label>-->
      <input
        type="text"
        data-posts-filter-target="search"
        data-action="input->posts-filter#filterBySearch"
        placeholder="Search by title, filename, tags..."
        class="block w-full rounded-xs border border-gray-500 focus:bg-blue-50 focus:ring-blue-300 text-xs font-mono px-4 py-2 bg-white"
>
    </div>
  </div>

  <!-- Results Counter -->
  <p class="mt-3 text-xs text-gray-500 font-sans">
    Showing <span data-posts-filter-target="count"><%= @posts.count %></span> of <%= @posts.count %> posts
  </p>

  <div class="mt-4 flex flex-col">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <div class="overflow-hidden ring-1 ring-black ring-opacity-5">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-2 pl-6 md:pl-4 pr-3 text-left text-sm font-semibold text-gray-900 uppercase">Title</th>
                <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase text-nowrap">Filename <span class="ml-1 text-[10px] text-gray-400 text-nowrap">(double-click to edit)</span></th>
                <th scope="col" class="px-1.5 py-2 text-left text-sm font-semibold text-gray-900 uppercase">Status</th>
                <th scope="col" class="relative py-1.5 pl-3 md:pr-4 pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white" data-posts-filter-target="tbody">
              <% @posts.each do |post| %>
                <tr data-posts-filter-target="row"
                    data-post-type="<%= post.metadata['post_type'] || 'article' %>"
                    data-status="<%= post.status %>"
                    data-date="<%= post.date&.to_time&.to_i || 0 %>"
                    data-title="<%= post.title %>"
                    data-updated-at="<%= post.updated_at.to_i %>"
                    data-searchable="<%= [
                      post.title,
                      post.url_name,
                      post.metadata['post_type'],
                      post.metadata['tags']&.join(' '),
                      post.status
                    ].compact.join(' ').downcase %>">
                  <td class="max-w-[16rem] py-1.5 pl-6 md:pl-4 pr-3 text-sm font-medium text-gray-900">
                    <div class="flex items-center gap-1.5">
                      <%= link_to post.title || "Untitled", edit_admin_post_path(post), class: "min-w-0 truncate text-blue-600 hover:text-blue-900" %>
                      <% if post.needs_attention? %>
                        <%
                          reasons = []
                          post.missing_type_required_fields.each { |f| reasons << "missing #{f[:name]}" unless f[:name].to_s == 'guid' }
                          post.missing_site_gated_fields.each { |name| reasons << "missing #{name}" }
                          post.missing_media_refs.each { |ref| reasons << "file not found: #{ref[:path]}" }
                          if (orphan = post.invalid_podcast_reference)
                            reasons << "podcast reference invalid: #{orphan}"
                          end
                        %>
                        <span class="shrink-0 inline-block text-base text-amber-600 font-semibold font-sans"
                              title="<%= reasons.join(', ') %>">
                          ⚠
                        </span>
                      <% end %>
                    </div>
                  </td>
                  <td class="max-w-0 px-1.5 py-4 text-sm text-gray-500">
                    <%= render 'shared/inline_rename', resource: post, resource_type: 'post',
                          display_class: "inline-block max-w-full truncate align-bottom" %>
                  </td>
                  <td class="whitespace-nowrap px-1.5 py-4 text-sm text-gray-500">
                    <% case post.status %>
                    <% when 'published' %>
                      <span class="inline-flex bg-green-100 px-2 text-xs font-semibold leading-5 text-green-800">Published</span>
                    <% when 'unlisted' %>
                      <span class="inline-flex bg-yellow-100 px-2 text-xs font-semibold leading-5 text-yellow-800">Unlisted</span>
                    <% else %>
                      <span class="inline-flex bg-gray-100 px-2 text-xs font-semibold leading-5 text-gray-800">Draft</span>
                    <% end %>
                  </td>
                  <td class="relative whitespace-nowrap py-4 pl-3 md:pr-4 pr-6 text-right text-sm font-medium">
                    <div class="flex items-center justify-end gap-2">
                      <%= link_to icon_svg("edit", class: "w-[1.1rem] h-[1.1rem]"), edit_admin_post_path(post),
                            class: "text-slate-400 hover:text-blue-700", title: "Edit", "aria-label": "Edit" %>
                      <%= link_to icon_svg("view", class: "w-[1.1rem] h-[1.1rem]"), post_path(url_name: post.url_name), target: "_blank",
                            class: "text-slate-400 hover:text-slate-600", title: "View", "aria-label": "View" %>
                      <%= button_to icon_svg("duplicate", class: "w-[1.1rem] h-[1.1rem]"), duplicate_admin_post_path(post), method: :post,
                            form: { class: "inline-flex" },
                            class: "text-slate-400 hover:text-blue-700 cursor-pointer", title: "Duplicate", "aria-label": "Duplicate" %>
                      <button type="button"
                              data-action="delete"
                              data-resource-id="<%= post.id %>"
                              data-resource-title="<%= post.title || post.filename %>"
                              data-resource-type="post"
                              data-delete-url="<%= admin_post_path(post) %>"
                              class="text-slate-400 hover:text-red-700 cursor-pointer"
                              title="Delete" aria-label="Delete">
                        <%= icon_svg("delete", class: "w-[1.1rem] h-[1.1rem]") %>
                      </button>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <%# One delete modal for the whole table; delete_modal.js retargets its form
      to the clicked row's post via data-delete-url. %>
  <% if @posts.any? %>
    <%= render "shared/delete_file_modal", resource: @posts.first, resource_type: "post" %>
  <% end %>
</div>
