<!DOCTYPE html>
<html>
<head>
  <title>Edit: <%= @post.title || 'Untitled' %></title>
</head>
<body class="bg-white text-black p-5" data-turbo-action="replace" data-md-editor>

  <% if @post.metadata['_yaml_parse_error'].present? %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-3 mb-3">
      <div class="flex">
        <div class="shrink-0">
          <svg class="h-5 w-5 text-yellow-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
        </div>
        <div class="ml-3">
          <p class="text-sm text-yellow-700">
            <strong>YAML Parsing Error:</strong> <%= @post.metadata['_yaml_parse_error'] %>
            <br>
            <span class="text-xs">The metadata below was partially recovered. Saving this form will fix the YAML formatting.</span>
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <!-- HEADER SECTION -->
  <div class="flex justify-between gap-3 items-start pb-2.5 relative">
    <div class="">
      <h1 class="text-xl font-bold leading-none">Edit Post: <%= @post.title %></h1>
      <div class="flex items-center">
      <%= render 'shared/inline_rename', resource: @post, resource_type: 'post', return_to: edit_admin_post_path(@post) %>
      </div>
    </div>
    <div class="flex items-center gap-2">
    <%= link_to "← Back to Posts", admin_posts_path, class: "inline-flex items-center uppercase text-sm px-1.5 pt-1 pb-0.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs text-nowrap" %>
    </div>
  </div>

  <% if flash[:warning] %>
    <div class="px-2.5 py-1 mb-5 border border-gray-300 bg-yellow-50"><%= flash[:warning] %></div>
  <% end %>

  <% if @post.needs_attention? %>
    <div class="bg-red-50 border border-amber-400 px-3 py-2 mb-5 text-sm">
      <strong class="text-amber-700">⚠ This post is published but has issues:</strong>
      <ul class="list-disc ml-5 mt-1 text-amber-700">
        <% @post.missing_type_required_fields.each do |field| %>
          <% next if field[:name].to_s == 'guid' %>
          <li>Missing required field: <code><%= field[:name] %></code></li>
        <% end %>
        <% @post.missing_site_gated_fields.each do |name| %>
          <li>Missing required field: <code><%= name %></code></li>
        <% end %>
        <% @post.missing_media_refs.each do |ref| %>
          <li>File not found: <code><%= ref[:path] %></code> (<%= ref[:field] %>)</li>
        <% end %>
        <% if (orphan = @post.invalid_podcast_reference) %>
          <li>
            Podcast <code><%= orphan %></code> doesn't exist in <code>podcast.yml</code>.
            Pick a valid podcast in the metadata editor.
          </li>
        <% end %>
      </ul>
      <p class="text-xs text-amber-600 mt-2 italic">Save your changes to refresh this list.</p>
    </div>
  <% end %>

  <% if @post.informational_notices.any? %>
    <div class="bg-blue-50 border border-blue-300 px-3 py-2 mb-5 text-sm text-blue-800">
      <% @post.informational_notices.each do |note| %>
        <p>ℹ︎ <%= note %></p>
      <% end %>
    </div>
  <% end %>

  <!-- Wrap everything in Stimulus controller -->
  <div data-controller="editor"
       data-editor-resource-type-value="post"
       data-editor-resource-id-value="<%= @post.id %>"
       data-editor-preview-path-value="<%= @preview_path || preview_admin_post_path(@post) %>"
       data-editor-collection-template-value="<%= SiteConfig.default('collections', 'button_template') %>"
       data-editor-aside-template-value="<%= SiteConfig.default('cards', 'aside_button_template') %>"
       data-editor-post-link-template-value="<%= SiteConfig.default('cards', 'post_link_button_template') %>"
       data-editor-pullquote-template-value="<%= SiteConfig.default('cards', 'pullquote_button_template') %>"
       data-editor-product-template-value="<%= SiteConfig.feature('store', 'product_button_template') %>"
       data-editor-currency-symbol-value="<%= store_currency_symbol %>"
       data-editor-highlight-media-value="<%= params[:highlight] %>">
    <div id="resend-modal-container"></div>

    <div class="mb-5 flex justify-between items-center">
      <div class="flex gap-2.5 items-baseline">
          <button type="submit" form="post-form" class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">Save</button>

        <button type="button"
                data-action="click->editor#preview"
                class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
          Preview
        </button>

        <%# View link shows when the post is publicly reachable on the
            live site — status: published OR status: unlisted. Reading
            metadata["status"] directly (rather than .published? / .public?)
            because HasMetadata#status defaults to "published" when the
            field is absent, which would falsely show View on items that
            haven't been explicitly published yet. %>
        <% if %w[published unlisted].include?(@post.metadata["status"].to_s.downcase) %>
          <%= link_to "View", @post.public_url, target: "_blank",
                class: "uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.2rem]" %>
        <% end %>

        <% if newsletters_enabled? %>
          <button type="button"
                  data-action="click->editor#sendTestEmail"
                  data-editor-test-email-url="<%= send_test_email_admin_post_path(@post) %>"
                  data-editor-default-email="<%= SiteConfig.current('site')&.config&.dig('author_email') %>"
                  class="uppercase text-xs px-1.5 py-0 border border-blue-600 bg-blue-50 hover:bg-blue-100 text-blue-700 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] flex">
            <span class="pt-[0.1rem]">Send Test</span>
            <svg version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 18.9844 13.3496" class="max-w-4 inline-block ml-2 my-0">
             <g>
              <rect height="13.3496" opacity="0" width="18.9844" x="0" y="0"/>
              <path d="M2.49023 13.3496L16.4062 13.3496C17.793 13.3496 18.623 12.5391 18.623 10.8984L18.623 2.46094C18.623 0.820312 17.7832 0.00976562 16.1328 0.00976562L2.2168 0.00976562C0.820312 0.00976562 0 0.820312 0 2.46094L0 10.8984C0 12.5391 0.830078 13.3496 2.49023 13.3496ZM2.43164 12.0215C1.73828 12.0215 1.33789 11.6406 1.33789 10.8984L1.33789 2.45117C1.33789 1.71875 1.73828 1.33789 2.43164 1.33789L16.1816 1.33789C16.8848 1.33789 17.2852 1.71875 17.2852 2.46094L17.2852 10.9082C17.2852 11.6406 16.8848 12.0215 16.1816 12.0215ZM13.5645 5.13672L15.5078 5.13672C15.8496 5.13672 16.1035 4.88281 16.1035 4.54102L16.1035 3.125C16.1035 2.7832 15.8496 2.5293 15.5078 2.5293L13.5645 2.5293C13.2227 2.5293 12.9688 2.7832 12.9688 3.125L12.9688 4.54102C12.9688 4.88281 13.2227 5.13672 13.5645 5.13672ZM6.36719 7.95898L12.2461 7.95898C12.5488 7.95898 12.7832 7.72461 12.7832 7.42188C12.7832 7.12891 12.5488 6.89453 12.2461 6.89453L6.36719 6.89453C6.07422 6.89453 5.83008 7.12891 5.83008 7.42188C5.83008 7.72461 6.07422 7.95898 6.36719 7.95898ZM6.36719 10.0293L10.791 10.0293C11.0938 10.0293 11.3281 9.78516 11.3281 9.49219C11.3281 9.19922 11.0938 8.95508 10.791 8.95508L6.36719 8.95508C6.07422 8.95508 5.83008 9.19922 5.83008 9.49219C5.83008 9.78516 6.07422 10.0293 6.36719 10.0293Z" fill="black" fill-opacity="0.85"/>
             </g>
            </svg>

          </button>
        <% end %>

        <div id="publish-button-container">
          <% unless @post.published? %>
            <button type="button"
                    data-action="click->editor#confirmPublish"
                    data-editor-post-id="<%= @post.id %>"
                    class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
              Publish
            </button>
          <% else %>
            <form action="<%= unpublish_admin_post_path(@post) %>"
                  method="post"
                  data-turbo="false"
                  data-action="submit->editor#confirmUnpublish">
              <input type="hidden" name="_method" value="patch">
              <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
              <button type="submit"
                      class="uppercase text-xs px-1.5 py-0 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem]">
                Unpublish
              </button>
            </form>
          <% end %>
        </div>
      </div>

      <!-- Right: Duplicate + Delete -->
      <div class="flex items-center gap-1">
        <%= button_to "Duplicate", duplicate_admin_post_path(@post), method: :post,
              form: { class: "inline" },
              class: "uppercase text-xs px-1.5 py-0 border border-gray-600 bg-gray-50 hover:bg-gray-100 text-gray-700 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer" %>
        <%= button_to "Delete", admin_post_path(@post), method: :delete,
              form: { class: "inline", data: { turbo_confirm: "Delete “#{@post.title || 'this post'}”? This cannot be undone." } },
              class: "uppercase text-xs px-1.5 py-0 border border-red-600 bg-red-50 hover:bg-red-100 text-red-700 font-mono rounded-xs h-4.5 leading-none pt-[0.1rem] cursor-pointer" %>
      </div>
    </div>

    <%= render 'shared/editor',
          form_url: admin_post_path(@post),
          resource_type: 'post',
          metadata: @metadata.gsub(/^---\n/, ''),
          content: @content,
          show_metadata: true,
          preview_path: @preview_path || preview_admin_post_path(@post),
          item: @post,
          metadata_config: @metadata_config,
          default_author: @default_author %>

  </div>
  <!-- End Stimulus controller -->

  <%= render 'shared/delete_file_modal', resource: @post, resource_type: 'post' %>

  <%# Trigger preview-window refresh for plain saves AND save-and-publish
      (controller flashes "Post published" or "Post published. Newsletter
      is being sent in the background." in those cases). %>
  <% if flash[:notice]&.match?(/\APost (saved|published)/) %>
    <div id="post-saved-trigger" data-trigger="refresh" style="display: none;"></div>
  <% end %>
</body>
</html>
