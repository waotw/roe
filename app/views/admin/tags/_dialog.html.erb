<%#
  The MANAGE TAGS window. Rendered outside the settings form — the tag
  manager has forms of its own, and forms can't nest. Needs an ancestor with
  data-controller="tag-dialog", which the MANAGE TAGS button shares.
%>
<div data-tag-dialog-target="dialog" data-action="click->tag-dialog#backdrop"
     class="hidden fixed inset-0 bg-black/60 flex items-start justify-center overflow-y-auto py-12" style="z-index: 100">
  <div class="bg-white p-6 shadow-xl max-w-3xl w-full mx-4 border border-gray-300" role="dialog" aria-label="Manage tags">
    <turbo-frame id="tag_manager" data-tag-dialog-target="frame" data-src="<%= admin_tags_path %>">
      <p class="text-sm text-gray-500 font-mono">Loading…</p>
    </turbo-frame>
  </div>
</div>
