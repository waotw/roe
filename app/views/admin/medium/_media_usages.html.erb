<%# A media card's "Used in" line, with the rest in a hover list. Rendered
    in the card, or fetched for cards on screen (MediumController#usages).
    Locals: usages. %>
<% if usages.any? %>
  <div class="text-xs text-gray-600 mt-2 flex flex-wrap items-baseline gap-x-1 gap-y-0.5">
    <div class="flex items-baseline gap-1 min-w-0 max-w-full">
      <span class="shrink-0">Used in:</span>
      <span class="text-gray-400 uppercase tracking-wide text-[10px] shrink-0"><%= usages.first[:type] %></span>
      <%# $ marks a reference that protects this file. %>
      <% if usages.first[:paid] %>
        <span class="text-green-700 font-semibold shrink-0" title="Paid — this reference protects the file">$</span>
      <% end %>
      <%= link_to usages.first[:label],
                           usages.first[:url],
                           class: "text-blue-600 hover:text-blue-800 hover:underline truncate min-w-[3rem]",
                           onclick: "event.stopPropagation()" %>
    </div>
    <% if usages.size > 1 %>
      <span class="relative group/uses inline-block shrink-0">
        <span class="text-gray-400 cursor-help">(+<%= usages.size - 1 %> more)</span>

        <!-- Popover with other references -->
        <div class="hidden group-hover/uses:block absolute z-50 bg-white border border-gray-400 shadow-lg p-2 rounded-xs min-w-48 max-h-48 overflow-y-auto left-0 -top-0.5 mt-1">
          <div class="text-xs font-semibold text-gray-700 mb-1 pb-1 border-b border-gray-300">
            Also used in:
          </div>
          <% usages[1..-1].each do |usage| %>
            <div class="flex items-baseline gap-1 py-1 px-1 -mx-1 rounded hover:bg-blue-50">
              <span class="text-gray-400 uppercase tracking-wide text-[10px] shrink-0"><%= usage[:type] %></span>
              <% if usage[:paid] %>
                <span class="text-green-700 font-semibold shrink-0" title="Paid — this reference protects the file">$</span>
              <% end %>
              <%= link_to usage[:label],
                          usage[:url],
                          class: "block text-xs text-blue-600 hover:text-blue-800",
                          onclick: "event.stopPropagation()" %>
            </div>
          <% end %>
        </div>
      </span>
    <% end %>
  </div>
<% else %>
  <div class="text-xs text-gray-400 mt-2">Unused</div>
<% end %>
