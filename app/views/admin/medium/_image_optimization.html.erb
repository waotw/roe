<%# Image variants generate automatically now — a baseline on upload/sync
    and the rest on-demand when an image is actually rendered — so there's
    no per-image status to manage or surface here. The one thing still
    worth flagging is a missing libvips, which silently disables
    optimization (images serve at full size) until it's installed. %>
<% unless ImageVariantGenerator.available? %>
  <div class="mt-3 p-3 border border-amber-300 bg-amber-50 rounded">
    <div class="flex items-start gap-2">
      <span class="text-amber-600">⚠️</span>
      <div>
        <p class="text-sm text-amber-800 font-medium">Image optimization disabled</p>
        <p class="text-xs text-amber-700 mt-1">
          libvips isn't installed, so images are served at full size. Install it to enable responsive variants.
        </p>
        <%= link_to "Install libvips →", admin_dependencies_path, class: "inline-block text-xs font-medium text-amber-800 underline hover:text-amber-900 mt-1" %>
      </div>
    </div>
  </div>
<% end %>
