<%# One media item in the browse grid. Locals: media, usages (array).
    Also rendered server-side after an upload (see MediumController#create) and
    injected at the top of the grid by the media-upload Stimulus controller. %>
<% variants_pending = media.media_type == 'images' && ImageVariantGenerator.available? &&
                      media.variant_stats.present? && !media.variant_stats[:ready] %>
<div class="border border-gray-300 p-2 hover:bg-gray-50 group relative"
     data-media-filter-target="item"
     data-variants-pending="<%= variants_pending %>"
     data-media-type="<%= media.media_type %>"
     data-has-references="<%= usages.any? %>"
     data-usage-global="<%= usages.any? { |u| u[:global] } %>"
     data-filename="<%= File.basename(media.file_path).downcase %>"
     data-uploaded-at="<%= media.created_at.to_i %>"
     data-file-size="<%= File.size?(File.join(RoeSitePaths::SITE_PATH, media.file_path.delete_prefix('/'))) || 0 %>"
     data-searchable="<%= File.basename(media.file_path).downcase %>"
     data-media-id="<%= media.id %>">

  <!-- Selection Checkbox -->
  <input type="checkbox"
         data-media-bulk-select-target="checkbox"
         data-media-id="<%= media.id %>"
         data-action="change->media-bulk-select#updateSelection"
         class="absolute top-3 left-3 w-5 h-5 cursor-pointer z-10 rounded border-gray-400"
         onclick="event.stopPropagation()">

  <!-- Image/Icon -->
  <div onclick="selectMedia('<%= j(media.file_path) %>', '<%= j(File.basename(media.file_path)) %>')"
       class="cursor-pointer">
    <% if media.media_type == 'images' %>
      <div class="relative">
        <% if ImageVariantGenerator.available? && media.variants_ready? %>
          <%= image_tag image_variant_path(media.file_path, :small), alt: File.basename(media.file_path), class: "w-full h-32 object-cover mb-2", loading: "lazy" %>
        <% else %>
          <%= image_tag media.file_path, alt: File.basename(media.file_path), class: "w-full h-32 object-cover mb-2", loading: "lazy" %>
        <% end %>

        <% if ImageVariantGenerator.available? %>
          <% variant_stats = media.variant_stats %>
          <% if variant_stats && !variant_stats[:ready] %>
            <div class="absolute top-1 right-1 bg-amber-500 text-white text-xs px-1.5 py-0.5 rounded">
              ⏳ <%= variant_stats[:generated] %>/<%= variant_stats[:total] %>
            </div>
            <%= button_to "⚡",
                          regenerate_variants_admin_medium_path(media),
                          method: :post,
                          class: "absolute top-7 right-1 bg-blue-500 text-white text-xs px-1.5 py-0.5 rounded hover:bg-blue-600",
                          title: "Generate variants",
                          data: { turbo: false } %>
          <% elsif variant_stats && variant_stats[:ready] %>
            <div class="absolute top-1 right-1 border border-mist-300 bg-lime-600 text-white text-xs px-1.5 py-0.5 rounded" title="Variants ready: <%= ImageVariantGenerator::VARIANTS.keys.join(', ') %>">
              ✓
            </div>
          <% end %>
        <% end %>
      </div>
    <% elsif media.media_type == 'audio' %>
      <div class="w-full h-32 bg-gray-200 mb-2 flex items-center justify-center">
        <span class="text-4xl">🎵</span>
      </div>
    <% elsif media.media_type == 'video' %>
      <div class="w-full h-32 bg-gray-200 mb-2 flex items-center justify-center">
        <span class="text-4xl">🎬</span>
      </div>
    <% end %>

    <!-- Filename -->
    <div class="mb-1">
      <%= render 'shared/inline_rename_media', media: media %>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col gap-1">
      <button onclick="copyUrl(event, '<%= j(media.file_path) %>')"
            class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-blue-100 hover:bg-blue-300 font-mono rounded-xs">
          Copy URL
        </button>
      <button onclick="copyMarkdown(event, '<%= j(media.file_path) %>', '<%= j(File.basename(media.file_path)) %>')"
          class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs">
        Markdown Link
      </button>
    </div>

    <!-- Usage Badge: posts, pages, docs, products, and config files -->
    <% if usages.any? %>
      <div class="text-xs text-gray-600 mt-2 flex flex-wrap items-baseline gap-x-1 gap-y-0.5">
        <div class="flex items-baseline gap-1 min-w-0 max-w-full">
          <span class="shrink-0">Used in:</span>
          <span class="text-gray-400 uppercase tracking-wide text-[10px] shrink-0"><%= usages.first[:type] %></span>
          <%= link_to usages.first[:label],
                               usages.first[:url],
                               class: "text-blue-600 hover:text-blue-800 hover:underline truncate min-w-[3rem]",
                               onclick: "event.stopPropagation()" %>
        </div>
        <% if usages.size > 1 %>
          <span class="relative group/uses inline-block shrink-0">
            <span class="text-gray-400 cursor-help">(+<%= usages.size - 1 %> more)</span>

            <!-- Popover with other references -->
            <div class="hidden group-hover/uses:block absolute z-50 bg-white border border-gray-400 shadow-lg p-2 rounded-xs min-w-48 max-h-48 overflow-y-auto left-0 -top-0.5 mt-1">
              <div class="text-xs font-semibold text-gray-700 mb-1 pb-1 border-b border-gray-300">
                Also used in:
              </div>
              <% usages[1..-1].each do |usage| %>
                <div class="flex items-baseline gap-1 py-1 px-1 -mx-1 rounded hover:bg-blue-50">
                  <span class="text-gray-400 uppercase tracking-wide text-[10px] shrink-0"><%= usage[:type] %></span>
                  <%= link_to usage[:label],
                              usage[:url],
                              class: "block text-xs text-blue-600 hover:text-blue-800",
                              onclick: "event.stopPropagation()" %>
                </div>
              <% end %>
            </div>
          </span>
        <% end %>
      </div>
    <% else %>
      <div class="text-xs text-gray-400 mt-2">Unused</div>
    <% end %>
  </div> <!-- end clickable area -->

</div>
