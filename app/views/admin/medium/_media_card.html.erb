<%# One media item in the browse grid. Locals: media, usages (array),
    mixed, lazy_usages.

    Also rendered on its own after an upload or a preview poll
    (MediumController#create and #card) and injected into the grid by the
    media-upload Stimulus controller.

    Kept light, because the browse page renders every file at once:
    - an image never shows its full-size original while a preview can be
      made (media_grid_preview); the card shows a box and is polled instead;
    - the rename form is one shared form the media-rename controller moves
      into whichever card is double-clicked;
    - with lazy_usages, "Used in" is fetched by media-lazy when the card
      scrolls into view (MediumController#usages). The flags the tabs filter
      on (data-has-references, data-usage-global) are still here;
    - content-visibility lets the browser skip laying out off-screen cards. %>
<% preview = media.media_type == "images" ? media_grid_preview(media.file_path) : nil %>
<% variants_pending = (preview && preview.first == :placeholder) ||
                     (media.media_type == 'video' && VideoVariantGenerator.status_for(media)[:state] == 'optimizing') %>
<div class="border border-gray-300 p-2 hover:bg-gray-50 group relative [content-visibility:auto] [contain-intrinsic-size:auto_16rem]"
     data-media-filter-target="item"
     data-variants-pending="<%= variants_pending %>"
     data-media-type="<%= media.media_type %>"
     data-has-references="<%= usages.any? %>"
     data-usage-global="<%= usages.any? { |u| u[:global] } %>"
     data-audience="<%= media.audience %>"
     data-mixed="<%= local_assigns[:mixed] ? true : false %>"
     data-filename="<%= File.basename(media.file_path).downcase %>"
     data-uploaded-at="<%= media.created_at.to_i %>"
     data-file-size="<%= File.size?(File.join(RoeSitePaths::SITE_PATH, media.file_path.delete_prefix('/'))) ||
                         (media.media_type == 'video' && VideoVariantGenerator.stand_in_size_for(media.file_path)) || 0 %>"
     data-searchable="<%= File.basename(media.file_path).downcase %>"
     data-media-id="<%= media.id %>">

  <!-- Selection Checkbox -->
  <input type="checkbox"
         data-media-bulk-select-target="checkbox"
         data-media-id="<%= media.id %>"
         data-file-path="<%= media.file_path %>"
         data-filename="<%= File.basename(media.file_path) %>"
         data-action="change->media-bulk-select#updateSelection"
         class="absolute top-3 left-3 w-5 h-5 cursor-pointer z-10 rounded border-gray-400"
         onclick="event.stopPropagation()">

  <!-- Image/Icon -->
  <div onclick="selectMedia('<%= j(media.file_path) %>', '<%= j(File.basename(media.file_path)) %>')"
       class="cursor-pointer">
    <% if media.media_type == 'images' %>
      <div class="relative">
        <% if preview.first == :placeholder %>
          <%# Preview not made yet: a box, never the original. The card is
              polled while it's on screen, which queues the preview, and
              swapped for the finished card. %>
          <div class="w-full h-32 mb-2 bg-gray-100 border border-dashed border-gray-300 flex items-center justify-center gap-1 text-xs text-gray-400 font-mono" data-preview-box>preview…</div>
        <% else %>
          <%= image_tag preview.last, alt: File.basename(media.file_path), class: "w-full h-32 object-cover mb-2", loading: "lazy" %>
        <% end %>
      </div>
    <% elsif media.media_type == 'audio' %>
      <div class="w-full h-32 bg-gray-200 mb-2 flex items-center justify-center">
        <span class="text-4xl">🎵</span>
      </div>
    <% elsif media.media_type == 'video' %>
      <%# Poster + progress while optimizing. Clicking it while optimizing
          reopens the progress window (media-upload#openFromCard); the
          media-upload controller polls the card and swaps it until it's
          done (data-variants-pending). %>
      <div class="mb-2" data-action="click->media-upload#openFromCard"><%= render "admin/medium/video_thumbnail", media: media, height: "h-32" %></div>
    <% end %>

    <!-- Filename -->
    <div class="mb-1">
      <%# The edit form is the media-rename controller's shared one, put in
          here on double-click. %>
      <div class="inline-rename-container"
           data-media-id="<%= media.id %>"
           data-rename-url="<%= rename_admin_medium_path(media) %>"
           data-name="<%= File.basename(media.file_path, File.extname(media.file_path)) %>"
           data-extension="<%= File.extname(media.file_path) %>">
        <p class="filename-display font-mono text-xs text-gray-600 bg-gray-200 cursor-pointer hover:text-white hover:bg-gray-400 px-1 py-0.5 rounded-xs truncate"
           data-action="dblclick->media-rename#start"
           title="Double-click to rename"><%= File.basename(media.file_path) %></p>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col gap-1">
      <button onclick="copyUrl(event, '<%= j(media.file_path) %>')"
            class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-blue-100 hover:bg-blue-300 font-mono rounded-xs">
          Copy URL
        </button>
      <button onclick="copyMarkdown(event, '<%= j(media.file_path) %>', '<%= j(File.basename(media.file_path)) %>')"
          class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs">
        Markdown Link
      </button>
    </div>

    <!-- Usage Badge: posts, pages, docs, products, and config files -->
    <% if usages.any? && local_assigns[:lazy_usages] %>
      <%# Filled by media-lazy once the card is on screen. Same height as the
          line it becomes, so nothing jumps. %>
      <div class="text-xs text-gray-300 mt-2" data-usages-pending="<%= media.id %>">Used in: …</div>
    <% else %>
      <%= render "admin/medium/media_usages", usages: usages %>
    <% end %>
  </div> <!-- end clickable area -->

</div>
