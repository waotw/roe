<!DOCTYPE html>
<html>
<head>
  <title>Media Browser</title>
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>
  <%= stylesheet_link_tag "application" %>
</head>
<body class="bg-white text-black p-5">

  <div class="mb-5 pb-2.5 border-b border-gray-300">
    <h1 class="text-2xl font-bold">Select Image</h1>
  </div>

  <!-- Upload Form -->
  <div class="mb-5 p-4 border border-gray-300 bg-gray-50">
    <div class="flex gap-2 items-center">
      <input type="file" id="browse-media-upload" accept="image/*" style="display: none;" onchange="handleBrowseUpload(event)">
      <button type="button" onclick="document.getElementById('browse-media-upload').click()" class="uppercase text-xs px-2 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs">
        Upload
      </button>
      <span id="upload-status" class="text-sm text-gray-600"></span>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mb-5 px-2.5 py-1 border border-gray-300 bg-green-100">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <!-- Media Grid -->
  <% if @media.any? %>
    <div class="grid grid-cols-4 gap-4">
      <% @media.each do |media| %>
        <div class="border border-gray-300 p-2 hover:bg-gray-50 cursor-pointer group relative" onclick="selectMedia('<%= media.file_path %>', '<%= File.basename(media.file_path) %>')">
          <img src="<%= media.file_path %>" alt="<%= File.basename(media.file_path) %>" class="w-full h-32 object-cover mb-2">
          <div class="mb-1">
            <%= render 'shared/inline_rename_media', media: media %>
          </div>
          <div class="flex flex-col gap-1">
            <button onclick="copyUrl(event, '<%= media.file_path %>')"
                  class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-blue-100 hover:bg-blue-300 font-mono rounded-xs">
                Copy URL
              </button>
            <button onclick="copyMarkdown(event, '<%= media.file_path %>', '<%= File.basename(media.file_path) %>')"
                class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs">
              Markdown Link
            </button>
            <%= button_to "×", admin_medium_path(media),
                method: :delete,
                class: "absolute top-1 right-1 w-6 h-6 bg-red-600 text-white hover:bg-red-700 opacity-0 group-hover:opacity-100 transition-opacity text-center leading-none",
                form: {
                  onsubmit: "event.stopPropagation(); return confirm('Delete this image?')",
                  class: "inline"
                } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-600">No images uploaded yet.</p>
  <% end %>

  <script>
  function handleBrowseUpload(event) {
    const file = event.target.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('meta[name="csrf-token"]').content;
    const status = document.getElementById('upload-status');
    status.textContent = 'Uploading...';

    fetch('/admin/medium', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': token
      },
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        status.textContent = 'Upload successful!';
        setTimeout(() => location.reload(), 500);
      } else {
        status.textContent = 'Upload failed: ' + data.error;
      }
    })
    .catch(error => {
      status.textContent = 'Upload error: ' + error;
    });

    event.target.value = '';
  }

    function selectMedia(path, filename) {
      // Send message to parent window (the editor)
      if (window.opener) {
        window.opener.postMessage({
          type: 'media-selected',
          path: path,
          filename: filename
        }, '*');
        window.close();
      }
    }

    function copyMarkdown(event, path, filename) {
      const markdown = `![${filename}](${path})`;

      // Copy to clipboard
      navigator.clipboard.writeText(markdown).then(() => {
        // Show temporary feedback
        const btn = event.target;
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('bg-green-200');

        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('bg-green-200');
        }, 1500);
      }).catch(err => {
        alert('Failed to copy: ' + err);
      });
    }

    function copyUrl(event, path) {
      // Copy just the path to clipboard
      navigator.clipboard.writeText(path).then(() => {
        // Show temporary feedback
        const btn = event.target;
        const originalText = btn.textContent;
        btn.textContent = 'Copied!';
        btn.classList.add('bg-green-200');

        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('bg-green-200');
        }, 1500);
      }).catch(err => {
        alert('Failed to copy: ' + err);
      });
    }
  </script>

</body>
</html>
