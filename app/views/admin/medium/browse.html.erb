<div class="mb-1 pb-2 border-b border-gray-300">
  <div class="flex items-start justify-between">
      <h1 class="text-2xl font-bold">Media Browser</h1>
      <div class="flex flex-col items-end gap-1">
        <%= link_to "SYSTEM IMAGES", browse_images_admin_system_assets_path, target: "_blank", class: "uppercase text-xs px-1.5 py-0.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
        <%= button_to "PRUNE VARIANTS",
                      prune_variants_admin_medium_index_path,
                      method: :post,
                      form: { data: { turbo: false },
                              onsubmit: "return confirm('Reduce variants for unused images and delete variants for images that have been deleted? In-use variants and original images are untouched.');" },
                      class: "uppercase text-[.65rem] text-amber-700 px-1.5 py-0.5 border border-amber-800 bg-amber-200 hover:bg-amber-300 font-mono rounded-xs" %>
        <%= link_to "About variants ↗", "https://go-roe.com/documentation/image-optimization", target: "_blank", class: "text-xs text-gray-400 hover:text-gray-600 underline" %>
      </div>
  </div>
  <%= render 'image_optimization' %>
</div>

<div data-controller="media-filter media-bulk-select media-upload"
     data-media-filter-total-value="<%= @media.count %>">

  <!-- Tabs for Media Types -->
  <div class="mb-4 border-b border-gray-200">
      <div class="flex justify-between items-center">
      <nav class="-mb-px flex space-x-8">
        <!-- Always show 'All' -->
        <button
          data-action="click->media-filter#filterByType"
          data-type="all"
          data-media-filter-target="tab"
          class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-mono uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          All
        </button>

        <!-- Show tabs for types that exist -->
        <% if @existing_types.include?('images') %>
          <button data-action="click->media-filter#filterByType" data-type="images" data-media-filter-target="tab" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-mono uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
            Images
          </button>
        <% end %>

        <% if @existing_types.include?('audio') %>
          <button data-action="click->media-filter#filterByType" data-type="audio" data-media-filter-target="tab" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-mono uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
            Audio
          </button>
        <% end %>

        <% if @existing_types.include?('video') %>
          <button data-action="click->media-filter#filterByType" data-type="video" data-media-filter-target="tab" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-mono uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
            Video
          </button>
        <% end %>
        <% if @has_global_media && MediaUsageIndex.global_tab_enabled? %>
          <button data-action="click->media-filter#filterByType" data-type="global" data-media-filter-target="tab" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-mono uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
            Global
          </button>
        <% end %>
          <button data-action="click->media-filter#filterByType" data-type="unused" data-media-filter-target="tab" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-mono uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
            Unused
          </button>
      </nav>
      <!-- Upload Form -->
      <%= form_with url: admin_medium_index_path, method: :post, multipart: true, local: true do |f| %>
        <%= f.file_field :files,
            accept: 'image/*,audio/*,video/*',
            multiple: true,
            class: "hidden",
            id: "file-upload-input",
            name: "files[]",
            data: { media_upload_target: "input", action: "change->media-upload#upload" } %>

        <label for="file-upload-input" class="cursor-pointer inline-flex items-center uppercase text-base text-white px-3 py-1 border border-lime-900 bg-lime-700 hover:bg-lime-600 font-mono rounded-xs">
          UPLOAD
        </label>
      <% end %>
    </div>
  </div>

  <!-- Bulk Action Toolbar -->
  <div data-media-bulk-select-target="toolbar"
       class="mb-4 p-3 border border-blue-300 bg-blue-50 rounded-xs"
       style="display: none;">
    <div class="flex items-center justify-between">
      <div class="text-xs font-mono text-blue-800">
        <span data-media-bulk-select-target="selectedCount">0</span> selected
      </div>
      <div class="flex gap-2">
        <button data-action="click->media-bulk-select#selectAllVisible"
                class="ml-3 text-xs px-3 py-1.5 border border-blue-600 bg-blue-100 hover:bg-blue-200 rounded-xs font-mono uppercase">
          Select All Visible
        </button>
        <button data-action="click->media-bulk-select#clearSelection"
                class="text-xs px-3 py-1.5 border border-gray-600 bg-white hover:bg-gray-100 rounded-xs font-mono uppercase">
          Clear Selection
        </button>
        <%= button_to "Delete Selected",
                      bulk_destroy_admin_medium_index_path,
                      method: :post,
                      form: {
                        data: {
                          action: "submit->media-bulk-select#submitDelete"
                        }
                      },
                      class: "text-xs px-3 py-1.5 border border-red-600 bg-red-100 hover:bg-red-200 rounded-xs font-mono uppercase" %>
      </div>
    </div>
  </div>

  <!-- Filters & Search -->
  <div class="mb-4 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
    <!-- Sort Dropdown -->
    <div class="flex-shrink-0">
      <select
        data-media-filter-target="sortFilter"
        data-action="change->media-filter#sortBy"
        class="block w-full bg-white rounded-xs border border-gray-500 text-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2 pr-12 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.75rem_center] bg-no-repeat">
        <option value="date-desc">Upload date (newest first)</option>
        <option value="date-asc">Upload date (oldest first)</option>
        <option value="name-asc">Filename (A-Z)</option>
        <option value="name-desc">Filename (Z-A)</option>
        <option value="size-desc">File size (largest first)</option>
        <option value="size-asc">File size (smallest first)</option>
      </select>
    </div>

    <!-- Search Input -->
    <div class="flex-grow">
      <input
        type="text"
        data-media-filter-target="search"
        data-action="input->media-filter#filterBySearch"
        placeholder="Search by filename..."
        class="block w-full rounded-xs border border-gray-500 focus:bg-blue-50 focus:ring-blue-300 sm:text-sm font-mono px-4 py-2 bg-white"
>
    </div>
  </div>

  <!-- Results Counter + audience toggles -->
  <div class="mb-4 flex items-center justify-between gap-4">
    <p class="text-xs text-gray-500 font-sans">
      Showing <span data-media-filter-target="count"><%= @media.count %></span> of <%= @media.count %> files<span data-media-filter-target="audienceNote"></span>
    </p>

    <%# Two predicates rather than a union: either on its own narrows to that
        set, both on narrows further to files that are somehow both — used by
        paid content and by something public. Neither on shows everything.
        The note beside the count spells that state out, because two filters
        showing fewer results than one is otherwise surprising. %>
    <div class="flex items-center gap-3 text-xs font-mono shrink-0">
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input type="checkbox"
               data-media-filter-target="paidToggle"
               data-action="change->media-filter#filterByAudience">
        <span class="text-green-700">$ Paid</span>
      </label>
      <label class="flex items-center gap-1.5 cursor-pointer">
        <input type="checkbox"
               data-media-filter-target="freeToggle"
               data-action="change->media-filter#filterByAudience">
        <span class="text-gray-600">Free</span>
      </label>
    </div>
  </div>

  <!-- Media Grid -->
  <div class="grid grid-cols-4 gap-2" data-media-filter-target="grid" data-media-upload-target="grid">
    <% @media.each do |media| %>
      <%= render "media_card", media: media, usages: @media_usages[media.file_path],
                 mixed: @mixed_media_ids.include?(media.id) %>
    <% end %>
  </div>
  <% if @media.empty? %>
    <p data-media-upload-target="empty" class="text-gray-600 mt-2">No media uploaded yet.</p>
  <% end %>

</div>

<script>
  function handleBrowseUpload(event) {
    const file = event.target.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('meta[name="csrf-token"]').content;
    const status = document.getElementById('upload-status');
    status.textContent = 'Uploading...';

    fetch('/admin/medium', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': token
      },
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        status.textContent = 'Upload successful!';
        setTimeout(() => location.reload(), 500);
      } else {
        status.textContent = 'Upload failed: ' + data.error;
      }
    })
    .catch(error => {
      status.textContent = 'Upload error: ' + error;
    });

    event.target.value = '';
  }

  function selectMedia(path, filename) {
    if (window.opener) {
      window.opener.postMessage({
        type: 'media-selected',
        path: path,
        filename: filename
      }, '*');
      window.close();
    }
  }

  function copyMarkdown(event, path, filename) {
    const markdown = `![${filename}](${path})`;
    navigator.clipboard.writeText(markdown).then(() => {
      const btn = event.target;
      const originalText = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('bg-green-200');
      setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('bg-green-200');
      }, 1500);
    }).catch(err => {
      alert('Failed to copy: ' + err);
    });
  }

  function copyUrl(event, path) {
    navigator.clipboard.writeText(path).then(() => {
      const btn = event.target;
      const originalText = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('bg-green-200');
      setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('bg-green-200');
      }, 1500);
    }).catch(err => {
      alert('Failed to copy: ' + err);
    });
  }
</script>
