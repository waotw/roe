<div class="mb-5 pb-2.5 border-b border-gray-300">
  <h1 class="text-2xl font-bold">Media Browser</h1>
</div>

<!-- System Status Notice -->
<% if !ImageVariantGenerator.available? %>
  <div class="mb-5 p-3 border border-amber-300 bg-amber-50 rounded">
    <div class="flex items-start gap-2">
      <span class="text-amber-600">⚠️</span>
      <div>
        <p class="text-sm text-amber-800 font-medium">Image optimization disabled</p>
        <p class="text-xs text-amber-700 mt-1">libvips is not installed.</p>
        <p class="text-xs text-amber-700 mt-1">Install it via instructions here: <a href="https://www.libvips.org/install.html" class="underline">libvips ↗</a></p>
        <p class="text-xs text-amber-700 mt-1">Images will be served at full size until variants are generated in production.</p>
      </div>
    </div>
  </div>
<% elsif Rails.env.production? %>
    <!-- Production: On-demand only -->
    <div class="mb-5 p-3 border border-blue-300 bg-blue-50 rounded">
      <div class="flex items-start gap-2">
        <span class="text-blue-600">ℹ️</span>
        <div>
          <p class="text-sm text-blue-800 font-medium">On-demand image optimization</p>
          <p class="text-xs text-blue-700 mt-1">
            Image variants are generated automatically when first requested. No background processing.
          </p>
          <p class="text-xs text-blue-600 mt-1">
            Process variants locally and deploy them for best performance.
          </p>
        </div>
      </div>
    </div>
<% else %>
  <% status = variant_generation_status %>

  <% if Rails.env.development? && status[:failed_jobs].any? %>
    <!-- Show failed jobs in development -->
    <div class="mb-5 p-3 border border-red-300 bg-red-50 rounded">
      <div class="flex items-start gap-2">
        <span class="text-red-600">💥</span>
        <div class="flex-1">
          <p class="text-sm text-red-800 font-medium">
            <%= status[:failed_jobs].count %> <%= 'job'.pluralize(status[:failed_jobs].count) %> failed
          </p>
          <% status[:failed_jobs].each do |failure| %>
            <div class="mt-2 p-2 bg-red-100 rounded text-xs font-mono">
              <p class="text-red-900 font-bold"><%= failure[:error_class] %>: <%= failure[:error_message] %></p>
              <% if failure[:backtrace] %>
                <details class="mt-1">
                  <summary class="text-red-700 cursor-pointer hover:text-red-900">Show backtrace</summary>
                  <pre class="mt-1 text-red-700 text-[10px] overflow-x-auto"><%= failure[:backtrace].join("\n") %></pre>
                </details>
              <% end %>
            </div>
          <% end %>
          <div class="mt-2">
            <%= button_to "Clear Failed Jobs",
                          clear_failed_jobs_admin_medium_index_path,
                          method: :post,
                          class: "text-xs px-2 py-1 border border-red-600 bg-red-100 hover:bg-red-200 rounded",
                          data: { turbo: false } %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <% if status[:active] %>
    <% if status[:worker_actually_dead] %>
      <!-- Worker is dead! -->
      <div class="mb-5 p-3 border border-red-300 bg-red-50 rounded">
        <div class="flex items-start gap-2">
          <span class="text-red-600">💀</span>
          <div class="flex-1">
            <p class="text-sm text-red-800 font-medium">Queue worker not running!</p>
            <p class="text-xs text-red-700 mt-1">
              <%= status[:pending_jobs] %> jobs waiting but worker is dead
            </p>
            <p class="text-xs text-red-600 mt-1">
              Restart bin/dev to process jobs
            </p>
          </div>
        </div>
      </div>
    <% else %>
      <!-- Jobs are running -->
      <div class="mb-5 p-3 border border-blue-300 bg-blue-50 rounded">
        <div class="flex items-start gap-2">
          <span class="text-blue-600 animate-pulse">🔄</span>
          <div class="flex-1">
            <p class="text-sm text-blue-800 font-medium">Optimizing images...</p>
            <p class="text-xs text-blue-700 mt-1">
              <%= status[:pending_jobs] %> pending, <%= status[:claimed_jobs] %> processing
            </p>
            <p class="text-xs text-blue-600 mt-1">
              Refresh page to see progress
            </p>
          </div>
          <%= button_to "Refresh", browse_admin_medium_index_path, method: :get, class: "text-xs px-2 py-1 border border-blue-600 bg-blue-100 hover:bg-blue-200 rounded" %>
        </div>
      </div>
    <% end %>
    <% elsif status[:without_variants] > 0 %>
      <!-- Images need variants but no jobs running -->
      <div class="mb-5 p-3 border border-amber-300 bg-amber-50 rounded">
        <div class="flex items-start gap-2">
          <span class="text-amber-600">⚠️</span>
          <div class="flex-1">
            <p class="text-sm text-amber-800 font-medium">
              <%= status[:without_variants] %> <%= 'image'.pluralize(status[:without_variants]) %> need optimization
            </p>
            <p class="text-xs text-amber-700 mt-1">
              <%= status[:with_variants] %> of <%= status[:total_images] %> optimized
            </p>
            <p class="text-xs text-amber-600 mt-1">
              Variants will be generated on-demand or click below to process now
            </p>
          </div>
          <%= button_to "Generate Missing Variants",
                        queue_missing_variants_admin_medium_index_path,
                        method: :post,
                        class: "text-xs px-2 py-1 border border-amber-600 bg-amber-200 hover:bg-amber-300 rounded",
                        data: { turbo: false } %>
        </div>
      </div>
    <% else %>
      <!-- All good! -->
      <div class="mb-5 p-3 border border-green-300 bg-green-50 rounded">
        <div class="flex items-start gap-2">
          <span class="text-green-600">✓</span>
          <div class="flex-1">
            <p class="text-sm text-green-800 font-medium">
              <% if status[:all_optimized] %>
                All images optimized
              <% else %>
                Image optimization ready
              <% end %>
            </p>
            <p class="text-xs text-green-700 mt-1">
              <%= status[:total_images] %> <%= 'image'.pluralize(status[:total_images]) %> with variants
            </p>
          </div>
          <%= button_to "Scan for Missing Variants",
                        queue_missing_variants_admin_medium_index_path,
                        method: :post,
                        class: "text-xs px-2 py-1 border border-green-600 bg-green-100 hover:bg-green-200 rounded",
                        data: { turbo: false } %>
        </div>
      </div>
    <% end %>
<% end %>

<!-- Upload Form -->
<%= form_with url: admin_medium_index_path, method: :post, multipart: true, local: true do |f| %>
  <%= f.file_field :files,
      accept: 'image/*,audio/*,video/*',
      multiple: true,
      class: "hidden",
      id: "file-upload-input",
      name: "files[]",
      data: { action: "change->upload#submit" } %>

  <label for="file-upload-input" class="cursor-pointer inline-flex items-center uppercase text-sm px-1.5 py-0.5 border border-blue-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs">
    Upload Media
  </label>
<% end %>

<script>
  document.getElementById('file-upload-input').addEventListener('change', function() {
    console.log('Files selected:', this.files.length);
    if (this.files.length > 0) {
      console.log('Submitting form...');
      this.form.submit();
    }
  });
</script>

<% if flash[:notice] %>
  <div class="mb-5 px-2.5 py-1 border border-gray-300 bg-green-100">
    <%= flash[:notice] %>
  </div>
<% end %>

<div data-controller="media-filter"
     data-media-filter-total-value="<%= @media.count %>">

  <!-- Tabs for Media Types -->
  <div class="mb-4 border-b border-gray-200">
    <nav class="-mb-px flex space-x-8">
      <!-- Always show 'All' -->
      <button
        data-action="click->media-filter#filterByType"
        data-type="all"
        data-media-filter-target="tab"
        class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
        All
      </button>

      <!-- Show tabs for types that exist -->
      <% if @existing_types.include?('images') %>
        <button data-action="click->media-filter#filterByType" data-type="images" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          Images
        </button>
      <% end %>

      <% if @existing_types.include?('audio') %>
        <button data-action="click->media-filter#filterByType" data-type="audio" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          Audio
        </button>
      <% end %>

      <% if @existing_types.include?('video') %>
        <button data-action="click->media-filter#filterByType" data-type="video" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          Video
        </button>
      <% end %>
        <button data-action="click->media-filter#filterByType" data-type="unused" class="whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium uppercase border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700">
          Unused
        </button>
    </nav>
  </div>

  <!-- Filters & Search -->
  <div class="mb-4 flex flex-col sm:flex-row gap-4 items-start sm:items-center">
    <!-- Sort Dropdown -->
    <div class="flex-shrink-0">
      <select
        data-media-filter-target="sortFilter"
        data-action="change->media-filter#sortBy"
        class="block w-full bg-white rounded-xs border border-gray-500 text-sm focus:border-blue-500 focus:ring-blue-500 px-4 py-2 pr-12 appearance-none bg-[url('data:image/svg+xml;charset=utf-8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20fill%3D%22none%22%20viewBox%3D%220%200%2020%2020%22%3E%3Cpath%20stroke%3D%22%236b7280%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%20stroke-width%3D%221.5%22%20d%3D%22M6%208l4%204%204-4%22%2F%3E%3C%2Fsvg%3E')] bg-[length:1.25rem] bg-[right_0.75rem_center] bg-no-repeat">
        <option value="date-desc">Upload date (newest first)</option>
        <option value="date-asc">Upload date (oldest first)</option>
        <option value="name-asc">Filename (A-Z)</option>
        <option value="name-desc">Filename (Z-A)</option>
        <option value="size-desc">File size (largest first)</option>
        <option value="size-asc">File size (smallest first)</option>
      </select>
    </div>

    <!-- Search Input -->
    <div class="flex-grow">
      <input
        type="text"
        data-media-filter-target="search"
        data-action="input->media-filter#filterBySearch"
        placeholder="Search by filename..."
        class="block w-full rounded-xs border border-gray-500 focus:bg-blue-50 focus:ring-blue-300 sm:text-sm font-mono px-4 py-2 bg-white"
>
    </div>
  </div>

  <!-- Results Counter -->
  <p class="mb-4 text-xs text-gray-500 font-sans">
    Showing <span data-media-filter-target="count"><%= @media.count %></span> of <%= @media.count %> files
  </p>

  <!-- Media Grid -->
  <% if @media.any? %>
    <div class="grid grid-cols-4 gap-4" data-media-filter-target="grid">
      <% @media.each do |media| %>
        <div class="border border-gray-300 p-2 hover:bg-gray-50 cursor-pointer group relative"
             data-media-filter-target="item"
             data-media-type="<%= media.media_type %>"
             data-has-references="<%= media.posts.any? %>"
             data-filename="<%= File.basename(media.file_path).downcase %>"
             data-uploaded-at="<%= media.created_at.to_i %>"
             data-file-size="<%= File.size?(Rails.root.join('public', media.file_path)) || 0 %>"
             data-searchable="<%= File.basename(media.file_path).downcase %>"
             onclick="selectMedia('<%= j(media.file_path) %>', '<%= j(File.basename(media.file_path)) %>')">

          <!-- Image/Icon -->
          <% if media.media_type == 'images' %>
            <div class="relative">
              <% if ImageVariantGenerator.available? && media.variants_ready? %>
                <%= image_tag image_variant_path(media.file_path, :small), alt: File.basename(media.file_path), class: "w-full h-32 object-cover mb-2", loading: "lazy" %>
              <% else %>
                <%= image_tag media.file_path, alt: File.basename(media.file_path), class: "w-full h-32 object-cover mb-2", loading: "lazy" %>
              <% end %>

              <% if ImageVariantGenerator.available? %>
                <% variant_stats = media.variant_stats %>
                <% if variant_stats && !variant_stats[:ready] %>
                  <div class="absolute top-1 left-1 bg-amber-500 text-white text-xs px-1.5 py-0.5 rounded">
                    ⏳ <%= variant_stats[:generated] %>/<%= variant_stats[:total] %>
                  </div>
                <% elsif variant_stats && variant_stats[:ready] %>
                  <div class="absolute top-1 left-1 bg-green-500 text-white text-xs px-1.5 py-0.5 rounded" title="Variants ready: <%= ImageVariantGenerator::VARIANTS.keys.join(', ') %>">
                    ✓
                  </div>
                <% end %>
              <% end %>
            </div>
          <% elsif media.media_type == 'audio' %>
            <div class="w-full h-32 bg-gray-200 mb-2 flex items-center justify-center">
              <span class="text-4xl">🎵</span>
            </div>
          <% elsif media.media_type == 'video' %>
            <div class="w-full h-32 bg-gray-200 mb-2 flex items-center justify-center">
              <span class="text-4xl">🎬</span>
            </div>
          <% end %>

          <!-- Filename -->
          <div class="mb-1">
            <%= render 'shared/inline_rename_media', media: media %>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col gap-1">
            <button onclick="copyUrl(event, '<%= j(media.file_path) %>')"
                  class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-blue-100 hover:bg-blue-300 font-mono rounded-xs">
                Copy URL
              </button>
            <button onclick="copyMarkdown(event, '<%= j(media.file_path) %>', '<%= j(File.basename(media.file_path)) %>')"
                class="flex-1 uppercase text-xs px-1.5 py-1 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs">
              Markdown Link
            </button>
            <%= button_to "×", admin_medium_path(media),
                method: :delete,
                class: "absolute top-1 right-1 w-6 h-6 bg-red-600 text-white hover:bg-red-700 opacity-0 group-hover:opacity-100 transition-opacity text-center leading-none",
                form: {
                  onsubmit: "event.stopPropagation(); return confirm('Delete this file?')",
                  class: "inline"
                } %>
          </div>

          <!-- Post Association Badge -->
          <% if media.posts.any? %>
            <div class="text-xs text-gray-600 mt-2">
              Used in: <%= link_to media.posts.first.title,
                                   edit_admin_post_path(media.posts.first, highlight: media.file_path),
                                   class: "text-blue-600 hover:text-blue-800 hover:underline",
                                   onclick: "event.stopPropagation()" %>
              <% if media.posts.count > 1 %>
                <span class="relative group/posts inline-block">
                  <span class="text-gray-400 cursor-help">(+<%= media.posts.count - 1 %> more)</span>

                  <!-- Popover with other posts -->
                  <div class="hidden group-hover/posts:block absolute z-50 bg-white border border-gray-400 shadow-lg p-2 rounded-xs min-w-48 left-0 -top-0.5 mt-1">
                    <div class="text-xs font-semibold text-gray-700 mb-1 pb-1 border-b border-gray-300">
                      Also used in:
                    </div>
                    <% media.posts[1..-1].each do |post| %>
                      <%= link_to post.title,
                                  edit_admin_post_path(post, highlight: media.file_path),
                                  class: "block text-xs text-blue-600 hover:bg-blue-50 hover:text-blue-800 py-1 px-1 -mx-1 rounded",
                                  onclick: "event.stopPropagation()" %>
                    <% end %>
                  </div>
                </span>
              <% end %>
            </div>
          <% else %>
            <div class="text-xs text-gray-400 mt-2">Unused</div>
          <% end %>

        </div> <!-- Close media item div -->
      <% end %> <!-- Close @media.each loop -->
    </div> <!-- Close grid div -->
  <% else %>
    <p class="text-gray-600">No media uploaded yet.</p>
  <% end %>

</div>

<script>
  function handleBrowseUpload(event) {
    const file = event.target.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('file', file);

    const token = document.querySelector('meta[name="csrf-token"]').content;
    const status = document.getElementById('upload-status');
    status.textContent = 'Uploading...';

    fetch('/admin/medium', {
      method: 'POST',
      headers: {
        'X-CSRF-Token': token
      },
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        status.textContent = 'Upload successful!';
        setTimeout(() => location.reload(), 500);
      } else {
        status.textContent = 'Upload failed: ' + data.error;
      }
    })
    .catch(error => {
      status.textContent = 'Upload error: ' + error;
    });

    event.target.value = '';
  }

  function selectMedia(path, filename) {
    if (window.opener) {
      window.opener.postMessage({
        type: 'media-selected',
        path: path,
        filename: filename
      }, '*');
      window.close();
    }
  }

  function copyMarkdown(event, path, filename) {
    const markdown = `![${filename}](${path})`;
    navigator.clipboard.writeText(markdown).then(() => {
      const btn = event.target;
      const originalText = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('bg-green-200');
      setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('bg-green-200');
      }, 1500);
    }).catch(err => {
      alert('Failed to copy: ' + err);
    });
  }

  function copyUrl(event, path) {
    navigator.clipboard.writeText(path).then(() => {
      const btn = event.target;
      const originalText = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('bg-green-200');
      setTimeout(() => {
        btn.textContent = originalText;
        btn.classList.remove('bg-green-200');
      }, 1500);
    }).catch(err => {
      alert('Failed to copy: ' + err);
    });
  }
</script>
