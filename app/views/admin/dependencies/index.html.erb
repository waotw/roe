<% content_for :editor_js, false %>
<% content_for :title, "Images & Video" %>
<div class="px-4 sm:px-0">
  <div class="mb-8">
    <%# COPY: Images & Video page heading and intro %>
    <h1 class="text-3xl font-bold text-gray-900">Images &amp; Video</h1>
    <p class="mt-2 text-sm text-gray-700">
      If you have `libvips` installed locally, Roe will use it to optimize your images automatically. This will drastically increase the speed at which images load and not waste bandwidth on huge images for thumbnails.
    </p>
    <p class="mt-2 text-sm text-gray-700">
      You can also create variants manually, this works great if you don't have that many images in your site.
    </p>
    <p class="mt-2 text-sm text-gray-700">
      With `ffmpeg` installed, Roe makes smaller web versions of the videos you upload. Add videos on the computer where you write, then send them to your live site with Site Sync.
    </p>
    <p class="mt-1 text-xs text-gray-500">
      Detected environment: <span class="font-medium text-gray-700"><%= @platform.label %></span>
    </p>
  </div>

  <div class="space-y-4">
    <% @tools.each do |tool| %>
      <%= render "admin/dependencies/tool", tool: tool, recheck_path: admin_dependencies_path %>
    <% end %>
  </div>
</div>
