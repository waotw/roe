<% content_for :editor_js, false %>
<div class="px-4 sm:px-0">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900">Images Tools</h1>
    <p class="mt-2 text-sm text-gray-700">
      If you have `libvips` installed locally, Roe will use it to optimize your images automatically. This will drastically increase the speed at which images load and not waste bandwidth on huge images for thumbnails.
    </p>
    <p class="mt-2 text-sm text-gray-700">
      You can also create variants manually, this works great if you don't have that many images in your site.
    </p>
    <p class="mt-1 text-xs text-gray-500">
      Detected environment: <span class="font-medium text-gray-700"><%= @platform.label %></span>
    </p>
  </div>

  <div class="space-y-4">
    <% @tools.each do |tool| %>
      <div class="border border-gray-200 rounded-lg p-4 bg-white">
        <%# ── Header row: name + status badge ──────────────────────── %>
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="text-base font-semibold text-gray-900">
              <%= tool[:label] %>
              <% if tool[:optional] %>
                <span class="ml-1 text-xs font-normal text-gray-400">optional</span>
              <% end %>
            </h2>
            <p class="text-sm text-gray-600 mt-0.5"><%= tool[:summary] %></p>
          </div>

          <% if tool[:installed] %>
            <span class="shrink-0 inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium bg-green-50 text-green-700 border border-green-200">
              <span>✓</span> Installed<%= " · #{tool[:version]}" if tool[:version].present? %>
            </span>
          <% else %>
            <span class="shrink-0 inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium bg-amber-50 text-amber-700 border border-amber-200">
              <span>○</span> Not installed
            </span>
          <% end %>
        </div>

        <%# ── Install guidance (only when missing) ──────────────────── %>
        <% unless tool[:installed] %>
          <p class="text-xs text-gray-500 mt-2"><%= tool[:why] %></p>

          <div class="mt-3">
            <% if tool[:install_command].present? %>
              <p class="text-xs text-gray-500 mb-1">
                To install on <%= @platform.label %>, run this in the terminal (doesn't matter where):
              </p>
              <div class="flex items-stretch gap-2"
                   data-controller="clipboard"
                   data-clipboard-success-label-value="Copied">
                <code class="flex-1 px-3 py-2 bg-gray-900 text-gray-100 rounded text-xs font-mono overflow-x-auto whitespace-nowrap"><%= tool[:install_command] %></code>
                <button type="button"
                        data-clipboard-target="trigger"
                        data-action="click->clipboard#copy"
                        data-clipboard-text-value="<%= tool[:install_command] %>"
                        class="shrink-0 px-3 py-2 text-xs font-medium border border-gray-300 rounded hover:bg-gray-50">
                  Copy
                </button>
              </div>
              <% if tool[:needs_sudo] %>
                <p class="text-xs text-gray-400 mt-1">You'll be asked for your password (the command uses <code>sudo</code>).</p>
              <% end %>
            <% else %>
              <p class="text-xs text-gray-600">
                We couldn't detect your package manager automatically. Install
                <span class="font-medium"><%= tool[:label] %></span> with your system's
                package manager, then re-check below.
              </p>
            <% end %>
          </div>

          <div class="mt-3 flex items-center gap-4">
            <%= link_to "I've installed it — re-check", admin_dependencies_path,
                        class: "text-xs font-medium px-3 py-2 border border-gray-900 bg-gray-900 text-white rounded hover:bg-gray-700" %>
            <% if tool[:docs_url].present? %>
              <%= link_to "Install guide ↗", tool[:docs_url], target: "_blank", rel: "noopener",
                          class: "text-xs font-medium text-gray-500 hover:text-gray-900" %>
            <% end %>
          </div>
        <% else %>
          <% if tool[:docs_url].present? %>
            <div class="mt-2">
              <%= link_to "Documentation ↗", tool[:docs_url], target: "_blank", rel: "noopener",
                          class: "text-xs font-medium text-gray-400 hover:text-gray-700" %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
