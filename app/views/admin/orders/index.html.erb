<%# COPY — Shop orders received from Snipcart. Placeholder copy the user
    rewrites before commit. data-test anchors are stable; assertions key off
    them, not this text. %>
<div class="px-4 sm:px-0 font-mono">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto font-sans">
      <h1 class="text-3xl font-bold text-gray-900">
        Summary of Orders
        <%# COPY — mode badge: makes clear which mode's orders are shown. Test
            orders only appear in test mode; live orders only in live mode. %>
        <% if @mode == "test" %>
          <span data-test="orders-mode" class="align-middle uppercase text-xs px-2 py-0.5 border border-yellow-600 bg-yellow-100 text-yellow-800 rounded-xs">Test mode</span>
        <% else %>
          <span data-test="orders-mode" class="align-middle uppercase text-xs px-2 py-0.5 border border-green-600 bg-green-100 text-green-800 rounded-xs">Live</span>
        <% end %>
      </h1>
      <p class="mt-2 text-sm text-gray-700">
        Visit your Snipcart account to see full details and take actions (ship, refund, etc.)<br>
        <span class="uppercase text-[10px] px-1 py-0.5 border border-gray-800 bg-blue-100 rounded-xs">m</span> = Member of your site
      </p>
    </div>
  </div>

  <% if @orders.any? %>
    <div class="mt-6 border border-gray-200 bg-white overflow-x-auto" data-test="orders-table">
      <table class="min-w-full divide-y divide-gray-200 text-xs">
        <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
          <tr>
            <th class="text-left font-medium px-3 py-2">Email</th>
            <th class="text-left font-medium px-3 py-2">Product</th>
            <th class="text-right font-medium px-3 py-2">Amount</th>
            <th class="text-left font-medium px-3 py-2">Date</th>
            <th class="text-left font-medium px-3 py-2">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          <% @orders.each do |order| %>
            <tr class="hover:bg-gray-50" data-test="order-row">
              <td class="px-3 py-2">
                <%= link_to (order.email.presence || "—"), admin_order_path(order),
                      class: "text-blue-600 hover:text-blue-800 hover:underline" %>
                <% if order.member? %>
                  <%= link_to "m", admin_member_path(order.member),
                        data: { test: "order-member-badge" },
                        class: "ml-1 uppercase text-[10px] px-1 py-0.5 border border-gray-800 bg-blue-100 hover:bg-blue-200 rounded-xs no-underline text-gray-900" %>
                <% end %>
              </td>
              <td class="px-3 py-2 text-gray-700" data-test="order-product">
                <%# COPY — the SKU of what they bought, linking to the product page
                    when the order captured a URL. "+N more" for multi-item orders. %>
                <% if order.sku_summary.present? %>
                  <% product_url = order.items.first&.url %>
                  <% if product_url.present? %>
                    <%= link_to order.sku_summary, product_url, target: "_blank", rel: "noopener",
                          class: "text-blue-600 hover:text-blue-800 hover:underline" %>
                  <% else %>
                    <%= order.sku_summary %>
                  <% end %>
                <% else %>—<% end %>
              </td>
              <td class="px-3 py-2 text-right tabular-nums">
                <% if order.total %>
                  <span class="<%= order.refunded? ? 'text-red-700' : 'text-green-700' %>">
                    <%= number_to_currency(order.total, unit: (order.currency || "usd").upcase + " ") %>
                  </span>
                <% else %>—<% end %>
              </td>
              <td class="px-3 py-2 text-gray-700"><%= order.placed_at&.strftime("%b %-d, %Y") || "—" %></td>
              <td class="px-3 py-2">
                <%# COPY — status badge: refunded=yellow (a negative txn, not an
                    error), shipped=blue, else (processed / any paid state)=green.
                    Mirrors Payment & Store History. %>
                <% if order.refunded? %>
                  <span class="inline-flex bg-yellow-100 px-2 py-1 text-xs font-semibold text-yellow-800">Refunded</span>
                <% elsif order.status.to_s.downcase == "shipped" %>
                  <span class="inline-flex bg-blue-100 px-2 py-1 text-xs font-semibold text-blue-800">Shipped</span>
                <% elsif order.status.present? %>
                  <span class="inline-flex bg-green-100 px-2 py-1 text-xs font-semibold text-green-800"><%= order.status %></span>
                <% else %>
                  <span class="text-gray-500">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# COPY — the webhook URL stays available even once orders exist, since the
        operator may need to re-paste it (new token, moving stores). %>
    <details class="mt-4 text-sm text-gray-600" data-test="orders-webhook-details">
      <summary class="cursor-pointer">Snipcart webhook URL</summary>
      <%= render "admin/orders/webhook_url" %>
    </details>
  <% else %>
    <%# COPY — empty state names what this page is for and where orders come
        from, since it can read as broken otherwise (see the empty-state rule). %>
    <div class="mt-6 p-6 border border-gray-200 bg-gray-50" data-test="orders-empty">
      <h3 class="text-base font-semibold text-gray-900 mb-1">No orders yet</h3>
      <p class="text-sm text-gray-700">
        Completed purchases from your Snipcart store appear here automatically.
        Roe receives them by webhook — add your webhook URL in Snipcart
        (Store Configurations → Webhooks) so orders start arriving:
      </p>
      <%= render "admin/orders/webhook_url" %>
    </div>
  <% end %>
</div>
