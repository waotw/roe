<!DOCTYPE html>
<html>
<head>
  <title>Edit Post Template</title>
</head>
<body>

  <div class="flex justify-between">
    <h1 class="text-2xl font-bold mb-6">Edit Post Template</h1>
    <%= link_to "← Back to Posts", admin_posts_path, class: "h-fit inline-flex items-center uppercase text-sm px-2 py-3 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none" %>
  </div>

  <p class="text-sm mb-2">This template is used when creating new posts.</p>

  <%= form_with url: admin_settings_post_template_path, method: :patch do |f| %>
    <%= f.text_area :content, class: "w-full h-96 font-mono text-sm p-2 border border-gray-300 bg-gray-50", value: @template_content %>
    <div class="flex gap-2">
    <p><button type="submit" class="uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs">Save Template</button></p>
    <%= link_to "cancel", admin_posts_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
    </div>
  <% end %>
</body>
</html>
