<!DOCTYPE html>
<html>
<head>
  <title>Edit <%= @type.capitalize %> Template</title>
</head>
<body>

  <div class="flex justify-between">
    <h1 class="text-2xl font-bold mb-6">Edit <%= @type.capitalize %> Template</h1>
    <%= link_to "← Back to #{@type.capitalize}s", send("admin_#{@type}s_path"), class: "h-fit inline-flex items-center uppercase text-sm px-2 py-3 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none" %>
  </div>

  <p class="text-sm mb-2">These defaults are added to every new <%= @type %>. You can change them here.</p>

  <% if @required_names.any? %>
    <div class="mb-4 p-3 bg-gray-50 border border-gray-300">
      <p class="text-xs font-semibold text-gray-700 mb-1">Always included (required)</p>
      <p class="font-mono text-xs text-gray-600"><%= @required_names.join(", ") %></p>
      <p class="text-xs text-gray-500 mt-1">Roe adds these to every new <%= @type %> automatically, so you don't set them here.</p>
    </div>
  <% end %>

  <%= form_with url: admin_settings_template_path(type: @type), method: :patch do |f| %>
    <label class="text-xs font-semibold text-gray-700 mb-1 block">Optional defaults + starter content</label>
    <%= f.text_area :content, class: "w-full h-96 font-mono text-sm p-2 border border-gray-300 bg-gray-50", value: @template_content %>
    <div class="flex gap-2 mt-2">
      <button type="submit" class="uppercase text-sm px-2 py-1.5 border border-gray-800 bg-blue-200 hover:bg-blue-300 font-mono rounded-xs">Save Template</button>
      <%= link_to "cancel", send("admin_#{@type}s_path"), class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-gray-200 hover:bg-gray-300 font-mono rounded-xs" %>
    </div>
  <% end %>
</body>
</html>
