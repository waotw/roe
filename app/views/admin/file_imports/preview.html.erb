<div class="max-w-3xl mx-auto">
  <h1 class="text-2xl font-bold mb-2">Review import</h1>
  <p class="text-sm text-gray-500 mb-6">
    <%= pluralize(@posts.size, "post") %> and <%= pluralize(@pages.size, "page") %> ready to import as drafts<%= @ambiguous.any? ? ", plus #{pluralize(@ambiguous.size, 'file')} that need a decision." : "." %>
  </p>

  <%= form_with url: run_admin_file_imports_path, method: :post, data: { turbo: false } do %>
    <%= hidden_field_tag :token, @token %>

    <% if @ambiguous.any? %>
      <div class="bg-white shadow p-6 mb-6">
        <h2 class="text-lg font-medium mb-1">Not sure about these</h2>
        <p class="text-sm text-gray-500 mb-4">Pick how each should come in. Default is Post.</p>
        <% @ambiguous.each do |d| %>
          <div class="flex items-center justify-between gap-4 border-t border-gray-100 py-2">
            <div class="min-w-0">
              <div class="text-sm text-gray-800 truncate"><%= d.title %></div>
              <code class="text-xs text-gray-400"><%= d.source_path %></code>
            </div>
            <div class="flex gap-3 shrink-0 text-sm">
              <label class="flex items-center gap-1"><%= radio_button_tag "kinds[#{d.source_path}]", "post", true %> Post</label>
              <label class="flex items-center gap-1"><%= radio_button_tag "kinds[#{d.source_path}]", "page" %> Page</label>
              <label class="flex items-center gap-1"><%= radio_button_tag "kinds[#{d.source_path}]", "skip" %> Skip</label>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="bg-white shadow p-6 mb-6">
      <h2 class="text-lg font-medium mb-3">Will import as drafts</h2>
      <% [ [ "Posts", @posts ], [ "Pages", @pages ] ].each do |label, docs| %>
        <% next if docs.empty? %>
        <details class="mb-2">
          <summary class="text-sm font-medium text-gray-700 cursor-pointer"><%= label %> (<%= docs.size %>)</summary>
          <ul class="mt-2 ml-4 list-disc text-xs text-gray-500 space-y-0.5">
            <% docs.first(200).each do |d| %>
              <li><%= d.title %> <span class="text-gray-300">— <%= d.source_path %></span></li>
            <% end %>
            <% if docs.size > 200 %><li>… and <%= docs.size - 200 %> more</li><% end %>
          </ul>
        </details>
      <% end %>
    </div>

    <div class="flex items-center gap-3">
      <%= submit_tag "IMPORT AS DRAFTS", class: "px-4 py-2 border border-gray-300 text-sm font-mono text-white bg-black hover:bg-white hover:text-black rounded-xs" %>
      <%= link_to "CANCEL", admin_file_imports_path, class: "text-sm text-gray-500 hover:text-gray-700 font-mono" %>
    </div>
  <% end %>
</div>
