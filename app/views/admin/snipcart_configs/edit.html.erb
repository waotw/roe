<div class="px-4 sm:px-0">
  <div class="sm:flex sm:items-center mb-6">
    <div class="sm:flex-auto">
      <h1 class="text-3xl font-bold text-gray-900">Snipcart Configuration</h1>
      <p class="mt-2 text-sm text-gray-700">
        Configure your Snipcart API keys for e-commerce functionality.
      </p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <%= link_to "← Back to Settings", admin_configs_path, class: "inline-flex items-center uppercase text-sm px-2 py-1.5 border border-gray-800 bg-white hover:bg-gray-300 font-mono rounded-xs leading-none" %>
    </div>
  </div>

  <% if flash[:notice] %>
    <div class="mb-4 bg-green-50 border border-green-200 p-4">
      <p class="text-sm text-green-800"><%= flash[:notice] %></p>
    </div>
  <% end %>

  <% if flash[:error] %>
    <div class="mb-4 bg-red-50 border border-red-200 p-4">
      <p class="text-sm text-red-800"><%= flash[:error] %></p>
    </div>
  <% end %>

  <!-- Connection Status -->
  <div class="mb-6 p-4 <%= @snipcart_config.connected? ? 'bg-green-50 border-green-200' : 'bg-yellow-50 border-yellow-200' %> border">
    <div class="flex items-center gap-2">
      <% if @snipcart_config.connected? %>
        <svg class="w-5 h-5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="font-semibold text-green-900">Connected</span>
        <% if @snipcart_config.connected_at.present? %>
          <span class="text-sm text-green-700">
            - Connected <%= time_ago_in_words(@snipcart_config.connected_at) %> ago
          </span>
        <% end %>
      <% else %>
        <svg class="w-5 h-5 text-yellow-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
        </svg>
        <span class="font-semibold text-yellow-900">Not Connected</span>
        <span class="text-sm text-yellow-700">- Enter your Snipcart API key below</span>
      <% end %>
    </div>
  </div>

  <!-- Get Started Guide -->
  <div class="mb-6 bg-blue-50 border border-blue-200 p-4">
    <h3 class="font-semibold text-blue-900 mb-2">Getting Started with Snipcart</h3>
    <ol class="text-sm text-blue-800 space-y-1 list-decimal list-inside">
      <li>Sign up at <a href="https://app.snipcart.com/register" target="_blank" class="underline">app.snipcart.com/register</a></li>
      <li>In your Snipcart dashboard, go to <strong>Account → API keys</strong></li>
      <li>Copy your <strong>Test</strong> public API key and paste it below</li>
      <li>Add your domain (<code class="bg-white px-1 font-mono text-xs"><%= @snipcart_config.default_domain || 'yourdomain.com' %></code>) in Snipcart dashboard → <strong>Store configurations → Domains & URLs</strong></li>
      <li>When ready to go live, add your <strong>Live</strong> API key and switch mode below</li>
    </ol>
  </div>

  <!-- Configuration Form -->
  <div class="bg-white border-2 border-gray-900 p-8">
    <%= form_with model: @snipcart_config, url: admin_snipcart_config_path, method: :patch, class: "space-y-6" do |f| %>

      <!-- Test API Key -->
      <div class="pb-6 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Test Mode API Key</h3>

        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700">
            Public API Key (Test)
          </label>
          <%= f.text_field :api_key_test,
              value: @snipcart_config.api_key_test,
              placeholder: "Enter your Snipcart test API key",
              class: "w-full px-3 py-2 border border-gray-300 rounded font-mono text-sm" %>
          <p class="text-xs text-gray-500">
            Start in test mode to integrate and test your store without real transactions.
          </p>
        </div>
      </div>

      <!-- Live API Key -->
      <div class="pb-6 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Live Mode API Key</h3>

        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700">
            Public API Key (Live)
          </label>
          <%= f.text_field :api_key_live,
              value: @snipcart_config.api_key_live,
              placeholder: "Enter your Snipcart live API key",
              class: "w-full px-3 py-2 border border-gray-300 rounded font-mono text-sm" %>
          <p class="text-xs text-gray-500">
            Once configured, switch to live mode below to process real transactions.
          </p>
        </div>
      </div>

      <!-- Snipcart Snippet -->
      <div class="pb-6 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Snipcart JavaScript Snippet</h3>

        <div class="space-y-2">
          <label class="block text-sm font-medium text-gray-700">
            Installation Snippet
          </label>
          <%= f.text_area :snippet,
              value: @snipcart_config.snippet,
              placeholder: "<script>\n  window.SnipcartSettings = {\n    publicApiKey: 'YOUR_API_KEY',\n    loadStrategy: 'on-user-interaction',\n  };\n  // ... rest of snippet\n</script>",
              rows: 8,
              class: "w-full px-3 py-2 border border-gray-300 rounded font-mono text-xs" %>
          <p class="text-xs text-gray-500">
            Copy the entire JavaScript snippet from Snipcart dashboard (same page as your API keys). This will be added to your site.
          </p>
        </div>
      </div>

      <!-- Mode Selection -->
      <div class="pb-6 border-b border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">Active Mode</h3>

        <div class="space-y-3">
          <label class="flex items-start gap-3 cursor-pointer">
            <%= f.radio_button :mode, 'test', class: "mt-1" %>
            <div>
              <div class="font-medium text-gray-900">Test Mode</div>
              <div class="text-sm text-gray-600">
                Use test API key - no real charges, limited email sending
              </div>
            </div>
          </label>

          <label class="flex items-start gap-3 cursor-pointer <%= 'opacity-50' unless @snipcart_config.live_mode_ready? %>">
            <%= f.radio_button :mode, 'live',
                disabled: !@snipcart_config.live_mode_ready?,
                class: "mt-1" %>
            <div>
              <div class="font-medium text-gray-900">
                Live Mode
                <% unless @snipcart_config.live_mode_ready? %>
                  <span class="text-xs font-normal text-gray-500">(add live API key first)</span>
                <% end %>
              </div>
              <div class="text-sm text-gray-600">
                Use live API key - real transactions and charges
              </div>
            </div>
          </label>
        </div>
      </div>

      <!-- Current Settings Info -->
      <div class="bg-gray-50 border border-gray-300 p-4">
        <h4 class="text-sm font-semibold text-gray-900 mb-2">Current Store Settings</h4>
        <dl class="text-sm space-y-1">
          <div class="flex gap-2">
            <dt class="font-mono text-gray-600 w-32">Currency:</dt>
            <dd class="font-mono text-gray-900"><%= @snipcart_config.currency.upcase %></dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-mono text-gray-600 w-32">Domain:</dt>
            <dd class="font-mono text-gray-900"><%= @snipcart_config.default_domain || '(not set)' %></dd>
          </div>
          <div class="flex gap-2">
            <dt class="font-mono text-gray-600 w-32">Load Strategy:</dt>
            <dd class="font-mono text-gray-900"><%= @snipcart_config.load_strategy %></dd>
          </div>
        </dl>
        <p class="text-xs text-gray-500 mt-2">
          Edit these in <%= link_to "store.yml", admin_edit_store_config_path, class: "underline" %>
        </p>
      </div>

      <!-- Actions -->
      <div class="flex items-center gap-3">
        <%= f.submit "Save Configuration",
            class: "uppercase text-sm px-4 py-2 border border-gray-800 bg-green-200 hover:bg-green-300 font-mono rounded-xs cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <!-- Danger Zone -->
  <% if @snipcart_config.connected? %>
    <div class="mt-6 bg-white border-2 border-red-600 p-8">
      <h3 class="text-lg font-semibold text-red-900 mb-2">Danger Zone</h3>
      <p class="text-sm text-red-700 mb-4">
        Disconnect Snipcart by removing all API keys. This will not delete products or content, but your store will stop functioning.
      </p>
      <%= button_to "Disconnect Snipcart",
          admin_snipcart_config_path,
          method: :delete,
          data: { turbo_confirm: "Are you sure? This will remove all Snipcart API keys." },
          class: "uppercase text-xs px-2 py-1.5 border border-red-600 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs" %>
    </div>
  <% end %>
</div>
