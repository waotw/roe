<div class="max-w-3xl mx-auto">
  <div class="flex items-baseline justify-between mb-4">
    <h1 class="text-2xl font-bold">Import #<%= @import.id %></h1>
    <%= link_to "← All imports", admin_feed_imports_path, class: "text-sm text-gray-500 hover:text-gray-700" %>
  </div>

  <div class="bg-white shadow p-6 mb-6">
    <dl class="grid grid-cols-2 gap-y-2 text-sm">
      <dt class="text-gray-400">Imported</dt>
      <dd><%= @import.created_at.strftime("%b %-d, %Y · %-l:%M %p") %></dd>
      <dt class="text-gray-400">Source</dt>
      <dd><%= @import.configuration["source"].presence || "feed" %></dd>
      <dt class="text-gray-400">Type</dt>
      <dd><%= @import.configuration["kind"].to_s.presence || "—" %></dd>
      <dt class="text-gray-400">Imported</dt>
      <dd><%= @import.stats["imported"].to_i %></dd>
      <% if @import.stats["skipped"].to_i.positive? %>
        <dt class="text-gray-400">Skipped (already imported)</dt>
        <dd><%= @import.stats["skipped"].to_i %></dd>
      <% end %>
      <dt class="text-gray-400">Still drafts</dt>
      <dd><%= @import.ref_draft_count %></dd>
      <dt class="text-gray-400">Now published</dt>
      <dd><%= @import.ref_published_count %></dd>
    </dl>
  </div>

  <div class="bg-white shadow p-6">
    <h2 class="text-sm font-semibold text-red-900 mb-2">Delete this import</h2>
    <p class="text-xs text-gray-600 mb-3">
      Removes this import's <strong>draft</strong> episodes/articles (file and record).
      Published items are kept — remove those manually. You can always re-import.
    </p>
    <button type="button"
            data-action="delete"
            data-resource-id="<%= @import.id %>"
            data-resource-title="Import #<%= @import.id %>"
            data-resource-type="import"
            data-delete-url="<%= admin_feed_import_path(@import) %>"
            class="uppercase text-xs px-3 py-1 border border-red-700 bg-red-100 hover:bg-red-200 text-red-700 font-mono rounded-xs cursor-pointer">
      Delete import &amp; drafts
    </button>
  </div>

  <%= render "shared/delete_file_modal",
             resource_type: "import",
             resource: @import,
             delete_path: admin_feed_import_path(@import),
             delete_message: "This deletes the DRAFT episodes/articles from this import (file and record). Published content is kept — remove those manually from Posts. You can always re-import.".html_safe %>
</div>
