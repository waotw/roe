<div class="collection-archive">
  <h1><%= @collection_title || "Collection" %></h1>

  <div class="collection-items">
    <% @items.each do |item| %>
      <article class="collection-item">
        <h2>
          <%= link_to item.title, item_path(item) %>
        </h2>

        <% if item.excerpt.present? %>
          <p class="excerpt"><%= item.excerpt %></p>
        <% end %>

        <footer>
          <time datetime="<%= item.created_at.iso8601 %>">
            <%= item.created_at.strftime("%B %d, %Y") %>
          </time>
        </footer>
      </article>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <nav class="pagination">
      <% if @current_page > 1 %>
        <% if @current_page == 2 %>
          <%= link_to "← Previous", "#{@base_url}.html", class: "prev" %>
        <% else %>
          <%= link_to "← Previous", "#{@base_url}/page-#{@current_page - 1}.html", class: "prev" %>
        <% end %>
      <% end %>

      <span class="page-info">
        Page <%= @current_page %> of <%= @total_pages %>
      </span>

      <% if @current_page < @total_pages %>
        <%= link_to "Next →", "#{@base_url}/page-#{@current_page + 1}.html", class: "next" %>
      <% end %>
    </nav>
  <% end %>
</div>
