<article class="content collection-page">
  <div class="collection-page-heading">
    <h1><%= @page_heading %></h1>
    <p class="collection-description"><%= @page_description %></p>
  </div>
  <% if @items.any? %>
    <div class="collection-list">
      <% @items.each do |item| %>
        <div class="collection-item">
          <h3><%= link_to item.title || 'Untitled', item_path(item) %></h3>

          <% if item.respond_to?(:subtitle) && item.subtitle.present? %>
            <p class="subtitle"><em><%= item.subtitle %></em></p>
          <% end %>

          <% if item.respond_to?(:date) && item.date %>
            <p class="date"><%= item.date.strftime('%B %d, %Y') %></p>
          <% end %>

          <% if item.respond_to?(:excerpt) && item.excerpt.present? %>
            <p class="excerpt"><%= item.excerpt %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <%= link_to '← Previous', collection_path(@filters, page: @page - 1, **pagination_params), class: 'pagination-prev' %>
        <% end %>

        <span class="pagination-info">Page <%= @page %> of <%= @total_pages %></span>

        <% if @page < @total_pages %>
          <%= link_to 'Next →', collection_path(@filters, page: @page + 1, **pagination_params), class: 'pagination-next' %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p>No items found.</p>
  <% end %>
</article>

<%
  # Helper methods for the view
  def pagination_params
    # Only include params that exist
    permitted = params.permit(:source, :order, :heading, :exclude).to_h.symbolize_keys
    permitted.reject { |k, v| v.blank? }
  end

  def item_path(item)
    case item
    when Post
      "/posts/#{item.url_name}"
    when Documentation
      "/documentation/#{item.url_name}"
    when Page
      "/#{item.url_name}"
    else
      "#"
    end
  end
%>
