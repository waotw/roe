<article class="content">
  <h1>
    <% if @post_type %>
      <%= @post_type.titleize %> Posts
    <% end %>
    <% if @tag %>
      <%= "tagged with #{@tag.titleize}" %>
    <% end %>
    <% if !@post_type && !@tag %>
      All Posts
    <% end %>
  </h1>

  <p class="text-gray-600 mb-8">
    Showing <%= @items.count %> of <%= @total_count %> posts
  </p>

  <div class="space-y-6">
    <% @items.each do |item| %>
      <div class="collection-item">
        <h3><%= link_to item.title || 'Untitled', post_path(item.url_name) %></h3>

        <% if item.date %>
          <p class="text-sm text-gray-500"><%= item.date.strftime('%B %d, %Y') %></p>
        <% end %>

        <% if item.excerpt %>
          <p class="text-gray-700 mt-2"><%= item.excerpt %></p>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @total_pages > 1 %>
    <div class="pagination mt-8 flex gap-4 justify-center">
      <% if @page > 1 %>
        <%= link_to "← Previous", collection_path(@filters, page: @page - 1), class: "px-4 py-2 border" %>
      <% end %>

      <span class="px-4 py-2">Page <%= @page %> of <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to "Next →", collection_path(@filters, page: @page + 1), class: "px-4 py-2 border" %>
      <% end %>
    </div>
  <% end %>
</article>
