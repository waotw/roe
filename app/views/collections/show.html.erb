<article class="content collection-page">
  <div class="collection-page-heading">
    <h1><%= sanitize(@page_heading, tags: %w[span], attributes: %w[class]) %></h1>
    <p class="collection-description"><%= @page_description %></p>
  </div>

  <% if @items.any? %>
    <div class="collection-list">
      <% @items.each do |item| %>
        <div class="collection-item">
          <h3><%= link_to item.title || 'Untitled', item_path(item) %></h3>

          <% if item.respond_to?(:subtitle) && item.subtitle.present? %>
            <p class="subtitle"><em><%= item.subtitle %></em></p>
          <% end %>

          <% if item.respond_to?(:date) && item.date %>
            <p class="date"><%= item.date.strftime('%B %d, %Y') %></p>
          <% end %>

          <% if item.respond_to?(:excerpt) && item.excerpt.present? %>
            <p class="excerpt"><%= item.excerpt %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Pagination -->
    <% if @total_pages > 1 %>
      <div class="pagination">
        <% if @page > 1 %>
          <% if @base_url %>
            <!-- Static site pagination -->
            <% if @page == 2 %>
              <%= link_to '← Previous', "#{@base_url}.html", class: 'pagination-prev' %>
            <% else %>
              <%= link_to '← Previous', "#{@base_url}/page-#{@page - 1}.html", class: 'pagination-prev' %>
            <% end %>
          <% else %>
            <!-- Dynamic site pagination -->
            <%= link_to '← Previous', collection_path(@filters, page: @page - 1), class: 'pagination-prev' %>
          <% end %>
        <% end %>

        <span class="pagination-info">Page <%= @page %> of <%= @total_pages %></span>

        <% if @page < @total_pages %>
          <% if @base_url %>
            <!-- Static site pagination -->
            <%= link_to 'Next →', "#{@base_url}/page-#{@page + 1}.html", class: 'pagination-next' %>
          <% else %>
            <!-- Dynamic site pagination -->
            <%= link_to 'Next →', collection_path(@filters, page: @page + 1), class: 'pagination-next' %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p>No items found.</p>
  <% end %>
</article>
