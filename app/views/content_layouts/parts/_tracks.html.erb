<%# Every track of the release, in track order, with this one marked. Only on
    a track whose release has more than one. Skipped when the body has a
    playlist collection of its own. The music twin of _episodes. %>
<% tracks = context[:release_tracks]; post = record %>
<% if tracks.present? && tracks.length > 1 %>
  <div class="track-list">
    <h2>All Tracks</h2>
    <ol>
      <% tracks.each do |track| %>
        <li class="track-item <%= 'is-current' if track.url_name == post.url_name %>">
          <a href="<%= post_path(track.url_name) %>">
            <div class="track-meta-row">
              <% if track.metadata['track_number'].present? %>
                <span class="track-number"><%= track.metadata['track_number'] %></span>
              <% end %>
              <% if track.metadata['duration'].present? %>
                <span class="track-duration"><%= format_duration(track.metadata['duration']) %></span>
              <% end %>
            </div>
            <span><%= track.title %></span>
          </a>
        </li>
      <% end %>
    </ol>
  </div>
<% end %>
