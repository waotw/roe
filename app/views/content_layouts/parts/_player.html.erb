<%# The post's audio or video. Skipped when the body has its own
    ```card type: player (BodyCheck), when the type has nothing to play, or
    when content.yml's `players` setting turns it off.

    A podcast episode gets the full podcast player: chapters, captions and
    ⏮ ⏭ to the show's previous and next episodes. Other types get the same
    player a ```card type: player in the body draws. %>
<% if kind == "post" && (player_kind = record.template_player_kind) && Post.template_players_enabled?(player_kind) %>
  <% if record.post_type == "podcast" %>
    <% episodes = context[:podcast_episodes] %>
    <% if episodes.present?
         index = episodes.index { |e| e.url_name == record.url_name }
         # Newest first: the episode that came out before this one is
         # further down the list (⏮), the one after it further up (⏭).
         prev_episode = index && index < episodes.length - 1 ? episodes[index + 1] : nil
         next_episode = index && index > 0 ? episodes[index - 1] : nil
       end %>
    <div class="podcast-hero <%= 'is-no-cover' if record.metadata['image'].blank? %>">
      <div class="hero-player">
        <%= render "posts/media_player", post: record, podcast_config: context[:podcast_config], prev_episode: prev_episode, next_episode: next_episode %>
      </div>
    </div>
  <% else %>
    <%# Inline spacing so it holds on every theme: the card itself only has
        space above it, since in a body the paragraphs around it bring theirs. %>
    <div class="post-player" style="margin-bottom: var(--space-6, 1.5rem);">
      <%= record.template_player_card_html %>
    </div>
  <% end %>
<% end %>
