<%# The page's layout draws what's inside the article: page.txt, or
    podcast-page.txt for a page connected to a podcast (`podcast: <key>`),
    which leads with the show's name and subscribe links. %>
<%# page-<url_name> is derived from the page's name, so renaming a page renames
    its class — a theme targeting .page-store stopped matching when the page was
    retitled "Bookshop". page-type-<type> is declared rather than derived, so it
    survives a rename. Both are emitted: the name-based one is what existing
    themes already target. A name that's also a layout part's (image, tags…)
    gets no name class: see Page#name_class. %>
<article class="<%= [ "page", @page.name_class, ("page-type-#{@page.page_type}" if @page.page_type), ("member-page" if @page.member_page?) ].compact.join(" ") %>">
  <%# .content wraps the whole layout, as on posts, products and docs. %>
  <div class="content">
    <%# Pass member context if available (for form error display) %>
    <%= render_content_layout(@page, page_context: (defined?(@member) ? { member: @member } : nil)) %>
  </div>
</article>
<%= render 'shared/preview_auto_refresh' if params[:preview] == 'true' %>
