<div class="auth-container">
  <div class="auth-form">
    <h1>Sign In</h1>

    <%= form_with url: signin_path, method: :post, local: true do |f| %>
      <div class="form-field">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true %>
      </div>

      <div class="form-field">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, autocomplete: "current-password", required: true %>
      </div>

      <%= f.submit "Sign In", class: "btn-primary" %>
    <% end %>

    <div class="auth-links">
      <p>Don't have an account? Contact us to join.</p>
    </div>
  </div>
</div>
