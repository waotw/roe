<div class="auth-container">
  <div class="auth-form">
    <h1>Account</h1>

    <div class="account-details">
      <div class="detail-row">
        <strong>Name:</strong>
        <span><%= @member.name %></span>
      </div>

      <div class="detail-row">
        <strong>Email:</strong>
        <span><%= @member.email %></span>
      </div>

      <div class="detail-row">
        <strong>Membership:</strong>
        <span><%= @member.tier.titleize %></span>
      </div>

      <div class="detail-row">
        <strong>Status:</strong>
        <span><%= @member.status.titleize %></span>
      </div>

      <% if @member.paid? && @member.paid_at %>
        <div class="detail-row">
          <strong>Upgraded:</strong>
          <span><%= @member.paid_at.strftime("%B %d, %Y") %></span>
        </div>
      <% end %>

      <div class="detail-row">
        <strong>Member since:</strong>
        <span><%= @member.subscribed_at.strftime("%B %d, %Y") %></span>
      </div>
    </div>

    <div class="account-actions">
      <%= link_to "Edit Account", account_edit_path, class: "btn-secondary" %>

      <% if @member.free? %>
        <% upgrade_page = Page.find_by(file_path: Rails.root.join('site', 'pages', 'upgrade.md').to_s) %>
        <% if upgrade_page %>
          <%= link_to "Upgrade to Paid", "/#{upgrade_page.url_name}", class: "btn-primary" %>
        <% end %>
      <% end %>

      <%= button_to "Sign Out", signout_path, method: :delete, class: "btn-outline" %>
    </div>
  </div>
</div>
