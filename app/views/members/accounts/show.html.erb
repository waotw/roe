<div class="member-page">
  <h1>Account</h1>

  <div class="account-details">
    <div class="detail-row">
      <strong>Name:</strong>
      <span><%= @member.name %></span>
    </div>

    <div class="detail-row">
      <strong>Email:</strong>
      <span><%= @member.email %></span>
    </div>

    <div class="detail-row">
      <strong>Membership:</strong>
      <span><%= @member.tier.titleize %></span>
    </div>

    <div class="detail-row">
      <strong>Status:</strong>
      <span><%= @member.status.titleize %></span>
    </div>

    <% if @member.paid? && @member.paid_at %>
      <div class="detail-row">
        <strong>Upgraded:</strong>
        <span><%= @member.paid_at.strftime("%B %d, %Y") %></span>
      </div>
    <% end %>

    <div class="detail-row">
      <strong>Member since:</strong>
      <span><%= @member.subscribed_at.strftime("%B %d, %Y") %></span>
    </div>
  </div>

  <%# Deleting is last, separated, and asks for a typed word — it can't be
      undone and shouldn't sit next to Edit Account where a mis-click lands.
      The copy names what survives, including the copies Stripe and Postmark
      keep, so nobody assumes this reached further than it does. %>
  <details class="account-delete">
    <summary>Delete my account</summary>

    <p>
      This removes all user identifiable information from this website. It can't be undone, and you'll
      be signed out immediately.
    </p>
    <p>
      This website will keep historical data like email deliveries and transaction history but your email address and name are removed from those records.
    </p>

    <%= form_with url: delete_account_path, method: :delete, class: "account-delete-form" do |f| %>
      <label for="confirm_delete">Type <strong>DELETE</strong> to confirm</label>
      <%= f.text_field :confirm, id: "confirm_delete", autocomplete: "off",
            class: "account-delete-input", placeholder: "DELETE" %>
      <%= f.submit "Delete my account", class: "btn-secondary account-delete-button" %>
    <% end %>
  </details>

  <div class="account-actions">
    <%= link_to "Edit Account", account_edit_path, class: "btn-outline" %>

    <% if @member.free? %>
      <%= button_to "Upgrade to Paid", create_checkout_path,
          class: "btn-primary",
          form_class: "checkout-form",
          data: { turbo: false } %>
    <% end %>
    <%= button_to "Sign Out", signout_path, method: :delete, class: "btn-secondary" %>
  </div>
    <% if @member.free? %>
      <p class="upgrade-link">Find out about <a href="/upgrade">paid membership</a></p>
    <% end %>

  <%# Private feed addresses, one per podcast or release with paid content.
      Its own section rather than part of .account-actions — that's a row of
      buttons, and this landed between "Edit Account" and "Sign Out".

      The URL carries the member's token, which the note says plainly. The
      token is never shown on its own: it means nothing without a feed address
      and showing it invites pasting it somewhere it doesn't belong. %>
  <% if @private_feeds.any? %>
    <div class="private-feeds">
      <h2>Your private podcast feeds</h2>
      <p class="private-feeds-note">
        Add these to your podcast app to get paid episodes. Each link is
        personal to you — anyone you share it with gets your paid episodes too.
      </p>

      <ul class="private-feeds-list">
        <% @private_feeds.each do |feed| %>
          <li class="private-feed" data-controller="clipboard subscribe-links">
            <% full_url = "#{request.base_url}#{feed.url}" %>
            <span class="private-feed-title"><%= feed.title %></span>
            <input type="text" class="private-feed-url" readonly
                   value="<%= full_url %>"
                   data-clipboard-target="source"
                   onclick="this.select()">
            <button type="button" class="btn-secondary"
                    data-action="click->clipboard#copy">Copy</button>

            <%# One tap instead of copy, switch app, find the add-by-URL screen,
                paste. That sequence is the worst part of a paid podcast on a
                phone, and it's where people give up.

                Audio feeds only — an article feed in a podcast app is nothing
                but confusion. iOS only too: neither scheme is registered
                elsewhere, and one with no handler fails silently, so these sit
                beside Copy rather than replacing it. %>
            <% if feed.kind.in?([ :podcast, :release ]) %>
              <a class="btn-secondary private-feed-app" data-platforms="ios" hidden
                 href="podcast://<%= full_url.sub(%r{\Ahttps?://}, '') %>">Apple Podcasts</a>
              <a class="btn-secondary private-feed-app" data-platforms="ios" hidden
                 href="overcast://x-callback-url/add?url=<%= CGI.escape(full_url) %>">Overcast</a>
            <% end %>
          </li>
        <% end %>
      </ul>

      <%# Rotating the token invalidates every link above at once. That's
          destructive in a way a member can't undo, so it confirms first and
          says exactly what breaks. %>
      <p class="private-feeds-regenerate">
        <%= button_to "Refresh your private links",
              regenerate_media_token_path,
              method: :post,
              class: "btn-secondary",
              form_class: "private-feeds-regenerate-form",
              data: { turbo_confirm: "Create new feed links? Your current links will stop working straight away, and you'll need to update your podcast app." } %>
        <span class="private-feeds-note">
          If you're private link has been compromised, click the above button and you'll get a fresh set of links. The old links will stop working so you'll need to resubscribe in your podcast player.
        </span>
      </p>
    </div>
  <% end %>
</div>
