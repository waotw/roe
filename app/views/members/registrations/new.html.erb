<div class="max-w-md mx-auto p-8">
  <h1 class="text-2xl font-bold mb-6">Sign Up</h1>

  <%= form_with model: @member, url: signup_path, class: "space-y-4" do |f| %>
    <% if @member.errors.any? %>
      <div class="bg-red-50 border border-red-300 p-4">
        <h3 class="font-semibold text-red-900">Errors:</h3>
        <ul class="list-disc list-inside text-red-700">
          <% @member.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :name, class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :name, class: "w-full p-2 border border-gray-300", required: true %>
    </div>

    <div>
      <%= f.label :email, class: "block text-sm font-medium mb-1" %>
      <%= f.email_field :email, class: "w-full p-2 border border-gray-300", required: true %>
    </div>

    <div>
      <%= f.submit "Sign Up", class: "w-full px-4 py-2 bg-blue-600 text-white hover:bg-blue-700" %>
    </div>
  <% end %>

  <p class="text-sm text-gray-600 mt-4">
    Already have an account? <%= link_to "Sign in", signin_path, class: "text-blue-600" %>
  </p>
</div>
