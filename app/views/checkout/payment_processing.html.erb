<div class="member-page">
  <% if current_member&.paid? %>
    <%# Payment confirmed - redirect to success page %>
    <script>
      window.location.href = "<%= checkout_success_path %>";
    </script>
  <% else %>
    <div class="alert alert--info">
      <h1>Processing Payment...</h1>
      <p>Please wait while we confirm your payment.</p>
      <p class="alert-note">This page will update automatically.</p>
    </div>

    <script nonce="<%= request.content_security_policy_nonce %>">
      (function() {
        let attempts = 0;
        const maxAttempts = 30; // 30 attempts * 2 seconds = 60 seconds max
        
        function checkPayment() {
          attempts++;
          
          if (attempts >= maxAttempts) {
            // Timeout - show error
            document.querySelector('.member-page').innerHTML = `
              <div class="alert alert--error">
                <h1>Payment Status Unclear</h1>
                <p>We're having trouble confirming your payment.</p>
                <p class="alert-note">Please check your email for a receipt, or <a href="/account">view your account</a> to confirm your membership status.</p>
              </div>
              <div class="form-actions">
                <a href="/account" class="btn-primary">View Account</a>
                <a href="/" class="btn-secondary">Back to Home</a>
              </div>
            `;
            return;
          }
          
          // Reload to check payment status
          window.location.reload();
        }
        
        // Check every 2 seconds
        setTimeout(checkPayment, 2000);
      })();
    </script>
  <% end %>
</div>
