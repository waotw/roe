<div class="member-page">
  <% if current_member&.paid? %>
    <div class="alert alert--success">
      <h1>Payment Successful!</h1>
      <p>You now have access to all paid content.</p>
    </div>

    <% password = Rails.cache.read("member_#{current_member.id}_password") %>
    <% if password %>
      <div class="alert alert--warning">
        <h2>⚠︎ Your Login Password</h2>
        <p>
          Save your unique password to login in without an email link.
        </p>

        <div class="password-display">
          <%= password %>
        </div>

        <button onclick="navigator.clipboard.writeText(<%= password.to_json %>)" class="btn-outline">
          📋 Copy Password
        </button>

        <p class="password-note">
          You can change this password at any time on your <a href="/account">account page<a/>.
        </p>
      </div>
    <% end %>

  <% else %>
    <div class="alert alert--info">
      <h1>Processing Payment...</h1>
      <p>Please wait while we confirm your payment.</p>
      <p class="alert-note">This page will update automatically.</p>
    </div>

    <script nonce="<%= request.content_security_policy_nonce %>">
      // Reload page every 2 seconds until member is upgraded
      setTimeout(function() {
        window.location.reload();
      }, 2000);
    </script>
  <% end %>
</div>
