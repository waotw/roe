<div class="max-w-2xl mx-auto p-8">
  <% if current_member&.paid? %>
    <div class="bg-green-50 border border-green-300 p-6 mb-6">
      <h1 class="text-2xl font-bold text-green-900 mb-2">Payment Successful!</h1>
      <p class="text-green-800">You now have access to all paid content.</p>
    </div>

    <% password = Rails.cache.read("member_#{current_member.id}_password") %>
    <% if password %>
      <div class="bg-amber-50 border-2 border-amber-500 p-6 mb-6">
        <h2 class="text-lg font-semibold text-amber-900 mb-2">⚠︎ Your Login Password</h2>
        <p class="text-sm text-amber-800 mb-3">
          Save your unique password to login in without an email link.
        </p>

        <div class="bg-white border border-amber-300 p-4 font-mono text-lg mb-3">
          <%= password %>
        </div>

        <button onclick="navigator.clipboard.writeText(<%= password.to_json %>)"
                class="px-4 py-2 bg-amber-200 hover:bg-amber-300 border border-amber-600 font-mono text-sm">
          📋 Copy Password
        </button>

        <p class="text-xs text-amber-700 mt-3">
          You can change this password at any time on your <a href="/account">account page<a/>.
        </p>
      </div>
    <% end %>

    <!--<div class="space-y-3">
      <%= link_to "Browse Paid Content", root_path, class: "block text-center px-4 py-2 bg-blue-600 text-white hover:bg-blue-700" %>
    </div>-->

  <% else %>
    <div class="bg-blue-50 border border-blue-300 p-6">
      <h1 class="text-xl font-bold text-blue-900 mb-2">Processing Payment...</h1>
      <p class="text-blue-800">Please wait while we confirm your payment.</p>
      <p class="text-sm text-blue-600 mt-2">This page will update automatically.</p>
    </div>

    <script nonce="<%= request.content_security_policy_nonce %>">
      // Reload page every 2 seconds until member is upgraded
      setTimeout(function() {
        window.location.reload();
      }, 2000);
    </script>
  <% end %>
</div>
