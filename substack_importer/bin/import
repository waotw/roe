#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "ostruct"

$LOAD_PATH.unshift File.expand_path("../lib", __dir__)

require "substack_importer"

module SubstackImporter
  class CLI
    def initialize
      @options = OpenStruct.new(
        input: nil,
        output: "output",
        base_url: nil,
        no_fetch: false,
        dry_run: false,
        verbose: false,
        replace_media: false,
        manifest: nil,
        drafts: false,
        published: true,
        type: nil,
        before: nil,
        after: nil
      )
    end

    def run(argv = ARGV)
      parser = option_parser
      parser.parse!(argv)

      if @options.manifest
        run_manifest_mode
      elsif @options.input
        run_import_mode
      else
        puts parser
        exit 1
      end
    rescue OptionParser::InvalidOption, OptionParser::MissingArgument => e
      puts "Error: #{e.message}"
      puts parser
      exit 1
    end

    private

    def option_parser
      OptionParser.new do |opts|
        opts.banner = "Usage: bin/import [options]"
        opts.separator ""
        opts.separator "Import Substack export into Roe CMS"
        opts.separator ""
        opts.separator "Primary import:"
        opts.separator "  bin/import --input path/to/export [--output site/] [--base-url URL] [--no-fetch] [--dry-run] [--verbose] [--replace-media]"
        opts.separator ""
        opts.separator "Secondary media download:"
        opts.separator "  bin/import --manifest missing_media.yml --output site/"
        opts.separator ""

        opts.on("-i", "--input PATH", "ZIP file or extracted directory") do |v|
          @options.input = v
        end

        opts.on("-o", "--output DIR", "Output root directory (default: output)") do |v|
          @options.output = v
        end

        opts.on("-b", "--base-url URL", "Publication URL override (e.g., https://thombenjamin.substack.com)") do |v|
          @options.base_url = v
        end

        opts.on("--no-fetch", "Skip live fetching entirely (offline mode)") do
          @options.no_fetch = true
        end

        opts.on("-n", "--dry-run", "Show what would be written without writing") do
          @options.dry_run = true
        end

        opts.on("-v", "--verbose", "Detailed logging") do
          @options.verbose = true
        end

        opts.on("--replace-media", "Re-download existing media files") do
          @options.replace_media = true
        end

        opts.on("-m", "--manifest PATH", "Manifest file for secondary download mode") do |v|
          @options.manifest = v
        end

        opts.on("--drafts", "Include draft posts") do
          @options.drafts = true
        end

        opts.on("--published", "Include published posts (default)") do
          @options.published = true
        end

        opts.on("-t", "--type TYPE", "Filter by type: newsletter, podcast, page") do |v|
          @options.type = v
        end

        opts.on("--before DATE", "Filter posts before date (YYYY-MM-DD)") do |v|
          @options.before = Date.parse(v)
        end

        opts.on("--after DATE", "Filter posts after date (YYYY-MM-DD)") do |v|
          @options.after = Date.parse(v)
        end

        opts.on("-h", "--help", "Show this help") do
          puts opts
          exit 0
        end
      end
    end

    def run_import_mode
      importer = Importer.new(@options)
      importer.run
    end

    def run_manifest_mode
      downloader = ManifestDownloader.new(@options)
      downloader.run
    end
  end
end

SubstackImporter::CLI.new.run
