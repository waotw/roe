# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore system files
.DS_Store
*/.DS_Store
**/.DS_Store

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/site/db/*.sqlite3
/site/db/*.sqlite3-*
!/site/db/.keep

/public/assets

# Ignore key files for decrypting credentials and more.
/config/*.key

# credentials.yml.enc is per-install — bin/setup generates a fresh one with
# install-specific Active Record Encryption keys (primary_key,
# deterministic_key, key_derivation_salt). Shipping the dev's encrypted
# credentials to other installs creates a master.key mismatch on every
# update (their key can't decrypt our credentials), which crashes boot
# during asset compilation. Each install owns its own — gitignored at
# source, regenerated by setup, preserved across updates by
# UpdateOrchestrator's preserve_secrets step.
/config/credentials.yml.enc


/app/assets/builds/*
!/app/assets/builds/.keep
/app/assets/builds/*
migrate-main.zip
expressiveegg/
migrate-main/

# Entire site folder is on persistent volume
/site/
/content/

# Static site generation output
/public/
output/
site_backups/
static_site/
faircamp/

# Graphify generated files
graphify-out/
/graphify-out/*
**/.graphify_*
**/graph.json
GRAPH_REPORT.md

# Roe versioned structure
/current/
/staging/
/static_site/
/site_backups/

# Temporary VERSION file copied during deploy (source is at ROE_ROOT/VERSION)
/VERSION

# Secrets:
.kamal/secrets

# Generated deploy configs (created via Admin > Configuration > deploy.yml)
# Never commit these — they contain personal server/registry values.
config/deploy*.yml
fly*.toml
app/themes/egg.css
