#!/usr/bin/env ruby
require "fileutils"
require "open3"
require "tmpdir"

APP_ROOT = File.expand_path("..", __dir__)
ROE_ROOT = File.basename(APP_ROOT) == "current" ? File.expand_path("..", APP_ROOT) : APP_ROOT

def system!(*args)
  system(*args, exception: true)
end

# ── Setup TUI ───────────────────────────────────────────────────────────
# One updating line per step: [progress bar] pct  Label  ·  live activity.
# Finalizes to a ✓/✗ checklist entry. Full output streams to a log the
# whole time; on failure it's printed inline, and the path is always
# available at the end.
class SetupTUI
  BAR_WIDTH = 20

  def initialize(pastel:, total:, log_path:)
    @pastel = pastel
    @total = total
    @done = 0
    @log_path = log_path
    @log = File.open(log_path, "w")
    @log.sync = true
    # Capture the REAL terminal up front. Steps redirect $stdout to the
    # log, so all status drawing must go to this saved handle — never the
    # live $stdout, or render would feed back into the capture.
    @out = $stdout
    @tty = @out.tty?
  end

  attr_reader :log_path

  def step(label)
    @label = label
    @log.puts("\n=== #{label} ===")
    @log.flush
    render(nil)
    begin
      yield self
      @done += 1
      finalize(:ok)
    rescue => e
      finalize(:fail)
      reveal(e)
      close
      raise
    end
  end

  # Run a shell command, streaming combined output to the log + activity
  # line. Raises on non-zero exit (so the step fails and output reveals).
  def sh(*cmd)
    Open3.popen2e(*cmd) do |_stdin, out, wait_thr|
      out.each_line do |line|
        @log.print(line)
        @log.flush
        render(line.chomp)
      end
      status = wait_thr.value
      raise "#{cmd.join(' ')} exited with status #{status.exitstatus}" unless status.success?
    end
  end

  # Run a Ruby block with its $stdout/$stderr captured to the real log
  # file (a genuine IO — Rails' Logger probes $stdout during boot and
  # would choke on a fake object). No live tail for Ruby steps; they're
  # fast and the bar + label is enough.
  def ruby
    original_out = $stdout
    original_err = $stderr
    $stdout = @log
    $stderr = @log
    yield
  ensure
    $stdout = original_out
    $stderr = original_err
  end

  def close
    @log.close unless @log.closed?
  end

  private

  def bar(fraction)
    filled = (BAR_WIDTH * fraction).round
    @pastel.cyan("█" * filled) + @pastel.dim("░" * (BAR_WIDTH - filled))
  end

  def render(activity)
    return unless @tty
    frac = @total.zero? ? 0.0 : @done.to_f / @total
    line = "  [#{bar(frac)}] #{(frac * 100).round.to_s.rjust(3)}%  #{@pastel.bold(@label)}"
    line += @pastel.dim("  ·  #{truncate(activity)}") if activity && !activity.empty?
    @out.print("\r\e[K#{line}")
    @out.flush
  end

  def finalize(status)
    mark = status == :ok ? @pastel.green("✓") : @pastel.red("✗")
    unless @tty
      @out.puts("#{status == :ok ? '✓' : '✗'} #{@label}")
      return
    end
    frac = @total.zero? ? 0.0 : @done.to_f / @total
    @out.print("\r\e[K  [#{bar(frac)}] #{mark}  #{@pastel.bold(@label)}\n")
    @out.flush
  end

  def reveal(error)
    @out.puts
    @out.puts @pastel.red.bold("This step failed:")
    @out.puts "  #{error.message}"
    @out.puts
    @out.puts @pastel.bold("What happened:")
    @out.puts(File.read(@log_path)) rescue nil
    @out.puts
    @out.puts @pastel.dim("Full log saved to: #{@log_path}")
  end

  def truncate(str, max = 48)
    clean = str.to_s.gsub(/\e\[[0-9;]*m/, "").strip
    clean.length > max ? "#{clean[0, max - 1]}…" : clean
  end
end

# ── Bundle-step progress (no gems) ────────────────────────────────────────
# The full TUI gems (pastel, tty-box) live in the bundle, so they can't be
# loaded until AFTER `bundle install` runs. This tiny renderer gives that
# one step the same look anyway — a cyan progress bar + live activity line
# finalizing to a ✓ — using nothing but raw ANSI (no gem dependencies). It
# drives the bar off the gem count in Gemfile.lock, advancing as Bundler
# fetches/installs each gem, then snaps to 100% on success.
class BootstrapProgress
  BAR_WIDTH = 20
  C = "\e[36m"  # cyan
  D = "\e[2m"   # dim
  G = "\e[32m"  # green
  R = "\e[31m"  # red
  B = "\e[1m"   # bold
  X = "\e[0m"   # reset

  # Count the gems Bundler manages, from the lockfile's spec list — the
  # denominator for the bar. Each managed gem is a 4-space-indented
  # "name (version)" line under GEM/specs: (dependency lines are indented
  # 6, so they're excluded). Falls back to a sane estimate if the lockfile
  # is missing/unreadable, so the bar still advances either way.
  def self.gem_count(lockfile)
    return 80 unless File.exist?(lockfile)
    n = File.foreach(lockfile).count { |l| l =~ /\A    [a-zA-Z0-9_.\-]+ \(.+\)/ }
    n.positive? ? n : 80
  rescue
    80
  end

  # Print a finalized ✓ line for a step that needed no work (re-runs where
  # `bundle check` already passes). Mirrors finalize(:ok)'s look.
  def self.skip(label, note = nil)
    suffix = note ? "  #{D}·  #{note}#{X}" : ""
    if $stdout.tty?
      $stdout.puts("  [#{C}#{'█' * BAR_WIDTH}#{X}] #{G}✓#{X}  #{B}#{label}#{X}#{suffix}")
    else
      $stdout.puts("✓ #{label}")
    end
  end

  def initialize(label:, total:, log_path:)
    @label = label
    @total = total <= 0 ? 1 : total
    @seen = {}
    @log_path = log_path
    @log = File.open(log_path, "w")
    @log.sync = true
    @out = $stdout
    @tty = @out.tty?
  end

  # Run a command, streaming combined output to the log while advancing the
  # bar as gems are fetched/installed. Raises on non-zero exit so the
  # caller's flow stops (and the log is revealed inline).
  def run(*cmd)
    render(nil)
    Open3.popen2e(*cmd) do |_stdin, io, wait_thr|
      io.each_line do |line|
        @log.print(line)
        track(line)
        render(line.chomp)
      end
      status = wait_thr.value
      raise "#{cmd.join(' ')} exited with status #{status.exitstatus}" unless status.success?
    end
    finalize(:ok)
  rescue => e
    finalize(:fail)
    reveal(e)
    raise
  ensure
    @log.close unless @log.closed?
  end

  private

  # Bundler prints "Fetching <gem> <ver>" then "Installing <gem> <ver>" for
  # each gem it installs. Track unique gem names so the fetch+install pair
  # (and any native-extension rebuilds) don't double-count.
  def track(line)
    @seen[$1] = true if line =~ /^\s*(?:Fetching|Installing)\s+(\S+)/
  end

  def fraction
    (@seen.size.to_f / @total).clamp(0.0, 0.99)
  end

  def bar(frac)
    filled = (BAR_WIDTH * frac).round
    "#{C}#{'█' * filled}#{X}#{D}#{'░' * (BAR_WIDTH - filled)}#{X}"
  end

  def render(activity)
    return unless @tty
    f = fraction
    line = "  [#{bar(f)}] #{(f * 100).round.to_s.rjust(3)}%  #{B}#{@label}#{X}"
    line += "  #{D}·  #{truncate(activity)}#{X}" if activity && !activity.empty?
    @out.print("\r\e[K#{line}")
    @out.flush
  end

  def finalize(status)
    unless @tty
      @out.puts(status == :ok ? "✓ #{@label}" : "✗ #{@label}")
      return
    end
    if status == :ok
      @out.print("\r\e[K  [#{C}#{'█' * BAR_WIDTH}#{X}] #{G}✓#{X}  #{B}#{@label}#{X}\n")
    else
      @out.print("\r\e[K  [#{bar(fraction)}] #{R}✗#{X}  #{B}#{@label}#{X}\n")
    end
    @out.flush
  end

  def reveal(error)
    @out.puts
    @out.puts "#{R}#{B}This step failed:#{X}"
    @out.puts "  #{error.message}"
    @out.puts
    @out.puts "#{B}What happened:#{X}"
    @out.puts(File.read(@log_path)) rescue nil
    @out.puts
    @out.puts "#{D}Full log saved to: #{@log_path}#{X}"
  end

  def truncate(str, max = 48)
    clean = str.to_s.gsub(/\e\[[0-9;]*m/, "").strip
    clean.length > max ? "#{clean[0, max - 1]}…" : clean
  end
end

FileUtils.chdir APP_ROOT do
  # ── Gems first ────────────────────────────────────────────────────────
  # The full TUI gems (pastel, tty-box) aren't loadable until the bundle is
  # installed — but this step still gets a real progress bar via the
  # gem-free BootstrapProgress renderer above. After the bundle is in place
  # we switch to the gem-backed SetupTUI for every step that follows.
  if system("bundle check", out: File::NULL, err: File::NULL)
    BootstrapProgress.skip("Installing gems", "already up to date")
  else
    gems_log = File.join(Dir.tmpdir, "roe-gems-#{Process.pid}.log")
    total    = BootstrapProgress.gem_count(File.join(APP_ROOT, "Gemfile.lock"))
    BootstrapProgress.new(label: "Installing gems", total: total, log_path: gems_log)
                     .run("bundle", "install")
  end

  require "bundler/setup"
  require "pastel"
  require "tty-box"

  pastel   = Pastel.new
  log_path = File.join(Dir.tmpdir, "roe-setup-#{Process.pid}.log")

  puts
  puts TTY::Box.frame(
    pastel.bold("Setting up Roe"),
    padding: [0, 3],
    align: :center,
    border: :thick,
    style: { border: { fg: :cyan } }
  )
  puts

  # 8 progress-tracked steps (the interactive admin setup runs separately
  # after, with its own UI).
  tui = SetupTUI.new(pastel: pastel, total: 8, log_path: log_path)

  # Per-install encryption material lives under /site/system/secrets/ (see
  # the long note in config/application.rb). Compute that path WITHOUT
  # loading Rails (which would itself read credentials and fail if absent).
  parent_dir       = File.expand_path("..", APP_ROOT)
  versioned_layout = File.basename(APP_ROOT) == "current"
  roe_root         = versioned_layout ? parent_dir : APP_ROOT
  site_path        = ENV["ROE_SITE_PATH"] || File.join(roe_root, "site")
  secrets_dir      = File.join(site_path, "system", "secrets")
  master_key_path  = File.join(secrets_dir, "master.key")
  credentials_path = File.join(secrets_dir, "credentials.yml.enc")

  # ── 1. Encryption keys ────────────────────────────────────────────────
  tui.step("Preparing encryption keys") do |s|
    s.ruby do
      unless File.exist?(master_key_path)
        puts "Generating new master key…"
        require "securerandom"
        FileUtils.mkdir_p(secrets_dir)
        File.chmod(0o700, secrets_dir)
        File.write(master_key_path, SecureRandom.hex(16))
        File.chmod(0o600, master_key_path)
        puts "Master key created at site/system/secrets/master.key"

        if File.exist?(credentials_path)
          File.delete(credentials_path)
          puts "Removed stale credentials.yml.enc (will be regenerated)"
        end

        readme_path = File.join(secrets_dir, "README.txt")
        unless File.exist?(readme_path)
          File.write(readme_path,
            "This directory contains your install's encryption keys.\n" \
            "Do NOT copy these files to other Roe installs or share them publicly.\n" \
            "Do ADD this directory to your .gitignore file if your repo is public.\n" \
            "Site backups include these files so a /site restore is self-sufficient.\n" \
            "SiteSync is configured to exclude this directory so dev/prod stay independent.\n")
        end
      end

      # Seed secret_key_base + AR encryption keys into the encrypted
      # credentials, each independently, writing once at the end only if
      # something changed. (See the detailed rationale that used to live
      # inline; preserved in git history.)
      require "active_support"
      require "active_support/encrypted_configuration"
      require "securerandom"

      if File.exist?(master_key_path)
        enc_config = ActiveSupport::EncryptedConfiguration.new(
          config_path: credentials_path,
          key_path:    master_key_path,
          env_key:     "RAILS_MASTER_KEY",
          raise_if_missing_key: true
        )

        existing = enc_config.config rescue {}
        raw      = enc_config.read   rescue ""
        hash     = raw.to_s.empty? ? {} : (YAML.safe_load(raw) || {})
        needs_write = false

        if existing[:secret_key_base].to_s.empty?
          puts "Generating secret_key_base…"
          hash["secret_key_base"] = SecureRandom.hex(64)
          needs_write = true
        else
          puts "secret_key_base present, skipping"
        end

        if existing.dig(:active_record_encryption, :primary_key).to_s.empty?
          puts "Generating Active Record encryption keys…"
          hash["active_record_encryption"] = {
            "primary_key"         => SecureRandom.alphanumeric(32),
            "deterministic_key"   => SecureRandom.alphanumeric(32),
            "key_derivation_salt" => SecureRandom.alphanumeric(32)
          }
          needs_write = true
        else
          puts "Active Record encryption keys present, skipping"
        end

        enc_config.write(hash.to_yaml) if needs_write
        puts "Credentials ready"
      else
        puts "Skipping (master key not found yet)"
      end
    end
  end

  # ── 2. Load Roe ───────────────────────────────────────────────────────
  tui.step("Loading Roe") do |s|
    s.ruby { require_relative "../config/environment" }
  end

  site_path = RoeSitePaths::SITE_PATH

  # ── 3. Site structure ─────────────────────────────────────────────────
  tui.step("Creating site structure") do |s|
    s.ruby do
      [
        site_path,
        File.join(site_path, "posts"),
        File.join(site_path, "pages"),
        File.join(site_path, "theme"),
        File.join(site_path, "media", "images"),
        File.join(site_path, "media", "audio"),
        File.join(site_path, "media", "video"),
        File.join(site_path, "emails"),
        File.join(site_path, "layout"),
        File.join(site_path, "system", "global"),
        File.join(site_path, "system", "features"),
        File.join(site_path, "system", "defaults"),
        File.join(site_path, "system", "assets", "fonts"),
        File.join(site_path, "system", "assets", "images"),
        File.join(site_path, "db", "development"),
      ].each { |dir| puts "ensuring #{dir}"; FileUtils.mkdir_p(dir) }
    end
  end

  # ── 4. Database ───────────────────────────────────────────────────────
  tui.step("Setting up the database") do |s|
    s.sh("bin/rails", "db:drop") if ARGV.include?("--reset")
    # db:prepare creates missing DBs, loads Solid Cache/Queue schemas, and
    # runs pending migrations — idempotent on first install and re-runs.
    s.sh("bin/rails", "db:prepare")
  end

  # ── 5. Default configuration / theme / pages ──────────────────────────
  tui.step("Generating configuration") do |s|
    s.ruby do
      ConfigGenerator.generate_all
      puts "default config generated"

      default_theme_src  = Rails.root.join("app", "themes", "default.css")
      default_theme_dest = File.join(site_path, "theme", "default.css")
      if File.exist?(default_theme_src) && !File.exist?(default_theme_dest)
        FileUtils.cp(default_theme_src, default_theme_dest)
        puts "copied default.css to site/theme/"
      else
        puts "theme already present, skipping"
      end

      PageGenerator.generate_defaults
      puts "default pages generated"
    end
  end

  # ── 6. Content sync ───────────────────────────────────────────────────
  tui.step("Syncing content") do |s|
    s.ruby { ContentSync.sync_all }
  end

  # ── 7. Styles ─────────────────────────────────────────────────────────
  tui.step("Building styles") do |s|
    s.sh("bin/rails", "tailwindcss:build")
  end

  # ── 8. Cleanup ────────────────────────────────────────────────────────
  tui.step("Cleaning up") do |s|
    s.sh("bin/rails", "log:clear", "tmp:clear")
  end

  tui.close

  puts
  puts pastel.green("Core setup complete.")
  puts pastel.dim("Setup details: #{log_path}")
  puts

  # ── Admin user (its own interactive TUI) ──────────────────────────────
  bootstrap = File.join(APP_ROOT, "bin", "bootstrap")
  system(RbConfig.ruby, bootstrap, in: $stdin, out: $stdout, err: $stderr)

  # Ensure start.command exists in ROE_ROOT for double-click launching.
  start_command = File.join(roe_root, "start.command")
  unless File.exist?(start_command)
    File.write(start_command, <<~SH)
      #!/bin/bash
      # Double-click this file to start Roe in Terminal.
      cd "$(dirname "$0")"
      ./roe.sh start
    SH
    File.chmod(0o755, start_command)
    puts pastel.dim("Created start.command (double-click to start the server)")
  end

  puts
  puts TTY::Box.frame(
    "#{pastel.green.bold('You\'re all set.')}\n\nStarting Roe…",
    padding: [0, 3],
    align: :center,
    border: :thick,
    style: { border: { fg: :green } }
  )
  puts
  STDOUT.flush

  # Hand off to roe.sh start — clean shell process, no bundler interference.
  exec("/bin/bash", File.join(roe_root, "roe.sh"), "start")
end
