#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")

  # Per-install encryption keys live under /site/system/secrets/ (not
  # current/config/) — see the lengthy comment in config/application.rb
  # for the why. We need to compute that path here without loading Rails
  # (which would itself try to read credentials and fail if missing).
  parent_dir       = File.expand_path("..", APP_ROOT)
  versioned_layout = File.basename(APP_ROOT) == "current"
  roe_root         = versioned_layout ? parent_dir : APP_ROOT
  site_path        = ENV["ROE_SITE_PATH"] || File.join(roe_root, "site")
  secrets_dir      = File.join(site_path, "system", "secrets")

  puts "\n== Checking master key =="
  master_key_path  = File.join(secrets_dir, "master.key")
  credentials_path = File.join(secrets_dir, "credentials.yml.enc")

  unless File.exist?(master_key_path)
    # Legacy migration: if a master.key still exists under current/config/
    # (pre-/site/system/secrets/ install), the one-time block in
    # config/application.rb would have already moved it on first boot.
    # We hit this branch only on truly fresh installs.
    puts "⚠️  #{master_key_path.sub(roe_root + '/', '')} not found. Generating new master key..."
    require "securerandom"
    FileUtils.mkdir_p(secrets_dir)
    File.chmod(0o700, secrets_dir)
    File.write(master_key_path, SecureRandom.hex(16))
    File.chmod(0o600, master_key_path)
    puts "✅ Master key created at site/system/secrets/master.key"

    # Remove any existing credentials file — it was encrypted with a different
    # key and would cause InvalidMessage errors on boot.
    if File.exist?(credentials_path)
      File.delete(credentials_path)
      puts "   Removed stale credentials.yml.enc (will be regenerated)"
    end

    # Drop a one-line warning README so anyone poking around the
    # secrets directory understands what's in there.
    readme_path = File.join(secrets_dir, "README.txt")
    unless File.exist?(readme_path)
      File.write(readme_path,
        "This directory contains your install's encryption keys.\n" \
        "Do NOT copy these files to other Roe installs or share them publicly.\n" \
        "Do ADD this directory to your .gitignore file if your repo is public.\n" \
        "Site backups include these files so a /site restore is self-sufficient.\n" \
        "SiteSync is configured to exclude this directory so dev/prod stay independent.\n")
    end
  end

  puts "\n== Checking AR Encryption credentials =="
  # Check credentials directly without loading Rails to avoid double-init.
  # ActiveSupport::EncryptedConfiguration can decrypt the file standalone
  # — and importantly, write to it whether or not it already exists, so
  # this branch runs even on installs that never had a credentials.yml.enc.
  require "active_support"
  require "active_support/encrypted_configuration"
  require "securerandom"

  if File.exist?(master_key_path)
    enc_config = ActiveSupport::EncryptedConfiguration.new(
      config_path: credentials_path,
      key_path:    master_key_path,
      env_key:     "RAILS_MASTER_KEY",
      raise_if_missing_key: true
    )

    existing = enc_config.config rescue {}
    if existing.dig(:active_record_encryption, :primary_key).present?
      puts "   AR Encryption keys present, skipping"
    else
      puts "   Generating AR Encryption keys..."
      raw = enc_config.read rescue ""
      hash = raw.blank? ? {} : YAML.safe_load(raw) || {}
      hash['active_record_encryption'] = {
        'primary_key'         => SecureRandom.alphanumeric(32),
        'deterministic_key'   => SecureRandom.alphanumeric(32),
        'key_derivation_salt' => SecureRandom.alphanumeric(32)
      }
      enc_config.write(hash.to_yaml)
      puts "✅ AR Encryption keys written to credentials.yml.enc"
    end
  else
    puts "   Skipping (master key not found yet)"
  end

  # Load Rails environment once — boots everything
  require_relative "../config/environment"

  puts "\n== Checking site directory structure =="
  site_path = RoeSitePaths::SITE_PATH

  unless File.directory?(site_path)
    puts "⚠️  Site directory not found at #{site_path}"
    puts "   Creating bare-bones site structure..."
  end

  # Always ensure all expected directories exist
  [
    site_path,
    File.join(site_path, "posts"),
    File.join(site_path, "pages"),
    File.join(site_path, "theme"),
    File.join(site_path, "media", "images"),
    File.join(site_path, "media", "audio"),
    File.join(site_path, "media", "video"),
    File.join(site_path, "emails"),
    File.join(site_path, "layout"),
    File.join(site_path, "system", "global"),
    File.join(site_path, "system", "features"),
    File.join(site_path, "system", "defaults"),
    File.join(site_path, "system", "assets", "fonts"),
    File.join(site_path, "system", "assets", "images"),
    File.join(site_path, "db", "development"),
  ].each { |dir| FileUtils.mkdir_p(dir) }

  puts "✅ Site structure ready"

  puts "\n== Preparing database =="
  system! "bin/rails db:drop" if ARGV.include?("--reset")

  # db:prepare walks every configured database (primary, cache, queue,
  # plus any others if added later): creates missing ones, loads
  # schema files where present (Solid Cache / Queue ship cache_schema.rb
  # and queue_schema.rb instead of migrations), runs pending migrations
  # otherwise. Idempotent — safe on first install and on re-runs.
  system! "bin/rails db:prepare"

  puts "\n== Generating default configuration =="
  ConfigGenerator.generate_all

  puts "\n== Copying default theme =="
  default_theme_src  = Rails.root.join("app", "themes", "default.css")
  default_theme_dest = File.join(site_path, "theme", "default.css")
  if File.exist?(default_theme_src) && !File.exist?(default_theme_dest)
    FileUtils.cp(default_theme_src, default_theme_dest)
    puts "✅ Copied default.css to site/theme/"
  else
    puts "   Theme already present, skipping"
  end

  puts "\n== Generating default pages =="
  PageGenerator.generate_defaults

  puts "\n== Syncing content to database =="
  ContentSync.sync_all

  puts "\n== Building Tailwind CSS =="
  system! "bin/rails tailwindcss:build"

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  puts "\n== Creating admin user =="
  # Use array form to avoid shell word-splitting on paths with spaces.
  # Pass file descriptors explicitly so gets/print work interactively.
  bootstrap = File.join(APP_ROOT, 'bin', 'bootstrap')
  system(RbConfig.ruby, bootstrap, in: $stdin, out: $stdout, err: $stderr)

  # Ensure start.command exists in ROE_ROOT for double-click launching
  roe_root = File.expand_path('..', APP_ROOT)
  start_command = File.join(roe_root, 'start.command')
  unless File.exist?(start_command)
    File.write(start_command, <<~SH)
      #!/bin/bash
      # Double-click this file to start Roe CMS in Terminal.
      cd "$(dirname "$0")"
      ./roe.sh start
    SH
    File.chmod(0755, start_command)
    puts "\n✅ Created start.command (double-click to start the server)"
  end

  puts "\n✅ Setup complete! Starting server..."
  STDOUT.flush

  # Hand off to roe.sh start — clean shell process, no bundler interference.
  # ROE_FIRST_RUN=1 tells roe.sh to open the admin/welcome URL instead of root.
  roe_sh = File.join(roe_root, 'roe.sh')
  ENV['ROE_FIRST_RUN'] = '1'
  exec('/bin/bash', roe_sh, 'start')
end
