#!/usr/bin/env ruby

require 'csv'
require 'fileutils'
require 'optparse'
require 'time'

# Configuration
IMPORT_DIR = File.expand_path(ENV['SUBSTACK_EXPORT'] || '~/Downloads/P4MPjfCCR1q-9K81hwOokA')
OUTPUT_DIR = File.expand_path(ENV['SUBSTACK_TRIMMED'] || '~/Downloads/ee-test-export')
NUM_SUBSCRIBERS = 100
NUM_POSTS = 20


# Substack's own export varies its header case between exports, so read both
# spellings the way MembersImporter does.
def field(row, *names) = names.filter_map { |n| row[n] }.first.to_s
def plan_of(row)       = field(row, 'plan', 'Plan').downcase.strip
def flag?(row, *names) = field(row, *names).downcase == 'true'
def email_of(row)      = field(row, 'email', 'Email', 'EMAIL').downcase.strip

# Mirrors MembersImporter#subscription_effective?. A paid plan that has lapsed
# imports as FREE, which is the case the never-downgrade rule exists for — so a
# sample without one can't exercise it.
def effective?(row)
  return true if flag?(row, 'active_subscription', 'Active Subscription')

  expiry = field(row, 'expiry', 'Expiry')
  return false if expiry.empty?

  begin
    Time.parse(expiry) > Time.now
  rescue ArgumentError
    false
  end
end

PAID_PLANS = %w[lifetime yearly monthly quarterly semiannually ios_app].freeze

# The buckets Roe branches on when deciding a tier — not the raw plan strings.
# determine_tier groups several plans together, and effectiveness can override
# any of them, so sampling by plan alone misses the interesting rows.
#
# A row lands in the first bucket that claims it.
PLAN_BUCKETS = {
  'lifetime'     => ->(r) { plan_of(r) == 'lifetime' && effective?(r) },
  'annual'       => ->(r) { plan_of(r) == 'yearly' && effective?(r) },
  'lapsed'       => ->(r) { PAID_PLANS.include?(plan_of(r)) && !effective?(r) },
  'monthly'      => ->(r) { plan_of(r) == 'monthly' && effective?(r) },
  'other_paid'   => ->(r) { %w[quarterly semiannually ios_app].include?(plan_of(r)) && effective?(r) },
  'comp'         => ->(r) { %w[comp other].include?(plan_of(r)) },
  'unsubscribed' => ->(r) { flag?(r, 'email_disabled', 'Email Disabled') },
  'free'         => ->(r) { plan_of(r).empty? }
}.freeze

# CLI flags
options = { ensure_podcasts: 0, per_plan: 5, plans: nil }
OptionParser.new do |opts|
  opts.banner = "Usage: trim_substack_export [options]"
  opts.on("--ensure-podcasts N", Integer,
          "Force at least N podcast posts into the sample (default: 0). " \
          "Useful for testing the RSS-feed enrichment path.") do |n|
    options[:ensure_podcasts] = n
  end
  opts.on("--plans LIST", Array,
          "Only sample subscribers from these buckets, comma separated. " \
          "One of: #{PLAN_BUCKETS.keys.join(', ')}. " \
          "Default: an assortment covering all of them.") do |list|
    options[:plans] = list
  end
  opts.on("--per-plan N", Integer,
          "How many subscribers to take from each bucket before filling the " \
          "rest at random (default: 5).") do |n|
    options[:per_plan] = n
  end
end.parse!

# Create output directory structure
FileUtils.mkdir_p(OUTPUT_DIR)
FileUtils.mkdir_p("#{OUTPUT_DIR}/posts")

puts "Processing Substack export..."
puts "Source: #{IMPORT_DIR}"
puts "Output: #{OUTPUT_DIR}"

# 1. Find the email_list file (it has the site name in it)
email_list_file = Dir.glob("#{IMPORT_DIR}/email_list.*.csv").first
unless email_list_file
  puts "❌ Error: Could not find email_list.*.csv"
  exit 1
end

email_list_filename = File.basename(email_list_file)
puts "\n1. Processing #{email_list_filename}..."

# Read and sample random subscribers
email_list = CSV.read(email_list_file, headers: true)
total_subscribers = email_list.count
# Take a few from each bucket first so every tier decision Roe can make is
# represented, then fill the remaining slots at random. A purely random sample
# of a mostly-free list will usually contain no lifetime members at all, and a
# run that can't reach a branch looks identical to one that reached it and
# found nothing wrong.
wanted_buckets = options[:plans] || PLAN_BUCKETS.keys
unknown = wanted_buckets - PLAN_BUCKETS.keys
unless unknown.empty?
  puts "❌ Unknown plan bucket(s): #{unknown.join(', ')}"
  puts "   Available: #{PLAN_BUCKETS.keys.join(', ')}"
  exit 1
end

claimed = {}
email_list.entries.each do |row|
  bucket = PLAN_BUCKETS.find { |_, match| match.call(row) }&.first
  (claimed[bucket] ||= []) << row if bucket
end

forced = wanted_buckets.flat_map { |b| (claimed[b] || []).sample(options[:per_plan]) }.uniq

if options[:plans]
  # Focusing on specific buckets: don't dilute the sample with everything else.
  kept_emails = forced.first(NUM_SUBSCRIBERS)
else
  remaining = [ NUM_SUBSCRIBERS - forced.size, 0 ].max
  kept_emails = forced + (email_list.entries - forced).sample(remaining)
end

kept_email_addresses = kept_emails.map { |row| email_of(row) }.reject(&:empty?).to_set

puts "  Subscribers by what Roe would do with them:"
wanted_buckets.each do |bucket|
  took = kept_emails.count { |r| PLAN_BUCKETS[bucket].call(r) }
  available = (claimed[bucket] || []).size
  flag = available.zero? ? "  ⚠️  none in this export — that path won't be tested" : ""
  puts format("    %-13s %3d of %-5d%s", bucket, took, available, flag)
end

# Write sampled email list
CSV.open("#{OUTPUT_DIR}/#{email_list_filename}", 'w') do |csv|
  csv << email_list.headers
  kept_emails.each { |row| csv << row }
end
puts "  Kept #{kept_email_addresses.count} of #{total_subscribers} subscribers"

# 2. Read posts.csv and sample posts
puts "\n2. Processing posts.csv..."
posts_csv = CSV.read("#{IMPORT_DIR}/posts.csv", headers: true)
total_posts = posts_csv.count

ensure_podcasts = options[:ensure_podcasts]
if ensure_podcasts > 0
  # Force N podcast posts into the sample first, then fill the remaining
  # slots with a random sample of any-type posts. Lets the RSS-enrichment
  # path get exercised on every run regardless of the random seed.
  podcast_posts = posts_csv.entries.select { |r| r['type'].to_s == 'podcast' }
  forced = podcast_posts.sample([ ensure_podcasts, podcast_posts.size ].min)
  remaining_slots = [ NUM_POSTS - forced.size, 0 ].max
  random_others = (posts_csv.entries - forced).sample(remaining_slots)
  kept_posts = forced + random_others
  puts "  Forced #{forced.size} podcast posts (of #{podcast_posts.size} available); filled #{random_others.size} more at random"
else
  kept_posts = posts_csv.entries.sample(NUM_POSTS)
end

# Extract post IDs (the number part before the dot)
kept_post_ids = kept_posts.map { |row| row['post_id'].split('.').first }.compact

puts "  Selected #{kept_post_ids.count} posts from #{total_posts}"

# Write filtered posts.csv
CSV.open("#{OUTPUT_DIR}/posts.csv", 'w') do |csv|
  csv << posts_csv.headers
  kept_posts.each { |row| csv << row }
end

# 3. Copy HTML files for kept posts
puts "\n3. Copying HTML files..."
copied_count = 0
kept_post_ids.each do |post_id|
  # Find HTML files that start with this post_id
  html_files = Dir.glob("#{IMPORT_DIR}/posts/#{post_id}.*.html")
  html_files.each do |html_file|
    FileUtils.cp(html_file, "#{OUTPUT_DIR}/posts/#{File.basename(html_file)}")
    copied_count += 1
  end
end
puts "  Copied #{copied_count} HTML files"

# 4. Process delivery CSVs - filter by kept emails AND kept posts
puts "\n4. Processing delivery CSVs..."
delivery_count = 0
delivery_rows_kept = 0
delivery_rows_total = 0

kept_post_ids.each do |post_id|
  # Find the delivery file
  delivery_file = Dir.glob("#{IMPORT_DIR}/posts/#{post_id}.deliver*.csv").first
  next unless delivery_file

  deliveries = CSV.read(delivery_file, headers: true)
  delivery_rows_total += deliveries.count

  filtered = deliveries.select do |row|
    kept_email_addresses.include?(row['email'])
  end

  if filtered.any?
    output_filename = File.basename(delivery_file)
    CSV.open("#{OUTPUT_DIR}/posts/#{output_filename}", 'w') do |csv|
      csv << deliveries.headers
      filtered.each { |row| csv << row }
    end
    delivery_count += 1
    delivery_rows_kept += filtered.count
  end
end
puts "  Processed #{delivery_count} delivery CSVs"
puts "  Kept #{delivery_rows_kept} of #{delivery_rows_total} delivery rows"

# 5. Process opens CSVs - filter by kept emails AND kept posts
puts "\n5. Processing opens CSVs..."
opens_count = 0
opens_rows_kept = 0
opens_rows_total = 0

kept_post_ids.each do |post_id|
  opens_file = Dir.glob("#{IMPORT_DIR}/posts/#{post_id}.opens*.csv").first
  next unless opens_file

  opens = CSV.read(opens_file, headers: true)
  opens_rows_total += opens.count

  filtered = opens.select do |row|
    kept_email_addresses.include?(row['email'])
  end

  if filtered.any?
    output_filename = File.basename(opens_file)
    CSV.open("#{OUTPUT_DIR}/posts/#{output_filename}", 'w') do |csv|
      csv << opens.headers
      filtered.each { |row| csv << row }
    end
    opens_count += 1
    opens_rows_kept += filtered.count
  end
end
puts "  Processed #{opens_count} opens CSVs"
puts "  Kept #{opens_rows_kept} of #{opens_rows_total} opens rows"

# 6. Compress the output directory
puts "\n6. Creating zip file..."
require 'zip'

zip_filename = "#{OUTPUT_DIR}.zip"
File.delete(zip_filename) if File.exist?(zip_filename)

Zip::File.open(zip_filename, create: true) do |zipfile|
  Dir.glob("#{OUTPUT_DIR}/**/*").each do |file|
    next if File.directory?(file)

    # Get the path relative to the parent of OUTPUT_DIR
    relative_path = file.sub("#{File.dirname(OUTPUT_DIR)}/", '')
    zipfile.add(relative_path, file)
  end
end

file_size = (File.size(zip_filename) / 1024.0 / 1024.0).round(2)
puts "  Created: #{zip_filename} (#{file_size} MB)"

puts "\n✅ Done! Trimmed export ready at: #{zip_filename}"
puts "\nSummary:"
puts "  - #{kept_email_addresses.count} subscribers (#{options[:plans] ? options[:plans].join(', ') : 'assorted plans'})"
puts "  - #{kept_posts.count} posts (random)"
puts "  - #{copied_count} HTML files"
puts "  - #{delivery_count} delivery CSVs (#{delivery_rows_kept} rows)"
puts "  - #{opens_count} opens CSVs (#{opens_rows_kept} rows)"
puts "\n📦 Import this file in your Substack importer!"
