#!/usr/bin/env bash
#
# Mirror selected /site/ subtrees back into the Roe app for release prep.
# /site is the source of truth (that's where you develop against);
# /current/lib and /current/app/themes follow.
#
# Two sync rules, one per subtree:
#
#   1. Docs — exact mirror. site/documentation/roe/ ↔ current/lib/.../roe/.
#      --delete is on; anything you delete from /site disappears from the
#      app on the next sync. New files added in /site are propagated.
#
#   2. Themes — update-only. site/theme/ → current/app/themes/.
#      --existing flag means files that exist in BOTH places are updated
#      from /site; files only in /site are ignored (you wanted to add a
#      new bundled theme file, move it manually). Files only in the app
#      are left alone (preserves bundled defaults like other starter
#      themes you haven't installed locally).
#
#   3. Docs index page — single file copy + YAML frontmatter strip.
#      site/pages/documentation.md → current/app/views/documentation/index.md.
#      The user-customizable /documentation page in /site is the source
#      of truth; the bundled copy in /current/app/views/... ships with
#      Roe and gets installed on first setup. The /site copy needs
#      frontmatter (it's a Page); the bundled view only needs the
#      markdown body, so we strip the `---\n…\n---\n` block from the
#      destination after copy.
#
# Usage (from anywhere):
#
#   bin/sync-from-site            # do it
#   bin/sync-from-site --dry-run  # show what would happen, no changes
#   bin/sync-from-site -n         # alias for --dry-run
#
# Runs idempotently — safe to invoke before every `bin/rails release:bump`.
set -euo pipefail

# Resolve project root (parent of current/) regardless of cwd.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROE_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

DRY_RUN=""
case "${1:-}" in
  -n|--dry-run)
    DRY_RUN="-n"
    echo "── DRY RUN — no files will be modified ──"
    echo ""
    ;;
  -h|--help)
    sed -n '3,30p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
esac

cd "$ROE_ROOT"

echo "→ Docs (exact mirror, --delete on):"
echo "    site/documentation/roe/  →  current/lib/site_templates/minimum/documentation/roe/"
rsync -avc $DRY_RUN --delete \
  site/documentation/roe/ \
  current/lib/site_templates/minimum/documentation/roe/
echo ""

echo "→ Themes (update existing files only, --existing on, --delete off):"
echo "    site/theme/  →  current/app/themes/"
rsync -avc $DRY_RUN --existing \
  site/theme/ \
  current/app/themes/
echo ""

echo "→ Docs index page (single file copy + frontmatter strip):"
echo "    site/pages/documentation.md  →  current/app/views/documentation/index.md"
rsync -vc $DRY_RUN \
  site/pages/documentation.md \
  current/app/views/documentation/index.md

# Strip YAML frontmatter from the destination. The /site/pages/
# source needs `---\n…\n---\n` at the top to be a valid Page, but
# the bundled view in /current/app/views/ renders only the markdown
# body — frontmatter would either show as literal text or confuse
# the markdown parser.
#
# awk state machine: on line 1, if it's `---`, enter frontmatter
# mode. While in frontmatter mode, skip lines until the next `---`
# (close), then exit. Print everything else. Robust to files that
# don't start with `---` (no change), files without frontmatter (no
# change), and `---` horizontal rules later in the body (preserved
# because in_fm is already 0 by then).
if [[ -z "$DRY_RUN" ]]; then
  dest="current/app/views/documentation/index.md"
  awk '
    NR == 1 && /^---$/ { in_fm = 1; next }
    in_fm && /^---$/   { in_fm = 0; next }
    !in_fm             { print }
  ' "$dest" > "${dest}.tmp" && mv "${dest}.tmp" "$dest"
  echo "    (stripped YAML frontmatter from destination)"
fi
echo ""

echo "→ Roe docs index page (single file copy + frontmatter strip):"
echo "    site/pages/documentation-all.md  →  current/app/views/documentation/roe_index.md"
rsync -vc $DRY_RUN \
  site/pages/documentation-all.md \
  current/app/views/documentation/roe_index.md

# Same frontmatter strip as the /documentation index above: the /site
# source is a Page (needs `---\n…\n---\n`), the bundled view renders the
# markdown body only. This is the page served at /documentation/roe.
if [[ -z "$DRY_RUN" ]]; then
  dest="current/app/views/documentation/roe_index.md"
  awk '
    NR == 1 && /^---$/ { in_fm = 1; next }
    in_fm && /^---$/   { in_fm = 0; next }
    !in_fm             { print }
  ' "$dest" > "${dest}.tmp" && mv "${dest}.tmp" "$dest"
  echo "    (stripped YAML frontmatter from destination)"
fi
echo ""

echo "→ Root launcher/docs (current/ is canonical → mirror to package root):"
# roe.sh, README.md and LICENSE live in BOTH current/ and the package
# root; current/ is the source of truth (roe.sh is edited there, the docs
# too). The root copies are what users actually invoke/read, so keep them
# in step here rather than only on in-app update. rsync -c so identical
# files are a no-op.
for f in roe.sh README.md LICENSE; do
  echo "    current/$f  →  $f"
  rsync -vc $DRY_RUN "current/$f" "$f"
done
echo ""

# ── Config key drift (advisory, read-only) ────────────────────────────────
# Configs are NOT synced by this script (their values are per-site), but
# their KEYS still need to stay in step with the seeded templates. This
# compares the key STRUCTURE of each /site config against its template and
# reports keys present in one but not the other — chiefly "new material in
# /site that isn't in site_templates yet". Advisory only: it never edits or
# fails (some /site keys are legitimately vestigial), and runs in both modes.
echo "→ Config key drift (advisory — /site vs site_templates, keys only):"
if command -v ruby >/dev/null 2>&1; then
  ruby - "$ROE_ROOT" <<'RUBY' || true
    require "yaml"
    require "set"

    root = ARGV[0]

    # /site config  =>  matching seeded template (plain-YAML configs only;
    # the .erb feature configs are covered by test/lib/site_templates_config_test.rb).
    pairs = {
      "site/system/global/site.yml"          => "current/lib/site_templates/minimum/system/global/site.yml",
      "site/system/global/fonts.yml"         => "current/lib/site_templates/minimum/system/global/fonts.yml",
      "site/system/global/custom_code.yml"   => "current/lib/site_templates/minimum/system/global/custom_code.yml",
      "site/system/defaults/cards.yml"       => "current/lib/site_templates/minimum/system/defaults/cards.yml",
      "site/system/defaults/collections.yml" => "current/lib/site_templates/minimum/system/defaults/collections.yml",
      "site/system/integrations/postmark.yml" => "current/lib/site_templates/features/postmark/system/integrations/postmark.yml",
      "site/system/integrations/snipcart.yml" => "current/lib/site_templates/features/snipcart/system/integrations/snipcart.yml",
      "site/system/integrations/stripe.yml"   => "current/lib/site_templates/features/stripe/system/integrations/stripe.yml",
    }

    # Recursively collect dotted key paths (keys only; list items are values).
    def key_paths(obj, prefix = "")
      return [] unless obj.is_a?(Hash)
      obj.flat_map do |k, v|
        path = prefix.empty? ? k.to_s : "#{prefix}.#{k}"
        [path] + key_paths(v, path)
      end
    end

    def load_keys(path)
      Set.new(key_paths(YAML.safe_load(File.read(path), aliases: true) || {}))
    rescue => e
      warn "    (could not parse #{path}: #{e.message})"
      nil
    end

    any = false
    pairs.each do |site_rel, tmpl_rel|
      site_path = File.join(root, site_rel)
      tmpl_path = File.join(root, tmpl_rel)
      next unless File.exist?(site_path) && File.exist?(tmpl_path) # skip disabled features

      site_keys = load_keys(site_path) or next
      tmpl_keys = load_keys(tmpl_path) or next

      missing = (site_keys - tmpl_keys).sort # in /site, NOT in template ← backport these
      extra   = (tmpl_keys - site_keys).sort # in template, not in /site (often fine)
      next if missing.empty? && extra.empty?

      any = true
      puts "    #{site_rel}"
      missing.each { |k| puts "      + in /site, missing from template:  #{k}" }
      extra.each   { |k| puts "      · in template, not in /site:        #{k}" }
    end

    puts "    ✓ All checked config keys are in sync." unless any
RUBY
else
  echo "    (ruby not found on PATH — skipping config key check)"
fi
echo ""

if [[ -n "$DRY_RUN" ]]; then
  echo "Dry run complete. Re-run without --dry-run to apply."
else
  echo "Done."
fi
