#!/usr/bin/env ruby
# frozen_string_literal: true

# Roe Markdown Doctor
#
# Diagnostic tool for Roe-authored Markdown files in site/.
#
# Checks:
#   1. Fence validity — backtick fences must be 3 or 4 backticks long (1 is
#      allowed inline but not alone on a line; 2 and 5+ are invalid).
#   2. Fence matching — an opening fence must be closed by a fence of the same
#      length. A 4-backtick fence should contain a nested 3-backtick fence;
#      otherwise it should be 3.
#   3. List spacing — a list item immediately following a non-list element
#      without a blank line in between. Kramdown/Roe needs the blank line.
#
# Output is terminal-only: counts, file/line locations, and supplemental regex
# patterns you can paste into an editor for find/replace work.

require "fileutils"
require "pathname"

# The checks live in the app so the editor can run them too — a second copy
# here would drift. Required directly rather than booting Rails, which is why
# MarkdownDoctor is kept free of ActiveSupport.
require_relative "../app/services/markdown_doctor"

# ── Path resolution ──────────────────────────────────────────────────────────

def site_path
  script_dir = __dir__
  app_dir    = File.expand_path("..", script_dir)

  project_root = if File.basename(app_dir) == "current"
    File.expand_path("..", app_dir)
  else
    app_dir
  end

  # Allow overriding with ROE_SITE_PATH for tests/non-standard layouts.
  ENV["ROE_SITE_PATH"] || File.join(project_root, "site")
end

def markdown_files(dir)
  return [] unless Dir.exist?(dir)

  Pathname.glob(File.join(dir, "**", "*.md")).sort.map(&:to_s)
end

# ── Reporting ────────────────────────────────────────────────────────────────

def pluralize(count, singular, plural = "#{singular}s")
  count == 1 ? "#{count} #{singular}" : "#{count} #{plural}"
end

def print_report(all_issues, files_scanned, target)
  grouped = all_issues.group_by { |i| i[:type] }

  puts "Scanned #{pluralize(files_scanned, 'file')} in #{target}"
  puts

  MarkdownDoctor::ISSUE_TYPES.each do |type, label|
    issues = grouped[type] || []
    puts "#{label}: #{issues.length}"

    issues.group_by { |i| i[:file] }.sort.each do |file, file_issues|
      puts "  #{file}"
      file_issues.each do |issue|
        puts "    line #{issue[:line]}: #{issue[:message]}"
      end
    end
  end

  total = all_issues.length
  puts
  if total == 0
    puts "No issues found."
  else
    puts "Total issues: #{total}"
  end

  puts
  puts "Supplemental regex patterns for editor search:"
  puts "  1 or 2 backtick fence:       ^`{1,2}[^`\\n]*$"
  puts "  5+ backtick fence:           ^`{5,}[^`\\n]*$"
  puts "  List without blank line:     (?m)^(?![#>\\-+*]|\\d+\\.)[^\\n].+\\r?\n^(?:[-*+]|\\d+\\.)[ \\t]"
  puts "  Unindented blockquote:       ^>(?!\\s{4})\\s?.*$  (between list items at column 0)"
end

# ── Main ─────────────────────────────────────────────────────────────────────

def run
  target = ARGV[0] || site_path
  files  = File.directory?(target) ? markdown_files(target) : [target]

  if files.empty?
    puts "No Markdown files found in #{target}"
    exit 0
  end

  all_issues = []

  files.each do |file|
    MarkdownDoctor.diagnose_file(file).each do |issue|
      all_issues << issue.merge(file: file)
    end
  end

  print_report(all_issues, files.length, target)

  exit(all_issues.empty? ? 0 : 1)
end

run
