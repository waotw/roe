#!/bin/bash -e

# Fix permissions if running as root
if [ "$(id -u)" = '0' ]; then
  mkdir -p /data/db /data/site
  chown -R rails:rails /data

  # Enable jemalloc
  if [ -z "${LD_PRELOAD+x}" ]; then
      LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
      export LD_PRELOAD
  fi

  # If running the rails server, prepare all databases on this machine.
  # Detection: look for "bin/rails server" pattern anywhere in the args,
  # so launch commands with flags appended (e.g. `bin/rails server -b
  # 0.0.0.0 -p 8080` as Fly's [processes] block emits) still match.
  # The previous version only matched when "server" was the literal
  # last arg, which silently skipped db:prepare on Fly deploys —
  # crashing Puma at boot because Solid Queue's tables hadn't been
  # created yet.
  echo "[docker-entrypoint] Checking if should run db:prepare..."
  echo "[docker-entrypoint] Args: $@"
  if echo "$@" | grep -qE 'bin/rails[[:space:]]+server\b'; then
    echo "[docker-entrypoint] Conditions met, running db:prepare..."
    gosu rails ./bin/rails db:prepare
    echo "[docker-entrypoint] db:prepare completed"
  else
    echo "[docker-entrypoint] Skipping db:prepare (conditions not met)"
  fi

  # Re-execute as rails user
  exec gosu rails "$@"
fi

# If we get here, we're already running as rails user
exec "$@"
