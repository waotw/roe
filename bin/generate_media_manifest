#!/usr/bin/env ruby
# frozen_string_literal: true

# Generates a media manifest for the site directory
# Outputs Markdown format for graphify ingestion
# This allows graphify to understand media relationships without processing thousands of image files
#
# Usage:
#   bin/generate_media_manifest           # Incremental update (default)
#   bin/generate_media_manifest --full    # Full regeneration

require "pathname"
require "digest"
require "time"

SITE_DIR = Pathname.new("site").expand_path
MANIFEST_PATH = SITE_DIR.join("media_manifest.md")

# Media file extensions to include
MEDIA_EXTENSIONS = %w[
  .jpg .jpeg .png .gif .svg .webp .ico
  .mp3 .mp4 .wav .ogg .m4a .mov .webm
].freeze

# Files/directories to exclude
EXCLUDE_PATTERNS = [
  /variants\//,           # Exclude variants/ subdirectory
  /\.DS_Store$/,
  /\.gitkeep$/,
  /\.keep$/,
  /^\./                   # Hidden files
].freeze

def media_file?(path)
  return false unless path.file?
  return false unless MEDIA_EXTENSIONS.include?(path.extname.downcase)
  
  # Check exclude patterns
  relative_path = path.relative_path_from(SITE_DIR).to_s
  EXCLUDE_PATTERNS.none? { |pattern| relative_path.match?(pattern) }
end

def categorize_file(path)
  ext = path.extname.downcase
  case ext
  when ".jpg", ".jpeg", ".png", ".gif", ".svg", ".webp", ".ico"
    "image"
  when ".mp3", ".mp4", ".wav", ".ogg", ".m4a", ".mov", ".webm"
    "audio"
  else
    "other"
  end
end

def file_checksum(path)
  Digest::MD5.file(path).hexdigest
end

def format_file_size(size)
  if size < 1024
    "#{size}B"
  elsif size < 1024 * 1024
    "#{(size / 1024.0).round(1)}KB"
  else
    "#{(size / (1024.0 * 1024)).round(1)}MB"
  end
end

def scan_media_files
  files_by_category = { "image" => [], "audio" => [] }
  files_by_directory = {}
  file_metadata = {}
  
  SITE_DIR.glob("**/*") do |path|
    next unless media_file?(path)
    
    relative_path = path.relative_path_from(SITE_DIR).to_s
    category = categorize_file(path)
    
    files_by_category[category] << relative_path
    
    # Group by directory
    dir = File.dirname(relative_path)
    files_by_directory[dir] ||= []
    files_by_directory[dir] << relative_path
    
    file_metadata[relative_path] = {
      size: path.size,
      size_formatted: format_file_size(path.size),
      checksum: file_checksum(path),
      modified_at: path.mtime.iso8601,
      extension: path.extname.downcase
    }
  end
  
  [files_by_category, files_by_directory, file_metadata]
end

def generate_markdown_manifest(files_by_category, files_by_directory, file_metadata)
  total_files = files_by_category.values.sum(&:size)
  generated_at = Time.now.iso8601
  
  md = <<~MARKDOWN
    # Site Media Manifest

    This file contains a complete inventory of all media files in the site directory.
    Generated: #{generated_at}
    Total files: #{total_files}

    ## Summary by Type

    - **Images**: #{files_by_category['image'].size} files
    - **Audio**: #{files_by_category['audio'].size} files

    ## Media Files by Directory

  MARKDOWN

  # Sort directories alphabetically
  files_by_directory.sort.each do |dir, files|
    md << "### #{dir}\n\n"
    
    files.sort.each do |relative_path|
      meta = file_metadata[relative_path]
      filename = File.basename(relative_path)
      
      md << "- **#{filename}**\n"
      md << "  - Path: `#{relative_path}`\n"
      md << "  - Size: #{meta[:size_formatted]}\n"
      md << "  - Modified: #{meta[:modified_at]}\n"
      md << "  - Checksum: `#{meta[:checksum]}`\n"
      md << "\n"
    end
  end

  md << <<~MARKDOWN

    ## All Image Files

    The following #{files_by_category['image'].size} image files are available for use in content:

  MARKDOWN

  files_by_category['image'].sort.each do |path|
    meta = file_metadata[path]
    md << "- `#{path}` (#{meta[:size_formatted]})\n"
  end

  if files_by_category['audio'].any?
    md << <<~MARKDOWN

      ## All Audio Files

      The following #{files_by_category['audio'].size} audio files are available:

    MARKDOWN

    files_by_category['audio'].sort.each do |path|
      meta = file_metadata[path]
      md << "- `#{path}` (#{meta[:size_formatted]})\n"
    end
  end

  md << <<~MARKDOWN

    ## Usage in Content

    Media files can be referenced in Markdown content using:

    - Images: `![Alt text](#{files_by_category['image'].first || 'media/images/example.jpg'})`
    - Audio: `[Audio description](#{files_by_category['audio'].first || 'media/audio/example.mp3'})`

    ## File Integrity

    Checksums (MD5) are provided for each file to verify integrity and detect changes.

  MARKDOWN

  md
end

def load_existing_manifest
  return nil unless MANIFEST_PATH.exist?
  MANIFEST_PATH.read
rescue
  nil
end

def generate_full_manifest
  puts "Generating full media manifest..."
  
  files_by_category, files_by_directory, file_metadata = scan_media_files
  markdown = generate_markdown_manifest(files_by_category, files_by_directory, file_metadata)
  
  MANIFEST_PATH.write(markdown)
  
  puts "✓ Generated media manifest at site/media_manifest.md"
  puts "  Images: #{files_by_category['image'].size}"
  puts "  Audio: #{files_by_category['audio'].size}"
  puts "  Total: #{files_by_category.values.sum(&:size)} files"
  puts "  Directories: #{files_by_directory.keys.size}"
  
  markdown
end

def generate_incremental_manifest
  puts "Checking for incremental updates..."
  
  existing_content = load_existing_manifest
  
  files_by_category, files_by_directory, file_metadata = scan_media_files
  current_total = files_by_category.values.sum(&:size)
  
  if existing_content
    # Extract total from existing markdown
    existing_total = existing_content.match(/Total files: (\d+)/)&.[](1)&.to_i || 0
    
    if existing_total == current_total
      puts "✓ No changes detected. Manifest is up to date."
      puts "  Total files: #{current_total}"
      return existing_content
    end
    
    puts "Changes detected (#{existing_total} → #{current_total} files)"
  else
    puts "No existing manifest found. Running full generation..."
  end
  
  markdown = generate_markdown_manifest(files_by_category, files_by_directory, file_metadata)
  MANIFEST_PATH.write(markdown)
  
  puts "✓ Updated media manifest"
  puts "  Images: #{files_by_category['image'].size}"
  puts "  Audio: #{files_by_category['audio'].size}"
  puts "  Total: #{current_total} files"
  puts "  Directories: #{files_by_directory.keys.size}"
  
  markdown
end

def main
  full_mode = ARGV.include?("--full")
  
  unless SITE_DIR.directory?
    puts "Error: site/ directory not found at #{SITE_DIR}"
    exit 1
  end
  
  if full_mode
    generate_full_manifest
  else
    generate_incremental_manifest
  end
  
  puts "\nManifest location: #{MANIFEST_PATH}"
  puts "\nNext step: Run '/graphify site/media_manifest.md' to ingest into graphify"
end

main
