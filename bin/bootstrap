#!/usr/bin/env ruby
require_relative "../config/environment"

puts "\n" + "=" * 60
puts "🔐 ADMIN USER SETUP"
puts "=" * 60

# Check if admin already exists
existing_user = User.first
if existing_user
  puts "\n⚠️  Admin user already exists: #{existing_user.email_address}"
  print "Do you want to reset the password? (y/n): "
  response = gets.chomp.downcase

  unless response == 'y' || response == 'yes'
    puts "Skipping admin setup."
    exit 0
  end

  user = existing_user
  puts "\nResetting password for: #{user.email_address}"
else
  puts "\nNo admin user found. Let's create one!"

  print "\nEmail address (default: admin@example.com): "
  email_address = gets.chomp
  email_address = 'admin@example.com' if email_address.empty?

  user = User.new(email_address: email_address)
end

# Password setup
puts "\n" + "-" * 60
puts "PASSWORD SETUP"
puts "-" * 60
print "\nGenerate a random password? (Y/n): "
use_random = gets.chomp.downcase

if use_random == 'n' || use_random == 'no'
  # Manual password entry
  require 'io/console'

  loop do
    print "Enter password (min 8 characters): "
    password = STDIN.noecho(&:gets).chomp
    puts ""

    print "Confirm password: "
    password_confirmation = STDIN.noecho(&:gets).chomp
    puts ""

    if password != password_confirmation
      puts "❌ Passwords don't match. Try again.\n"
      next
    end

    if password.length < 8
      puts "❌ Password must be at least 8 characters. Try again.\n"
      next
    end

    user.password = password
    user.password_confirmation = password_confirmation
    break
  end

  show_password = false
else
  # Generate random password
  password = SecureRandom.alphanumeric(16)
  user.password = password
  user.password_confirmation = password
  show_password = true
end

# Save user
if user.save
  puts "\n" + "=" * 60
  puts "✅ SUCCESS!"
  puts "=" * 60
  puts "\nAdmin user #{existing_user ? 'updated' : 'created'}:"
  puts "   📧 Email: #{user.email_address}"

  if show_password
    puts "   🔑 Password: #{password}"
    puts "\n⚠️  SAVE THIS PASSWORD NOW!"
    puts "   You won't be able to see it again."
  end

  puts "\n   🌐 Login at: http://localhost:3000/session/new"
  puts "\n" + "=" * 60

  if show_password
    print "\nPress enter after you've saved the password..."
    gets
  end
else
  puts "\n❌ Error creating user:"
  user.errors.full_messages.each { |msg| puts "   - #{msg}" }
  exit 1
end
